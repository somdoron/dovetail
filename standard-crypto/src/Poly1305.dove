package standard.crypto

import standard.prelude.Array

/// Poly1305 one-time authenticator (RFC 8439). Constant-time, using the
/// poly1305-donna 26-bit-limb representation: five 26-bit limbs held in
/// `Uint64`, so every limb product and accumulation fits in 64 bits without
/// needing 128-bit arithmetic. The final modular reduction and the conditional
/// subtraction of p = 2^130 - 5 are branch-free.
module Poly1305 =
    private function load32(b: Array<Uint8>, off: Int32): Uint64 =
        b
            .get(off)
            .toUint64()
            | (b.get(off + 1).toUint64() << 8u64)
            | (b.get(off + 2).toUint64() << 16u64)
            | (b.get(off + 3).toUint64() << 24u64)

    private function store32(b: Array<Uint8>, off: Int32, word: Uint64): Unit =
        b.set(off, word.toUint8())
        b.set(off + 1, (word >> 8u64).toUint8())
        b.set(off + 2, (word >> 16u64).toUint8())
        b.set(off + 3, (word >> 24u64).toUint8())

    /// Compute the 16-byte Poly1305 tag of `msg` under the 32-byte one-time
    /// `key` (r ‖ s).
    function mac(key: Array<Uint8>, msg: Array<Uint8>): Array<Uint8> =
        let mask26 = 0x3ffffffu64

        // Clamp r and split into 26-bit limbs (the masks fold in the clamp).
        let t0 = load32(key, 0)
        let t1 = load32(key, 4)
        let t2 = load32(key, 8)
        let t3 = load32(key, 12)
        let r0 = t0 & 0x3ffffffu64
        let r1 = ((t0 >> 26u64) | (t1 << 6u64)) & 0x3ffff03u64
        let r2 = ((t1 >> 20u64) | (t2 << 12u64)) & 0x3ffc0ffu64
        let r3 = ((t2 >> 14u64) | (t3 << 18u64)) & 0x3f03fffu64
        let r4 = (t3 >> 8u64) & 0x00fffffu64
        let s1 = r1 * 5u64
        let s2 = r2 * 5u64
        let s3 = r3 * 5u64
        let s4 = r4 * 5u64

        let mutable h0 = 0u64
        let mutable h1 = 0u64
        let mutable h2 = 0u64
        let mutable h3 = 0u64
        let mutable h4 = 0u64

        let total = msg.length
        let mutable offset = 0
        while offset < total do
            let remaining = total - offset
            let blockLen = if remaining >= 16 then 16 else remaining
            let buf = Array<Uint8>.fill(16, 0u8)
            let mutable c = 0
            while c < blockLen do
                buf.set(c, msg.get(offset + c))
                c = c + 1
            // For a full block the high bit is 2^128 (bit 24 of limb 4); for a
            // partial block append a 0x01 byte and use no extra high bit.
            let hibit = if blockLen == 16 then 0x1000000u64 else 0u64
            if blockLen < 16 then buf.set(blockLen, 1u8)

            // h += m
            h0 = h0 + (load32(buf, 0) & mask26)
            h1 = h1 + ((load32(buf, 3) >> 2u64) & mask26)
            h2 = h2 + ((load32(buf, 6) >> 4u64) & mask26)
            h3 = h3 + ((load32(buf, 9) >> 6u64) & mask26)
            h4 = h4 + ((load32(buf, 12) >> 8u64) | hibit)

            // h *= r  (mod 2^130 - 5), schoolbook with the *5 reductions folded in.
            let d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1
            let d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2
            let d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3
            let d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4
            let d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0

            // Partial carry propagation.
            let mutable cc = d0 >> 26u64
            h0 = d0 & mask26
            let e1 = d1 + cc
            cc = e1 >> 26u64
            h1 = e1 & mask26
            let e2 = d2 + cc
            cc = e2 >> 26u64
            h2 = e2 & mask26
            let e3 = d3 + cc
            cc = e3 >> 26u64
            h3 = e3 & mask26
            let e4 = d4 + cc
            cc = e4 >> 26u64
            h4 = e4 & mask26
            h0 = h0 + cc * 5u64
            cc = h0 >> 26u64
            h0 = h0 & mask26
            h1 = h1 + cc

            offset = offset + 16

        // Fully carry h.
        let mutable c2 = h1 >> 26u64
        h1 = h1 & mask26
        h2 = h2 + c2
        c2 = h2 >> 26u64
        h2 = h2 & mask26
        h3 = h3 + c2
        c2 = h3 >> 26u64
        h3 = h3 & mask26
        h4 = h4 + c2
        c2 = h4 >> 26u64
        h4 = h4 & mask26
        h0 = h0 + c2 * 5u64
        c2 = h0 >> 26u64
        h0 = h0 & mask26
        h1 = h1 + c2

        // Compute g = h + 5 (= h - p, modulo 2^130); subtract 2^130 in limb 4.
        let mutable g0 = h0 + 5u64
        c2 = g0 >> 26u64
        g0 = g0 & mask26
        let mutable g1 = h1 + c2
        c2 = g1 >> 26u64
        g1 = g1 & mask26
        let mutable g2 = h2 + c2
        c2 = g2 >> 26u64
        g2 = g2 & mask26
        let mutable g3 = h3 + c2
        c2 = g3 >> 26u64
        g3 = g3 & mask26
        let mutable g4 = h4 + c2 - 0x4000000u64

        // Select g if h >= p (g did not underflow), else keep h — branch-free.
        let sign = (g4 >> 63u64) & 1u64
        let useG = sign - 1u64
        let keepH = ~useG
        h0 = (h0 & keepH) | (g0 & useG)
        h1 = (h1 & keepH) | (g1 & useG)
        h2 = (h2 & keepH) | (g2 & useG)
        h3 = (h3 & keepH) | (g3 & useG)
        h4 = (h4 & keepH) | (g4 & useG)

        // Collapse five 26-bit limbs into four 32-bit words.
        let w0 = (h0 | (h1 << 26u64)) & 0xffffffffu64
        let w1 = ((h1 >> 6u64) | (h2 << 20u64)) & 0xffffffffu64
        let w2 = ((h2 >> 12u64) | (h3 << 14u64)) & 0xffffffffu64
        let w3 = ((h3 >> 18u64) | (h4 << 8u64)) & 0xffffffffu64

        // mac = (h + s) mod 2^128
        let pad0 = load32(key, 16)
        let pad1 = load32(key, 20)
        let pad2 = load32(key, 24)
        let pad3 = load32(key, 28)
        let mutable f = w0 + pad0
        let m0 = f & 0xffffffffu64
        f = w1 + pad1 + (f >> 32u64)
        let m1 = f & 0xffffffffu64
        f = w2 + pad2 + (f >> 32u64)
        let m2 = f & 0xffffffffu64
        f = w3 + pad3 + (f >> 32u64)
        let m3 = f & 0xffffffffu64

        let tag = Array<Uint8>.fill(16, 0u8)
        store32(tag, 0, m0)
        store32(tag, 4, m1)
        store32(tag, 8, m2)
        store32(tag, 12, m3)
        tag

test "Poly1305 RFC 8439 section 2.5.2" =
    let key =
        [|
            0x85u8,
            0xd6u8,
            0xbeu8,
            0x78u8,
            0x57u8,
            0x55u8,
            0x6du8,
            0x33u8,
            0x7fu8,
            0x44u8,
            0x52u8,
            0xfeu8,
            0x42u8,
            0xd5u8,
            0x06u8,
            0xa8u8,
            0x01u8,
            0x03u8,
            0x80u8,
            0x8au8,
            0xfbu8,
            0x0du8,
            0xb2u8,
            0xfdu8,
            0x4au8,
            0xbfu8,
            0xf6u8,
            0xafu8,
            0x41u8,
            0x49u8,
            0xf5u8,
            0x1bu8,
        |]
    let msg = "Cryptographic Forum Research Group".bytes()
    let tag = Poly1305.mac(key, msg)
    let expected =
        [|
            0xa8u8,
            0x06u8,
            0x1du8,
            0xc1u8,
            0x30u8,
            0x51u8,
            0x36u8,
            0xc6u8,
            0xc2u8,
            0x2bu8,
            0x8bu8,
            0xafu8,
            0x0cu8,
            0x01u8,
            0x27u8,
            0xa9u8,
        |]
    assert tag.length == 16
    let mutable i = 0
    let mutable ok = true
    while i < 16 do
        if tag.get(i) != expected.get(i) then ok = false
        i = i + 1
    assert ok
