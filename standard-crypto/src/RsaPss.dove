package standard.crypto

import standard.prelude.Array

/// RSA signatures (RFC 8017 / PKCS#1 v2.2): RSA-PSS (sign + verify) and
/// PKCS#1 v1.5 (verify only). Both are parameterized by a `HashAlgorithm` so
/// the SHA-256 and SHA-384 variants used by TLS 1.3 and X.509 are available.
///
/// PKCS#1 v1.5 *signing* and v1.5 *encryption* are intentionally excluded; v1.5
/// verify exists only because the public web PKI signs certificates with it.
/// RSA keys are structured (modulus + exponent big-endian bytes, as found in
/// X.509 / PKCS#1), so this uses plain byte arrays rather than the byte-keyed
/// `SignatureAlgorithm` trait. The deterministic PSS signer uses an empty salt.
module RsaPss =
    /// Largest RSA modulus (in bytes) accepted on the verify path: 1024 bytes =
    /// 8192-bit, far above any real certificate key, so it never rejects a genuine
    /// signature but caps the O(limbs^2) Bignum work an attacker cert can demand.
    function maxRsaModulusBytes(): Int32 = 1024

    /// Largest RSA public exponent (in bytes) accepted on the verify path. `modExp`
    /// runs one O(limbs^2) multiply per exponent bit, so an unbounded exponent is a
    /// second compute-DoS axis independent of the modulus. Real exponents are tiny
    /// (3 = 0x03, 65537 = 0x010001); 8 bytes is far above any real key.
    function maxRsaExponentBytes(): Int32 = 8

    /// MGF1 mask generation function, parameterized by hash.
    function mgf1(hash: HashAlgorithm, seed: Array<Uint8>, maskLen: Int32): Array<Uint8> =
        let hLen = hash.digestSize
        let res = Array<Uint8>.fill(maskLen, 0u8)
        let mutable counter = 0
        let mutable pos = 0
        while pos < maskLen do
            let c = Array<Uint8>.fill(4, 0u8)
            c.set(0, (counter >> 24).toUint8())
            c.set(1, (counter >> 16).toUint8())
            c.set(2, (counter >> 8).toUint8())
            c.set(3, counter.toUint8())
            let h = hash.hash(seed.concat(c))
            let mutable j = 0
            while (j < hLen) && (pos + j < maskLen) do
                res.set(pos + j, h.get(j))
                j = j + 1
            counter = counter + 1
            pos = pos + hLen
        res

    /// EMSA-PSS-ENCODE (RFC 8017 §9.1.1). `mHash` is `hash` of the message.
    function emsaPssEncode(hash: HashAlgorithm, mHash: Array<Uint8>, emBits: Int32, salt: Array<Uint8>): Array<Uint8> =
        let hLen = hash.digestSize
        let sLen = salt.length
        let emLen = (emBits + 7) / 8
        let mPrime = Array<Uint8>.fill(8, 0u8).concat(mHash).concat(salt)
        let h = hash.hash(mPrime)
        let dbLen = emLen - hLen - 1
        let db = Array<Uint8>.fill(dbLen, 0u8)
        db.set(dbLen - sLen - 1, 0x01u8)
        salt.copy(db, dbLen - sLen)
        let dbMask = mgf1(hash, h, dbLen)
        let maskedDb = Array<Uint8>.fill(dbLen, 0u8)
        let mutable i = 0
        while i < dbLen do
            maskedDb.set(i, db.get(i) ^ dbMask.get(i))
            i = i + 1
        let topBits = 8 * emLen - emBits
        maskedDb.set(0, maskedDb.get(0) & (0xffu8 >> topBits.toUint8()))
        let em = Array<Uint8>.fill(emLen, 0u8)
        maskedDb.copy(em, 0)
        h.copy(em, dbLen)
        em.set(emLen - 1, 0xbcu8)
        em

    /// EMSA-PSS-VERIFY (RFC 8017 §9.1.2).
    function emsaPssVerify(hash: HashAlgorithm, mHash: Array<Uint8>, em: Array<Uint8>, emBits: Int32, sLen: Int32): Bool =
        let hLen = hash.digestSize
        let emLen = (emBits + 7) / 8
        if emLen < hLen + sLen + 2 then
            false
        else if em.get(emLen - 1) != 0xbcu8 then
            false
        else
            let dbLen = emLen - hLen - 1
            let maskedDb = Array<Uint8>.fill(dbLen, 0u8)
            em.copy(0, maskedDb, 0, dbLen)
            let h = Array<Uint8>.fill(hLen, 0u8)
            em.copy(dbLen, h, 0, hLen)
            let topBits = 8 * emLen - emBits
            if (maskedDb.get(0) >> (8 - topBits).toUint8()) != 0u8 then
                false
            else
                let dbMask = mgf1(hash, h, dbLen)
                let db = Array<Uint8>.fill(dbLen, 0u8)
                let mutable i = 0
                while i < dbLen do
                    db.set(i, maskedDb.get(i) ^ dbMask.get(i))
                    i = i + 1
                db.set(0, db.get(0) & (0xffu8 >> topBits.toUint8()))
                let mutable ok = true
                i = 0
                while i < dbLen - sLen - 1 do
                    if db.get(i) != 0u8 then ok = false
                    i = i + 1
                if db.get(dbLen - sLen - 1) != 0x01u8 then ok = false
                if ok == false then
                    false
                else
                    let salt = Array<Uint8>.fill(sLen, 0u8)
                    db.copy(dbLen - sLen, salt, 0, sLen)
                    let mPrime = Array<Uint8>.fill(8, 0u8).concat(mHash).concat(salt)
                    ConstantTime.equal(hash.hash(mPrime), h)

    /// Verify an RSA-PSS signature with the given hash. `modulus`/`exponent` are
    /// big-endian; `sLen` is the expected salt length.
    public function verify(
        hash: HashAlgorithm,
        modulus: Array<Uint8>,
        exponent: Array<Uint8>,
        message: Array<Uint8>,
        signature: Array<Uint8>,
        sLen: Int32
    ): Bool =
        let modLen = modulus.length
        // A zero-length modulus (from an `02 00` INTEGER in an attacker cert) makes
        // `Bignum.fromBytes` an empty limb array, and `modExp` -> `n0inv` -> `m.get(0)`
        // traps on it — an unauthenticated parse-time DoS. An absurdly large modulus is a
        // compute-DoS (montMul is O(limbs^2)). Bound both before touching Bignum. Real
        // RSA is <= 8192-bit (1024 bytes).
        if modLen == 0 || modLen > maxRsaModulusBytes() || exponent.length == 0 || exponent.length > maxRsaExponentBytes() || signature.length != modLen then
            false
        else
            let nLimbs = Bignum.fromBytes(modulus, 0, modLen)
            let eLimbs = Bignum.fromBytes(exponent, 0, exponent.length)
            let s = Bignum.fromBytes(signature, 0, modLen)
            let m = Bignum.modExp(s, eLimbs, nLimbs)
            let emBits = Bignum.bitLength(nLimbs) - 1
            let emLen = (emBits + 7) / 8
            let em = Bignum.toBytes(m, emLen)
            emsaPssVerify(hash, hash.hash(message), em, emBits, sLen)

    /// Produce an RSA-PSS signature with the given hash and salt (empty salt =
    /// deterministic). `modulus`/`privateExponent` are big-endian.
    public function sign(
        hash: HashAlgorithm,
        modulus: Array<Uint8>,
        privateExponent: Array<Uint8>,
        message: Array<Uint8>,
        salt: Array<Uint8>
    ): Array<Uint8> =
        let modLen = modulus.length
        let nLimbs = Bignum.fromBytes(modulus, 0, modLen)
        let dLimbs = Bignum.fromBytes(privateExponent, 0, privateExponent.length)
        let emBits = Bignum.bitLength(nLimbs) - 1
        let em = emsaPssEncode(hash, hash.hash(message), emBits, salt)
        let emInt = Bignum.fromBytes(em, 0, em.length)
        let s = Bignum.modExp(emInt, dLimbs, nLimbs)
        Bignum.toBytes(s, modLen)

    // --- PKCS#1 v1.5 (verify only; sign provided for self-test) ---

    /// DigestInfo DER prefix for SHA-256.
    function digestInfoSha256(): Array<Uint8> =
        [|0x30u8, 0x31u8, 0x30u8, 0x0du8, 0x06u8, 0x09u8, 0x60u8, 0x86u8,
         0x48u8, 0x01u8, 0x65u8, 0x03u8, 0x04u8, 0x02u8, 0x01u8, 0x05u8,
         0x00u8, 0x04u8, 0x20u8|]

    /// DigestInfo DER prefix for SHA-384.
    function digestInfoSha384(): Array<Uint8> =
        [|0x30u8, 0x41u8, 0x30u8, 0x0du8, 0x06u8, 0x09u8, 0x60u8, 0x86u8,
         0x48u8, 0x01u8, 0x65u8, 0x03u8, 0x04u8, 0x02u8, 0x02u8, 0x05u8,
         0x00u8, 0x04u8, 0x30u8|]

    /// EM = 0x00 ‖ 0x01 ‖ 0xff..ff ‖ 0x00 ‖ t  (EMSA-PKCS1-v1.5).
    private function pkcs1Pad(t: Array<Uint8>, emLen: Int32): Array<Uint8> =
        let em = Array<Uint8>.fill(emLen, 0u8)
        em.set(1, 0x01u8)
        let psLen = emLen - t.length - 3
        let mutable i = 0
        while i < psLen do
            em.set(2 + i, 0xffu8)
            i = i + 1
        t.copy(em, 2 + psLen + 1)
        em

    /// Verify a PKCS#1 v1.5 signature with the given hash + DigestInfo prefix.
    function pkcs1Verify(
        hash: HashAlgorithm,
        digestInfoPrefix: Array<Uint8>,
        modulus: Array<Uint8>,
        exponent: Array<Uint8>,
        message: Array<Uint8>,
        signature: Array<Uint8>
    ): Bool =
        let modLen = modulus.length
        // See `verify`: reject an empty modulus (would trap in Bignum.n0inv) and an
        // absurdly large one (compute-DoS) before any Bignum work.
        if modLen == 0 || modLen > maxRsaModulusBytes() || exponent.length == 0 || exponent.length > maxRsaExponentBytes() || signature.length != modLen then
            false
        else
            let nLimbs = Bignum.fromBytes(modulus, 0, modLen)
            let eLimbs = Bignum.fromBytes(exponent, 0, exponent.length)
            let s = Bignum.fromBytes(signature, 0, modLen)
            let em = Bignum.toBytes(Bignum.modExp(s, eLimbs, nLimbs), modLen)
            let expected = pkcs1Pad(digestInfoPrefix.concat(hash.hash(message)), modLen)
            ConstantTime.equal(em, expected)

    /// PKCS#1 v1.5 sign (used for self-tests; not part of the intended API).
    function pkcs1Sign(
        hash: HashAlgorithm,
        digestInfoPrefix: Array<Uint8>,
        modulus: Array<Uint8>,
        privateExponent: Array<Uint8>,
        message: Array<Uint8>
    ): Array<Uint8> =
        let modLen = modulus.length
        let nLimbs = Bignum.fromBytes(modulus, 0, modLen)
        let dLimbs = Bignum.fromBytes(privateExponent, 0, privateExponent.length)
        let em = pkcs1Pad(digestInfoPrefix.concat(hash.hash(message)), modLen)
        Bignum.toBytes(Bignum.modExp(Bignum.fromBytes(em, 0, modLen), dLimbs, nLimbs), modLen)

test "EMSA-PSS encode/verify roundtrip (salted)" =
    let mHash = Sha256.hash("attack at dawn".bytes())
    let emBits = 2047
    let salt = [|
        0x11u8, 0x22u8, 0x33u8, 0x44u8, 0x55u8, 0x66u8, 0x77u8, 0x88u8,
        0x99u8, 0xaau8, 0xbbu8, 0xccu8, 0xddu8, 0xeeu8, 0xffu8, 0x00u8,
        0x11u8, 0x22u8, 0x33u8, 0x44u8, 0x55u8, 0x66u8, 0x77u8, 0x88u8,
        0x99u8, 0xaau8, 0xbbu8, 0xccu8, 0xddu8, 0xeeu8, 0xffu8, 0x00u8,
    |]
    let em = RsaPss.emsaPssEncode(Sha256, mHash, emBits, salt)
    assert RsaPss.emsaPssVerify(Sha256, mHash, em, emBits, salt.length)
    // wrong message hash must fail
    assert RsaPss.emsaPssVerify(Sha256, Sha256.hash("retreat".bytes()), em, emBits, salt.length) == false

test "EMSA-PSS encode/verify roundtrip (empty salt)" =
    let mHash = Sha256.hash("deterministic".bytes())
    let emBits = 2047
    let salt: Array<Uint8> = [||]
    let em = RsaPss.emsaPssEncode(Sha256, mHash, emBits, salt)
    assert RsaPss.emsaPssVerify(Sha256, mHash, em, emBits, 0)

test "RSA PSS + PKCS#1 v1.5 roundtrips (generated 512-bit key)" =
    // Build a real RSA key from two known primes (the P-256 field prime and the
    // P-256 group order — both prime). N = P*Q is ~512-bit. d = e^{-1} mod phi.
    let pPrime = [|0xffffffffffffffffu64, 0x00000000ffffffffu64, 0x0000000000000000u64, 0xffffffff00000001u64|]
    let qPrime = [|0xf3b9cac2fc632551u64, 0xbce6faada7179e84u64, 0xffffffffffffffffu64, 0xffffffff00000000u64|]
    let nLimbs = Bignum.mul(pPrime, qPrime)
    let phi = Bignum.mul(Bignum.subSmall(pPrime, 1u64), Bignum.subSmall(qPrime, 1u64))
    // 65537 and 3 both divide this phi; use M61 = 2^61-1 (coprime to phi).
    let e = 2305843009213693951u64
    let invPhiE = Bignum.invModU64(Bignum.divSmall(phi, e)._1, e)
    let dLimbs = Bignum.divSmall(Bignum.addSmall(Bignum.mulSmall(phi, e - invPhiE), 1u64), e)._0
    let nBytes = Bignum.toBytes(nLimbs, 64)
    let dBytes = Bignum.toBytes(dLimbs, 64)
    let eBytes = [|0x1fu8, 0xffu8, 0xffu8, 0xffu8, 0xffu8, 0xffu8, 0xffu8, 0xffu8|]
    let message = "the magic words are squeamish ossifrage".bytes()
    let tampered = "the magic words are squeamish ossifragE".bytes()
    let emptySalt: Array<Uint8> = [||]
    // PSS with SHA-256
    let pss256 = RsaPss.sign(Sha256, nBytes, dBytes, message, emptySalt)
    assert RsaPss.verify(Sha256, nBytes, eBytes, message, pss256, 0)
    assert RsaPss.verify(Sha256, nBytes, eBytes, tampered, pss256, 0) == false
    // PSS with SHA-384 (48-byte hash still fits a 64-byte EM)
    let pss384 = RsaPss.sign(Sha384, nBytes, dBytes, message, emptySalt)
    assert RsaPss.verify(Sha384, nBytes, eBytes, message, pss384, 0)
    assert RsaPss.verify(Sha256, nBytes, eBytes, message, pss384, 0) == false
    // PKCS#1 v1.5 with SHA-256
    let v15 = RsaPss.pkcs1Sign(Sha256, RsaPss.digestInfoSha256(), nBytes, dBytes, message)
    assert RsaPss.pkcs1Verify(Sha256, RsaPss.digestInfoSha256(), nBytes, eBytes, message, v15)
    assert RsaPss.pkcs1Verify(Sha256, RsaPss.digestInfoSha256(), nBytes, eBytes, tampered, v15) == false

test "RsaPss verify rejects a zero-length modulus (no Bignum trap)" =
    // An empty modulus + empty signature previously passed the `signature.length == modLen`
    // check (0 == 0) and trapped in Bignum.n0inv (`m.get(0)` on an empty limb array).
    // Reachable from X509.validate on an attacker cert with an `02 00` RSA modulus and an
    // empty `03 00` signature — must be a clean `false`, not a crash.
    let empty = Array<Uint8>.empty()
    let e = [|0x01u8, 0x00u8, 0x01u8|]
    let msg = [|0x00u8|]
    assert RsaPss.verify(Sha256, empty, e, msg, empty, 32) == false
    assert RsaPss.pkcs1Verify(Sha256, RsaPss.digestInfoSha256(), empty, e, msg, empty) == false
