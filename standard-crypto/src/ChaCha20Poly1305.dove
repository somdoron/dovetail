package standard.crypto

import standard.prelude.Array
import standard.prelude.Option
import standard.prelude.Result

/// ChaCha20-Poly1305 AEAD (RFC 8439 §2.8). Combines the ChaCha20 stream cipher
/// with the Poly1305 one-time authenticator. The low-level core; the trait
/// wrapper (`AeadAlgorithm`) is in this file below.
module ChaCha20Poly1305Core =
    /// Number of zero bytes to pad `n` up to a 16-byte boundary.
    private function pad16Len(n: Int32): Int32 = if n % 16 == 0 then 0 else 16 - (n % 16)

    /// Derive the Poly1305 one-time key: the first 32 bytes of the ChaCha20
    /// keystream block at counter 0.
    private function polyKey(key: Array<Uint8>, nonce: Array<Uint8>): Array<Uint8> =
        let block = ChaCha20.block(key, 0u32, nonce)
        let pk = Array<Uint8>.fill(32, 0u8)
        block.copy(0, pk, 0, 32)
        pk

    private function writeLE64(b: Array<Uint8>, off: Int32, n: Int32): Unit =
        let v = n.toInt64().toUint64()
        let mutable i = 0
        while i < 8 do
            b.set(off + i, (v >> (i * 8).toUint64()).toUint8())
            i = i + 1

    /// MAC input: AAD ‖ pad16 ‖ ciphertext ‖ pad16 ‖ le64(|AAD|) ‖ le64(|CT|).
    private function macData(aad: Array<Uint8>, ciphertext: Array<Uint8>): Array<Uint8> =
        let aadPad = pad16Len(aad.length)
        let ctPad = pad16Len(ciphertext.length)
        let lenOff = aad.length + aadPad + ciphertext.length + ctPad
        let data = Array<Uint8>.fill(lenOff + 16, 0u8)
        aad.copy(data, 0)
        ciphertext.copy(data, aad.length + aadPad)
        writeLE64(data, lenOff, aad.length)
        writeLE64(data, lenOff + 8, ciphertext.length)
        data

    /// Encrypt; returns (ciphertext, 16-byte tag).
    function encrypt(
        key: Array<Uint8>,
        nonce: Array<Uint8>,
        plaintext: Array<Uint8>,
        aad: Array<Uint8>
    ): (Array<Uint8>, Array<Uint8>) =
        let ciphertext = ChaCha20.encrypt(key, 1u32, nonce, plaintext)
        let tag = Poly1305.mac(polyKey(key, nonce), macData(aad, ciphertext))
        (ciphertext, tag)

    /// Verify the tag and decrypt; `None` on authentication failure.
    function decrypt(
        key: Array<Uint8>,
        nonce: Array<Uint8>,
        ciphertext: Array<Uint8>,
        aad: Array<Uint8>,
        tag: Array<Uint8>
    ): Option<Array<Uint8>> =
        let expected = Poly1305.mac(polyKey(key, nonce), macData(aad, ciphertext))
        if ConstantTime.equal(expected, tag) then
            Some(ChaCha20.encrypt(key, 1u32, nonce, ciphertext))
        else
            None

/// ChaCha20-Poly1305 as an `AeadAlgorithm`. 256-bit key, 96-bit nonce, 128-bit
/// tag. `encrypt` appends the tag to the ciphertext; `decrypt` expects that
/// layout and verifies before returning plaintext.
class ChaCha20Poly1305Algorithm() implements AeadAlgorithm =
    public property keySize(self): Int32 = 32

    public property nonceSize(self): Int32 = 12

    public property tagSize(self): Int32 = 16

    public function encrypt(
        self,
        key: SymmetricKey,
        nonce: Nonce,
        plaintext: Array<Uint8>,
        authenticatedData: Array<Uint8>
    ): Array<Uint8> =
        let r = ChaCha20Poly1305Core.encrypt(key.value, nonce.value, plaintext, authenticatedData)
        r._0.concat(r._1)

    public function decrypt(
        self,
        key: SymmetricKey,
        nonce: Nonce,
        ciphertext: Array<Uint8>,
        authenticatedData: Array<Uint8>
    ): Result<Array<Uint8>, CryptoError> =
        let n = ciphertext.length
        if n < 16 then
            Error(CryptoError.AuthenticationFailed)
        else
            let ctLen = n - 16
            let ct = Array<Uint8>.fill(ctLen, 0u8)
            ciphertext.copy(0, ct, 0, ctLen)
            let tag = Array<Uint8>.fill(16, 0u8)
            ciphertext.copy(ctLen, tag, 0, 16)
            match ChaCha20Poly1305Core
                .decrypt(key.value, nonce.value, ct, authenticatedData, tag) with
                case Some(plaintext) => Ok(plaintext)
                case None => Error(CryptoError.AuthenticationFailed)

/// The ChaCha20-Poly1305 AEAD algorithm.
public let ChaCha20Poly1305: AeadAlgorithm = ChaCha20Poly1305Algorithm()

test "ChaCha20-Poly1305 AEAD RFC 8439 section 2.8.2" =
    let key = Array<Uint8>.fill(32, 0u8)
    let mutable i = 0
    while i < 32 do
        key.set(i, (0x80 + i).toUint8())
        i = i + 1
    let nonce =
        [|
            0x07u8,
            0x00u8,
            0x00u8,
            0x00u8,
            0x40u8,
            0x41u8,
            0x42u8,
            0x43u8,
            0x44u8,
            0x45u8,
            0x46u8,
            0x47u8,
        |]
    let aad =
        [|
            0x50u8,
            0x51u8,
            0x52u8,
            0x53u8,
            0xc0u8,
            0xc1u8,
            0xc2u8,
            0xc3u8,
            0xc4u8,
            0xc5u8,
            0xc6u8,
            0xc7u8,
        |]
    let plaintext =
        "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
            .bytes()
    let result = ChaCha20Poly1305Core.encrypt(key, nonce, plaintext, aad)
    let ciphertext = result._0
    let tag = result._1
    let expectedCt =
        [|
            0xd3u8,
            0x1au8,
            0x8du8,
            0x34u8,
            0x64u8,
            0x8eu8,
            0x60u8,
            0xdbu8,
            0x7bu8,
            0x86u8,
            0xafu8,
            0xbcu8,
            0x53u8,
            0xefu8,
            0x7eu8,
            0xc2u8,
            0xa4u8,
            0xadu8,
            0xedu8,
            0x51u8,
            0x29u8,
            0x6eu8,
            0x08u8,
            0xfeu8,
            0xa9u8,
            0xe2u8,
            0xb5u8,
            0xa7u8,
            0x36u8,
            0xeeu8,
            0x62u8,
            0xd6u8,
            0x3du8,
            0xbeu8,
            0xa4u8,
            0x5eu8,
            0x8cu8,
            0xa9u8,
            0x67u8,
            0x12u8,
            0x82u8,
            0xfau8,
            0xfbu8,
            0x69u8,
            0xdau8,
            0x92u8,
            0x72u8,
            0x8bu8,
            0x1au8,
            0x71u8,
            0xdeu8,
            0x0au8,
            0x9eu8,
            0x06u8,
            0x0bu8,
            0x29u8,
            0x05u8,
            0xd6u8,
            0xa5u8,
            0xb6u8,
            0x7eu8,
            0xcdu8,
            0x3bu8,
            0x36u8,
            0x92u8,
            0xddu8,
            0xbdu8,
            0x7fu8,
            0x2du8,
            0x77u8,
            0x8bu8,
            0x8cu8,
            0x98u8,
            0x03u8,
            0xaeu8,
            0xe3u8,
            0x28u8,
            0x09u8,
            0x1bu8,
            0x58u8,
            0xfau8,
            0xb3u8,
            0x24u8,
            0xe4u8,
            0xfau8,
            0xd6u8,
            0x75u8,
            0x94u8,
            0x55u8,
            0x85u8,
            0x80u8,
            0x8bu8,
            0x48u8,
            0x31u8,
            0xd7u8,
            0xbcu8,
            0x3fu8,
            0xf4u8,
            0xdeu8,
            0xf0u8,
            0x8eu8,
            0x4bu8,
            0x7au8,
            0x9du8,
            0xe5u8,
            0x76u8,
            0xd2u8,
            0x65u8,
            0x86u8,
            0xceu8,
            0xc6u8,
            0x4bu8,
            0x61u8,
            0x16u8,
        |]
    let expectedTag =
        [|
            0x1au8,
            0xe1u8,
            0x0bu8,
            0x59u8,
            0x4fu8,
            0x09u8,
            0xe2u8,
            0x6au8,
            0x7eu8,
            0x90u8,
            0x2eu8,
            0xcbu8,
            0xd0u8,
            0x60u8,
            0x06u8,
            0x91u8,
        |]
    assert ciphertext.length == expectedCt.length
    assert tag.length == 16
    let mutable n = 0
    let mutable ok = true
    while n < expectedCt.length do
        if ciphertext.get(n) != expectedCt.get(n) then ok = false
        n = n + 1
    assert ok
    n = 0
    while n < 16 do
        if tag.get(n) != expectedTag.get(n) then ok = false
        n = n + 1
    assert ok

test "ChaCha20-Poly1305 AEAD round-trip and tamper detection" =
    let key = Array<Uint8>.fill(32, 0x42u8)
    let nonce = Array<Uint8>.fill(12, 0x24u8)
    let aad = "header".bytes()
    let plaintext = "secret message".bytes()
    let enc = ChaCha20Poly1305Core.encrypt(key, nonce, plaintext, aad)
    let ciphertext = enc._0
    let tag = enc._1
    // correct decryption
    let dec = ChaCha20Poly1305Core.decrypt(key, nonce, ciphertext, aad, tag)
    assert dec.isSome
    let recovered = dec.require
    assert ConstantTime.equal(recovered, plaintext)
    // tampered ciphertext fails
    let tampered = ciphertext.clone()
    tampered.set(0, tampered.get(0) ^ 0x01u8)
    let bad = ChaCha20Poly1305Core.decrypt(key, nonce, tampered, aad, tag)
    assert bad.isNone

test "ChaCha20-Poly1305 AeadAlgorithm trait round-trip" =
    let key = SymmetricKey(Array<Uint8>.fill(32, 0x11u8))
    let nonce = Nonce(Array<Uint8>.fill(12, 0x22u8))
    let aad = "metadata".bytes()
    let plaintext = "hello aead world".bytes()
    assert ChaCha20Poly1305.keySize == 32
    assert ChaCha20Poly1305.nonceSize == 12
    assert ChaCha20Poly1305.tagSize == 16
    let envelope = ChaCha20Poly1305.encrypt(key, nonce, plaintext, aad)
    // ciphertext + 16-byte tag
    assert envelope.length == plaintext.length + 16
    let opened = ChaCha20Poly1305.decrypt(key, nonce, envelope, aad)
    assert opened.isOk
    assert ConstantTime.equal(opened.require, plaintext)
    // wrong AAD is rejected
    let bad = ChaCha20Poly1305.decrypt(key, nonce, envelope, "other".bytes())
    assert bad.isError
