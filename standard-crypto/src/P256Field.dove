package standard.crypto

import standard.prelude.Array

/// NIST P-256 modular arithmetic, used by ECDH-P256 and ECDSA-P256.
///
/// Elements are four little-endian `Uint64` limbs. Multiplication is Montgomery
/// (CIOS), which avoids a special-form reduction and works uniformly for both
/// the field prime `p` and the group order `n`. The Montgomery constants
/// (n0inv, R^2) are computed at runtime, so the only literal constants are `p`
/// and `n` themselves.
module P256Field =
    /// The field prime p = 2^256 - 2^224 + 2^192 + 2^96 - 1.
    function p(): Array<Uint64> =
        [|0xffffffffffffffffu64, 0x00000000ffffffffu64, 0x0000000000000000u64, 0xffffffff00000001u64|]

    /// The group order n.
    function n(): Array<Uint64> =
        [|0xf3b9cac2fc632551u64, 0xbce6faada7179e84u64, 0xffffffffffffffffu64, 0xffffffff00000000u64|]

    /// -m^{-1} mod 2^64, via Newton's iteration (m is odd).
    function n0inv(m: Array<Uint64>): Uint64 =
        let m0 = m.get(0)
        let mutable inv = m0
        let mutable i = 0
        while i < 6 do
            inv = inv * (2u64 - m0 * inv)
            i = i + 1
        0u64 - inv

    /// Add two 4-limb values, returning the carry-out in the high word of a
    /// 5-limb array.
    private function add5(a: Array<Uint64>, b: Array<Uint64>): Array<Uint64> =
        let r = Array<Uint64>.fill(5, 0u64)
        let mutable carry = 0u64
        let mutable i = 0
        while i < 4 do
            let s = a.get(i).toUint128() + b.get(i).toUint128() + carry.toUint128()
            r.set(i, s.low)
            carry = s.high
            i = i + 1
        r.set(4, carry)
        r

    /// Reduce `t` (5 limbs, value < 2*m) modulo `m`, in place, to 4 limbs.
    private function condSub(t: Array<Uint64>, m: Array<Uint64>): Unit =
        let diff = Array<Uint64>.fill(4, 0u64)
        let mutable borrow = 0u64
        let mutable i = 0
        while i < 4 do
            let lhs = t.get(i).toUint128()
            let rhs = m.get(i).toUint128() + borrow.toUint128()
            let d = lhs - rhs
            diff.set(i, d.low)
            borrow = (d >> 64u128).low & 1u64
            i = i + 1
        // Use the subtracted value if there was a top carry (t[4]==1) or no borrow.
        let useSub = t.get(4) | (1u64 - borrow)
        let mask = 0u64 - useSub
        i = 0
        while i < 4 do
            t.set(i, (diff.get(i) & mask) | (t.get(i) & (~mask)))
            i = i + 1

    /// Montgomery multiply: a * b * R^{-1} mod m, with R = 2^256. `ni = n0inv(m)`.
    function montMul(a: Array<Uint64>, b: Array<Uint64>, m: Array<Uint64>, ni: Uint64): Array<Uint64> =
        let t = Array<Uint64>.fill(6, 0u64)
        let mutable i = 0
        while i < 4 do
            let mutable c = 0u64
            let mutable j = 0
            while j < 4 do
                let prod = Uint128.multiply(a.get(j), b.get(i)) + t.get(j).toUint128() + c.toUint128()
                t.set(j, prod.low)
                c = prod.high
                j = j + 1
            let s4 = t.get(4).toUint128() + c.toUint128()
            t.set(4, s4.low)
            t.set(5, s4.high)
            // Reduction.
            let mm = t.get(0) * ni
            let p0 = Uint128.multiply(mm, m.get(0)) + t.get(0).toUint128()
            let mutable c2 = p0.high
            let mutable jj = 1
            while jj < 4 do
                let pj = Uint128.multiply(mm, m.get(jj)) + t.get(jj).toUint128() + c2.toUint128()
                t.set(jj - 1, pj.low)
                c2 = pj.high
                jj = jj + 1
            let s = t.get(4).toUint128() + c2.toUint128()
            t.set(3, s.low)
            t.set(4, t.get(5) + s.high)
            i = i + 1
        condSub(t, m)
        [|t.get(0), t.get(1), t.get(2), t.get(3)|]

    /// R^2 mod m, computed as 2^512 mod m by 512 modular doublings.
    function rr(m: Array<Uint64>): Array<Uint64> =
        let mutable x = [|1u64, 0u64, 0u64, 0u64|]
        let mutable i = 0
        while i < 512 do
            let s = add5(x, x)
            condSub(s, m)
            x = [|s.get(0), s.get(1), s.get(2), s.get(3)|]
            i = i + 1
        x

    /// a + b mod m.
    function add(a: Array<Uint64>, b: Array<Uint64>, m: Array<Uint64>): Array<Uint64> =
        let s = add5(a, b)
        condSub(s, m)
        [|s.get(0), s.get(1), s.get(2), s.get(3)|]

    /// a - b mod m.
    function sub(a: Array<Uint64>, b: Array<Uint64>, m: Array<Uint64>): Array<Uint64> =
        // a - b = a + (m - b)
        let mb = Array<Uint64>.fill(4, 0u64)
        let mutable borrow = 0u64
        let mutable i = 0
        while i < 4 do
            let lhs = m.get(i).toUint128()
            let rhs = b.get(i).toUint128() + borrow.toUint128()
            let d = lhs - rhs
            mb.set(i, d.low)
            borrow = (d >> 64u128).low & 1u64
            i = i + 1
        add(a, mb, m)

    /// Convert to Montgomery form (a * R mod m).
    function toMont(a: Array<Uint64>, m: Array<Uint64>, ni: Uint64): Array<Uint64> =
        montMul(a, rr(m), m, ni)

    /// Convert out of Montgomery form (a * R^{-1} mod m).
    function fromMont(a: Array<Uint64>, m: Array<Uint64>, ni: Uint64): Array<Uint64> =
        montMul(a, [|1u64, 0u64, 0u64, 0u64|], m, ni)

    /// The Montgomery form of 1 (= R mod m).
    function montOne(m: Array<Uint64>, ni: Uint64): Array<Uint64> =
        toMont([|1u64, 0u64, 0u64, 0u64|], m, ni)

    /// Modular inverse a^{-1} mod m (Fermat: a^{m-2}), inputs/outputs in
    /// Montgomery form. `m` must be prime.
    function montInv(a: Array<Uint64>, m: Array<Uint64>, ni: Uint64): Array<Uint64> =
        // exponent e = m - 2
        let e = Array<Uint64>.fill(4, 0u64)
        let mutable borrow = 2u64
        let mutable k = 0
        while k < 4 do
            let lhs = m.get(k).toUint128()
            let d = lhs - borrow.toUint128()
            e.set(k, d.low)
            borrow = (d >> 64u128).low & 1u64
            k = k + 1
        // square-and-multiply, MSB first over 256 bits
        let mutable result = montOne(m, ni)
        let mutable i = 255
        while i >= 0 do
            result = montMul(result, result, m, ni)
            let bit = (e.get(i / 64) >> (i % 64).toUint64()) & 1u64
            if bit == 1u64 then
                result = montMul(result, a, m, ni)
            i = i - 1
        result

    /// Equality of two 4-limb values (constant-time).
    function equal(a: Array<Uint64>, b: Array<Uint64>): Bool =
        let mutable diff = 0u64
        let mutable i = 0
        while i < 4 do
            diff = diff | (a.get(i) ^ b.get(i))
            i = i + 1
        diff == 0u64

    /// True iff all four limbs are zero.
    function isZero(a: Array<Uint64>): Bool =
        equal(a, [|0u64, 0u64, 0u64, 0u64|])

    /// Reduce `x` (value < 2*m) modulo `m`: one conditional subtraction.
    function reduceOnce(x: Array<Uint64>, m: Array<Uint64>): Array<Uint64> =
        let t = [|x.get(0), x.get(1), x.get(2), x.get(3), 0u64|]
        condSub(t, m)
        [|t.get(0), t.get(1), t.get(2), t.get(3)|]

    /// a < b (constant-time).
    function lessThan(a: Array<Uint64>, b: Array<Uint64>): Bool =
        let mutable borrow = 0u64
        let mutable i = 0
        while i < 4 do
            let lhs = a.get(i).toUint128()
            let rhs = b.get(i).toUint128() + borrow.toUint128()
            let d = lhs - rhs
            borrow = (d >> 64u128).low & 1u64
            i = i + 1
        borrow == 1u64

test "P256Field Montgomery roundtrip and multiply" =
    let m = P256Field.p()
    let ni = P256Field.n0inv(m)
    // fromMont(toMont(x)) == x
    let x = [|0x1234567890abcdefu64, 0xfedcba0987654321u64, 0x0011223344556677u64, 0x8899aabbccddeeffu64|]
    let rt = P256Field.fromMont(P256Field.toMont(x, m, ni), m, ni)
    assert P256Field.equal(rt, x)
    // toMont(2)*toMont(3) -> fromMont == 6
    let two = P256Field.toMont([|2u64, 0u64, 0u64, 0u64|], m, ni)
    let three = P256Field.toMont([|3u64, 0u64, 0u64, 0u64|], m, ni)
    let six = P256Field.fromMont(P256Field.montMul(two, three, m, ni), m, ni)
    assert P256Field.equal(six, [|6u64, 0u64, 0u64, 0u64|])

test "P256Field inverse" =
    let m = P256Field.p()
    let ni = P256Field.n0inv(m)
    let a = P256Field.toMont([|0x123456789au64, 0xbeefu64, 0x42u64, 0x1u64|], m, ni)
    let inv = P256Field.montInv(a, m, ni)
    let prod = P256Field.montMul(a, inv, m, ni)
    assert P256Field.equal(prod, P256Field.montOne(m, ni))

test "P256Field add and sub" =
    let m = P256Field.p()
    // (p-1) + 1 == 0
    let pm1 = P256Field.sub([|0u64, 0u64, 0u64, 0u64|], [|1u64, 0u64, 0u64, 0u64|], m)
    let back = P256Field.add(pm1, [|1u64, 0u64, 0u64, 0u64|], m)
    assert P256Field.isZero(back)
