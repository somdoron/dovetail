package standard.crypto

import standard.prelude.Array
import standard.prelude.String

/// ChaCha20 stream cipher (RFC 8439). 32-bit ARX, little-endian I/O. Used only
/// as part of the ChaCha20-Poly1305 AEAD; not exposed as a standalone cipher
/// (an unauthenticated stream cipher is a footgun).
module ChaCha20 =
    /// Rotate a 32-bit word left by `n` bits (1 <= n <= 31).
    private function rotl(x: Uint32, n: Uint32): Uint32 =
        (x << n) | (x >> (32u32 - n))

    private function loadLE(b: Array<Uint8>, off: Int32): Uint32 =
        b.get(off).toUint32()
            | (b.get(off + 1).toUint32() << 8u32)
            | (b.get(off + 2).toUint32() << 16u32)
            | (b.get(off + 3).toUint32() << 24u32)

    private function storeLE(b: Array<Uint8>, off: Int32, word: Uint32): Unit =
        b.set(off, word.toUint8())
        b.set(off + 1, (word >> 8u32).toUint8())
        b.set(off + 2, (word >> 16u32).toUint8())
        b.set(off + 3, (word >> 24u32).toUint8())

    /// One ChaCha quarter-round on words (a,b,c,d) of state `s`.
    private function quarterRound(s: Array<Uint32>, a: Int32, b: Int32, c: Int32, d: Int32): Unit =
        s.set(a, s.get(a) + s.get(b))
        s.set(d, rotl(s.get(d) ^ s.get(a), 16u32))
        s.set(c, s.get(c) + s.get(d))
        s.set(b, rotl(s.get(b) ^ s.get(c), 12u32))
        s.set(a, s.get(a) + s.get(b))
        s.set(d, rotl(s.get(d) ^ s.get(a), 8u32))
        s.set(c, s.get(c) + s.get(d))
        s.set(b, rotl(s.get(b) ^ s.get(c), 7u32))

    /// Produce the 64-byte keystream block for `(key, counter, nonce)`.
    /// `key` is 32 bytes, `nonce` is 12 bytes.
    function block(key: Array<Uint8>, counter: Uint32, nonce: Array<Uint8>): Array<Uint8> =
        let s = Array<Uint32>.fill(16, 0u32)
        s.set(0, 0x61707865u32)
        s.set(1, 0x3320646eu32)
        s.set(2, 0x79622d32u32)
        s.set(3, 0x6b206574u32)
        let mutable i = 0
        while i < 8 do
            s.set(4 + i, loadLE(key, i * 4))
            i = i + 1
        s.set(12, counter)
        s.set(13, loadLE(nonce, 0))
        s.set(14, loadLE(nonce, 4))
        s.set(15, loadLE(nonce, 8))

        let w = Array<Uint32>.fill(16, 0u32)
        i = 0
        while i < 16 do
            w.set(i, s.get(i))
            i = i + 1

        let mutable r = 0
        while r < 10 do
            quarterRound(w, 0, 4, 8, 12)
            quarterRound(w, 1, 5, 9, 13)
            quarterRound(w, 2, 6, 10, 14)
            quarterRound(w, 3, 7, 11, 15)
            quarterRound(w, 0, 5, 10, 15)
            quarterRound(w, 1, 6, 11, 12)
            quarterRound(w, 2, 7, 8, 13)
            quarterRound(w, 3, 4, 9, 14)
            r = r + 1

        let ks = Array<Uint8>.fill(64, 0u8)
        i = 0
        while i < 16 do
            storeLE(ks, i * 4, w.get(i) + s.get(i))
            i = i + 1
        ks

    /// Encrypt (or decrypt — symmetric) `data` with ChaCha20, starting at block
    /// counter `initialCounter`.
    function encrypt(
        key: Array<Uint8>,
        initialCounter: Uint32,
        nonce: Array<Uint8>,
        data: Array<Uint8>
    ): Array<Uint8> =
        let res = Array<Uint8>.fill(data.length, 0u8)
        let mutable blockIndex = 0u32
        let mutable pos = 0
        while pos < data.length do
            let ks = block(key, initialCounter + blockIndex, nonce)
            let mutable j = 0
            while j < 64 && pos + j < data.length do
                res.set(pos + j, data.get(pos + j) ^ ks.get(j))
                j = j + 1
            blockIndex = blockIndex + 1u32
            pos = pos + 64
        res

test "ChaCha20 block function RFC 8439 section 2.3.2" =
    let key = Array<Uint8>.fill(32, 0u8)
    let mutable i = 0
    while i < 32 do
        key.set(i, i.toUint8())
        i = i + 1
    let nonce = [|
        0x00u8, 0x00u8, 0x00u8, 0x09u8, 0x00u8, 0x00u8, 0x00u8, 0x4au8,
        0x00u8, 0x00u8, 0x00u8, 0x00u8,
    |]
    let ks = ChaCha20.block(key, 1u32, nonce)
    let expected = [|
        0x10u8, 0xf1u8, 0xe7u8, 0xe4u8, 0xd1u8, 0x3bu8, 0x59u8, 0x15u8,
        0x50u8, 0x0fu8, 0xddu8, 0x1fu8, 0xa3u8, 0x20u8, 0x71u8, 0xc4u8,
        0xc7u8, 0xd1u8, 0xf4u8, 0xc7u8, 0x33u8, 0xc0u8, 0x68u8, 0x03u8,
        0x04u8, 0x22u8, 0xaau8, 0x9au8, 0xc3u8, 0xd4u8, 0x6cu8, 0x4eu8,
        0xd2u8, 0x82u8, 0x64u8, 0x46u8, 0x07u8, 0x9fu8, 0xaau8, 0x09u8,
        0x14u8, 0xc2u8, 0xd7u8, 0x05u8, 0xd9u8, 0x8bu8, 0x02u8, 0xa2u8,
        0xb5u8, 0x12u8, 0x9cu8, 0xd1u8, 0xdeu8, 0x16u8, 0x4eu8, 0xb9u8,
        0xcbu8, 0xd0u8, 0x83u8, 0xe8u8, 0xa2u8, 0x50u8, 0x3cu8, 0x4eu8,
    |]
    assert ks.length == 64
    let mutable n = 0
    let mutable ok = true
    while n < 64 do
        if ks.get(n) != expected.get(n) then ok = false
        n = n + 1
    assert ok

test "ChaCha20 encryption RFC 8439 section 2.4.2" =
    let key = Array<Uint8>.fill(32, 0u8)
    let mutable i = 0
    while i < 32 do
        key.set(i, i.toUint8())
        i = i + 1
    let nonce = [|
        0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x00u8, 0x4au8,
        0x00u8, 0x00u8, 0x00u8, 0x00u8,
    |]
    let plaintext = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.".bytes()
    let ciphertext = ChaCha20.encrypt(key, 1u32, nonce, plaintext)
    let expected = [|
        0x6eu8, 0x2eu8, 0x35u8, 0x9au8, 0x25u8, 0x68u8, 0xf9u8, 0x80u8,
        0x41u8, 0xbau8, 0x07u8, 0x28u8, 0xddu8, 0x0du8, 0x69u8, 0x81u8,
        0xe9u8, 0x7eu8, 0x7au8, 0xecu8, 0x1du8, 0x43u8, 0x60u8, 0xc2u8,
        0x0au8, 0x27u8, 0xafu8, 0xccu8, 0xfdu8, 0x9fu8, 0xaeu8, 0x0bu8,
        0xf9u8, 0x1bu8, 0x65u8, 0xc5u8, 0x52u8, 0x47u8, 0x33u8, 0xabu8,
        0x8fu8, 0x59u8, 0x3du8, 0xabu8, 0xcdu8, 0x62u8, 0xb3u8, 0x57u8,
        0x16u8, 0x39u8, 0xd6u8, 0x24u8, 0xe6u8, 0x51u8, 0x52u8, 0xabu8,
        0x8fu8, 0x53u8, 0x0cu8, 0x35u8, 0x9fu8, 0x08u8, 0x61u8, 0xd8u8,
        0x07u8, 0xcau8, 0x0du8, 0xbfu8, 0x50u8, 0x0du8, 0x6au8, 0x61u8,
        0x56u8, 0xa3u8, 0x8eu8, 0x08u8, 0x8au8, 0x22u8, 0xb6u8, 0x5eu8,
        0x52u8, 0xbcu8, 0x51u8, 0x4du8, 0x16u8, 0xccu8, 0xf8u8, 0x06u8,
        0x81u8, 0x8cu8, 0xe9u8, 0x1au8, 0xb7u8, 0x79u8, 0x37u8, 0x36u8,
        0x5au8, 0xf9u8, 0x0bu8, 0xbfu8, 0x74u8, 0xa3u8, 0x5bu8, 0xe6u8,
        0xb4u8, 0x0bu8, 0x8eu8, 0xedu8, 0xf2u8, 0x78u8, 0x5eu8, 0x42u8,
        0x87u8, 0x4du8,
    |]
    assert ciphertext.length == expected.length
    let mutable n = 0
    let mutable ok = true
    while n < expected.length do
        if ciphertext.get(n) != expected.get(n) then ok = false
        n = n + 1
    assert ok
