package standard.io.crypto

import standard.io.crypto.CryptoRandom
import standard.prelude.Array
import standard.prelude.Option
import standard.io.Random
import standard.io.Async
import standard.io.Resource
import standard.crypto.AeadAlgorithm
import standard.crypto.KeyExchange
import standard.crypto.SignatureAlgorithm
import standard.crypto.SymmetricKey
import standard.crypto.Nonce
import standard.crypto.SecretKey
import standard.crypto.KeyPair
import standard.crypto.HasSensitiveData
import standard.crypto.ConstantTime
import standard.crypto.Aes256Gcm
import standard.crypto.ChaCha20Poly1305
import standard.crypto.X25519
import standard.crypto.EcdhP256
import standard.crypto.Ed25519
import standard.crypto.EcdsaP256
import standard.crypto.EcdsaP384

/// `CryptoRandom` — the entropy-using half of the crypto API. The pure
/// `standard.crypto` package can verify and use keys but cannot *generate* them
/// (no entropy). These extensions add generation on top of the crypto traits,
/// drawing from `standard.io.Random` (which wraps the host RNG as an async
/// effect).
///
/// Every random secret is exposed as a `Resource`, never as a bare value:
///   * acquisition is asynchronous — randomness is an I/O effect;
///   * release zeroizes the key material, so a secret is wiped on every
///     scope-exit path (success, error, cancellation).
/// Consume them with `use` inside an async scope:
///
///     let key = use Aes256Gcm.generateKey()    // random AEAD key, wiped on exit
///     let kp  = use Ed25519.generateKeyPair()   // random key pair, secret wiped
extension CryptoRandom for AeadAlgorithm =
    /// A random symmetric key of this cipher's key size. Zeroized on release.
    public function generateKey(self): Resource<SymmetricKey, Never> =
        Resource
            .make(
            () => Random.bytes(self.keySize).map((b: Array<Uint8>) => SymmetricKey(b)),
            (k: SymmetricKey) => Async.thunk(() => k.clear())
        )

    /// A random nonce of this cipher's nonce size. A nonce is public (sent in
    /// the clear), so there is nothing to wipe — it is a resource only so that
    /// generation stays in the async/effect world. Release is a no-op.
    public function generateNonce(self): Resource<Nonce, Never> =
        Resource
            .make(
            () => Random.bytes(self.nonceSize).map((b: Array<Uint8>) => Nonce(b)),
            (_: Nonce) => Async.succeed(())
        )

extension CryptoRandom for KeyExchange =
    /// A random key pair. The secret is zeroized on release.
    public function generateKeyPair(self): Resource<KeyPair, Never> =
        Resource
            .make(
            () => randomKeyExchangeKeyPair(self),
            (kp: KeyPair) => Async.thunk(() => kp.secret.clear())
        )

extension CryptoRandom for SignatureAlgorithm =
    /// A random key pair. The secret is zeroized on release.
    public function generateKeyPair(self): Resource<KeyPair, Never> =
        Resource
            .make(
            () => randomSignatureKeyPair(self),
            (kp: KeyPair) => Async.thunk(() => kp.secret.clear())
        )

// Rejection sampling: draw `secretKeySize` random bytes and accept them as a
// secret iff the algorithm says they form a valid one (NIST curves reject an
// out-of-range scalar; Curve25519-family always accept). Rejection probability
// is ~2^-32 (P-256) or far smaller, so the loop effectively never iterates.
// Async because each draw is an async effect; two near-identical helpers
// because KeyExchange and SignatureAlgorithm are distinct traits with no shared
// supertype.
async function randomKeyExchangeKeyPair(algo: KeyExchange): Async<KeyPair, Never> =
    let mutable found: Option<KeyPair> = None
    let mutable done = false
    while done == false do
        let candidate = await Random.bytes(algo.secretKeySize)
        match algo.secretKeyFromBytes(candidate) with
            case Some(secret) =>
                found = Some(KeyPair { secret = secret; publicKey = algo.derivePublicKey(secret) })
                done = true
            case None => ()
    found.require

async function randomSignatureKeyPair(algo: SignatureAlgorithm): Async<KeyPair, Never> =
    let mutable found: Option<KeyPair> = None
    let mutable done = false
    while done == false do
        let candidate = await Random.bytes(algo.secretKeySize)
        match algo.secretKeyFromBytes(candidate) with
            case Some(secret) =>
                found = Some(KeyPair { secret = secret; publicKey = algo.derivePublicKey(secret) })
                done = true
            case None => ()
    found.require

test "generateKey/generateNonce resources have the right sizes and keys vary" =
    let mutable ok = false
    let program: Async<Unit, Never> =
        let k1 = use Aes256Gcm.generateKey()
        let k2 = use Aes256Gcm.generateKey()
        let n = use Aes256Gcm.generateNonce()
        let cn = use ChaCha20Poly1305.generateKey()
        // Two independent draws must differ (a 32-byte collision is impossible).
        Async
            .thunk(
            () =>
                ok =
                    (k1.value.length == 32)
                        && (n.value.length == 12)
                        && (cn.value.length == 32)
                        && (ConstantTime.equal(k1.value, k2.value) == false)
        )
    program.run()
    assert ok

test "X25519 generated key pairs agree (ECDH)" =
    let mutable ok = false
    let program: Async<Unit, Never> =
        let a = use X25519.generateKeyPair()
        let b = use X25519.generateKeyPair()
        let sa = X25519.computeSharedSecret(a.secret, b.publicKey)
        let sb = X25519.computeSharedSecret(b.secret, a.publicKey)
        Async.thunk(() => ok = sa.isOk && ConstantTime.equal(sa.require.value, sb.require.value))
    program.run()
    assert ok

test "EcdhP256 generated key pairs agree (ECDH)" =
    let mutable ok = false
    let program: Async<Unit, Never> =
        let a = use EcdhP256.generateKeyPair()
        let b = use EcdhP256.generateKeyPair()
        let sa = EcdhP256.computeSharedSecret(a.secret, b.publicKey)
        let sb = EcdhP256.computeSharedSecret(b.secret, a.publicKey)
        Async.thunk(() => ok = sa.isOk && ConstantTime.equal(sa.require.value, sb.require.value))
    program.run()
    assert ok

test "Ed25519 generated key pair signs and verifies" =
    let mutable ok = false
    let program: Async<Unit, Never> =
        let kp = use Ed25519.generateKeyPair()
        let msg = "hello signature".bytes()
        let sig = Ed25519.sign(kp.secret, msg)
        Async
            .thunk(
            () =>
                ok =
                    Ed25519
                        .verify(kp.publicKey, msg, sig)
                        && (Ed25519.verify(kp.publicKey, "tampered".bytes(), sig) == false)
        )
    program.run()
    assert ok

test "EcdsaP256 generated key pair signs and verifies" =
    let mutable ok = false
    let program: Async<Unit, Never> =
        let kp = use EcdsaP256.generateKeyPair()
        let msg = "hello signature".bytes()
        let sig = EcdsaP256.sign(kp.secret, msg)
        Async
            .thunk(
            () =>
                ok =
                    EcdsaP256
                        .verify(kp.publicKey, msg, sig)
                        && (EcdsaP256.verify(kp.publicKey, "tampered".bytes(), sig) == false)
        )
    program.run()
    assert ok

test "EcdsaP384 generated key pair signs and verifies" =
    let mutable ok = false
    let program: Async<Unit, Never> =
        let kp = use EcdsaP384.generateKeyPair()
        let msg = "hello signature".bytes()
        let sig = EcdsaP384.sign(kp.secret, msg)
        Async
            .thunk(
            () =>
                ok =
                    EcdsaP384
                        .verify(kp.publicKey, msg, sig)
                        && (EcdsaP384.verify(kp.publicKey, "tampered".bytes(), sig) == false)
        )
    program.run()
    assert ok

// End-to-end: acquire a managed key and nonce, encrypt with them inside the
// scope; both are released (key wiped) on exit. We can't observe the post-exit
// wipe (we don't hold the buffer); `clear()` itself is covered in
// standard-crypto/src/Sensitive.dove.
test "managed key + nonce encrypt within their scope" =
    let mutable ok = false
    let program: Async<Unit, Never> =
        let key = use Aes256Gcm.generateKey()
        let nonce = use Aes256Gcm.generateNonce()
        let ct = Aes256Gcm.encrypt(key, nonce, "secret message".bytes(), Array<Uint8>.empty())
        Async.thunk(() => ok = ct.length > 0)
    program.run()
    assert ok
