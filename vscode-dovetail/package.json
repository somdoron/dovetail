{
  "name": "dovetail-language",
  "displayName": "Dovetail Language",
  "description": "Language support for the Dovetail programming language",
  "version": "0.1.1",
  "publisher": "dovetail-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/somdoron/dovetail",
    "directory": "vscode-dovetail"
  },
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:dovetail",
    "workspaceContains:Dovetail.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dovetail",
        "aliases": [
          "Dovetail",
          "dovetail"
        ],
        "extensions": [
          ".dove"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dovetail",
        "scopeName": "source.dovetail",
        "path": "./syntaxes/dovetail.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "dovetail.runTest",
        "title": "Dovetail: Run Test"
      },
      {
        "command": "dovetail.runTestFile",
        "title": "Dovetail: Run All Tests in File"
      },
      {
        "command": "dovetail.runTestsInProject",
        "title": "Dovetail: Run All Tests in Project"
      },
      {
        "command": "dovetail.runTestsInWorkspace",
        "title": "Dovetail: Run All Tests in Workspace"
      }
    ],
    "problemMatchers": [
      {
        "name": "dovetail",
        "owner": "dovetail",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "dovetail-test",
        "owner": "dovetail",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\s+FAIL:\\s+(\\S+)\\s+-\\s+(.+)$",
          "code": 1,
          "message": 2
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Dovetail Language",
      "properties": {
        "dovetail.serverPath": {
          "type": "string",
          "default": "dovetail",
          "description": "Path to the Dovetail compiler binary"
        },
        "dovetail.serverConnection": {
          "type": "string",
          "enum": [
            "stdio",
            "tcp"
          ],
          "default": "stdio",
          "description": "How to connect to the LSP server"
        },
        "dovetail.serverPort": {
          "type": "number",
          "default": 9257,
          "description": "TCP port for the LSP server (when using TCP connection)"
        },
        "dovetail.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose logging and pass --verbose to the LSP server"
        },
        "dovetail.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the Dovetail language server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "install-ext": "vsce package && code --install-extension dovetail-language-0.1.1.vsix",
    "test:grammar": "vscode-tmgrammar-snap ./test/grammar/*.dove -s source.dovetail -g ./syntaxes/dovetail.tmLanguage.json",
    "test": "npm run test:grammar"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^3.0.0",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
