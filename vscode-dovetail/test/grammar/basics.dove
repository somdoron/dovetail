package a

// Functions
function add(x: Int32, y: Int32): Int32 = x + y

public function greet(name: String): String = "hello"

// Variables
function main(): Unit =
  let x = 42
  let mutable count = 0
  let name: String = "world"
  count = count + 1
  assert x == 42

