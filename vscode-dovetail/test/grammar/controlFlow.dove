package a

// If/then/else
function abs(x: Int32): Int32 =
  if x < 0 then -x else x

function classify(n: Int32): String =
  if n > 0 then
    "positive"
  else if n < 0 then
    "negative"
  else
    "zero"

// Match/case
enum Color =
    Red
    Green
    Blue

function colorName(c: Color): String =
  match c
    case Color.Red -> "red"
    case Color.Green -> "green"
    case Color.Blue -> "blue"

// While loop
function countTo(n: Int32): Int32 =
  let mutable i = 0
  while i < n
    i = i + 1
  i

// For loop
function sum(items: Array[Int32]): Int32 =
  let mutable total = 0
  for item in items
    total = total + item
  total
