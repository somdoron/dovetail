package test

import standard.io.fs.Path

test "Path.of parses absolute" =
    let p = Path.of("/etc/hosts")
    assert p.isAbsolute
    assert p.segments.length == 2
    assert p.segments.get(0) == "etc"
    assert p.segments.get(1) == "hosts"

test "Path.of parses relative" =
    let p = Path.of("logs/today")
    assert !p.isAbsolute
    assert p.segments.length == 2
    assert p.segments.get(0) == "logs"
    assert p.segments.get(1) == "today"

test "Path.of bare root" =
    let p = Path.of("/")
    assert p.isAbsolute
    assert p.segments.length == 0

test "Path.of empty string is relative empty" =
    let p = Path.of("")
    assert !p.isAbsolute
    assert p.segments.length == 0

test "Path.of skips empty segments" =
    let p = Path.of("/a//b///c")
    assert p.segments.length == 3
    assert p.segments.get(0) == "a"
    assert p.segments.get(2) == "c"

test "Path join with String" =
    let p = Path.of("/var").join("log")
    assert p.isAbsolute
    assert p.segments.length == 2
    assert p.segments.get(1) == "log"

test "Path / operator with String" =
    let p = Path.of("/var") / "log" / "app.txt"
    assert p.segments.length == 3
    assert p.segments.get(2) == "app.txt"

test "Path / operator with relative Path" =
    let p = Path.of("/var") / Path.of("log/app")
    assert p.segments.length == 3
    assert p.segments.get(2) == "app"

test "Path.name returns last segment" =
    let p = Path.of("/var/log/app.txt")
    match p.name with
        case Some(n) => assert n == "app.txt"
        case None => panic "expected name"

test "Path.name None on bare root" =
    let p = Path.of("/")
    match p.name with
        case Some(_) => panic "expected None"
        case None => assert true

test "Path.stem strips extension" =
    let p = Path.of("/var/log/app.txt")
    match p.stem with
        case Some(s) => assert s == "app"
        case None => panic "expected stem"

test "Path.ext returns after last dot" =
    let p = Path.of("/var/log/app.txt")
    match p.ext with
        case Some(e) => assert e == "txt"
        case None => panic "expected ext"

test "Path.ext None for dotfile" =
    let p = Path.of("/home/.bashrc")
    match p.ext with
        case Some(_) => panic "dotfile should have no ext"
        case None => assert true

test "Path.parent drops last segment" =
    let p = Path.of("/var/log/app.txt").parent
    match p with
        case Some(par) =>
            assert par.isAbsolute
            assert par.segments.length == 2
            match par.name with
                case Some(n) => assert n == "log"
                case None => panic "expected log"
        case None => panic "expected parent"

test "Path.parent None on bare root" =
    let p = Path.of("/").parent
    match p with
        case Some(_) => panic "bare root has no parent"
        case None => assert true

test "Path.withExtension replaces" =
    let p = Path.of("/var/log/app.txt").withExtension("log")
    match p.name with
        case Some(n) => assert n == "app.log"
        case None => panic "expected name"

test "Path.withExtension adds when none" =
    let p = Path.of("/var/log/app").withExtension("txt")
    match p.name with
        case Some(n) => assert n == "app.txt"
        case None => panic "expected name"

test "Path.normalize collapses dot" =
    let p = Path.of("/var/./log").normalize()
    assert p.segments.length == 2
    assert p.segments.get(0) == "var"
    assert p.segments.get(1) == "log"

test "Path.normalize collapses dotdot" =
    let p = Path.of("/var/log/../tmp").normalize()
    assert p.segments.length == 2
    assert p.segments.get(0) == "var"
    assert p.segments.get(1) == "tmp"

test "Path.normalize discards leading dotdot for absolute" =
    let p = Path.of("/../etc").normalize()
    assert p.segments.length == 1
    assert p.segments.get(0) == "etc"

test "Path.normalize preserves leading dotdot for relative" =
    let p = Path.of("../sibling").normalize()
    assert p.segments.length == 2
    assert p.segments.get(0) == ".."
    assert p.segments.get(1) == "sibling"
