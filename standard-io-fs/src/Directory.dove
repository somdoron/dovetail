package standard.io.fs

import standard.wasi.fs.FileDescriptor
import standard.wasi.CopyResult
import standard.prelude.List
import standard.io.Async
import standard.io.Resource

/// An opened directory descriptor. Always obtained via a `Resource`-returning
/// constructor (`Directory.root()`, `Directory.cwd()`, `Directory.preopens()`,
/// `Directory.open(path)`) — never constructed directly. The Resource handles
/// FD lifecycle: no-op release for preopens (runtime-owned), drop-on-release
/// for walked directories.
public newtype Directory = FileDescriptor

module Directory =

    // --- Preopens (Async, no FD lifecycle — runtime owns them) -------------

    /// All preopened (mount-path, Directory) pairs. Preopens are owned by the
    /// WASI runtime, so there's no FD lifecycle to manage; this is a plain
    /// async lookup, not a `Resource`.
    public async function preopens(): Async<List<(String, Directory)>, FileStreamError> =
        let raw = await Async.thunk(() => FileDescriptor.preopens())
        let mutable result: List<(String, Directory)> = List.empty
        // `raw` crosses the WASI boundary as an array; the list starts here.
        for entry in raw do
            result = result.prepend((entry._1, Directory(entry._0)))
        result.reverse()

    /// The preopen mounted at `/` (or the first absolute preopen).
    public async function root(): Async<Directory, FileStreamError> =
        let fd = await rootPreopen()
        Directory(fd)

    /// The preopen for the current working directory (mount path `.` or empty).
    public async function cwd(): Async<Directory, FileStreamError> =
        let fd = await cwdPreopen()
        Directory(fd)

    /// Open the directory at `path`. If the path resolves to a preopen (empty
    /// segments), release is a no-op; otherwise the walked FD is closed on
    /// release.
    public function open(path: Path): Resource<Directory, FileStreamError> =
        openDirFdResource(path).map<Directory>(fd => Directory(fd))

    // --- Static helpers (smart-routed, path-based) -------------------------

    /// Create an empty directory at `path`. Parent must exist; for recursive
    /// creation use `createAll`.
    public async function create(path: Path): Async<Unit, FileStreamError> =
        let pair = use parentResource(path)
        let result = await createDirectoryAtAsync(pair._0, pair._1)
        await Async.fromResult(result.mapError(mapWasiError))

    /// Remove an empty directory at `path`.
    public async function remove(path: Path): Async<Unit, FileStreamError> =
        let pair = use parentResource(path)
        let result = await removeDirectoryAtAsync(pair._0, pair._1)
        await Async.fromResult(result.mapError(mapWasiError))

    /// List entries one level under `path`. Order is host-defined; `.` and `..`
    /// are filtered out. Both the directory FD and the iteration stream are
    /// released LIFO when this function returns (success OR failure).
    public async function entries(path: Path): Async<List<DirEntry>, FileStreamError> =
        let dir = use dirEntryStreamResource(path)
        // Prepended, not appended: growing the result by one entry per step
        // copied every entry read so far on every step, which made listing a
        // directory quadratic in the number of files it holds. A list prepends
        // in constant time; the order is put back once, at the end.
        let mutable collected: List<DirEntry> = List.empty
        let mutable done = false
        // The listing's latch, and it has to be one: the host can report the last
        // entry and the reason the directory ended in the same copy, and there is
        // no wrapper here to hold the reason until the next call. Held to the end
        // of the loop rather than raised where it arrives, so the entry that came
        // with it is not thrown away first — and then raised, because a directory
        // that stopped because of an I/O error is not a shorter directory, and a
        // caller handed a list has no way to tell the two apart.
        let mutable failure: Option<FileStreamError> = None
        while !done do
            let next = await readNextDirEntry(dir)
            match next._2 with
                case Some(reason) => failure = Some(reason)
                case None => ()
            match next._1 with
                case None =>
                    // An empty answer ends the listing too. The ending check
                    // below is the ordinary way out; this covers the answer it
                    // cannot classify — a zero-count read reported as
                    // `Completed`, which is also what `CopyResult.ofCode` hands
                    // back for any code it does not recognise. Re-posting on
                    // that loops forever, and a host that produced one would at
                    // worst have its listing end an entry early.
                    done = true
                case Some(de) =>
                    if de.name == "." || de.name == ".." then
                        ()
                    else
                        collected = collected.prepend(DirEntry { name = de.name; entryType = descriptorTypeToEntryType(de.entryType) })
            // The ending is a separate question from the entry, and asked after
            // it: a copy that reports the listing over can still be carrying its
            // last entry. Stopping on the ending rather than on an absent entry
            // is what keeps the next iteration from posting a copy on a stream
            // that has already ended.
            if next._0 != CopyResult.Completed then
                done = true
        match failure with
            case Some(reason) => await Async<List<DirEntry>, FileStreamError>.fail(reason)
            case None => collected.reverse()

    /// True iff a directory (not a file) exists at `path`.
    public async function exists(path: Path): Async<Bool, FileStreamError> =
        let pair = use parentResource(path)
        let statResult = await statAtAsync(pair._0, defaultPathFlagsFollow(), pair._1)
        match statResult with
            case Ok(s) =>
                match descriptorTypeToEntryType(s.descriptorType) with
                    case EntryType.Directory => true
                    case _ => false
            case Error(_) => false

    /// Metadata for the entry at `path`, or None if it doesn't exist.
    public async function metadata(path: Path): Async<Option<Metadata>, FileStreamError> =
        let pair = use parentResource(path)
        let statResult = await statAtAsync(pair._0, defaultPathFlagsFollow(), pair._1)
        match statResult with
            case Ok(s) => Some(fileStatToMetadata(s))
            case Error(_) => None
