package standard.io.net

// Sibling file holding all wasi address/error imports. Public-facing
// addresses are strings, so this file's job is:
//   1. Parse string addresses into wasi `SocketAddress` values.
//   2. Format wasi `SocketAddress` / `IpAddress` values back to strings.
//   3. Map `NetworkError` → `NetError`.
// Everything wasi-typed stays inside this file. The rest of the library
// touches addresses only as strings.

import standard.io.Async
import standard.wasi.net.IpAddress
import standard.wasi.net.Ipv4Address
import standard.wasi.net.SocketAddress
import standard.wasi.net.Ipv4SocketAddress
import standard.wasi.net.Ipv6SocketAddress
import standard.wasi.net.NetworkError
import standard.wasi.net.DnsError
import standard.wasi.net.IpAddressFamily

// --- Error mapping ---------------------------------------------------------

/// `wasi:sockets/ip-name-lookup` has its own error-code variant list, so name
/// resolution maps separately from the socket errors below.
function mapWasiDnsError(error: DnsError): NetError =
    match error with
        case DnsError.AccessDenied => NetError.AccessDenied
        case DnsError.InvalidArgument => NetError.InvalidArgument
        case DnsError.NameUnresolvable => NetError.HostnameNotResolvable
        case DnsError.TemporaryResolverFailure => NetError.HostnameNotResolvable
        case DnsError.PermanentResolverFailure => NetError.HostnameNotResolvable
        case DnsError.Other(detail) => NetError.Other(detail)

function mapWasiNetError(error: NetworkError): NetError =
    match error with
        case NetworkError.AccessDenied => NetError.AccessDenied
        case NetworkError.NotSupported => NetError.Unsupported
        case NetworkError.InvalidArgument => NetError.InvalidArgument
        case NetworkError.OutOfMemory => NetError.OutOfMemory
        case NetworkError.Timeout => NetError.Timeout
        case NetworkError.InvalidState => NetError.InvalidState
        case NetworkError.AddressNotBindable => NetError.AddressNotBindable
        case NetworkError.AddressInUse => NetError.AddressInUse
        case NetworkError.RemoteUnreachable => NetError.RemoteUnreachable
        case NetworkError.ConnectionRefused => NetError.ConnectionRefused
        case NetworkError.ConnectionBroken => NetError.ConnectionReset
        case NetworkError.ConnectionReset => NetError.ConnectionReset
        case NetworkError.ConnectionAborted => NetError.ConnectionAborted
        case NetworkError.DatagramTooLarge => NetError.DatagramTooLarge
        case NetworkError.Canceled => NetError.Canceled
        case NetworkError.Other(detail) => NetError.Other(detail)

/// Public `From` impl so downstream packages that pull bytes off a
/// `TcpStream` (whose `input`/`output` still surface the raw wasi
/// `NetworkError`) can lift those errors into the cleaned-up `NetError`
/// without re-implementing the variant-by-variant mapping. Without this,
/// every direct consumer of `AsyncInputStream<NetworkError>.read` would
/// either be stuck holding wasi types or duplicate `mapWasiNetError`.
implement From<NetworkError> for NetError =
    public function from(value: NetworkError): NetError = mapWasiNetError(value)

// --- Address formatting (wasi → String) ------------------------------------

/// Format a wasi `IpAddress` as canonical text. v1 emits IPv6 without `::`
/// zero-compression; tighten later if needed.
function formatWasiIp(ip: IpAddress): String =
    match ip with
        case IpAddress.V4(v4) =>
            v4.a.format() ++ "." ++ v4.b.format() ++ "." ++ v4.c.format() ++ "." ++ v4.d.format()
        case IpAddress.V6(v6) =>
            let high = formatHex16(v6.a) ++ ":" ++ formatHex16(v6.b) ++ ":" ++ formatHex16(v6.c) ++ ":" ++ formatHex16(v6.d)
            let low = formatHex16(v6.e) ++ ":" ++ formatHex16(v6.f) ++ ":" ++ formatHex16(v6.g) ++ ":" ++ formatHex16(v6.h)
            high ++ ":" ++ low
        case _ => ""

/// Format a wasi `SocketAddress` as canonical "host:port" / "[host]:port".
function formatWasiSocketAddress(socket: SocketAddress): String =
    match socket with
        case SocketAddress.V4(v4) =>
            formatWasiIp(IpAddress.V4(v4.address)) ++ ":" ++ v4.port.format()
        case SocketAddress.V6(v6) =>
            "[" ++ formatWasiIp(IpAddress.V6(v6.address)) ++ "]:" ++ v6.port.format()
        case _ => ""

// --- Address parsing (String → wasi) ---------------------------------------

/// Parse a host literal as an IPv4 address. Returns `None` if not a valid
/// IPv4 form. IPv6 host parsing is a follow-up; users wanting IPv6 should
/// not rely on this for v1.
function parseIpv4String(text: String): Option<IpAddress> =
    match text.split(".") with
        case [aText, bText, cText, dText] =>
            match (
                parseUint8Decimal(aText),
                parseUint8Decimal(bText),
                parseUint8Decimal(cText),
                parseUint8Decimal(dText)
            ) with
                case (Some(a), Some(b), Some(c), Some(d)) =>
                    Some(IpAddress.V4(Ipv4Address { a = a; b = b; c = c; d = d }))
                case _ => None
        case _ => None

/// Parse a "host:port" string into a wasi SocketAddress. v1: IPv4 only.
function parseSocketAddressString(text: String): Option<SocketAddress> =
    match text.split(":") with
        case [hostText, portText] =>
            match (parseIpv4String(hostText), parsePortDecimal(portText)) with
                case (Some(IpAddress.V4(v4Addr)), Some(port)) =>
                    Some(SocketAddress.V4(Ipv4SocketAddress { port = port; address = v4Addr }))
                case _ => None
        case _ => None

/// Family detection for socket-address strings (best-effort, IPv4-only for v1).
function familyOfAddressString(text: String): IpAddressFamily =
    if text.contains("[") then
        IpAddressFamily.Ipv6
    else
        IpAddressFamily.Ipv4

// --- Build wasi SocketAddress from IpAddress + port -----------------------

function buildSocketAddressFromIp(ip: IpAddress, port: Uint16): SocketAddress =
    match ip with
        case IpAddress.V4(v4) =>
            SocketAddress.V4(Ipv4SocketAddress { port = port; address = v4 })
        case IpAddress.V6(v6) =>
            SocketAddress.V6(Ipv6SocketAddress {
                port = port; flowInfo = 0u32; address = v6; scopeId = 0u32
            })
        case _ =>
            SocketAddress.V4(Ipv4SocketAddress { port = port; address = Ipv4Address { a = 0u8; b = 0u8; c = 0u8; d = 0u8 } })

// --- Decimal helpers (file-local) ------------------------------------------

function parseUint8Decimal(text: String): Option<Uint8> =
    match parseDecimal(text) with
        case Some(value) =>
            if value >= 0i32 && value <= 255i32 then
                Some(value.toUint8())
            else
                None
        case None => None

function parsePortDecimal(text: String): Option<Uint16> =
    match parseDecimal(text) with
        case Some(value) =>
            if value >= 0i32 && value <= 65535i32 then
                Some(value.toUint16())
            else
                None
        case None => None

function parseDecimal(text: String): Option<Int32> =
    if text.length == 0 then
        None
    else
        let bytes = text.bytes()
        let mutable index = 0i32
        let mutable accumulator = 0i32
        let mutable failed = false
        while index < bytes.length && !failed do
            let byte = bytes.get(index)
            if byte < 48u8 || byte > 57u8 then
                failed = true
            else
                let digit = (byte - 48u8).toInt32()
                if accumulator > 214748364i32 then
                    failed = true
                else
                    accumulator = accumulator * 10i32 + digit
            index = index + 1
        if failed then
            None
        else
            Some(accumulator)

function formatHex16(value: Uint16): String =
    let n = value.toInt32()
    if n == 0i32 then
        "0"
    else
        let mutable digits = Array<Uint8>.empty()
        let mutable remaining = n
        while remaining > 0i32 do
            let nibble = remaining % 16i32
            let byte = if nibble < 10i32 then
                (nibble + 48i32).toUint8()
            else
                (nibble - 10i32 + 97i32).toUint8()
            digits = Array<Uint8>.fill(1, byte).concat(digits)
            remaining = remaining / 16i32
        String.fromBytes(digits, 0, digits.length)

/// Lift a synchronous `wasi:sockets` call into this package's async surface:
/// run it in a thunk and map its `NetworkError` to a `NetError`.
///
/// Every socket option, every address getter, and the backlog setter is this
/// same two-line shape, and there are two dozen of them across `Tcp` and `Udp`.
/// The generic parameter is the option's own value type, so nothing is erased —
/// each instantiation is the call it wraps.
function netCall<T>(call: () => Result<T, NetworkError>): Async<T, NetError> =
    Async<T, NetError>.fromResult<T>(call().mapError(mapWasiNetError))
