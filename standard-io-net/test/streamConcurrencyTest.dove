package test

import standard.io.Async
import standard.io.Fiber
import standard.io.Promise
import standard.io.Queue
import standard.io.Cause
import standard.time.Duration
import standard.io.AsyncInputStream
import standard.io.AsyncOutputStream
import standard.io.net.Tcp
import standard.io.net.TcpListener
import standard.io.net.TcpStream
import standard.io.net.NetError
import standard.wasi.net.NetworkError

// Regression tests for the p3 stream invariants that only show up when more
// than one fiber touches a single stream end, or when a stream ends underneath
// a fiber that is still using it. All of them trap or hang without the fixes,
// so the `@timeout` is part of the assertion.
function toNetError(e: NetworkError): NetError = NetError.from(e)

function streamPort(address: String): Uint16 =
    let text =
        match address.split(":").last with
            case Some(portText) => portText
            case None => panic "expected a host:port local address"
    let mutable acc = 0i32
    let mutable i = 0i32
    while i < text.byteLength do
        acc = acc * 10 + (text.bytes().get(i).toInt32() - 48)
        i = i + 1
    acc.toUint16()

// --- A2: two fibers writing one stream ---------------------------------------
// p3 permits ONE outstanding write per stream end and the host op is posted
// before the fiber parks, so without a lock spanning start→finish the second
// fiber's `writeStart` lands on a busy stream and wasmtime traps. Both writes
// must land whole (interleaving halves of them would also be wrong).
@timeout(10000)
 test "Streams: two fibers writing one output stream serialize instead of trapping" =
    let mutable received = 0i32
    concurrentWriteProgram((n: Int32) => received = n).run()
    // 2 x 32 KiB — big enough that each write blocks partway and the two fibers
    // genuinely overlap rather than each completing inline.
    assert received == 65536i32

async function drainAll(stream: TcpStream, wanted: Int32): Async<Int32, NetError> =
    let mutable total = 0i32
    let mutable done = false
    while !done do
        let chunk = await stream.input.read(65536i64).mapError(toNetError)
        if chunk.length == 0 then
            done = true
        else
            total = total + chunk.length
            if total >= wanted then done = true
    total

async function acceptAndCount(listener: TcpListener, wanted: Int32, report: Promise<Int32, Never>):
    Async<Unit, NetError> =
    let stream: TcpStream = use listener.accept()
    let total = await drainAll(stream, wanted)
    await report.complete(total)
    ()

async function writeChunk(output: AsyncOutputStream<NetworkError>, fill: Uint8):
    Async<Unit, NetError> =
    await output.write(Array<Uint8>.fill(32768, fill).readonly).mapError(toNetError)

async function concurrentWriteProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let counted: Promise<Int32, Never> = await Async<Int32, Never>.makePromise()
    let _server: Fiber<Unit, NetError> =
        await acceptAndCount(listener, 65536i32, counted).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let a: Fiber<Unit, NetError> = await writeChunk(client.output, 65u8).fork()
    let b: Fiber<Unit, NetError> = await writeChunk(client.output, 66u8).fork()
    await a.join()
    await b.join()
    let total = await counted.awaitPromise()
    setter(total)

// --- A2: two fibers reading one stream ---------------------------------------
@timeout(10000)
 test "Streams: two fibers reading one input stream serialize instead of trapping" =
    let mutable total = 0i32
    concurrentReadProgram((n: Int32) => total = n).run()
    // Both reads completed and between them saw all 16 bytes the server sent.
    assert total == 16i32

async function readOnce(input: AsyncInputStream<NetworkError>, report: Promise<Int32, Never>):
    Async<Unit, NetError> =
    let chunk = await input.read(8i64).mapError(toNetError)
    await report.complete(chunk.length)
    ()

async function acceptAndSendTwice(listener: TcpListener): Async<Unit, NetError> =
    let stream: TcpStream = use listener.accept()
    await stream.output.write(Array<Uint8>.fill(8, 67u8).readonly).mapError(toNetError)
    await stream.output.write(Array<Uint8>.fill(8, 68u8).readonly).mapError(toNetError)
    // Hold the connection open until the client has read both halves.
    let _tail = await stream.input.read(1i64).mapError(toNetError)
    ()

async function concurrentReadProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let _server: Fiber<Unit, NetError> = await acceptAndSendTwice(listener).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let firstOut: Promise<Int32, Never> = await Async<Int32, Never>.makePromise()
    let secondOut: Promise<Int32, Never> = await Async<Int32, Never>.makePromise()
    let a: Fiber<Unit, NetError> = await readOnce(client.input, firstOut).fork()
    let b: Fiber<Unit, NetError> = await readOnce(client.input, secondOut).fork()
    await a.join()
    await b.join()
    let first = await firstOut.awaitPromise()
    let second = await secondOut.awaitPromise()
    setter(first + second)

// --- A3: closing a stream under a parked reader -------------------------------
// Ending the scope that owns a connection while a fiber in it is parked mid-read
// used to cancel the host op and then abandon the fiber, leaving it Suspended
// forever. It must be resumed — at EOF, for a reader — and only then interrupted.
@timeout(10000)
 test "Streams: releasing a connection under a parked read unwinds the reader, not abandons it" =
    let mutable resumedWith = -1i32
    closeUnderReaderProgram((n: Int32) => resumedWith = n).run()
    // RE-POINTED, and it was vacuous before: the marker started at 0 INSIDE the
    // program and the assertion was `== 0`, so a reader that never ran a step of
    // its continuation passed exactly like one that ran it. It also depended on
    // `parked.complete(())` firing from the forked fiber, which it did not:
    // completing a promise took effect where the `Async` was CONSTRUCTED, so the
    // scope closed before the reader had taken a single step. Both are fixed —
    // the second one in `Promise` itself — and the sentinel is now a value no arm
    // produces.
    //
    // And the property is not what the old name claimed. A scope releasing the
    // connection INTERRUPTS the reader, and an interrupt is not an end of
    // stream: -3 is the failure arm, which means the fiber was resumed and
    // unwound through its own handler. -1 is the abandonment this exists to
    // catch — a fiber left Suspended forever — and 0 would be the false EOF that
    // would report a truncated body as a complete one.
    assert resumedWith == -3i32

async function acceptAndHold(listener: TcpListener, release: Promise<Unit, Never>):
    Async<Unit, NetError> =
    let stream: TcpStream = use listener.accept()
    // Never writes: the client's read has nothing to complete it.
    await release.awaitPromise()
    ()

async function parkedReader(
    input: AsyncInputStream<NetworkError>,
    parked: Promise<Unit, Never>,
    mark: (Int32) => Unit
): Async<Unit, Never> =
    await parked.complete(())
    // Parks here; the only thing that can move it again is the scope's interrupt
    // when the connection below is released. That interrupt cancels the posted
    // read — which transferred nothing, so there is nothing to hand back — and
    // the fiber unwinds through the handler below. `foldCause` and not `fold`
    // because an interruption is not a typed failure, and a plain `thunk` rather
    // than a promise because a fiber unwinding under an interrupt is not owed
    // another async step.
    let read: Async<Int32, NetworkError> =
        input.read(64i64).map((chunk: Array<Uint8>) => chunk.length)
    await read
        .foldCause<Unit, Never>(
        (_: Cause<NetworkError>) => Async.thunk(() => mark(-3i32)),
        (n: Int32) => Async.thunk(() => mark(n))
    )

/// Open a connection in an inner scope, park a reader on it, then let the scope
/// end — releasing the `TcpStream` resource from under the parked fiber. The
/// scope owns the reader, so it interrupts it and waits for it to unwind before
/// the release: a read parked on a host op has to be resumable, or the fiber is
/// abandoned Suspended and the scope never finishes.
async function connectThenRelease(
    port: Uint16,
    parked: Promise<Unit, Never>,
    mark: (Int32) => Unit
): Async<Unit, NetError> =
    let client: TcpStream = use Tcp.connect("127.0.0.1", port)
    // The promise fires from the READER's first step, which is what makes the
    // wait below mean anything. It used to fire from HERE, when the body was
    // constructed, and the wait returned before the reader existed — a defect in
    // `Promise.complete`, fixed there rather than worked around with a thunk.
    let _reader: Fiber<Unit, Never> =
        await parkedReader(client.input, parked, mark).forkBackground()
    // The reader completes `parked` and runs straight on into `read`, so by the
    // time this resumes it is genuinely suspended on the host op.
    await parked.awaitPromise()
    ()

async function closeUnderReaderProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let release: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let _server: Fiber<Unit, NetError> = await acceptAndHold(listener, release).forkBackground()
    // -1, which no arm of the reader can produce: this used to be 0, which is
    // exactly what the assertion expected, so the test passed on a reader that
    // never ran.
    let mutable resumed = -1i32
    let parked: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    // The scope inside `connectThenRelease` waits for the reader to unwind, so
    // by the time it returns `resumed` has been written.
    await connectThenRelease(streamPort(address), parked, (n: Int32) => resumed = n)
    await release.complete(())
    setter(resumed)

// --- A1: end-of-stream latch --------------------------------------------------
// The stream's result future is one-shot. Reading past EOF used to re-post on
// the finished host stream and re-read the spent future; both trap.
@timeout(10000)
 test "Streams: reading past EOF keeps returning empty instead of trapping" =
    let mutable extraReads = -1i32
    readPastEofProgram((n: Int32) => extraReads = n).run()
    // Three further reads after EOF, all empty, no trap.
    assert extraReads == 3i32

async function acceptAndClose(listener: TcpListener): Async<Unit, NetError> =
    let stream: TcpStream = use listener.accept()
    // The scope closes the connection on the way out, which is what gives the
    // client its EOF.
    await stream.output.write("bye".bytes().readonly).mapError(toNetError)

async function readPastEofProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let _server: Fiber<Unit, NetError> = await acceptAndClose(listener).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    // `readAll` consumes the stream through EOF, which latches the result future.
    let all = await client.input.readAll().mapError(toNetError)
    assert all.length == 3i32
    let mutable empties = 0i32
    let mutable i = 0i32
    while i < 3i32 do
        let extra = await client.input.read(64i64).mapError(toNetError)
        if extra.length == 0 then empties = empties + 1
        i = i + 1
    setter(empties)

// --- B6: a failed write stays failed ------------------------------------------
// The write side's result future is one-shot too. After the peer resets the
// connection the first write latches the failure; later writes must re-report it
// from the latch rather than re-reading the spent future.
@timeout(10000)
 test "Streams: writes after a dropped peer keep failing from the latch" =
    let mutable failures = 0i32
    writeAfterFailureProgram((n: Int32) => failures = n).run()
    // The write that discovers the drop, plus three more, all failing.
    assert failures == 4i32

async function acceptAndDrop(listener: TcpListener): Async<Unit, NetError> =
    let _stream: TcpStream = use listener.accept()
    ()

async function writeUntilFailure(output: AsyncOutputStream<NetworkError>): Async<Int32, NetError> =
    let big = Array<Uint8>.fill(65536, 65u8)
    let mutable attempts = 0i32
    let mutable failed = false
    while attempts < 1000i32 && !failed do
        let didFail =
            await output
                .write(big.readonly)
                .fold<Bool, NetError>(
                (_: NetworkError) => Async.succeed(true),
                (_: Unit) => Async.succeed(false)
            )
        failed = didFail
        attempts = attempts + 1
    if failed then 1i32 else 0i32

async function writeAfterFailureProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let _server: Fiber<Unit, NetError> = await acceptAndDrop(listener).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let first = await writeUntilFailure(client.output)
    let mutable failures = first
    let mutable i = 0i32
    while i < 3i32 do
        let again =
            await client
                .output
                .write("x".bytes().readonly)
                .fold<Int32, NetError>(
                (_: NetworkError) => Async.succeed(1i32),
                (_: Unit) => Async.succeed(0i32)
            )
        failures = failures + again
        i = i + 1
    setter(failures)

// --- closing a stream whose reader went away ----------------------------------
//
// `close` is the only operation that can see a late write failure: a `write`
// resolves when the host ACCEPTS the bytes, and the verdict lands on the
// stream's one-shot result future, which only resolves once the write end is
// gone. So a `close` that reports success is a caller being told its bytes
// arrived — and it reported success on a stream whose reader had vanished,
// because the path that noticed the vanished reader recorded the ENDING without
// recording the REASON, and the report answers from the reason.
@timeout(10000)
 test "Streams: closing a stream whose reader vanished reports the failure, not success" =
    let mutable outcome = 0i32
    closeAfterDropProgram((n: Int32) => outcome = n).run()
    // 1 = the writes failed, AND the close that followed refused to call it
    // delivered.
    assert outcome == 1i32

async function closeAfterDropProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let _server: Fiber<Unit, NetError> = await acceptAndDrop(listener).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let wrote = await writeUntilFailure(client.output)
    let closeFailed =
        await client
            .output
            .close()
            .fold<Bool, NetError>(
            (_: NetworkError) => Async.succeed(true),
            (_: Unit) => Async.succeed(false)
        )
    setter(if wrote == 1i32 && closeFailed then 1i32 else 2i32)

// --- C1: offset-based partial writes ------------------------------------------
// `writeStart` now copies from an offset instead of the caller re-slicing per
// retry. A large payload is guaranteed to complete partially, so an off-by-one
// in the offset arithmetic shows up as corrupted or short data — not just as a
// performance difference.
@timeout(15000)
 test "Streams: a large partial-write round-trip preserves every byte" =
    let mutable verified = false
    largeWriteProgram((b: Bool) => verified = b).run()
    assert verified

async function acceptAndEchoAll(
    listener: TcpListener,
    wanted: Int32,
    report: Promise<Array<Uint8>, Never>
): Async<Unit, NetError> =
    let stream: TcpStream = use listener.accept()
    let mutable buffer = Array<Uint8>.empty()
    let mutable done = false
    while !done do
        let chunk = await stream.input.read(65536i64).mapError(toNetError)
        if chunk.length == 0 then
            done = true
        else
            buffer = buffer.concat(chunk)
            if buffer.length >= wanted then done = true
    await report.complete(buffer)
    ()

async function largeWriteProgram(setter: (Bool) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let received: Promise<Array<Uint8>, Never> = await Async<Array<Uint8>, Never>.makePromise()
    // 300 KiB — far past any socket buffer, so the write completes in several
    // chunks and every retry goes through the offset path.
    let size = 307200i32
    let payload = Array<Uint8>.fill(size, 0u8)
    let mutable i = 0i32
    while i < size do
        payload.set(i, (i % 251i32).toUint8())
        i = i + 1
    let _server: Fiber<Unit, NetError> =
        await acceptAndEchoAll(listener, size, received).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    // No end-of-stream signal needed: `acceptAndEchoAll` stops at `wanted`.
    await client.output.write(payload.readonly).mapError(toNetError)
    let echoed = await received.awaitPromise()
    let mutable ok = echoed.length == size
    let mutable j = 0i32
    while j < size do
        if echoed.get(j) != payload.get(j) then ok = false
        j = j + 1
    setter(ok)

// --- flush must not claim success over a broken stream ------------------------
// `flush` used to return `Ok` unconditionally, which made "write it all, then
// flush, then trust the result" a lie: a stream the host had already dropped
// reported clean. It now answers from the same latch a further write would.
@timeout(10000)
 test "Streams: flush reports the failure a dropped peer already latched" =
    let mutable flushFailed = false
    flushAfterDropProgram((b: Bool) => flushFailed = b).run()
    assert flushFailed

async function flushAfterDropProgram(setter: (Bool) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let _server: Fiber<Unit, NetError> = await acceptAndDrop(listener).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    // Writes until the host reports the peer's drop, which latches the error.
    await writeUntilFailure(client.output)
    let failed =
        await client
            .output
            .flush()
            .fold<Bool, NetError>(
            (_: NetworkError) => Async.succeed(true),
            (_: Unit) => Async.succeed(false)
        )
    setter(failed)

// --- the window between posting a stream op and parking on it -----------------
// A host op is posted before the fiber parks. If the 1024-step budget expires in
// between, the fiber goes back on the run queue still Running, and an interrupt
// delivered there overwrites its continuation — unwinding through the stream
// lock without cancelling the op. The next fiber to take that lock then posts a
// second op on the same stream end, which p3 forbids, and the component traps.
//
// This sweeps the position of the budget boundary: the reader burns `burn` steps
// before its read, so the boundary walks across the post/park pair. The main
// fiber burns its own steps so that it is scheduled right after the reader's
// budget expires, which is the only moment an interrupt can land on a Running
// fiber. After each attempt a plain read must still work — pre-fix, the attempt
// that lands in the window leaves an op posted and that read traps.
async function burnSteps(count: Int32): Async<Unit, Never> =
    let mutable i = 0i32
    while i < count do
        await Async.succeed(())
        i = i + 1

async function burnThenRead(input: AsyncInputStream<NetworkError>, burn: Int32):
    Async<Unit, Never> =
    await burnSteps(burn)
    await input
        .read(16i64)
        .fold<Unit, Never>(
        (_: NetworkError) => Async.succeed(()),
        (_: Array<Uint8>) => Async.succeed(())
    )

async function acceptAndDripOnCue(listener: TcpListener, cue: Queue<Bool>, rounds: Int32):
    Async<Unit, NetError> =
    let stream: TcpStream = use listener.accept()
    let mutable i = 0i32
    while i < rounds do
        await cue.take()
        await stream.output.write(Array<Uint8>.fill(1, 88u8).readonly).mapError(toNetError)
        i = i + 1
    ()

async function postParkWindowProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let rounds = 64i32
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let cue: Queue<Bool> = await Queue<Bool>.makeUnbounded()
    let _server: Fiber<Unit, NetError> =
        await acceptAndDripOnCue(listener, cue, rounds).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let mutable delivered = 0i32
    let mutable burn = 1000i32
    let mutable round = 0i32
    while round < rounds do
        let reader: Fiber<Unit, Never> = await burnThenRead(client.input, burn).forkBackground()
        // Outlast the reader's budget so this fiber is next in the queue when
        // the reader's expires, and interrupt it there.
        await burnSteps(1100i32)
        await reader.interrupt()
        // `join` re-raises the fiber's cause, and this one was interrupted on
        // purpose — swallow it and keep the sweep going.
        await reader
            .join()
            .foldCause<Unit, NetError>(
            (_: Cause<Never>) => Async.succeed(()),
            (_: Unit) => Async.succeed(())
        )
        // The stream must still be usable: a leftover posted op traps here.
        await cue.offer(true)
        let chunk = await client.input.read(16i64).mapError(toNetError)
        delivered = delivered + chunk.length
        burn = burn + 1i32
        round = round + 1
    setter(delivered)

// A generous budget: the sweep is ~64 fork/interrupt/join rounds each burning
// two step budgets, which runs in seconds on an idle machine but is the first
// thing to blow a tight timeout when the suite shares the CPU.
@timeout(180000)
 test "Streams: an interrupt between posting a read and parking on it leaves no op behind" =
    let mutable delivered = -1i32
    postParkWindowProgram((n: Int32) => delivered = n).run()
    // One byte per round, every round.
    assert delivered == 64i32

// --- an explicit close detaches every fiber from the handle -------------------
// `close` is the one place a stream is torn down while other fibers are still
// live on it — a Resource finalizer runs only after its scope has unwound them.
// So it has to do by hand what an interrupt does per fiber: stop the copy in
// flight, AND clear the queue of fibers waiting their turn on the same end.
//
// Both halves trap without the fix, in different ways. Leave the in-flight copy
// and the drop hits a busy stream. Leave the queue and the drop hands the lock
// to the next fiber, which posts on a handle the host has already reclaimed and
// reassigned — the failure then lands on whatever stream got that index next.
//
// WHERE THE SECOND READER NOW WAITS has moved, and this test is worth reading
// with that in mind: `WasiInputStream` takes its own read lock around the state
// check and the copy, so B queues there rather than in the runtime — and is
// answered from the latch when it is granted, instead of being detached by the
// close. Same outcome, one layer up, and a better one, because the answer comes
// from asking the stream rather than from being failed by the runtime. The
// runtime's own queue drain is still what stands behind the streams that have no
// wrapper lock (see the two-queued-acceptors test in `accept_test`), and it is
// still what this close calls.
/// 1 = failed with `Canceled`, 2 = failed with something else, 3 = returned.
function readOutcome(result: Result<Int32, NetError>): Int32 =
    match result with
        case Error(NetError.Canceled) => 1i32
        case Error(_) => 2i32
        case Ok(_) => 3i32

/// Signals `posted` and then reads.
///
/// The signal must come from THIS fiber's first step, or the close below lands
/// before the read is posted — and that failure is silent rather than a hang: the
/// read answers from the closed latch with a clean EOF, which reads as a pass.
/// Completing a promise used to take effect where its `Async` was CONSTRUCTED,
/// which put the signal in the forking fiber; that is fixed in `Promise`.
async function announceThenRead(
    input: AsyncInputStream<NetworkError>,
    posted: Promise<Unit, Never>,
    report: Promise<Int32, Never>
): Async<Unit, Never> =
    await posted.complete(())
    let outcome =
        await input
            .read(64i64)
            .mapError(toNetError)
            .fold<Int32, Never>(
            (e: NetError) => Async.succeed(readOutcome(Error(e))),
            (chunk: Array<Uint8>) => Async.succeed(readOutcome(Ok(chunk.length)))
        )
    await report.complete(outcome)
    ()

@timeout(10000)
 test "Streams: close cancels the read in flight and drains the readers queued behind it" =
    let mutable first = 0i32
    let mutable second = 0i32
    closeUnderTwoReadersProgram((a: Int32) => first = a, (b: Int32) => second = b).run()
    // Both `Canceled`: the first from the cancelled copy, the second from the
    // lock queue it never got to the front of.
    assert first == 1i32
    assert second == 1i32

async function closeUnderTwoReadersProgram(setFirst: (Int32) => Unit, setSecond: (Int32) => Unit):
    Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let release: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    // Never writes, so neither read can complete on its own.
    let _server: Fiber<Unit, NetError> = await acceptAndHold(listener, release).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let postedA: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let postedB: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let reportedA: Promise<Int32, Never> = await Async<Int32, Never>.makePromise()
    let reportedB: Promise<Int32, Never> = await Async<Int32, Never>.makePromise()
    // The signal comes from the forked fiber's own first step, and the fiber then
    // runs on into `read` before this one is scheduled again — making "A is parked
    // on the host op" true rather than merely likely.
    let a: Fiber<Unit, Never> =
        await announceThenRead(client.input, postedA, reportedA).forkBackground()
    await postedA.awaitPromise()
    // A now holds the handle's lock and is parked on the host op, so B queues
    // behind it rather than posting a second read of its own.
    let b: Fiber<Unit, Never> =
        await announceThenRead(client.input, postedB, reportedB).forkBackground()
    await postedB.awaitPromise()
    await client.input.close().mapError(toNetError)
    let resultA = await reportedA.awaitPromise()
    let resultB = await reportedB.awaitPromise()
    await a.join()
    await b.join()
    await release.complete(())
    setFirst(resultA)
    setSecond(resultB)

// --- a stream that ends under a queued reader ---------------------------------
//
// The runtime's per-handle lock is taken INSIDE the copy node, and a fiber that
// finds it held is suspended on that node — so when the lock is handed on, the
// node re-runs and posts. The stream wrapper's "is this stream still open"
// check happens before the node and never runs again, which makes the lock
// queue a suspension point the check cannot see across.
//
// Reader B, queued behind A, is granted the handle the instant A's copy reports
// the stream ended — and posts a copy on a stream whose one-shot result future
// has just been spent. Reading it twice traps, and a trap is the whole
// component. Both readers must come back with the end of stream instead, which
// is what the wrapper's own read lock is for: it puts the check and the post
// inside one critical section, so B re-asks the question after it waits rather
// than before.
async function acceptThenCloseOnCue(listener: TcpListener, cue: Promise<Unit, Never>):
    Async<Unit, NetError> =
    let _stream: TcpStream = use listener.accept()
    // Nothing is ever written, so neither read can complete on its own; the
    // scope closing the connection is what ends the stream under both of them.
    await cue.awaitPromise()
    ()

async function twoReadersAtEofProgram(setFirst: (Int32) => Unit, setSecond: (Int32) => Unit):
    Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let cue: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let _server: Fiber<Unit, NetError> = await acceptThenCloseOnCue(listener, cue).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let postedA: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let postedB: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let reportedA: Promise<Int32, Never> = await Async<Int32, Never>.makePromise()
    let reportedB: Promise<Int32, Never> = await Async<Int32, Never>.makePromise()
    let a: Fiber<Unit, Never> =
        await announceThenRead(client.input, postedA, reportedA).forkBackground()
    await postedA.awaitPromise()
    // A is on the handle; B waits its turn rather than posting a second read.
    let b: Fiber<Unit, Never> =
        await announceThenRead(client.input, postedB, reportedB).forkBackground()
    await postedB.awaitPromise()
    await cue.complete(())
    let resultA = await reportedA.awaitPromise()
    let resultB = await reportedB.awaitPromise()
    await a.join()
    await b.join()
    setFirst(resultA)
    setSecond(resultB)

@timeout(10000)
 test "Streams: a stream that ends under a queued reader answers it instead of trapping" =
    let mutable first = 0i32
    let mutable second = 0i32
    twoReadersAtEofProgram((a: Int32) => first = a, (b: Int32) => second = b).run()
    // 3 = a read that returned. Both of them: the one whose copy saw the end,
    // and the one that was waiting behind it — for which the answer comes from
    // the latch, with no second copy posted on a finished stream.
    assert first == 3i32
    assert second == 3i32

// --- the same on the write side -----------------------------------------------
// A write parked on a peer that never drains is exactly the case where waiting
// for the in-flight op instead of cancelling it would never return.
/// The write-side twin of `announceThenRead`, with the same signalling order.
async function announceThenWrite(
    output: AsyncOutputStream<NetworkError>,
    posted: Promise<Unit, Never>,
    report: Promise<Int32, Never>
): Async<Unit, Never> =
    await posted.complete(())
    // Far past any socket buffer, so this blocks partway with the peer holding
    // the connection open and reading nothing.
    let outcome =
        await output
            .write(Array<Uint8>.fill(4194304, 65u8).readonly)
            .mapError(toNetError)
            .fold<Int32, Never>(
            (e: NetError) => Async.succeed(readOutcome(Error(e))),
            (_: Unit) => Async.succeed(3i32)
        )
    await report.complete(outcome)
    ()

@timeout(10000)
 test "Streams: close cancels the write in flight instead of waiting for a peer that never drains" =
    let mutable outcome = 0i32
    closeUnderWriterProgram((n: Int32) => outcome = n).run()
    assert outcome == 1i32

async function closeUnderWriterProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let release: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let _server: Fiber<Unit, NetError> = await acceptAndHold(listener, release).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let posted: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let reported: Promise<Int32, Never> = await Async<Int32, Never>.makePromise()
    let writer: Fiber<Unit, Never> =
        await announceThenWrite(client.output, posted, reported).forkBackground()
    // The writer signals from its own first step and runs on into `write`, which
    // parks as soon as the socket buffer fills — the peer holds the connection
    // open and never reads — so it is genuinely in flight by the time this
    // fiber is scheduled again.
    await posted.awaitPromise()
    await client.output.close().mapError(toNetError)
    let result = await reported.awaitPromise()
    await writer.join()
    await release.complete(())
    setter(result)

// --- closing twice, and using the stream afterwards ---------------------------
// Using a stream after `close` is documented as undefined, but "undefined" must
// not mean "reads somebody else's socket". A dropped p3 handle's index is reused
// immediately, so every path that could still touch the handle after a close has
// to be latched shut: the second `close` (which would otherwise cancel copies on
// whatever stream now holds that index), and any later read or write.
//
// The `use` below then releases both streams over the top of the explicit close,
// so this also pins that the Resource finalizer is a no-op once close has run.
@timeout(10000)
 test "Streams: closing twice and using the stream afterwards latches instead of touching a reused handle" =
    let mutable outcome = 0i32
    closeTwiceProgram((n: Int32) => outcome = n).run()
    // 1 = both closes returned, and the later read and the later write both
    // reported the close rather than touching the handle.
    assert outcome == 1i32

async function closeTwiceProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let release: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let _server: Fiber<Unit, NetError> = await acceptAndHold(listener, release).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    await client.output.close().mapError(toNetError)
    await client.output.close().mapError(toNetError)
    await client.input.close().mapError(toNetError)
    await client.input.close().mapError(toNetError)
    // RE-POINTED, and the invariant it was written for is untouched: a read
    // after a close answers from the latch rather than posting a copy on
    // whatever stream now owns that handle index. What CHANGED is the answer
    // the latch gives.
    //
    // It used to be an empty array, which this library defines as the end of the
    // stream — so a read racing a sibling's close was told the peer had
    // finished. The fiber that was already parked on the handle when the close
    // ran got `Canceled` from the runtime instead, which means the answer to
    // "did the peer finish, or did somebody take my stream away" was decided by
    // which side of the close the scheduler put you on. A body reader on the
    // losing side reported a truncated body as a complete one. So a closed
    // stream now reports the close, in the same words, to both.
    let readFailed =
        await client
            .input
            .read(64i64)
            .fold<Bool, NetError>(
            (_: NetworkError) => Async.succeed(true),
            (bytes: Array<Uint8>) => Async.succeed(false)
        )
    let writeFailed =
        await client
            .output
            .write("x".bytes().readonly)
            .fold<Bool, NetError>(
            (_: NetworkError) => Async.succeed(true),
            (_: Unit) => Async.succeed(false)
        )
    await release.complete(())
    setter(if readFailed && writeFailed then 1i32 else 2i32)

// --- a fiber masked by a raced cancel is interrupted at its next park ---------
//
// Interrupting a fiber parked mid-read cancels the copy — but a cancel can LOSE:
// the host may already have copied bytes into the fiber's buffer, and cancelling
// hands them back rather than undoing anything. Throwing them away would strand
// whatever came through, so the runtime resumes the fiber with them and holds the
// interrupt until it has owned them.
//
// Held, not dropped. If the fiber's next move is to park again it will never own
// anything, so the debt has to be settled there — a fiber that parks still owing
// an interrupt waits forever, because nothing interrupts it twice. These two take
// the park sites that are not copy nodes, a `join` and a contended mutex, and
// leave each one un-completable: without the safe point at the park the fiber
// hangs and the whole program deadlocks.
//
// The race is arranged rather than hoped for. The reader parks on an empty
// socket; the peer then writes, which copies the bytes into the reader's pinned
// buffer and queues its completion IN THE HOST. The runtime only collects host
// events when nothing is runnable, and the peer's signal has just made this fiber
// runnable — so the interrupt below lands on a read that has completed and not
// yet been delivered, which is exactly the losing cancel.
async function neverFinishing(started: Promise<Unit, Never>): Async<Unit, Never> =
    await started.complete(())
    let forever: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    await forever.awaitPromise()

async function sendThenHold(listener: TcpListener, sent: Promise<Unit, Never>):
    Async<Unit, NetError> =
    let stream: TcpStream = use listener.accept()
    await stream.output.write(Array<Uint8>.fill(8, 70u8).readonly).mapError(toNetError)
    await sent.complete(())
    let _tail = await stream.input.read(1i64).mapError(toNetError)
    ()

async function readThenJoin(
    input: AsyncInputStream<NetworkError>,
    target: Fiber<Unit, Never>,
    posted: Promise<Unit, Never>
): Async<Unit, NetError> =
    // Signalled and then posted without parking in between, so by the time
    // anyone else runs this fiber is sitting in the read.
    await posted.complete(())
    let _bytes = await input.read(64i64).mapError(toNetError)
    await target.join()

async function maskedJoinProgram(setter: (Bool) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let sent: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let _server: Fiber<Unit, NetError> = await sendThenHold(listener, sent).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let started: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let posted: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let victim: Fiber<Unit, Never> = await neverFinishing(started).forkBackground()
    await started.awaitPromise()
    let masked: Fiber<Unit, NetError> = await readThenJoin(client.input, victim, posted).fork()
    await posted.awaitPromise()
    await sent.awaitPromise()
    await masked.interrupt()
    let ended =
        await masked
            .join()
            .foldCause(
            (_: Cause<NetError>) => Async.succeed(true),
            (_: Unit) => Async.succeed(false)
        )
    setter(ended)

@timeout(15000)
 test "Streams: a reader masked by a losing cancel is interrupted at its next park, not stranded" =
    let mutable interrupted = false
    maskedJoinProgram((b: Bool) => interrupted = b).run()
    assert interrupted

// The mutex park site — the other one that is not a copy node — is deliberately
// not tested separately. It goes through the same `beginPark` helper, and the
// socket-based version of it does not reproduce: the peer's write lands before
// the reader posts, so the read completes inline and there is no losing cancel to
// mask. A test that passes with the fix removed pins nothing, which is the whole
// argument for there being one helper rather than a check per park site.
// --- interrupting a write parked against a peer that has gone ----------------
//
// A write cancelled while parked used to be SETTLED on the way out, which read
// the stream's one-shot result future when the cancel reported the stream ended.
// The reading was then thrown away — a cancelled write reports `false` by design,
// because the bytes are the caller's and there is nothing transferred to take
// custody of — so the wrapper never learned, and still believed the future was
// unread. Its finalizer then read it a second time: a trap during teardown, not
// a missing error. The cancel path now leaves the future alone and `dropHandles`
// reads it exactly once, which is what the contract said all along.
//
// HONEST LIMIT: this exercises the cancel path but does not discriminate — it
// passes with the old `settleWrite` restored. Whether the host reports a
// cancelled write as `Dropped` (the branch that reads the future) is the host's
// call, and against a peer that closed its end wasmtime reports `Cancelled`
// here, so the double read never fires. What the test does pin is that
// interrupting a fiber parked mid-write and then releasing the connection
// under it neither traps nor hangs, which had no coverage at all.
async function writeForever(output: AsyncOutputStream<NetworkError>, posted: Promise<Unit, Never>):
    Async<Unit, NetError> =
    let big = Array<Uint8>.fill(1048576, 65u8)
    await posted.complete(())
    let mutable i = 0i32
    while i < 1000i32 do
        await output
            .write(big.readonly)
            .mapError(toNetError)
            .catchAll((_: NetError) => Async.succeed(()))
        i = i + 1

async function interruptedWriterProgram(setter: (Bool) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let _server: Fiber<Unit, NetError> = await acceptAndDrop(listener).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let posted: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let writer: Fiber<Unit, NetError> = await writeForever(client.output, posted).fork()
    await posted.awaitPromise()
    // Give the writer a turn to block on the socket, then pull it out from under
    // itself. Releasing `client` afterwards is what runs `dropHandles` — the
    // second read of the result future, if the cancel spent it.
    await Async<Unit, NetError>.sleep(Duration.ofMillis(50i64))
    await writer.interrupt()
    await writer
        .join()
        .foldCause((_: Cause<NetError>) => Async.succeed(()), (_: Unit) => Async.succeed(()))
    setter(true)

@timeout(20000)
 test "Streams: interrupting a write against a dropped peer leaves the result future for the finalizer" =
    let mutable finished = false
    interruptedWriterProgram((b: Bool) => finished = b).run()
    assert finished

// --- a cancel that reports the stream ENDED ----------------------------------
//
// A cancel is normally an undo: nothing moved, so nothing is settled and the
// fiber simply takes its interrupt. But the status a cancel comes back with can
// be `Dropped` at a count of zero, and that is not an undo — it is the host
// telling the guest that the stream is over, and the telling has happened
// whether or not anybody passes it on. Left as an undo, the wrapper stays
// `Open` and contradicts something the host has already said: the next read
// posts a copy on a stream the guest has been notified about, which traps
// ("cannot read after being notified that the writable end dropped").
//
// Arranged rather than hoped for, in the manner of the masked-reader test
// below: the reader parks on a socket the peer then closes, and the interrupt
// lands before the runtime collects host events — so the cancel, not a
// completion, is what reports the ending. The read after it is the assertion:
// it must answer from the latch.
async function holdUntilSignalled(listener: TcpListener, closeNow: Promise<Unit, Never>):
    Async<Unit, NetError> =
    let _stream: TcpStream = use listener.accept()
    await closeNow.awaitPromise()
    ()

async function acceptThenCloseOnSignal(
    listener: TcpListener,
    closeNow: Promise<Unit, Never>,
    closed: Promise<Unit, Never>
): Async<Unit, NetError> =
    // The connection's scope is the inner function, so it has been released —
    // the peer really is gone — before `closed` is completed below.
    await holdUntilSignalled(listener, closeNow)
    await closed.complete(())
    ()

/// 1 = failed, 2 = end of stream, 3 = bytes.
async function readAgain(input: AsyncInputStream<NetworkError>): Async<Int32, NetError> =
    await input
        .read(64i64)
        .mapError(toNetError)
        .fold<Int32, NetError>(
        (_: NetError) => Async.succeed(1i32),
        (bytes: Array<Uint8>) => Async.succeed(if bytes.length == 0 then 2i32 else 3i32)
    )

async function droppedCancelProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let closeNow: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let closed: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let _server: Fiber<Unit, NetError> =
        await acceptThenCloseOnSignal(listener, closeNow, closed).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let posted: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let reported: Promise<Int32, Never> = await Async<Int32, Never>.makePromise()
    let reader: Fiber<Unit, Never> =
        await announceThenRead(client.input, posted, reported).forkBackground()
    await posted.awaitPromise()
    await closeNow.complete(())
    await closed.awaitPromise()
    await reader.interrupt()
    await reader
        .join()
        .foldCause<Unit, NetError>(
        (_: Cause<Never>) => Async.succeed(()),
        (_: Unit) => Async.succeed(())
    )
    setter(await readAgain(client.input))

@timeout(10000)
 test "Streams: a cancel that reports the stream ended leaves the stream ended" =
    let mutable outcome = 0i32
    droppedCancelProgram((n: Int32) => outcome = n).run()
    // 2 = the end of stream, answered from the latch with no second copy posted.
    // A trap is the failure this guards, and it is not a value: without the fix
    // the stream is still `Open` here and the read posts on a handle the guest
    // has been told is finished.
    assert outcome == 2i32

// --- a write interrupted with the array half out fences the stream -----------
//
// The hole is the point, and it is invisible. A write of n bytes is a sequence
// of copies; stop the sequence after k and the transport has a prefix of an
// array on it, with nothing on the wire to say so. The next writer's bytes are
// then spliced onto that prefix and the peer reads one corrupt message where
// two were sent — which is not an I/O error anywhere along the path, so nobody
// ever finds out.
//
// AN INTERRUPT is the case the fence exists for, and the reason it cannot live
// in the write loop's `Cancelled` arm, which is where it started: an interrupted
// fiber reaches no arm at all. It is failed where it parked and goes straight
// into its unwind, so the only place that sees every partial write is the way
// out of the write itself.
//
// The peer here holds the connection open and never reads, which is what makes
// the write park with part of the array already gone rather than fail outright.
async function writeUntilInterrupted(
    output: AsyncOutputStream<NetworkError>,
    posted: Promise<Unit, Never>
): Async<Unit, Never> =
    await posted.complete(())
    // Far past any socket buffer: the first copies get bytes out and one of them
    // then parks with the array half delivered.
    await output
        .write(Array<Uint8>.fill(4194304, 65u8).readonly)
        .fold<Unit, Never>((_: NetworkError) => Async.succeed(()), (_: Unit) => Async.succeed(()))

async function tornWriteProgram(setter: (Int32) => Unit): Async<Unit, NetError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress()
    let release: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let _server: Fiber<Unit, NetError> = await acceptAndHold(listener, release).forkBackground()
    let client: TcpStream = use Tcp.connect("127.0.0.1", streamPort(address))
    let posted: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let writer: Fiber<Unit, Never> =
        await writeUntilInterrupted(client.output, posted).forkBackground()
    await posted.awaitPromise()
    // Long enough to fill the socket and park; the same 50ms the interrupted-write
    // test above uses for the same purpose.
    await Async<Unit, NetError>.sleep(Duration.ofMillis(50i64))
    await writer.interrupt()
    await writer
        .join()
        .foldCause<Unit, NetError>(
        (_: Cause<Never>) => Async.succeed(()),
        (_: Unit) => Async.succeed(())
    )
    let outcome =
        await client
            .output
            .write("x".bytes().readonly)
            .mapError(toNetError)
            .fold<Int32, NetError>(
            (e: NetError) => Async.succeed(readOutcome(Error(e))),
            (_: Unit) => Async.succeed(3i32)
        )
    await release.complete(())
    setter(outcome)

// WHAT THIS DOES NOT PIN, stated because it looks as though it does: the
// runtime hands a cancelled WRITE's byte count back to the fiber, and this test
// passes with that reverted. It cannot discriminate it, because `written` has
// already accumulated the copies that completed before the parked one — the
// count on the cancelled copy itself only matters when it is the ONLY copy that
// moved bytes, which needs the host to accept part of an array between the
// moment the write blocks and the moment the cancel reaches it. Nothing in this
// tree can ask a host for that: a parked write is parked precisely because the
// host took nothing. The count is delivered because a hole the fence cannot see
// is a hole nobody reports, not because a test would notice.
//
// The read-side twin of the same delivery IS pinned, by the cancel-reports-ended
// test above: there the news at a count of zero is the ending itself.
@timeout(20000)
 test "Streams: a write interrupted with the array half out fences the stream" =
    let mutable outcome = 0i32
    tornWriteProgram((n: Int32) => outcome = n).run()
    // 1 = `Canceled`: the stream refused the next write because it is torn, and
    // said so with the error that means "an operation was taken away from you"
    // rather than the one that means "the transport is gone" — the transport is
    // fine, which is exactly why nothing else would have reported this.
    //
    // 3 is the bug: bytes accepted onto the end of somebody else's truncated
    // array.
    assert outcome == 1i32
