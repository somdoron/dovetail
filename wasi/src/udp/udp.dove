package standard.wasi.udp

import standard.wasi.AsyncCall
import standard.wasi.net.IpAddressFamily
import standard.wasi.net.SocketAddress
import standard.wasi.net.NetworkError

/// A UDP socket resource handle.
///
/// The p3 surface is far smaller than p2's: `send`/`receive` are plain async
/// funcs carrying a `list<u8>` payload, so there are no incoming/outgoing
/// datagram-stream resources and no pollables. Everything except send/receive
/// is synchronous.
public newtype UdpSocket = Int32

/// One received datagram: the payload plus the peer it came from. Named to
/// avoid colliding with the user-facing `standard.io.net.Datagram`.
public record ReceivedDatagram =
    data: Array<Uint8>
    remoteAddress: SocketAddress

module UdpSocket =
    /// Create a new UDP socket for the given address family.
    public function create(family: IpAddressFamily): Result<UdpSocket, NetworkError> = intrinsic

    /// Bind to a local address. A zero port picks a free one.
    public function bind(self, address: SocketAddress): Result<Unit, NetworkError> = intrinsic

    /// Associate the socket with a peer: `send` may then omit the destination
    /// and `receive` only yields datagrams from that peer. Generates no traffic.
    public function connect(self, address: SocketAddress): Result<Unit, NetworkError> = intrinsic

    /// Undo a `connect`.
    public function disconnect(self): Result<Unit, NetworkError> = intrinsic

    /// Start sending `data`. `remoteAddress` must be `None` on a connected
    /// socket and `Some` otherwise. Await the call, then `sendFinish`.
    public function sendStart(self, data: Array<Uint8>, remoteAddress: Option<SocketAddress>):
        AsyncCall = intrinsic

    /// Complete a send and free the call's pinned block.
    public function sendFinish(call: AsyncCall): Result<Unit, NetworkError> = intrinsic

    /// Start receiving one datagram. Await the call, then `receiveFinish`.
    public function receiveStart(self): AsyncCall = intrinsic

    /// Lift the received datagram, freeing the payload buffer and the call's
    /// pinned block.
    public function receiveFinish(call: AsyncCall):
        Result<ReceivedDatagram, NetworkError> = intrinsic

    public function localAddress(self): Result<SocketAddress, NetworkError> = intrinsic

    public function remoteAddress(self): Result<SocketAddress, NetworkError> = intrinsic

    /// The address family this socket was created with.
    public function addressFamily(self): IpAddressFamily = intrinsic

    // Socket options. Every one is `result<_, error-code>`, and a host may
    // legitimately answer `NotSupported` — none of them is obligatory.
    /// IP_TTL / IPV6_UNICAST_HOPS. Setting 0 is an `InvalidArgument`.
    public function unicastHopLimit(self): Result<Int32, NetworkError> = intrinsic

    public function setUnicastHopLimit(self, value: Int32): Result<Unit, NetworkError> = intrinsic

    /// SO_RCVBUF / SO_SNDBUF. Hosts treat these as a cap and may clamp or round,
    /// so a value read back need not equal the value set. Setting 0 is an
    /// `InvalidArgument`.
    public function receiveBufferSize(self): Result<Int64, NetworkError> = intrinsic

    public function setReceiveBufferSize(self, value: Int64): Result<Unit, NetworkError> = intrinsic

    public function sendBufferSize(self): Result<Int64, NetworkError> = intrinsic

    public function setSendBufferSize(self, value: Int64): Result<Unit, NetworkError> = intrinsic

    /// Release the socket handle.
    public function close(self): Unit = intrinsic
