package standard.wasi.clock

import standard.time.Instant
import standard.time.Duration
import standard.wasi.AsyncCall

/// The monotonic clock and its async timers — the runtime's time source.
///
/// Timers hand back an `AsyncCall` like any other async import, so a sleep parks
/// on a subtask exactly like a socket read does.
///
/// The raw-nanosecond entry points and the `Duration` one live together on
/// purpose. They were two modules in two files for a while, on the theory that
/// the runtime needed a clock that did not depend on `standard.time` — but the
/// whole `wasi` project depends on it regardless, and the lower module ended up
/// with exactly one caller: the upper one.
module MonotonicClock =
    /// Nanoseconds since an unspecified origin (monotonic, non-decreasing).
    public function now(): Int64 = intrinsic

    /// Start an async wait for `nanoseconds`. The returned call's subtask
    /// completes when the time has elapsed (no result buffer).
    ///
    /// The ABI takes nanoseconds; `waitForStart` is the same timer with a
    /// `Duration` in front of it.
    public function waitForNanosStart(nanoseconds: Int64): AsyncCall = intrinsic

    /// Start an async wait for the given duration.
    public function waitForStart(duration: Duration): AsyncCall =
        let nanos = duration.seconds * 1000000000i64 + duration.nanos.toInt64()
        // A negative (already-elapsed) duration lifts to a huge u64 nanosecond count at the
        // WASI boundary — a ~584-year wait instead of firing at once. Clamp to 0 so an
        // already-passed deadline (`timeout(deadline - now)`) fires now rather than hanging.
        MonotonicClock
            .waitForNanosStart(if nanos < 0i64 then 0i64 else nanos)

    /// Start an async wait until a monotonic mark — a `now()` reading, not a
    /// time of day. The two are not interchangeable: `now()` counts from an
    /// unspecified origin, so passing it a wall-clock value would wait out the
    /// difference between that origin and the Unix epoch.
    public function waitUntilNanosStart(deadline: Int64): AsyncCall = intrinsic

module WallClock =
    public property now: Instant = intrinsic
