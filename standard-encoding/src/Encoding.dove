package standard.encoding

import standard.prelude.Array
import standard.prelude.String
import standard.prelude.Result

/// Represents errors that can occur during encoding or decoding operations.
public enum EncodingError =
    /// An invalid character was encountered at the given position.
    InvalidCharacter(Int32, Char)
    /// The input has an invalid length for the expected encoding format.
    InvalidLength(String)

/// Base64 encoding and decoding, supporting both standard (RFC 4648) and URL-safe alphabets.
module Base64 =
    private function base64CharStd(n: Int32): String =
        if n < 26 then String.fromBytes(Array<Uint8>.fill(1, (n + 65).toUint8()), 0, 1)
        else if n < 52 then String.fromBytes(Array<Uint8>.fill(1, (n - 26 + 97).toUint8()), 0, 1)
        else if n < 62 then String.fromBytes(Array<Uint8>.fill(1, (n - 52 + 48).toUint8()), 0, 1)
        else if n == 62 then String.fromChar('+')
        else String.fromChar('/')

    private function base64CharUrl(n: Int32): String =
        if n < 26 then String.fromBytes(Array<Uint8>.fill(1, (n + 65).toUint8()), 0, 1)
        else if n < 52 then String.fromBytes(Array<Uint8>.fill(1, (n - 26 + 97).toUint8()), 0, 1)
        else if n < 62 then String.fromBytes(Array<Uint8>.fill(1, (n - 52 + 48).toUint8()), 0, 1)
        else if n == 62 then String.fromChar('-')
        else String.fromChar('_')

    private function base64ValStd(c: Char): Int32 =
        let bytes = String.fromChar(c).bytes()
        let b = bytes.get(0).toInt32()
        if b >= 65 then
            if b <= 90 then
                b - 65
            else if b >= 97 then
                if b <= 122 then b - 71 else -1
            else
                -1
        else if b >= 48 then
            if b <= 57 then b + 4 else -1
        else if b == 43 then
            62
        else if b == 47 then
            63
        else
            -1

    private function base64ValUrl(c: Char): Int32 =
        let bytes = String.fromChar(c).bytes()
        let b = bytes.get(0).toInt32()
        if b >= 65 then
            if b <= 90 then
                b - 65
            else if b == 95 then
                63
            else if b >= 97 then
                if b <= 122 then b - 71 else -1
            else
                -1
        else if b >= 48 then
            if b <= 57 then b + 4 else -1
        else if b == 45 then
            62
        else
            -1

    private function encodeInternal(data: Array<Uint8>, char_fn: (Int32) => String): String =
        let len = data.length
        let fullGroups = len / 3
        let remainder = len % 3
        let outLen = fullGroups * 4 + (if remainder == 0 then 0 else 4)
        let mutable result = ""
        let mutable i = 0
        while i < fullGroups do
            let p = i * 3
            let b0 = data.get(p).toInt32()
            let b1 = data.get(p + 1).toInt32()
            let b2 = data.get(p + 2).toInt32()
            let n0 = b0 / 4
            let n1 = (b0 % 4) * 16 + b1 / 16
            let n2 = (b1 % 16) * 4 + b2 / 64
            let n3 = b2 % 64
            result = result ++ char_fn(n0) ++ char_fn(n1) ++ char_fn(n2) ++ char_fn(n3)
            i = i + 1
        if remainder == 1 then
            let b0 = data.get(fullGroups * 3).toInt32()
            let n0 = b0 / 4
            let n1 = (b0 % 4) * 16
            result = result ++ char_fn(n0) ++ char_fn(n1) ++ "=="
        else if remainder == 2 then
            let b0 = data.get(fullGroups * 3).toInt32()
            let b1 = data.get(fullGroups * 3 + 1).toInt32()
            let n0 = b0 / 4
            let n1 = (b0 % 4) * 16 + b1 / 16
            let n2 = (b1 % 16) * 4
            result = result ++ char_fn(n0) ++ char_fn(n1) ++ char_fn(n2) ++ "="
        result

    private function decodeInternal(encoded: String, val_fn: (Char) => Int32):
        Result<Array<Uint8>, EncodingError> =
        let len = encoded.length
        if len % 4 != 0 then
            Error(EncodingError.InvalidLength("length must be multiple of 4"))
        else
            let padding = base64CountPadding(encoded)
            let dataLen = (len / 4) * 3 - padding
            let buf = Array<Uint8>.fill(dataLen, 0u8)
            let mutable i = 0
            let mutable pos = 0
            let mutable err: Option<EncodingError> = None
            while i < len - 4 do
                let v0 = val_fn(encoded.getChar(i))
                let v1 = val_fn(encoded.getChar(i + 1))
                let v2 = val_fn(encoded.getChar(i + 2))
                let v3 = val_fn(encoded.getChar(i + 3))
                if v0 < 0 then
                    err = Some(EncodingError.InvalidCharacter(i, encoded.getChar(i)))
                    i = len
                else if v1 < 0 then
                    err = Some(EncodingError.InvalidCharacter(i + 1, encoded.getChar(i + 1)))
                    i = len
                else if v2 < 0 then
                    err = Some(EncodingError.InvalidCharacter(i + 2, encoded.getChar(i + 2)))
                    i = len
                else if v3 < 0 then
                    err = Some(EncodingError.InvalidCharacter(i + 3, encoded.getChar(i + 3)))
                    i = len
                else
                    buf.set(pos, ((v0 * 4 + v1 / 16) % 256).toUint8())
                    buf.set(pos + 1, ((v1 * 16 + v2 / 4) % 256).toUint8())
                    buf.set(pos + 2, ((v2 * 64 + v3) % 256).toUint8())
                    pos = pos + 3
                    i = i + 4
            match err with
                case Some(e) => Error(e)
                case None =>
                    if i < len then
                        let v0 = val_fn(encoded.getChar(i))
                        let v1 = val_fn(encoded.getChar(i + 1))
                        let v2 = val_fn(encoded.getChar(i + 2))
                        let v3 = val_fn(encoded.getChar(i + 3))
                        if v0 < 0 then
                            Error(EncodingError.InvalidCharacter(i, encoded.getChar(i)))
                        else
                            if v1 < 0 then
                                Error(EncodingError.InvalidCharacter(i + 1, encoded.getChar(i + 1)))
                            else
                                if v2 < 0 then
                                    // A padding `=` in the third position REQUIRES a `=` in the
                                    // fourth too (a two-byte-dropped final group is `xx==`). Without
                                    // this check, `AB=C` — data after padding — decodes to a wrong,
                                    // over-length result instead of an InvalidCharacter error.
                                    if encoded
                                        .getChar(i + 2)
                                        == '='
                                        && encoded.getChar(i + 3) == '=' then
                                        buf.set(pos, ((v0 * 4 + v1 / 16) % 256).toUint8())
                                        Ok(buf)
                                    else
                                        Error(
                                            EncodingError
                                                .InvalidCharacter(i + 2, encoded.getChar(i + 2))
                                        )
                                else if v3 < 0 then
                                    if encoded.getChar(i + 3) == '=' then
                                        buf.set(pos, ((v0 * 4 + v1 / 16) % 256).toUint8())
                                        buf.set(pos + 1, ((v1 * 16 + v2 / 4) % 256).toUint8())
                                        Ok(buf)
                                    else
                                        Error(
                                            EncodingError
                                                .InvalidCharacter(i + 3, encoded.getChar(i + 3))
                                        )
                                else
                                    buf.set(pos, ((v0 * 4 + v1 / 16) % 256).toUint8())
                                    buf.set(pos + 1, ((v1 * 16 + v2 / 4) % 256).toUint8())
                                    buf.set(pos + 2, ((v2 * 64 + v3) % 256).toUint8())
                                    Ok(buf)
                    else
                        Ok(buf)

    private function base64CountPadding(s: String): Int32 =
        let len = s.length
        if len < 2 then
            0
        else if s.getChar(len - 1) == '=' then
            if s.getChar(len - 2) == '=' then 2 else 1
        else
            0

    /// Encodes a byte array to a standard Base64 string with padding.
    public function encode(data: Array<Uint8>): String = encodeInternal(data, base64CharStd)

    /// Decodes a standard Base64 string back to bytes. Returns an error for invalid input.
    public function decode(encoded: String): Result<Array<Uint8>, EncodingError> =
        decodeInternal(encoded, base64ValStd)

    /// Encodes a byte array to a URL-safe Base64 string, using `-` and `_` instead of `+` and `/`.
    public function encodeUrlSafe(data: Array<Uint8>): String = encodeInternal(data, base64CharUrl)

    /// Decodes a URL-safe Base64 string back to bytes. Returns an error for invalid input.
    public function decodeUrlSafe(encoded: String): Result<Array<Uint8>, EncodingError> =
        decodeInternal(encoded, base64ValUrl)

/// Hexadecimal encoding and decoding using lowercase output and case-insensitive decoding.
module Hex =
    private function hexChar(n: Int32): String =
        let b = if n < 10 then (n + 48).toUint8() else (n - 10 + 97).toUint8()
        String.fromBytes(Array<Uint8>.fill(1, b), 0, 1)

    private function hexVal(c: Char): Int32 =
        let b = String.fromChar(c).bytes().get(0).toInt32()
        if b >= 48 then
            if b <= 57 then
                b - 48
            else if b >= 97 then
                if b <= 102 then b - 87 else -1
            else if b >= 65 then
                if b <= 70 then b - 55 else -1
            else
                -1
        else
            -1

    /// Encodes a byte array to a lowercase hexadecimal string.
    public function encode(data: Array<Uint8>): String =
        let len = data.length
        let mutable result = ""
        let mutable i = 0
        while i < len do
            let b = data.get(i).toInt32()
            result = result ++ hexChar(b / 16) ++ hexChar(b % 16)
            i = i + 1
        result

    /// Decodes a hexadecimal string to bytes. Accepts both uppercase and lowercase input.
    public function decode(encoded: String): Result<Array<Uint8>, EncodingError> =
        let len = encoded.length
        if len % 2 != 0 then
            Error(EncodingError.InvalidLength("hex string must have even length"))
        else
            let outLen = len / 2
            let buf = Array<Uint8>.fill(outLen, 0u8)
            let mutable i = 0
            let mutable ok = true
            let mutable errPos = 0
            let mutable errChar = ' '
            while i < len do
                let hi = hexVal(encoded.getChar(i))
                let lo = hexVal(encoded.getChar(i + 1))
                if hi < 0 then
                    ok = false
                    errPos = i
                    errChar = encoded.getChar(i)
                    i = len
                else if lo < 0 then
                    ok = false
                    errPos = i + 1
                    errChar = encoded.getChar(i + 1)
                    i = len
                else
                    buf.set(i / 2, (hi * 16 + lo).toUint8())
                    i = i + 2
            if ok then Ok(buf) else Error(EncodingError.InvalidCharacter(errPos, errChar))

test "Base64 encode empty" =
    let data = Array<Uint8>.fill(0, 0u8)
    assert Base64.encode(data) == ""

test "Base64 encode single byte" =
    let data = Array<Uint8>.fill(1, 65u8)
    assert Base64.encode(data) == "QQ=="

test "Base64 encode two bytes" =
    let data = Array<Uint8>.fill(2, 0u8)
    data.set(0, 65u8)
    data.set(1, 66u8)
    assert Base64.encode(data) == "QUI="

test "Base64 encode three bytes" =
    let data = Array<Uint8>.fill(3, 0u8)
    data.set(0, 65u8)
    data.set(1, 66u8)
    data.set(2, 67u8)
    assert Base64.encode(data) == "QUJD"

test "Base64 encode decode roundtrip" =
    let data = Array<Uint8>.fill(5, 0u8)
    data.set(0, 72u8)
    data.set(1, 101u8)
    data.set(2, 108u8)
    data.set(3, 108u8)
    data.set(4, 111u8)
    let encoded = Base64.encode(data)
    assert encoded == "SGVsbG8="
    let decoded = Base64.decode(encoded)
    assert decoded.isOk
    let result = decoded.require
    assert result.length == 5
    assert result.get(0) == 72u8
    assert result.get(1) == 101u8
    assert result.get(4) == 111u8

test "Base64 decode invalid length" =
    let result = Base64.decode("abc")
    assert result.isError

test "Base64 decode invalid character" =
    let result = Base64.decode("!!!!")
    assert result.isError

test "Base64 decode rejects data after padding" =
    // `=` in the third position requires `=` in the fourth; a valid char there is malformed.
    assert Base64.decode("AB=C").isError
    // proper single/double padding still decodes
    assert Base64.decode("QQ==").isOk
    assert Base64.decode("QUI=").isOk

test "Base64 url safe encode uses dash and underscore" =
    let data = Array<Uint8>.fill(3, 0u8)
    data.set(0, 251u8)
    data.set(1, 239u8)
    data.set(2, 254u8)
    let std = Base64.encode(data)
    let url = Base64.encodeUrlSafe(data)
    assert std
        .contains("+")
        || std.contains("/")
        || url.contains("-")
        || url.contains("_")
        || std == url

test "Base64 url safe roundtrip" =
    let data = Array<Uint8>.fill(4, 0u8)
    data.set(0, 255u8)
    data.set(1, 128u8)
    data.set(2, 64u8)
    data.set(3, 32u8)
    let encoded = Base64.encodeUrlSafe(data)
    let decoded = Base64.decodeUrlSafe(encoded)
    assert decoded.isOk
    let result = decoded.require
    assert result.length == 4
    assert result.get(0) == 255u8
    assert result.get(1) == 128u8
    assert result.get(2) == 64u8
    assert result.get(3) == 32u8

test "Hex encode empty" =
    let data = Array<Uint8>.fill(0, 0u8)
    assert Hex.encode(data) == ""

test "Hex encode single byte" =
    let data = Array<Uint8>.fill(1, 255u8)
    assert Hex.encode(data) == "ff"

test "Hex encode multiple bytes" =
    let data = Array<Uint8>.fill(3, 0u8)
    data.set(0, 171u8)
    data.set(1, 205u8)
    data.set(2, 239u8)
    assert Hex.encode(data) == "abcdef"

test "Hex decode valid" =
    let result = Hex.decode("48656c6c6f")
    assert result.isOk
    let data = result.require
    assert data.length == 5
    assert data.get(0) == 72u8
    assert data.get(1) == 101u8

test "Hex decode uppercase" =
    let result = Hex.decode("ABCDEF")
    assert result.isOk
    let data = result.require
    assert data.get(0) == 171u8
    assert data.get(1) == 205u8
    assert data.get(2) == 239u8

test "Hex decode odd length" =
    let result = Hex.decode("abc")
    assert result.isError

test "Hex decode invalid character" =
    let result = Hex.decode("zz")
    assert result.isError

test "Hex encode decode roundtrip" =
    let data = Array<Uint8>.fill(4, 0u8)
    data.set(0, 0u8)
    data.set(1, 127u8)
    data.set(2, 128u8)
    data.set(3, 255u8)
    let encoded = Hex.encode(data)
    let decoded = Hex.decode(encoded)
    assert decoded.isOk
    let result = decoded.require
    assert result.length == 4
    assert result.get(0) == 0u8
    assert result.get(1) == 127u8
    assert result.get(2) == 128u8
    assert result.get(3) == 255u8
