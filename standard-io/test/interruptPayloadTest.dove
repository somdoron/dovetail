package test

import standard.io.Async
import standard.io.Cause
import standard.io.Fiber
import standard.io.Mutex
import standard.io.MutexError
import standard.io.Queue
import standard.time.Duration
import standard.wasi.ComponentFuture
import standard.wasi.ComponentStreamRead
import standard.wasi.CopyOperation
import standard.wasi.CopyResult
import standard.wasi.EventPayload
import standard.wasi.IoError
import standard.wasi.Waitable
import standard.wasi.cli.StdoutStream

// AN INTERRUPT MUST NOT DESTROY WHAT THE FIBER IS HOLDING.
//
// Two things qualify and they are the same rule seen from both ends: elements a
// raced cancel handed back, and — for a fiber that has not run yet — its own
// program, handlers included. Both used to be thrown away, and neither failure
// is visible at the call site: the fiber is dying either way, and what is lost
// is something nobody else was ever going to hand over.
//
// Driven synthetically, because the case needs a copy that BLOCKS and then
// reports elements when it is cancelled, and no transport in this tree can be
// asked for that: a read parks precisely because the host has nothing yet.

enum CarriedError =
    Broken

implement IoError for CarriedError

implement Display for CarriedError =
    public function format(self: CarriedError): String = "carried error"

/// A copy the host has taken and not finished. The canonical ABI's BLOCKED
/// sentinel is the status word — the high half of the operation value — being
/// -1; the low half is the pinned buffer, which nothing below ever touches.
function blockedCopy(): CopyOperation = CopyOperation(-1i64 << 32i64)

/// The one idle stream end every synthetic-copy fixture in this package parks
/// on, opened once for the whole test binary.
///
/// Nothing is posted on it — every copy here is synthetic — but the runtime
/// JOINS whatever waitable it is given into its waitable-set and removes it
/// again, and both of those are host calls that a made-up index would trap on. A
/// stdout stream is the cheapest handle that is certainly valid and certainly
/// has nothing in flight; `Console` and the panic reporter each open their own,
/// so this one is nobody else's.
///
/// Cached, and that is the point: `StdoutStream.open()` takes a FRESH host
/// handle every call and stdout has no drop — it lives as long as the component
/// — so a fixture that opened one per call spent a handle-table entry per test
/// and per sweep iteration, with nothing able to give them back. One handle
/// serves every fixture exactly as well as many, since none of them posts on it.
module IdleStdout =
    let handle: Waitable = StdoutStream.open().componentWrite().writable

    public property shared: Waitable = handle

/// The fixtures' spelling of `IdleStdout.shared`, kept as a function because
/// `closeAtomicTest`, `grantedLockInterruptTest` and `schedulerWindowTest` all
/// call it.
function idleWaitable(): Waitable = IdleStdout.shared

/// A stream end whose copy blocks and whose CANCEL LOSES: it reports that the
/// host had already transferred `payload`. Cancelling it hands those elements
/// back rather than undoing anything, which is the whole of the case.
function racingSource(payload: Array<Uint8>, waitable: Waitable): ComponentStreamRead<Array<Uint8>, CarriedError> =
    ComponentStreamRead<Array<Uint8>, CarriedError> {
        readable = waitable
        ending = () => Ok(())
        start = (capacity: Int32) => blockedCopy()
        cancel = () => EventPayload.ofCopy(CopyResult.Completed, payload.length)
        canceledError = CarriedError.Broken
        stillOpen = () => true
        dropEnd = () => ()
        // Synthetic copies pin no buffer, so there is nothing to free and
        // nothing owned to close.
        discardElements = (copy: CopyOperation, count: Int32) => ()
        lift = (copy: CopyOperation, count: Int32) => payload
    }

/// The same end, with a cancel that WINS: nothing was transferred, so there is
/// nothing to hand over and the interrupt is an undo.
function undoneSource(waitable: Waitable): ComponentStreamRead<Array<Uint8>, CarriedError> =
    ComponentStreamRead<Array<Uint8>, CarriedError> {
        readable = waitable
        ending = () => Ok(())
        start = (capacity: Int32) => blockedCopy()
        cancel = () => EventPayload.ofCopy(CopyResult.Cancelled, 0i32)
        canceledError = CarriedError.Broken
        stillOpen = () => true
        dropEnd = () => ()
        discardElements = (copy: CopyOperation, count: Int32) => ()
        lift = (copy: CopyOperation, count: Int32) => Array<Uint8>.empty()
    }

/// A read shaped like every read in this library: a mutex held with `use` across
/// the copy, so the bytes come back THROUGH a bracket release — and a bracket
/// release runs masked.
async function readUnderLock(
    source: ComponentStreamRead<Array<Uint8>, CarriedError>,
    lock: Mutex
): Async<Array<Uint8>, CarriedError> =
    let _held = use lock.acquire().orPanicWith((_: MutexError) => "read re-entered its own lock")
    let copied = await Async<Array<Uint8>, CarriedError>.streamRead(source, 64i32)
    copied._1

/// …and a caller that puts what came back somewhere that outlives it. This is
/// `Console.readLine`'s `appendChunk`, which deposits into a process-wide line
/// buffer: the fiber is dying, the bytes are not the fiber's, and stdin has
/// nowhere to re-read them from.
async function depositAfterRead(
    source: ComponentStreamRead<Array<Uint8>, CarriedError>,
    lock: Mutex,
    landed: Array<String>
): Async<Unit, Never> =
    let chunk = await readUnderLock(source, lock)
        .catchAll<Never>((_: CarriedError) => Async.succeed(Array<Uint8>.empty()))
    landed.set(0, chunk.length.format() ++ " bytes")

@timeout(10000)
test "an interrupted read deposits the bytes its cancel handed back" =
    let landed = Array<String>.fill(2, "nothing")
    racedReadProgram(landed).run()
    // The bytes reached the buffer they belong to. They used to reach the fiber
    // and die one frame later, at the mutex release on the way out of the read:
    // the release runs masked, and the end of a masked region was treated as a
    // safe point for an interrupt that was in fact waiting for the fiber to OWN
    // what it had been handed.
    assert landed.get(0) == "4 bytes"
    // The fiber owned them and ran on: an interrupt deferred to a safe point does
    // not stop a fiber that reaches the end of its work first. It is still
    // interrupted — nothing after this would have run.
    assert landed.get(1) == "finished"

async function racedReadProgram(landed: Array<String>): Async<Unit, Never> =
    let lock = await Mutex.make()
    let source = racingSource([|1u8, 2u8, 3u8, 4u8|], idleWaitable())
    let reader: Fiber<Unit, Never> = await depositAfterRead(source, lock, landed).fork()
    // Long enough for the reader to be parked on the copy rather than merely
    // enqueued: an interrupt that arrives before a fiber has run is a different
    // rule (see the forkAndUse test in `resource_test`), and this one is about
    // the fiber that is already inside the read.
    await Async<Unit, Never>.sleep(Duration.ofMillis(50i64))
    await reader.interrupt()
    await joinOutcome(reader, landed)

@timeout(10000)
test "an interrupted read whose cancel won deposits nothing" =
    let landed = Array<String>.fill(2, "nothing")
    undoneReadProgram(landed).run()
    // The control, and the half that must not change: a cancel that transferred
    // nothing is an UNDO. There is no payload to own, so the interrupt lands where
    // it always did and the deposit never runs.
    assert landed.get(0) == "nothing"
    // …and the fiber really did unwind, which is what stops this from passing on
    // a runtime that had merely stopped scheduling it. Asserting only the absence
    // of the deposit would be an assertion that the array is as it was built.
    assert landed.get(1) == "unwound"

async function undoneReadProgram(landed: Array<String>): Async<Unit, Never> =
    let lock = await Mutex.make()
    let source = undoneSource(idleWaitable())
    let reader: Fiber<Unit, Never> = await depositAfterRead(source, lock, landed).fork()
    await Async<Unit, Never>.sleep(Duration.ofMillis(50i64))
    await reader.interrupt()
    await joinOutcome(reader, landed)

/// Wait for the reader and record how it ended: `unwound` if it took its
/// interrupt, `finished` if it ran to the end. Both are legitimate outcomes here
/// — a fiber handed a payload finishes and takes its interrupt later — so this is
/// what each test's own expectation is checked against.
async function joinOutcome(fiber: Fiber<Unit, Never>, landed: Array<String>): Async<Unit, Never> =
    await fiber.join().foldCause<Unit, Never>(
        (_: Cause<Never>) => Async.thunk(() => landed.set(1, "unwound")),
        (_: Unit) => Async.thunk(() => landed.set(1, "finished"))
    )

/// A future whose copy blocks and whose cancel LOSES — the host had already
/// resolved it — but to a typed ERROR. The host handed back a code, not a
/// value: there is nothing to own, so this is not a payload the fiber must be
/// resumed with. It is the one raced outcome that owns nothing.
function failingRacedFuture(waitable: Waitable): ComponentFuture<Unit, CarriedError> =
    ComponentFuture<Unit, CarriedError> {
        readable = waitable
        start = () => blockedCopy()
        cancel = () => EventPayload.ofCopy(CopyResult.Completed, 1i32)
        lift = (copy: CopyOperation) =>
            let failed: Result<Unit, CarriedError> = Error(CarriedError.Broken)
            failed
        dropReadable = () => ()
    }

/// Recover from the future's error, then take from a queue: the take dequeues
/// inside its own mask, and the element leaves that mask through a pop.
async function recoverThenTake(
    future: ComponentFuture<Unit, CarriedError>,
    queue: Queue<Int32>,
    landed: Array<String>
): Async<Unit, Never> =
    await Async<Unit, CarriedError>.futureValue(future)
        .catchAll<Never>((_: CarriedError) => Async.succeed(()))
    let element = await queue.take()
    landed.set(0, element.format())

@timeout(10000)
test "an interrupted future whose cancel handed back an error takes the interrupt" =
    let landed = Array<String>.fill(3, "nothing")
    racedErrorProgram(landed).run()
    // The interrupt superseded the typed error at the future, as it supersedes a
    // typed failure at every mask pop: the recovery never ran.
    assert landed.get(0) == "nothing"
    assert landed.get(1) == "unwound"
    // And the element is still in the queue. The runtime used to resume the
    // fiber with the error AND a pending interrupt but nothing carried; the
    // recovery then dequeued the element inside `take`'s mask, and the mask's
    // pop — reading the pending interrupt as one this region had deferred —
    // paid it instead of exposing the element, which reached nobody.
    assert landed.get(2) == "42"

async function racedErrorProgram(landed: Array<String>): Async<Unit, Never> =
    let queue = await Queue<Int32>.make(1i32)
    await queue.offer(42i32)
    let reader: Fiber<Unit, Never> =
        await recoverThenTake(failingRacedFuture(idleWaitable()), queue, landed).fork()
    await Async<Unit, Never>.sleep(Duration.ofMillis(50i64))
    await reader.interrupt()
    await joinOutcome(reader, landed)
    let remaining = await queue.take().timeout(Duration.ofMillis(200i64))
    match remaining with
        case Some(element) => landed.set(2, element.format())
        case None => landed.set(2, "lost")

