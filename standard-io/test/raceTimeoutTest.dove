package test

import standard.io.Async
import standard.io.Cause
import standard.io.Fiber
import standard.io.Resource
import standard.time.Duration

// `Async.race` and `Async.timeout`. The contract under test is as much about
// the LOSER as the winner: the loser is interrupted, and the race does not
// return until the loser has finished unwinding — so anything it holds (a
// `use`-block resource, a bracket) is released BEFORE the racing caller
// proceeds. Every ordering claim is asserted through a stamped sequence
// number, not a flag alone, so a release that runs late fails the assertion
// instead of passing by coincidence. Timeouts on every test: a broken scope
// shows up as a hang.
enum RaceTestError =
    Boom

implement Display for RaceTestError =
    public function format(self: RaceTestError): String = "boom"

/// Stamp the next sequence number into `seq[slot]`. `seq[0]` is the counter.
function stampNow(seq: Array<Int32>, slot: Int32): Unit =
    let next = seq.get(0) + 1i32
    seq.set(0, next)
    seq.set(slot, next)

/// A racer that holds a resource for its whole (long) life: acquires via
/// `use`, then sleeps far past every deadline in this file. Its release
/// stamps `seq[slot]`, so a test can order the release against whatever the
/// caller does after the race returns.
async function holderThatSleeps(seq: Array<Int32>, slot: Int32): Async<Int32, Never> =
    let res: Resource<Int32, Never> =
        Resource
            .make(() => Async.succeed(0i32), (_: Int32) => Async.thunk(() => stampNow(seq, slot)))
    let _held: Int32 = use res
    await Async<Unit, Never>.sleep(Duration.ofMillis(5000i64))
    99i32

// --- the first success wins ---------------------------------------------------
async function slowCompleting(flag: Array<Int32>): Async<Int32, Never> =
    await Async<Unit, Never>.sleep(Duration.ofMillis(5000i64))
    flag.set(0, 1i32)
    2i32

async function valueWinsProgram(outcome: Array<Int32>, flag: Array<Int32>): Async<Unit, Never> =
    let fast: Async<Int32, Never> =
        Async<Unit, Never>.sleep(Duration.ofMillis(10i64)).map((_: Unit) => 1i32)
    outcome.set(0, await fast.race(slowCompleting(flag)))

@timeout(10000)
 test "race: the first success wins and the loser is interrupted" =
    let outcome = Array<Int32>.fill(1, 0i32)
    let flag = Array<Int32>.fill(1, 0i32)
    valueWinsProgram(outcome, flag).run()
    assert outcome.get(0) == 1i32
    // The loser never reached the line after its sleep: it was interrupted,
    // not waited for. (A race that waited for it would also take five seconds,
    // but this asserts the interruption rather than timing.)
    assert flag.get(0) == 0i32

// --- the first FAILURE also wins ----------------------------------------------
async function failSoon(): Async<Int32, RaceTestError> =
    await Async<Unit, Never>.sleep(Duration.ofMillis(10i64))
    await Async<Int32, RaceTestError>.fail(RaceTestError.Boom)

async function slowSucceed(): Async<Int32, RaceTestError> =
    await Async<Unit, Never>.sleep(Duration.ofMillis(5000i64))
    9i32

async function failureWinsProgram(outcome: Array<Int32>): Async<Unit, Never> =
    let raced: Async<Int32, RaceTestError> = failSoon().race(slowSucceed())
    outcome
        .set(
        0,
        await raced
            .fold<Int32, Never>(
            (_: RaceTestError) => Async.succeed(1i32),
            (_: Int32) => Async.succeed(2i32)
        )
    )

@timeout(10000)
 test "race: the first failure decides the race with that failure" =
    let outcome = Array<Int32>.fill(1, 0i32)
    failureWinsProgram(outcome).run()
    // A completion is a completion: the racer that FAILED first won the race,
    // and the race failed with its error — the slow success never got a say.
    assert outcome.get(0) == 1i32

// --- a panic in a racer propagates as a panic ---------------------------------
async function panicSoon(): Async<Int32, Never> =
    await Async<Unit, Never>.sleep(Duration.ofMillis(10i64))
    await Async<Int32, Never>.failPanic("racer blew up")

async function slowQuietly(): Async<Int32, Never> =
    await Async<Unit, Never>.sleep(Duration.ofMillis(5000i64))
    3i32

function recordPanicked(cause: Cause<Never>, outcome: Array<Int32>): Async<Unit, Never> =
    match cause with
        case Cause.Panicked(_, _) => Async.thunk(() => outcome.set(0, 1i32))
        case _ => Async.thunk(() => outcome.set(0, 3i32))

async function panicWinsProgram(outcome: Array<Int32>): Async<Unit, Never> =
    let raced: Async<Int32, Never> = panicSoon().race(slowQuietly())
    await raced
        .foldCause<Unit, Never>(
        (cause: Cause<Never>) => recordPanicked(cause, outcome),
        (_: Int32) => Async.thunk(() => outcome.set(0, 2i32))
    )

@timeout(10000)
 test "race: a panic in a racer propagates as a panic, not a value" =
    let outcome = Array<Int32>.fill(1, 0i32)
    panicWinsProgram(outcome).run()
    // The defect travelled through the shared promise as a full `Cause` and
    // came out of the race as `Cause.Panicked` — catchable only by `foldCause`,
    // exactly like a panic in un-raced code.
    assert outcome.get(0) == 1i32

// --- the loser's resource is released before the race returns -------------------
async function loserReleaseProgram(outcome: Array<Int32>, seq: Array<Int32>): Async<Unit, Never> =
    let fast: Async<Int32, Never> =
        Async<Unit, Never>.sleep(Duration.ofMillis(10i64)).map((_: Unit) => 5i32)
    outcome.set(0, await fast.race(holderThatSleeps(seq, 1i32)))
    // Runs strictly after `race` returned — the ordering witness.
    stampNow(seq, 2i32)

@timeout(10000)
 test "race: the losing racer's resource is released before race returns" =
    let outcome = Array<Int32>.fill(1, 0i32)
    let seq = Array<Int32>.fill(3, 0i32)
    loserReleaseProgram(outcome, seq).run()
    assert outcome.get(0) == 5i32
    // The release RAN…
    assert seq.get(1) != 0i32
    // …and it ran BEFORE the statement after the race: the scope waited for
    // the interrupted loser to unwind, finalizer included, before returning.
    assert seq.get(1) < seq.get(2)

// --- a PANIC in the loser's finalizer is not swallowed by the winner ----------
//
// The winner completes with a value; the loser is interrupted and unwinds its
// `use` release, which PANICS. That defect must not vanish behind the winner —
// it supersedes the winner's value and comes out of the race as `Cause.Panicked`
// (see `decideRace`). Without that, `foldCause`'s SUCCESS arm would run on the
// winner's `1` and the panic would be silently lost.
async function loserPanicsOnRelease(): Async<Int32, Never> =
    let res: Resource<Int32, Never> =
        Resource
            .make(
            () => Async.succeed(0i32),
            (_: Int32) => Async<Unit, Never>.failPanic("loser finalizer blew up")
        )
    let _held: Int32 = use res
    await Async<Unit, Never>.sleep(Duration.ofMillis(5000i64))
    99i32

async function loserPanicWinsProgram(outcome: Array<Int32>): Async<Unit, Never> =
    let fast: Async<Int32, Never> =
        Async<Unit, Never>.sleep(Duration.ofMillis(10i64)).map((_: Unit) => 1i32)
    let raced: Async<Int32, Never> = fast.race(loserPanicsOnRelease())
    await raced
        .foldCause<Unit, Never>(
        (cause: Cause<Never>) => recordPanicked(cause, outcome),
        (_: Int32) => Async.thunk(() => outcome.set(0, 2i32))
    )

@timeout(10000)
 test "race: a panic in the LOSER's finalizer supersedes the winner" =
    let outcome = Array<Int32>.fill(1, 0i32)
    loserPanicWinsProgram(outcome).run()
    // `recordPanicked` writes 1 on `Cause.Panicked`; the success arm would have
    // written 2 (the winner's value came through instead of the defect).
    assert outcome.get(0) == 1i32

// --- a race inside a `use` block: scope nesting stays LIFO ---------------------
async function raceInsideUseProgram(outcome: Array<Int32>, seq: Array<Int32>): Async<Unit, Never> =
    let blockRes: Resource<Int32, Never> =
        Resource
            .make(() => Async.succeed(1i32), (_: Int32) => Async.thunk(() => stampNow(seq, 3i32)))
    let _outer: Int32 = use blockRes
    let fast: Async<Int32, Never> =
        Async<Unit, Never>.sleep(Duration.ofMillis(10i64)).map((_: Unit) => 5i32)
    outcome.set(0, await fast.race(holderThatSleeps(seq, 1i32)))
    stampNow(seq, 2i32)

@timeout(10000)
 test "race: inside a use block the loser's release precedes the block's" =
    let outcome = Array<Int32>.fill(1, 0i32)
    let seq = Array<Int32>.fill(4, 0i32)
    raceInsideUseProgram(outcome, seq).run()
    assert outcome.get(0) == 5i32
    // The race's own scope closed first: the loser's release ran before the
    // statement after the race…
    assert seq.get(1) != 0i32
    assert seq.get(1) < seq.get(2)
    // …and the ENCLOSING `use` block's release ran after that — the race scope
    // nests inside the block scope, LIFO, not alongside it.
    assert seq.get(2) < seq.get(3)

// --- interrupting the race interrupts both racers -----------------------------
async function interruptedRaceProgram(outcome: Array<Int32>, seq: Array<Int32>):
    Async<Unit, Never> =
    let racing: Fiber<Int32, Never> =
        await holderThatSleeps(seq, 1i32).race(holderThatSleeps(seq, 2i32)).fork()
    // Long enough for both racers to be parked in their sleeps.
    await Async<Unit, Never>.sleep(Duration.ofMillis(50i64))
    await racing.interrupt()
    await racing
        .join()
        .foldCause<Unit, Never>(
        (_: Cause<Never>) => Async.thunk(() => outcome.set(0, 1i32)),
        (_: Int32) => Async.thunk(() => outcome.set(0, 2i32))
    )
    stampNow(seq, 3i32)

@timeout(10000)
 test "race: interrupting the racing fiber interrupts both racers" =
    let outcome = Array<Int32>.fill(1, 0i32)
    let seq = Array<Int32>.fill(4, 0i32)
    interruptedRaceProgram(outcome, seq).run()
    // The race fiber unwound with a cause (the interruption), not a value.
    assert outcome.get(0) == 1i32
    // Both racers' releases ran — the abnormal close tore both down…
    assert seq.get(1) != 0i32
    assert seq.get(2) != 0i32
    // …and both had finished unwinding by the time the join returned.
    assert seq.get(1) < seq.get(3)
    assert seq.get(2) < seq.get(3)

// --- timeout: the timer wins --------------------------------------------------
async function timerWinsProgram(outcome: Array<Int32>, seq: Array<Int32>): Async<Unit, Never> =
    let winner: Option<Int32> = await holderThatSleeps(seq, 1i32).timeout(Duration.ofMillis(20i64))
    stampNow(seq, 2i32)
    match winner with
        case Some(_) => outcome.set(0, 1i32)
        case None => outcome.set(0, 2i32)

@timeout(10000)
 test "timeout: the timer wins with None and the slow side is torn down first" =
    let outcome = Array<Int32>.fill(1, 0i32)
    let seq = Array<Int32>.fill(3, 0i32)
    timerWinsProgram(outcome, seq).run()
    // None, not a value: the deadline decided.
    assert outcome.get(0) == 2i32
    // The interrupted computation's `use`-block release ran, and ran before
    // `timeout` returned to the caller.
    assert seq.get(1) != 0i32
    assert seq.get(1) < seq.get(2)

// --- timeout: self wins -------------------------------------------------------
async function selfWinsProgram(outcome: Array<Int32>): Async<Unit, Never> =
    let fast: Async<Int32, Never> =
        Async<Unit, Never>.sleep(Duration.ofMillis(10i64)).map((_: Unit) => 42i32)
    let winner: Option<Int32> = await fast.timeout(Duration.ofMillis(5000i64))
    match winner with
        case Some(v) => outcome.set(0, v)
        case None => outcome.set(0, -1i32)

@timeout(10000)
 test "timeout: a completion before the deadline is Some(value)" =
    let outcome = Array<Int32>.fill(1, 0i32)
    selfWinsProgram(outcome).run()
    assert outcome.get(0) == 42i32

// --- timeout: a failure before the deadline stays a failure --------------------
async function failureBeatsTimerProgram(outcome: Array<Int32>): Async<Unit, Never> =
    let timed: Async<Option<Int32>, RaceTestError> = failSoon().timeout(Duration.ofMillis(5000i64))
    outcome
        .set(
        0,
        await timed
            .fold<Int32, Never>(
            (_: RaceTestError) => Async.succeed(1i32),
            (_: Option<Int32>) => Async.succeed(2i32)
        )
    )

@timeout(10000)
 test "timeout: a failure before the deadline propagates, not None" =
    let outcome = Array<Int32>.fill(1, 0i32)
    failureBeatsTimerProgram(outcome).run()
    // A timeout is about lateness. An answer that arrived broken ARRIVED —
    // reporting it as `None` would launder the failure into a deadline.
    assert outcome.get(0) == 1i32
