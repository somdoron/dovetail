package test

import standard.io.Async

// =============================================================================
// Desugar await stress tests. Each test exercises a different combination of
// await positions, branching constructs, loops, and sequencing. All tests
// observe side effects via captured mutable state since `program.run()`
// returns Unit.
// =============================================================================
// --- Group A: Plain (no await) sanity ---
test "plain while loop (no await) — Phase 3 must not apply" =
    let mutable acc: Int32 = 0
    plainWhileSync((n: Int32) => acc = acc + n)
    assert acc == 10 // 1+2+3+4

function plainWhileSync(cb: (Int32) => Unit): Unit =
    let mutable i: Int32 = 1
    while i < 5 do
        cb(i)
        i = i + 1

test "plain if/else (no await) inside async function" =
    let mutable result: Int32 = 0
    plainIfElseProgram(true, (n: Int32) => result = n).run()
    assert result == 1
    let mutable result2: Int32 = 0
    plainIfElseProgram(false, (n: Int32) => result2 = n).run()
    assert result2 == 2

async function plainIfElseProgram(cond: Bool, setter: (Int32) => Unit): Async<Unit, Never> =
    if cond then setter(1) else setter(2)

// --- Group B: if/else with await ---
test "B1: tail if/else with await in then-branch only" =
    let mutable seen: Int32 = 0
    ifAwaitThen(true, (n: Int32) => seen = n).run()
    assert seen == 100
    ifAwaitThen(false, (n: Int32) => seen = n).run()
    assert seen == 7

async function ifAwaitThen(cond: Bool, setter: (Int32) => Unit): Async<Unit, Never> =
    if cond then
        let v: Int32 = await Async.succeed(100)
        setter(v)
    else
        setter(7)

test "B2: tail if/else with await in both branches" =
    let mutable seen: Int32 = 0
    ifAwaitBoth(true, (n: Int32) => seen = n).run()
    assert seen == 50
    ifAwaitBoth(false, (n: Int32) => seen = n).run()
    assert seen == 99

async function ifAwaitBoth(cond: Bool, setter: (Int32) => Unit): Async<Unit, Never> =
    if cond then
        let a: Int32 = await Async.succeed(50)
        setter(a)
    else
        let b: Int32 = await Async.succeed(99)
        setter(b)

test "B3: if without else, await in then-branch" =
    let mutable seen: Int32 = -1
    ifAwaitNoElse(true, (n: Int32) => seen = n).run()
    assert seen == 42
    let mutable seen2: Int32 = -1
    ifAwaitNoElse(false, (n: Int32) => seen2 = n).run()
    assert seen2 == -1 // closure not invoked

async function ifAwaitNoElse(cond: Bool, setter: (Int32) => Unit): Async<Unit, Never> =
    if cond then
        let v: Int32 = await Async.succeed(42)
        setter(v)

test "B4: nested if/else, await in inner else" =
    let mutable seen: Int32 = 0
    nestedIfAwait(true, true, (n: Int32) => seen = n).run()
    assert seen == 11
    nestedIfAwait(true, false, (n: Int32) => seen = n).run()
    assert seen == 22
    nestedIfAwait(false, true, (n: Int32) => seen = n).run()
    assert seen == 33

async function nestedIfAwait(a: Bool, b: Bool, setter: (Int32) => Unit): Async<Unit, Never> =
    if a then
        if b then
            let x: Int32 = await Async.succeed(11)
            setter(x)
        else
            setter(22)
    else
        setter(33)

test "B5: let x = if cond then await ... else ... (Phase 2 lift)" =
    let mutable result: Int32 = 0
    letIfAwait(true, (n: Int32) => result = n).run()
    assert result == 5
    letIfAwait(false, (n: Int32) => result = n).run()
    assert result == 13

async function letIfAwait(cond: Bool, setter: (Int32) => Unit): Async<Unit, Never> =
    let x: Int32 = if cond then await Async.succeed(5) else 13
    setter(x)

test "B6: let x = if cond then await foo else await bar (Phase 2, await in both)" =
    let mutable result: Int32 = 0
    letIfAwaitBoth(true, (n: Int32) => result = n).run()
    assert result == 77
    letIfAwaitBoth(false, (n: Int32) => result = n).run()
    assert result == 88

async function letIfAwaitBoth(cond: Bool, setter: (Int32) => Unit): Async<Unit, Never> =
    let x: Int32 = if cond then await Async.succeed(77) else await Async.succeed(88)
    setter(x)

// --- Group C: match with await ---
test "C1: tail match with await in one arm" =
    let mutable seen: Int32 = 0
    matchAwaitOneArm(true, (n: Int32) => seen = n).run()
    assert seen == 100
    matchAwaitOneArm(false, (n: Int32) => seen = n).run()
    assert seen == 200

async function matchAwaitOneArm(flag: Bool, setter: (Int32) => Unit): Async<Unit, Never> =
    match flag with
        case true =>
            let v: Int32 = await Async.succeed(100)
            setter(v)
        case false => setter(200)

test "C2: tail match on enum with await in arm" =
    let mutable seen: Int32 = 0
    let okResult: Result<Int32, String> = Ok(42)
    matchResultAwait(okResult, (n: Int32) => seen = n).run()
    assert seen == 84
    let errResult: Result<Int32, String> = Error("bad")
    matchResultAwait(errResult, (n: Int32) => seen = n).run()
    assert seen == -1

async function matchResultAwait(r: Result<Int32, String>, setter: (Int32) => Unit):
    Async<Unit, Never> =
    match r with
        case Ok(v) =>
            let doubled: Int32 = await Async.succeed(v * 2)
            setter(doubled)
        case Error(_) => setter(-1)

test "C3: let x = match ... case A => await ... (Phase 2 lift)" =
    let mutable result: Int32 = 0
    letMatchAwait(true, (n: Int32) => result = n).run()
    assert result == 333
    letMatchAwait(false, (n: Int32) => result = n).run()
    assert result == 444

async function letMatchAwait(flag: Bool, setter: (Int32) => Unit): Async<Unit, Never> =
    let x: Int32 =
        match flag with
            case true => await Async.succeed(333)
            case false => 444
    setter(x)

// --- Group D: while with await ---
test "D1: while with await, mutable counter" =
    let mutable counter: Int32 = 0
    whileAwaitCounter(5, () => counter, (n: Int32) => counter = n).run()
    assert counter == 5

async function whileAwaitCounter(target: Int32, getCount: () => Int32, setCount: (Int32) => Unit):
    Async<Unit, Never> =
    while getCount() < target do
        let _ = await Async.succeed(0)
        setCount(getCount() + 1)

test "D2: while with await — zero iterations" =
    let mutable touched: Int32 = 0
    let mutable reached: Bool = false
    whileNoIterations(() => touched = touched + 1, () => reached = true).run()
    assert touched == 0
    // The program ran; the loop body did not. Without the second assertion this
    // is an assertion that a counter still holds the value it was built with.
    assert reached

async function whileNoIterations(touch: () => Unit, done: () => Unit): Async<Unit, Never> =
    let mutable n: Int32 = 0
    while n > 0 do
        let _ = await Async.succeed(0)
        touch()
        n = n - 1
    done()

test "D3: while with multiple awaits per iteration" =
    let mutable sum: Int32 = 0
    multipleAwaitsInWhile(() => sum, (n: Int32) => sum = n).run()
    // i=0: a=1, b=2 → sum=3
    // i=1: a=2, b=3 → sum=8
    // i=2: a=3, b=4 → sum=15
    assert sum == 15

async function multipleAwaitsInWhile(getSum: () => Int32, setSum: (Int32) => Unit):
    Async<Unit, Never> =
    let mutable i: Int32 = 0
    while i < 3 do
        let a: Int32 = await Async.succeed(i + 1)
        let b: Int32 = await Async.succeed(i + 2)
        setSum(getSum() + a + b)
        i = i + 1

// --- Group E: composition (most stress-prone) ---
test "E1: if/else inside while body, await in branches" =
    let mutable evenSum: Int32 = 0
    let mutable oddSum: Int32 = 0
    ifInsideWhile(() => evenSum, (n: Int32) => evenSum = n, () => oddSum, (n: Int32) => oddSum = n)
        .run()
    // i=0 (even) → evenSum += 0
    // i=1 (odd) → oddSum += 1
    // i=2 (even) → evenSum += 2
    // i=3 (odd) → oddSum += 3
    // i=4 (even) → evenSum += 4
    assert evenSum == 6
    assert oddSum == 4

async function ifInsideWhile(
    getEven: () => Int32,
    setEven: (Int32) => Unit,
    getOdd: () => Int32,
    setOdd: (Int32) => Unit
): Async<Unit, Never> =
    let mutable i: Int32 = 0
    while i < 5 do
        if i % 2 == 0 then
            let v: Int32 = await Async.succeed(i)
            setEven(getEven() + v)
        else
            let v: Int32 = await Async.succeed(i)
            setOdd(getOdd() + v)
        i = i + 1

test "E2: nested while loops, inner has await, outer does not" =
    let mutable total: Int32 = 0
    nestedWhileInnerAwait(() => total, (n: Int32) => total = n).run()
    // outer i=0: inner sums j=0..2 = 0+1+2 = 3
    // outer i=1: same +3 = 6
    // outer i=2: same +3 = 9
    assert total == 9

async function nestedWhileInnerAwait(getTotal: () => Int32, setTotal: (Int32) => Unit):
    Async<Unit, Never> =
    let mutable outerI: Int32 = 0
    while outerI < 3 do
        let mutable innerJ: Int32 = 0
        while innerJ < 3 do
            let v: Int32 = await Async.succeed(innerJ)
            setTotal(getTotal() + v)
            innerJ = innerJ + 1
        outerI = outerI + 1

test "E3: match inside while body, await in arm" =
    let mutable accumulator: Int32 = 0
    matchInsideWhile(() => accumulator, (n: Int32) => accumulator = n).run()
    // i=0: Ok(0) → accumulator += 0*10 = 0
    // i=1: Error → accumulator -= 1
    // i=2: Ok(2) → accumulator += 20 = 19
    // i=3: Error → accumulator -= 1 = 18
    // i=4: Ok(4) → accumulator += 40 = 58
    assert accumulator == 58

async function matchInsideWhile(getAcc: () => Int32, setAcc: (Int32) => Unit): Async<Unit, Never> =
    let mutable i: Int32 = 0
    while i < 5 do
        let r: Result<Int32, Unit> = if i % 2 == 0 then Ok(i) else Error(())
        match r with
            case Ok(v) =>
                let doubled: Int32 = await Async.succeed(v * 10)
                setAcc(getAcc() + doubled)
            case Error(_) => setAcc(getAcc() - 1)
        i = i + 1

test "E4: while followed by tail await" =
    let mutable counter: Int32 = 0
    let mutable tailResult: Int32 = 0
    whileThenTailAwait(() => counter, (n: Int32) => counter = n, (n: Int32) => tailResult = n).run()
    assert counter == 3
    assert tailResult == 999

async function whileThenTailAwait(
    getCount: () => Int32,
    setCount: (Int32) => Unit,
    setTail: (Int32) => Unit
): Async<Unit, Never> =
    while getCount() < 3 do
        let _ = await Async.succeed(0)
        setCount(getCount() + 1)
    let tailVal: Int32 = await Async.succeed(999)
    setTail(tailVal)

test "E5: await before while" =
    let mutable initial: Int32 = 0
    let mutable counter: Int32 = 0
    awaitBeforeWhile((n: Int32) => initial = n, () => counter, (n: Int32) => counter = n).run()
    assert initial == 7
    assert counter == 3

async function awaitBeforeWhile(
    setInit: (Int32) => Unit,
    getCount: () => Int32,
    setCount: (Int32) => Unit
): Async<Unit, Never> =
    let init: Int32 = await Async.succeed(7)
    setInit(init)
    while getCount() < 3 do
        let _ = await Async.succeed(0)
        setCount(getCount() + 1)

test "E6: while with let-binding-of-await result used in if inside body" =
    let mutable bigCount: Int32 = 0
    let mutable smallCount: Int32 = 0
    whileLetIfAwait(
        () => bigCount,
        (n: Int32) => bigCount = n,
        () => smallCount,
        (n: Int32) => smallCount = n
    )
        .run()
    // i=0..4: chunk = i, big if chunk>=2 else small
    // big: i=2,3,4 → 3 times
    // small: i=0,1 → 2 times
    assert bigCount == 3
    assert smallCount == 2

async function whileLetIfAwait(
    getBig: () => Int32,
    setBig: (Int32) => Unit,
    getSmall: () => Int32,
    setSmall: (Int32) => Unit
): Async<Unit, Never> =
    let mutable i: Int32 = 0
    while i < 5 do
        let chunk: Int32 = await Async.succeed(i)
        if chunk >= 2 then setBig(getBig() + 1) else setSmall(getSmall() + 1)
        i = i + 1

// --- Group F: await positions (Phase 1 stress) ---
test "F1: await as function-call argument" =
    let mutable result: Int32 = 0
    awaitAsArg((n: Int32) => result = n).run()
    assert result == 30

function double(n: Int32): Int32 = n * 2

async function awaitAsArg(setter: (Int32) => Unit): Async<Unit, Never> =
    setter(double(await Async.succeed(15)))

test "F2: await inside chained method calls" =
    let mutable result: Int32 = 0
    awaitChained((n: Int32) => result = n).run()
    assert result == 100 // (await 10) * 10

async function awaitChained(setter: (Int32) => Unit): Async<Unit, Never> =
    let v: Int32 = (await Async.succeed(10)) * 10
    setter(v)

test "F3: multiple awaits in single binary op" =
    let mutable result: Int32 = 0
    awaitBinaryOp((n: Int32) => result = n).run()
    assert result == 12

async function awaitBinaryOp(setter: (Int32) => Unit): Async<Unit, Never> =
    let s: Int32 = (await Async.succeed(5)) + (await Async.succeed(7))
    setter(s)

// --- Group G: tricky compositions ---
test "G1: while with all paths including await and non-await branches" =
    let mutable total: Int32 = 0
    let mutable skipped: Int32 = 0
    mixedBranchesWhile(
        () => total,
        (n: Int32) => total = n,
        () => skipped,
        (n: Int32) => skipped = n
    )
        .run()
    // i=0 (even): await path → total += 0
    // i=1 (odd): skip path → skipped += 1
    // i=2 (even): await → total += 2
    // i=3 (odd): skip → skipped += 1
    // i=4 (even): await → total += 4
    assert total == 6
    assert skipped == 2

async function mixedBranchesWhile(
    getTotal: () => Int32,
    setTotal: (Int32) => Unit,
    getSkip: () => Int32,
    setSkip: (Int32) => Unit
): Async<Unit, Never> =
    let mutable i: Int32 = 0
    while i < 5 do
        if i % 2 == 0 then
            let v: Int32 = await Async.succeed(i)
            setTotal(getTotal() + v)
        else
            setSkip(getSkip() + 1)
        i = i + 1

test "G2: sequence: await, while-with-await, match-with-await, tail await" =
    let mutable log: Array<Int32> = [||]
    bigSequence(() => log, (a: Array<Int32>) => log = a).run()
    // Steps:
    //  1. await 1 → log [1]
    //  2. while i<3: await i+10 → log [1, 10], [1, 10, 11], [1, 10, 11, 12]
    //  3. match Ok(99): await → log [..., 99]
    //  4. tail await 7 → log [..., 7]
    assert log.length == 6
    assert log.get(0) == 1
    assert log.get(1) == 10
    assert log.get(2) == 11
    assert log.get(3) == 12
    assert log.get(4) == 99
    assert log.get(5) == 7

async function bigSequence(getLog: () => Array<Int32>, setLog: (Array<Int32>) => Unit):
    Async<Unit, Never> =
    let first: Int32 = await Async.succeed(1)
    setLog(getLog().concat(Array<Int32>.fill(1, first)))
    let mutable i: Int32 = 0
    while i < 3 do
        let v: Int32 = await Async.succeed(i + 10)
        setLog(getLog().concat(Array<Int32>.fill(1, v)))
        i = i + 1
    let r: Result<Int32, Unit> = Ok(99)
    match r with
        case Ok(x) =>
            let y: Int32 = await Async.succeed(x)
            setLog(getLog().concat(Array<Int32>.fill(1, y)))
        case Error(_) => setLog(getLog().concat(Array<Int32>.fill(1, -1)))
    let last: Int32 = await Async.succeed(7)
    setLog(getLog().concat(Array<Int32>.fill(1, last)))

test "G3: deeply nested — match arm contains if which contains while-with-await" =
    let mutable result: Int32 = 0
    deepNesting(true, () => result, (n: Int32) => result = n).run()
    assert result == 6 // 1+2+3
    deepNesting(false, () => result, (n: Int32) => result = n).run()
    assert result == -1 // unchanged in the false path? Actually overwritten to -1

async function deepNesting(flag: Bool, getR: () => Int32, setR: (Int32) => Unit):
    Async<Unit, Never> =
    let opt: Option<Bool> = Some(flag)
    match opt with
        case Some(b) =>
            if b then
                let mutable i: Int32 = 1
                while i <= 3 do
                    let v: Int32 = await Async.succeed(i)
                    setR(getR() + v)
                    i = i + 1
            else
                setR(-1)
        case None => setR(-99)
