package test

import standard.io.Async
import standard.io.Cause
import standard.io.Fiber
import standard.io.Mutex
import standard.io.MutexError
import standard.io.Promise
import standard.io.ReentrantMutex
import standard.time.Duration

// A mutex is pure runtime bookkeeping — no node here ever touches the host — so
// these tests drive the queue/handoff/reclaim protocol directly. `Async.sleep`
// supplies the one real waitable they need.
//
// The first three tests came from `stream_lock_test.dove`, which drove the same
// protocol through the per-handle stream lock on a synthetic handle. The runtime
// now takes that lock itself, so the behaviours moved here rather than going
// away: the queue, the stale-entry guard and the teardown reclaim are shared.
async function markAfterDelay(mark: () => Unit): Async<Unit, Never> =
    await Async<Unit, Never>.sleep(Duration.ofMillis(150i64))
    mark()

/// Recovering from the interrupt is the whole point: the fiber survives it, so
/// its abandoned entry in the mutex queue outlives the interrupt that abandoned
/// it, and the timer gives the runtime a second waitable to strand it on.
async function sleepThenFinish(finished: Promise<Unit, Never>): Async<Unit, Never> =
    await Async<Unit, Never>.sleep(Duration.ofMillis(300i64))
    await finished.complete(())
    ()

async function holdMutex(
    mutex: ReentrantMutex,
    ready: Promise<Unit, Never>,
    release: Promise<Unit, Never>
): Async<Unit, Never> =
    let _held = use mutex.acquire()
    await ready.complete(())
    await release.awaitPromise()

/// Take the mutex and give it straight back.
async function takeMutexBriefly(mutex: ReentrantMutex): Async<Unit, Never> =
    let _held = use mutex.acquire()
    ()

// ── the handoff skips a waiter that was interrupted and recovered ────────────
async function queueThenRecover(
    mutex: ReentrantMutex,
    queued: Promise<Unit, Never>,
    finished: Promise<Unit, Never>
): Async<Unit, Never> =
    await queued.complete(())
    // Blocks in the acquire because the holder has the mutex; the interrupt
    // lands while this fiber sits in that queue.
    await takeMutexBriefly(mutex)
        .foldCause((_: Cause<Never>) => sleepThenFinish(finished), (_: Unit) => Async.succeed(()))

async function staleQueueEntryProgram(mark: () => Unit, note: () => Unit): Async<Unit, Never> =
    let mutex: ReentrantMutex = await ReentrantMutex.make()
    let ready: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let release: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let queued: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let finished: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let holder: Fiber<Unit, Never> = await holdMutex(mutex, ready, release).fork()
    await ready.awaitPromise()
    let waiter: Fiber<Unit, Never> = await queueThenRecover(mutex, queued, finished).fork()
    // The waiter signals `queued` and runs straight on to the acquire without
    // parking in between, so by the time this fiber is scheduled again the
    // waiter is sitting in the mutex queue.
    await queued.awaitPromise()
    await waiter.interrupt()
    // Releasing hands the mutex on: the waiter's abandoned queue entry must be
    // skipped rather than resuming it out of its 300ms timer.
    await release.complete(())
    let marker: Fiber<Unit, Never> = await markAfterDelay(mark).fork()
    await finished.awaitPromise()
    note()
    await holder.join()
    await marker.join()

@timeout(20000)
 test "Runtime: a mutex handoff skips a waiter that was interrupted and recovered" =
    let mutable marked = false
    let mutable finishedAfterMark = false
    let mark: () => Unit = () => marked = true
    let note: () => Unit = () => finishedAfterMark = marked
    staleQueueEntryProgram(mark, note).run()
    // Without the `awaitingMutex` check the handoff resumes the recovered waiter
    // immediately, so it finishes long before the 150ms marker.
    assert finishedAfterMark

// ── the ordinary path still works ───────────────────────────────────────────
async function takeMutexAndFinish(
    mutex: ReentrantMutex,
    queued: Promise<Unit, Never>,
    finished: Promise<Unit, Never>
): Async<Unit, Never> =
    await queued.complete(())
    let _held = use mutex.acquire()
    await finished.complete(())
    ()

async function handOffProgram(): Async<Unit, Never> =
    let mutex: ReentrantMutex = await ReentrantMutex.make()
    let ready: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let release: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let queued: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let finished: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let holder: Fiber<Unit, Never> = await holdMutex(mutex, ready, release).fork()
    await ready.awaitPromise()
    let waiter: Fiber<Unit, Never> = await takeMutexAndFinish(mutex, queued, finished).fork()
    await queued.awaitPromise()
    await release.complete(())
    await finished.awaitPromise()
    await holder.join()
    await waiter.join()

@timeout(20000)
 test "Runtime: a mutex handoff still resumes a waiter that is genuinely queued" =
    let mutable ran = false
    handOffProgram().map((_: Unit) => ran = true).run()
    assert ran

// ── a mutex granted to a fiber that then dies is not stranded ───────────────
//
// A mutex is TAKEN one step before its bracket's release frame is installed: the
// acquire node hands the fiber `Succeed(())` and the frame goes on at the fiber's
// next step. An interrupt landing in that window overwrites the `Succeed(())`
// with a failure, so the still-pending `BracketAcquireFrame` reads it as "acquire
// failed — nothing to release" and `ReleaseMutex` never runs. The mutex would
// then be held by a fiber that no longer exists and every later user of it would
// queue behind that forever. `releaseHeldMutexes` is the backstop.
//
// The window is hit deterministically by ordering the run queue: main wakes the
// holder and the interrupter in that order, so the holder's release grants the
// mutex to the waiter (appending it to the queue) while the interrupter is still
// ahead of it — and the interrupt lands before the waiter takes a step.
async function grantedThenInterrupted(
    mutex: ReentrantMutex,
    queued: Promise<Unit, Never>,
    tookMutex: Promise<Unit, Never>
): Async<Unit, Never> =
    await queued.complete(())
    let _held = use mutex.acquire()
    await tookMutex.complete(())
    ()

async function interruptOnWake(
    parked: Promise<Unit, Never>,
    wake: Promise<Unit, Never>,
    target: Fiber<Unit, Never>
): Async<Unit, Never> =
    await parked.complete(())
    await wake.awaitPromise()
    await target.interrupt()

async function laterUserOfMutex(mutex: ReentrantMutex, finished: Promise<Unit, Never>):
    Async<Unit, Never> =
    let _held = use mutex.acquire()
    await finished.complete(())
    ()

async function interruptedGranteeProgram(): Async<Unit, Never> =
    let mutex: ReentrantMutex = await ReentrantMutex.make()
    let ready: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let release: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let queued: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let tookMutex: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let wake: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let parked: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let finished: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let holder: Fiber<Unit, Never> = await holdMutex(mutex, ready, release).fork()
    await ready.awaitPromise()
    let grantee: Fiber<Unit, Never> = await grantedThenInterrupted(mutex, queued, tookMutex).fork()
    await queued.awaitPromise()
    let interrupter: Fiber<Unit, Never> = await interruptOnWake(parked, wake, grantee).fork()
    // Let the interrupter reach its `wake` park before anything is woken, so
    // waking it puts it straight on the run queue in a known position.
    await parked.awaitPromise()
    // Run queue after this step: [holder, interrupter]. The holder releases and
    // grants the mutex to the grantee, appending it behind the interrupter.
    await release.complete(())
    await wake.complete(())
    await holder.join()
    await interrupter.join()
    // The grantee never got to install its release frame, so nothing it does
    // will hand the mutex on. Somebody must, or this fiber waits forever.
    let later: Fiber<Unit, Never> = await laterUserOfMutex(mutex, finished).fork()
    await finished.awaitPromise()
    await later.join()

@timeout(20000)
 test "Runtime: a mutex granted to a fiber interrupted before its next step is not stranded" =
    let mutable ran = false
    interruptedGranteeProgram().map((_: Unit) => ran = true).run()
    assert ran

// ── the difference between the two mutex types ──────────────────────────────
function isAlreadyHeld(cause: Cause<MutexError>): Bool =
    match cause with
        case Cause.Failed(error, _) =>
            match error with
                case MutexError.AlreadyHeld => true
        case _ => false

async function acquireOnce(mutex: Mutex): Async<Unit, MutexError> =
    let _held = use mutex.acquire()
    ()

async function acquireTwice(mutex: Mutex): Async<Unit, MutexError> =
    let _outer = use mutex.acquire()
    let _inner = use mutex.acquire()
    ()

async function selfAcquireProgram(): Async<(Bool, Bool), Never> =
    let mutex: Mutex = await Mutex.make()
    let reported: Bool =
        await acquireTwice(mutex)
            .foldCause(
            (cause: Cause<MutexError>) => Async.succeed(isAlreadyHeld(cause)),
            (_: Unit) => Async.succeed(false)
        )
    // The outer hold's release still ran on the way out, so the mutex is usable.
    // A `Mutex` that reported the deadlock and then leaked itself would be no
    // better than the deadlock.
    let reusable: Bool =
        await acquireOnce(mutex)
            .foldCause(
            (_: Cause<MutexError>) => Async.succeed(false),
            (_: Unit) => Async.succeed(true)
        )
    (reported, reusable)

@timeout(20000)
 test "Mutex: acquiring one this fiber already holds reports AlreadyHeld instead of hanging" =
    let mutable reported = false
    let mutable reusable = false
    selfAcquireProgram()
        .map(
        (outcome: (Bool, Bool)) =>
            reported = outcome._0
            reusable = outcome._1
    )
        .run()
    assert reported
    assert reusable

// A `ReentrantMutex` nests, and hands off only when the OUTERMOST hold exits.
// The inner `use` block ending must not release it — that is the whole property,
// and it is invisible unless somebody is waiting.
async function nestAndExitInner(
    mutex: ReentrantMutex,
    innerExited: Promise<Unit, Never>,
    release: Promise<Unit, Never>
): Async<Unit, Never> =
    let _outer = use mutex.acquire()
    await takeMutexBriefly(mutex)
    await innerExited.complete(())
    await release.awaitPromise()

async function nestedHoldProgram(mark: () => Unit, note: () => Unit): Async<Unit, Never> =
    let mutex: ReentrantMutex = await ReentrantMutex.make()
    let innerExited: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let release: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let queued: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let took: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let holder: Fiber<Unit, Never> = await nestAndExitInner(mutex, innerExited, release).fork()
    await innerExited.awaitPromise()
    let waiter: Fiber<Unit, Never> = await takeMutexAndFinish(mutex, queued, took).fork()
    await queued.awaitPromise()
    // The inner hold is long gone. If exiting it had handed the mutex on, the
    // waiter would take it now and beat the 150ms marker.
    let marker: Fiber<Unit, Never> = await markAfterDelay(mark).fork()
    await marker.join()
    await release.complete(())
    await took.awaitPromise()
    note()
    await holder.join()
    await waiter.join()

@timeout(20000)
 test "ReentrantMutex: a nested hold releases only when the outermost one exits" =
    let mutable marked = false
    let mutable tookAfterMark = false
    let mark: () => Unit = () => marked = true
    let note: () => Unit = () => tookAfterMark = marked
    nestedHoldProgram(mark, note).run()
    assert tookAfterMark

// `acquire` is a `Resource`, so `use` gives it a bracket — and every bracket is a
// fiber scope. Fibers forked while holding a mutex are therefore finalized before
// it is released, for the same reason a resource is never released under a fiber
// still using it.
async function forkInsideHold(mutex: ReentrantMutex, mark: () => Unit): Async<Unit, Never> =
    let _held = use mutex.acquire()
    let child: Fiber<Unit, Never> = await markAfterDelay(mark).fork()
    ()

async function forkInsideHoldProgram(mark: () => Unit, note: () => Unit): Async<Unit, Never> =
    let mutex: ReentrantMutex = await ReentrantMutex.make()
    await forkInsideHold(mutex, mark)
    note()
    ()

@timeout(20000)
 test "Mutex: a fiber forked while holding a mutex is awaited before it is released" =
    let mutable marked = false
    let mutable markedBeforeRelease = false
    let mark: () => Unit = () => marked = true
    let note: () => Unit = () => markedBeforeRelease = marked
    forkInsideHoldProgram(mark, note).run()
    assert markedBeforeRelease
