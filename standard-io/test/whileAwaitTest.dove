package test

import standard.io.Async

// Tests for `await` inside a `while` body. The desugar pass lowers these
// to `Awaitable.whileLoop(cond, body).andThen(_ => rest)` chains.
test "while + await: simple counter sums 1..5" =
    let mutable sum: Int32 = 0
    let program: Async<Unit, Never> = countSumProgram(5, () => sum, (n: Int32) => sum = n)
    program.run()
    assert sum == 15 // 1+2+3+4+5

async function countSumProgram(n: Int32, getSum: () => Int32, setSum: (Int32) => Unit):
    Async<Unit, Never> =
    let mutable i: Int32 = 0
    while i < n do
        let v: Int32 = await Async.succeed(i + 1)
        setSum(getSum() + v)
        i = i + 1

test "while + await: zero iterations leaves state untouched" =
    let mutable touched: Int32 = 0
    let mutable reached: Bool = false
    let program: Async<Unit, Never> =
        zeroIterationsProgram(() => touched = touched + 1, () => reached = true)
    program.run()
    assert touched == 0
    // …and the program ran at all. Asserting only that the counter is still at
    // the value it was built with passes just as well on a program that never
    // started, which is the shape this pair exists to avoid.
    assert reached

async function zeroIterationsProgram(touch: () => Unit, done: () => Unit): Async<Unit, Never> =
    let mutable count: Int32 = 0
    while count > 0 do
        let _ = await Async.succeed(0)
        touch()
        count = count - 1
    done()

test "while + await: multiple awaits per iteration" =
    let mutable sum: Int32 = 0
    let program: Async<Unit, Never> = doubleAwaitsProgram(() => sum, (n: Int32) => sum = n)
    program.run()
    // i=0: a=1, b=2 → sum += 3 → sum=3
    // i=1: a=2, b=3 → sum += 5 → sum=8
    // i=2: a=3, b=4 → sum += 7 → sum=15
    assert sum == 15

async function doubleAwaitsProgram(getSum: () => Int32, setSum: (Int32) => Unit):
    Async<Unit, Never> =
    let mutable i: Int32 = 0
    while i < 3 do
        let a: Int32 = await Async.succeed(i + 1)
        let b: Int32 = await Async.succeed(i + 2)
        setSum(getSum() + a + b)
        i = i + 1

// Regression: a `let mutable` whose initializer is itself an `await`, then
// reassigned from an `await` inside the loop AND read by the loop condition.
// `let mutable x = await e` used to desugar `x` into the andThen continuation's
// (immutable) parameter, dropping the `mutable` flag — so capture analysis never
// boxed it and the in-loop reassignment was invisible across the await
// suspension point. The condition kept seeing the initial value and the loop
// spun forever. The fix rebinds the await result to a fresh temp and
// re-introduces a real `let mutable x = temp` so boxing applies.
test "while + await: mutable initialized from await, reassigned in loop" =
    let mutable result: Int32 = -1
    let program: Async<Unit, Never> = mutableFromAwaitProgram((n: Int32) => result = n)
    program.run()
    assert result == 5

async function mutableFromAwaitProgram(setResult: (Int32) => Unit): Async<Unit, Never> =
    let mutable n: Int32 = await Async.succeed(0)
    let mutable guard: Int32 = 0
    while n < 5 do
        guard = guard + 1
        if guard > 100 then panic "loop did not converge: mutable-from-await reassignment lost"
        n = await Async.succeed(n + 1)
    setResult(n)
