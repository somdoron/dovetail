package standard.io

import standard.collection.MutableStack
import standard.collection.MutableQueue
import standard.collection.MutableMap
import standard.collection.ArrayList
import standard.collection.MutableSet
import standard.wasi.WaitableSet
import standard.wasi.EventPayload
import standard.wasi.ComponentSubtask
import standard.wasi.ComponentStreamRead
import standard.wasi.ComponentStreamWrite
import standard.wasi.CopyOperation
import standard.wasi.CopyResult
import standard.wasi.Stream
import standard.wasi.Waitable
import standard.wasi.SubtaskHandle

enum Frame =
    ProducerCleanupFrame(ProducerState)
    ProducerValueFrame { producer: ProducerState, cleanupFailure: Option<Cause<Any>> }
    ProducerCleanupHandlerFrame
    ProducerRequestFrame(ProducerRequest)
    ProducerShutdownFrame { request: ProducerRequest, originalFailure: Option<Cause<Any>> }
    ProducerAwaitFrame(ProducerRequest)
    MapFrame { transform: (Any) => Any, location: SourceLocation }
    AndThenFrame { continuation: (Any) => Async<Any, Any>, location: SourceLocation }
    FoldFrame { onFailure: (Any) => Async<Any, Any>, onSuccess: (Any) => Async<Any, Any> }
    FoldCauseFrame { onCause: (Cause<Any>) => Async<Any, Any>, onSuccess: (Any) => Async<Any, Any> }
    // Hard masks — the `Uninterruptible`
    // node: release chains and user critical sections — cannot be punched by
    // `Interruptible`. Soft masks — the acquire masks the `Bracket`/`Attach`
    // arms push — can. `wasHard` is what lets the pop keep `hardMaskDepth`
    // balanced on both the success and failure paths.
    UninterruptibleFrame { previousInterruptible: Bool, wasHard: Bool }
    AwaitFrame { signal: Waiter, check: Async<Option<Any>, Any> }
    // Both bracket frames carry the scope this bracket opened and the scope to
    // restore on the way out. `release` receives the resource AND the body's
    // outcome (`Ok(value)` on success, `Error(cause)` on failure/panic/interrupt)
    // — plain `bracket` ignores the outcome; `bracketWithResult` inspects it.
    BracketAcquireFrame { release: (Any, Result<Any, Cause<Any>>) => Async<Unit, Never>, useFn: (Any) => Async<Any, Any>, scope: ScopeId, outerScope: ScopeId }
    BracketReleaseFrame { release: (Any, Result<Any, Cause<Any>>) => Async<Unit, Never>, resource: Any, scope: ScopeId, outerScope: ScopeId }
    // `attachToScope`: registers the finalizer its acquire produced on the scope
    // that was innermost when the `Attach` node ran. One ScopeId, not two —
    // an attach opens no scope, so it restores none.
    AttachAcquireFrame { finalizerOf: (Any) => Finalizer, scope: ScopeId }
    // Closes a scope that acquired nothing of its own: drain, then run the
    // finalizers attached to it, then carry on with the value or cause that
    // reached the frame. `BracketReleaseFrame` without the release.
    ScopeCloseFrame { scope: ScopeId, outerScope: ScopeId }

implement Default for Frame =
    public property default: Frame =
        Frame.MapFrame { transform = (x: Any) => x; location = SourceLocation { file = ""; line = 0; column = 0; functionName = "" } }

public enum FiberResult =
    Succeeded(Any)
    FiberFailed(Cause<Any>)

enum FiberStatus =
    Running
    Suspended
    /// Parked at a scope close, waiting for that scope's fibers to finalize
    /// before the close can finish. What the fiber does next is in the scope
    /// record's `resume`. Deliberately distinct from `Suspended`: every wake
    /// path (`wakeWaiter`, `wakeReadyFiber`, `grantStreamLock`) matches
    /// `Suspended` explicitly, so a draining fiber is inert to all of them.
    Draining(ScopeId)
    Completed

/// How a fiber is attached to the scope that owns it.
enum ChildKind =
    /// `fork`: a normal scope close waits for it; an abnormal one interrupts it.
    Structured
    /// `forkBackground`: any close interrupts it.
    Background

/// What a fiber does once the scope it is draining empties.
enum DrainResume =
    /// A nested scope closed normally — resume the `use` block with its value.
    ResumeValue(Any)
    /// A nested scope closed abnormally — resume into the failure path.
    ResumeCause(Cause<Any>)
    /// A fiber's root scope closed — finalize the fiber with this result.
    FinishFiber(FiberResult)
    /// A race scope whose outcome nobody has decided yet. The first racer to
    /// FINALIZE replaces this with the resume matching its own result — a
    /// success or a failure, whichever completed first — and interrupts its
    /// sibling (`decideRace`). By the time the scope empties the decision is
    /// always in, so this value never reaches `resumeDrain` — unless the race
    /// was interrupted first, in which case `closeScope` overwrote it with the
    /// interruption, the same way an interrupt supersedes a bracket's outcome.
    RaceUndecided

implement Default for DrainResume =
    public property default: DrainResume = DrainResume.ResumeValue(())

/// What a fiber must do after asking to close a scope.
enum ScopeClose =
    /// Children outstanding: the fiber is now `Draining` on the scope, and the
    /// frame that asked must be re-pushed UNCHANGED so the close is re-entered
    /// once the scope empties.
    Draining
    /// The scope is gone from `Runtime.scopes` and the caller now owns what it
    /// left behind: the finalizers `attachToScope` registered on it, most
    /// recent first. Run them before the caller's own release, if it has one.
    /// `List.empty` whenever nothing attached, which is the overwhelmingly common
    /// case and costs nothing.
    ///
    /// Handing the finalizers back in the same breath as the removal is the
    /// point of the type: a close cannot take a scope out of the map and forget
    /// what was owed on it.
    Closed(List<Finalizer>)

/// What one open scope holds: the fibers forked into it, and the finalizers
/// attached to it by `Resource.attachToScope`. Allocated on a scope's FIRST fork
/// or FIRST attachment, so a scope that does neither costs nothing but a missed
/// map lookup.
class ScopeRecord(
    public owner: FiberId,
    public structured: MutableSet<FiberId>,
    public background: MutableSet<FiberId>,
    /// Finalizers attached to this scope, most recent FIRST — the list is
    /// prepend-built, so head-first is already reverse acquisition order and the
    /// close needs no sorting.
    ///
    /// A record now outlives its last child while this is non-empty: a scope
    /// holding a finalizer is live even with nothing forked in it, so `leaveScope`
    /// drops a record only when there is nothing left at all.
    public mutable finalizers: List<Finalizer>,
    /// Only read while `owner` is `Draining` on this scope; stale otherwise.
    public mutable resume: DrainResume,
    /// Set by `Race` when it arms this scope, and never cleared. It is what
    /// tells `decideRace` that a child's DEFECT is the scope's business: a race
    /// owes its caller the loser's panic (F8), an ordinary `use`/root scope owes
    /// its owner nothing a structured child did — that is join-only, §5.4 rule 7.
    public mutable isRace: Bool,
    public mutable producers: List<ProducerState>
) =
    public function make(owner: FiberId): ScopeRecord =
        let structured = MutableSet<FiberId>.new()
        let background = MutableSet<FiberId>.new()
        let finalizers: List<Finalizer> = List.empty
        let resume: DrainResume = DrainResume.ResumeValue(())
        ScopeRecord(owner, structured, background, finalizers, resume, false, [])

    /// No fibers left to wait for — the drain is over. NOT "nothing left at
    /// all": see `isDroppable`. Named apart from the old `isEmpty` on purpose,
    /// so every call site had to be re-read when finalizers arrived.
    public property hasNoChildren(self): Bool =
        self.structured.isEmpty && self.background.isEmpty

    /// Nothing left at all, so the record may be dropped.
    public property isDroppable(self): Bool =
        self.hasNoChildren && self.finalizers.isEmpty && self.producers.isEmpty

implement Default for ScopeRecord =
    public property default: ScopeRecord = ScopeRecord.make(FiberId(0))

class FiberState(
    public id: FiberId,
    public handle: Fiber<Any, Any>,
    public mutable asyncValue: Async<Any, Any>,
    public mutable continuation: MutableStack<Frame>,
    public mutable interruptible: Bool,
    public mutable status: FiberStatus,
    /// Who forked this fiber. Diagnostics only — `Runtime.childScope` is what
    /// links a fiber to the lifetime that owns it.
    public parent: Option<FiberId>,
    /// This fiber's whole body as a scope: what `fork` attaches to outside any
    /// `use`/`bracket` block, and what closes when the body ends.
    public rootScope: ScopeId,
    /// The innermost scope currently open in this fiber — what the next `fork`
    /// attaches to. Saved and restored by the bracket frames.
    public mutable currentScope: ScopeId,
    public joinWaiters: MutableStack<FiberId>,
    public mutable interruptPending: Bool,
    /// Wakes that arrived for a waiter this fiber was registered on while the
    /// fiber was NOT parked on that `Await` — it was running its check, or its
    /// check had suspended on something else. The wake consumed the
    /// registration (`wakeWaiters` pops it), so without a record of it the
    /// fiber would finish its check, trust the stale `None`, and park forever
    /// on a waiter nobody will wake again. The `AwaitFrame` arm consults this
    /// before parking and re-runs the whole `Await` instead. A set keyed by
    /// waiter rather than a flag, so a wake for one wait is never spent
    /// answering another.
    public pendingWakes: MutableSet<Waiter>,
    public registeredWaiters: MutableSet<Waiter>,
    /// Set when this fiber is holding something an interrupt must not destroy, so
    /// that the interrupt waits for a point at which destroying it costs nothing.
    ///
    /// TWO THINGS QUALIFY, and they are the same thing seen from two ends.
    ///
    /// ELEMENTS A RACED CANCEL HANDED BACK. The host had already transferred them,
    /// so cancelling HANDS THEM OVER rather than undoing anything, and only the
    /// fiber's own code knows what they are: an accepted socket has to become a
    /// resource before its release can be armed, and stdin bytes have to reach the
    /// process-wide line buffer they belong to. Interrupting before that strands a
    /// connection nobody will close, or eats input nobody can re-read.
    ///
    /// ITS OWN PROGRAM, for a fiber that has not taken a step. An interrupt
    /// replaces `asyncValue` and unwinds the CONTINUATION, which is exactly right
    /// for a fiber part-way through — its handlers are already frames. A fiber
    /// that has never run has an empty continuation and its handlers still inside
    /// `asyncValue`, so replacing it discards them: `Resource.forkAndUse` builds a
    /// `foldCause` whose failure arm releases the resource the PARENT acquired,
    /// and an interrupt landing on the freshly-enqueued child threw that arm away
    /// with the rest of the program.
    ///
    /// WAITS FOR WHAT, and the two cases answer differently because they are owed
    /// different things.
    ///
    /// The unstarted fiber is owed exactly ONE STEP, paid at the bottom of `step`.
    /// One step is what turns its outermost node into a frame — every combinator
    /// pushes its frame in a single step — and a frame is all the interrupt needs
    /// to unwind through. Not a step more: a fiber that has been interrupted must
    /// not go on to run its body, and deferring to the next park would let one
    /// whose first node happens to resolve immediately finish normally.
    ///
    /// The carried value is owed a SAFE POINT: it has been owned (a bracket armed
    /// its release), or the fiber plainly never will own it — it tries to park
    /// again, or it runs out of continuation. The end of an unrelated masked
    /// region is NOT one: see the `UninterruptibleFrame` arm, which is where a
    /// mutex release on the way out of a read used to eat the bytes that read had
    /// just been handed.
    ///
    /// This is the same hazard `settlePendingAcquire` closes one step later, where
    /// the acquire has already produced its value.
    ///
    /// Set whenever a value the continuation has not consumed yet is EXPOSED:
    /// an element-bearing wake, an `Ok` raced-cancel payload, a sync host
    /// lift, a mutex take, and — the general form — any mask's result leaving
    /// its pop while the fiber is interruptible. Cleared at every safe point,
    /// interrupt or not: the acquire frames (owned), every park (`beginPark`,
    /// the Draining parks), and delivery. Between those points a set flag only
    /// routes an interrupt down the deferred branch, which the next safe point
    /// or the fairness boundary pays — so a stale flag costs latency, never
    /// correctness. What it must never do is survive INTO a mask pop with an
    /// interrupt pending that the pop was meant to pay: that is why parks
    /// clear it and why no NON-element source sets it once an interrupt is
    /// already pending. Element sources (element wakes, sync read/future
    /// lifts, mutex takes) set it regardless — bytes beat the interrupt — and
    /// the pop they defer past is not the one that owed the interrupt.
    public mutable maskedUntilSafePoint: Bool,
    /// Whether this fiber has ever taken a step. Only ever goes false → true, and
    /// only `maskedUntilSafePoint` above reads it.
    public mutable started: Bool,
    public mutable trace: List<SourceLocation>,
    // This fiber's involvement with the one p3 stream/future lock it can be
    // involved with. See `StreamLock`.
    public mutable streamLock: StreamLock,
    // The mutex this fiber is queued behind, if any. Same role as
    // `StreamLock.Awaiting` on the stream side, and the same reason: a queue
    // entry alone does not
    // entitle a fiber to the mutex, because an interrupted fiber can recover and
    // go on to do something else while its entry is still in the queue.
    public mutable awaitingMutex: Option<MutexState>,
    // The mutexes this fiber currently holds. Unlike a stream lock — of which a
    // fiber holds at most one, taken and released inside a single copy — mutexes
    // legitimately nest across different mutexes, so this is a list.
    public mutable heldMutexes: List<MutexState>,
    // The mutex this fiber has just been handed by `grantMutex`, if any. Set at
    // the handoff — the fiber already owns the mutex (`takeMutex` ran) — and
    // consumed when the fiber re-runs the acquire node it parked on. While set,
    // no release frame is armed for the hold, so an interrupt landing in this
    // window must reclaim the mutex itself (`reclaimGrantedMutex`) rather than
    // trust an unwind that has nothing to release. The mutex twin of
    // `StreamLock`'s Awaiting-to-Held grant protocol.
    public mutable grantedMutex: Option<MutexState>,
    /// One-shot: set by the `Yield` node to make `runFiber` end this fiber's
    /// step-run and re-enqueue it behind the other ready fibers. Cleared the
    /// moment `runFiber` acts on it, so it never survives a scheduling turn.
    public mutable yielding: Bool,
    /// How many HARD masks are open: `Uninterruptible` regions — every release
    /// chain the interpreter wraps, and every user critical section. While it is
    /// non-zero, `Interruptible` refuses to re-enable interrupts: the acquire
    /// mask is the only mask it exists to punch, and a finalizer's mask must
    /// hold even across a mutex acquire inside it.
    public mutable hardMaskDepth: Int32
) =
    public function make(id: FiberId, program: Async<Any, Any>, parent: Option<FiberId>,
                        rootScope: ScopeId): FiberState =
        FiberState.make(id, program, parent, rootScope, Fiber<Any, Any>(id))

    public function make(id: FiberId, program: Async<Any, Any>, parent: Option<FiberId>,
                        rootScope: ScopeId, handle: Fiber<Any, Any>): FiberState =
        let continuation = MutableStack<Frame>.new()
        let joinWaiters = MutableStack<FiberId>.new()
        let streamLock: StreamLock = StreamLock.Free
        let awaitingMutex: Option<MutexState> = None
        let heldMutexes: List<MutexState> = List.empty
        let grantedMutex: Option<MutexState> = None
        let pendingWakes = MutableSet<Waiter>.new()
        let registeredWaiters = MutableSet<Waiter>.new()
        FiberState(id, handle, program, continuation, true, FiberStatus.Running,
            parent, rootScope, rootScope, joinWaiters, false, pendingWakes, registeredWaiters,
            false, false, List.empty, streamLock, awaitingMutex, heldMutexes, grantedMutex, false, 0)

    public function hasPendingWake(self, signal: Waiter): Bool =
        self.pendingWakes.contains(signal)

    public function recordWake(self, signal: Waiter): Unit =
        self.pendingWakes.add(signal)

    public function forgetWake(self, signal: Waiter): Unit =
        self.pendingWakes.remove(signal)

    /// Record that this fiber now owns the lock on `waitable`, overwriting the
    /// `Awaiting` it was granted out of if it queued for it.
    public function takeLock(self, waitable: Waitable): Unit =
        self.streamLock = StreamLock.Held(waitable)

    /// Whether this fiber already owns the lock on `waitable`, which for a copy
    /// about to post means a grant put it there.
    public function holdsLock(self, waitable: Waitable): Bool =
        match self.streamLock with
            case Held(held) => held.equals(waitable)
            case _ => false

    /// The lock this fiber owns, if any — what teardown has to hand on.
    public function heldLock(self): Option<Waitable> =
        match self.streamLock with
            case Held(held) => Some(held)
            case _ => None

    /// Give up the lock on `waitable`, reporting whether this fiber held it.
    /// False means somebody has already handed the lock on for us — a fiber
    /// whose lock was reclaimed at teardown, say — and handing it off a second
    /// time would give one stream to two fibers.
    public function dropLock(self, waitable: Waitable): Bool =
        if self.holdsLock(waitable) then
            self.streamLock = StreamLock.Free
            true
        else
            false

    /// Record that this fiber now holds `state`, at depth one.
    public function takeMutex(self, state: MutexState): Unit =
        state.owner = Some(self.id)
        state.depth = 1
        self.heldMutexes = self.heldMutexes.prepend(state)

    /// Whether this fiber is the current holder of `state`.
    public function holdsMutex(self, state: MutexState): Bool =
        match state.owner with
            case Some(holder) => holder.value == self.id.value
            case None => false

    /// Forget a mutex this fiber has finished with. The mutex's own `owner` and
    /// `depth` are cleared by the caller, which is the only thing that knows
    /// whether the outermost hold has exited.
    public function forgetMutex(self, state: MutexState): Unit =
        self.heldMutexes = self.heldMutexes.filter((held: MutexState) => !ClassIdentity.equals(held, state))

    /// Consume the grant `grantMutex` left for this fiber, if it is for exactly
    /// `state`: the re-run of the acquire node it parked on finds the mutex
    /// already its own. Checked BEFORE `holdsMutex` in both acquire arms —
    /// ownership transferred at the grant, so without this the re-run would read
    /// its own grant as `AlreadyHeld` (or nest a level nobody will release).
    public function consumeGrantedMutex(self, state: MutexState): Bool =
        match self.grantedMutex with
        case Some(granted) =>
            if ClassIdentity.equals(granted, state) then
                self.grantedMutex = None
                true
            else
                false
        case None => false

    /// True only while this fiber sits on an acquire for exactly this mutex — the
    /// one state in which a handoff may resume it.
    public function isAwaitingMutex(self, state: MutexState): Bool =
        match self.status with
        case FiberStatus.Suspended =>
            match self.awaitingMutex with
                case Some(pending) => ClassIdentity.equals(pending, state)
                case None => false
        case _ => false

    /// True only while this fiber sits on the node that asked for the lock on
    /// exactly `waitable` — the one state in which a handoff may resume it.
    public function isAwaitingLock(self, waitable: Waitable): Bool =
        match self.status with
        case FiberStatus.Suspended =>
            match self.streamLock with
                case Awaiting(pending) => pending.equals(waitable)
                case _ => false
        case _ => false

implement Default for FiberState =
    public property default: FiberState =
        let id = FiberId(0)
        let program: Async<Any, Any> = Succeed(())
        let parent: Option<FiberId> = None
        FiberState.make(id, program, parent, ScopeId(0))

/// Whether interpreting `node` pushes a frame — the combinators — as opposed
/// to doing its work (or finishing the fiber) in the same step. Host-op arms
/// are leaves here too: they pay a pending interrupt themselves before
/// posting, so pre-delivering to them is equivalent.
function buildsFrame(node: Async<Any, Any>): Bool =
    match node with
        case _p: CreateProducer<Any, Any, Any> => true
        case _p: Pull<Any, Any> => true
        case _p: InterruptProducer<Any, Any> => true
        case _m: Map<Any, Any> => true
        case _a: AndThen<Any, Any> => true
        case _f: Fold<Any, Any> => true
        case _fc: FoldCause<Any, Any> => true
        case _u: Uninterruptible<Any, Any> => true
        case _i: Interruptible<Any, Any> => true
        case _b: Bracket<Any, Any> => true
        case _at: Attach<Any, Any> => true
        case _aw: Await<Any, Any> => true
        case _ => false

/// Run a closing scope's attached finalizers, most recent first — `finalizers`
/// is prepend-built, so head-first is already reverse acquisition order.
///
/// Each finalizer's `Async` is BUILT when its turn comes rather than when the
/// chain is assembled, so a `Switchable`'s finalizer still reads whichever
/// resource is current at the moment it runs.
///
/// Not masked here: every caller wraps this chain AND its own release in one
/// `Uninterruptible`, so an interrupt can no more land between two finalizers
/// than inside one. A finalizer that PANICS does NOT abort the chain: every
/// remaining finalizer still runs — a leaked resource is worse than a lost
/// second panic — and the FIRST cause is re-raised once they have all had
/// their turn.
internal async function runFinalizers(finalizers: List<Finalizer>): Async<Unit, Never> =
    let mutable remaining = finalizers
    let mutable firstCause: Option<Cause<Never>> = None
    while !remaining.isEmpty do
        let finalizer = remaining.head
        let caught = await catchFinalizerCause(finalizer)
        if firstCause.isNone then
            firstCause = caught
        remaining = remaining.tail
    match firstCause with
        case Some(cause) =>
            let reraise: Async<Unit, Never> = FailCause(cause)
            await reraise
        case None => ()

/// Run one finalizer and hand back the cause it failed with instead of letting
/// that cause propagate, so `runFinalizers` can carry on through the rest of
/// the chain. A `Finalizer` is `Async<Unit, Never>` and the chain runs masked,
/// so the only cause reachable here is a panic.
internal function catchFinalizerCause(finalizer: Finalizer): Async<Option<Cause<Never>>, Never> =
    let clean: Option<Cause<Never>> = None
    let onCause = (cause: Cause<Any>) =>
        // Re-tag as `Cause<Never>`: a `Finalizer` is `Async<Unit, Never>`, so
        // whatever it ended with carries no typed payload to preserve, and
        // `Cause` is covariant in `E` — there is nothing to cast.
        let narrowed: Cause<Never> =
            match cause with
                case Cause.Panicked(message, trace) => Cause.Panicked(message, trace)
                case Cause.Interrupted(trace) => Cause.Interrupted(trace)
                case Cause.Failed(_, trace) =>
                    Cause.Panicked("finalizer failed with a typed error, which Finalizer's Never forbids", trace)
        let captured: Async<Any, Any> = Succeed(Some(narrowed))
        captured
    let onSuccess = (_: Any) =>
        let nothing: Async<Any, Any> = Succeed(clean)
        nothing
    let caught: Async<Option<Cause<Never>>, Never> =
        FoldCause<Option<Cause<Never>>, Never>(finalizer(), onCause, onSuccess)
    caught

/// The unwind a closing scope owes: its attached finalizers, then `after` —
/// the bracket release that owns the scope, or a plain `Succeed` when nothing
/// owns it. Wrapped in one `Uninterruptible` by the caller, never here.
///
/// When nothing attached (the common case) this is `after` unchanged, so no
/// existing path grows a node.
///
/// `after` runs even when the finalizer chain ended in a PANIC: the bracket's
/// own resource is owed its release whatever happened to what attached inside
/// it, or a panicking attachment would strand the `use conn = …` that owns
/// the scope. The chain's cause is re-raised once `after` is done, and beats a
/// cause of `after`'s own — first cause wins, exactly as inside the chain.
function unwindChain(finalizers: List<Finalizer>, after: Async<Any, Any>): Async<Any, Any> =
    if finalizers.isEmpty then
        after
    else
        let chain: Async<Any, Any> = runFinalizers(finalizers)
        let onCause = (cause: Cause<Any>) =>
            let reraise = (_: Any) =>
                let first: Async<Any, Any> = FailCause(cause)
                first
            let reraiseCause = (_: Cause<Any>) =>
                let first: Async<Any, Any> = FailCause(cause)
                first
            let afterThenFail: Async<Any, Any> = FoldCause<Any, Any>(after, reraiseCause, reraise)
            afterThenFail
        let onSuccess = (_: Any) => after
        let unwind: Async<Any, Any> = FoldCause<Any, Any>(chain, onCause, onSuccess)
        unwind

/// Lift a completion outcome into the fiber's next `Async`: a value to resume
/// with, or the typed failure the component reported.
function liftOutcome(outcome: Result<Any, Any>): Async<Any, Any> =
    match outcome with
        case Ok(value) =>
            let resumed: Async<Any, Any> = Succeed(value)
            resumed
        case Error(error) =>
            let failed: Async<Any, Any> = FailCause(Cause.Failed(error, emptyTrace()))
            failed

/// Bound a host-reported copy count to `[0, capacity]` before it drives a copy
/// out of a pinned buffer. The canonical ABI guarantees `count <= capacity`, but a
/// buggy/hostile host reporting more would make the lift read past the pinned
/// block (corruption / out-of-bounds), so clamp defensively — cheap, and matching
/// the sign-bit masking's "don't trust a host-assigned magnitude" discipline.
function boundCopyCount(count: Int32, capacity: Int32): Int32 =
    if count < 0 then 0 else if count > capacity then capacity else count

/// A fiber's involvement with the one p3 stream/future lock it can be involved
/// with. Three exclusive states rather than three fields: a lock is taken and
/// released inside a single copy node, and copy nodes do not nest, so a fiber
/// queues for at most one lock and holds at most one.
enum StreamLock =
    Free
    /// Queued behind this waitable's holder. A queue entry alone does not
    /// entitle a fiber to the lock: an interrupted fiber can recover
    /// (`foldCause`) and park again on something else, and its abandoned entry
    /// must not resume it. See `grantStreamLock`.
    Awaiting(Waitable)
    /// Owns the lock on this waitable. Recorded the moment the lock is taken or
    /// granted, not when a release frame is installed: an interrupt landing in
    /// between used to strand the lock forever. See `releaseHeldLocks`.
    Held(Waitable)

/// What kind of host operation a suspension is waiting for, and so which event
/// code may legally wake it.
///
/// The payload word is not self-describing — a subtask event carries a state, a
/// copy event carries `CopyResult | count << 4`, and the two are told apart by
/// the event code alone. Recording what was posted is what lets the code be
/// checked instead of ignored: decoding a subtask state as a copy result would
/// read state 2 (RETURNED) as `Dropped` with a count of 0 and hand a fiber a
/// clean end of stream that never happened.
/// Streams and futures are separate code spaces even though they park through
/// the same primitive and decode their payload the same way — the host reports a
/// future's completion as FUTURE_READ, never as STREAM_READ. Collapsing the two
/// into one `Read` would make the check below accept an event for the wrong
/// waitable kind, which is the one thing it exists to catch.
enum SuspensionKind =
    /// An async import call. Event code 1 (SUBTASK).
    Subtask
    /// A copy from the readable end of a stream. Event code 2 (STREAM_READ).
    Read
    /// A copy into the writable end of a stream. Event code 3 (STREAM_WRITE).
    Write
    /// A copy from the readable end of a future. Event code 4 (FUTURE_READ).
    FutureRead

module SuspensionKind =
    /// The component-model event code this kind is woken by.
    ///
    /// FUTURE_WRITE (5) has no kind because nothing here parks on one: the only
    /// futures the library reads are the streams' one-shot result futures, and
    /// those are read synchronously with cancel-if-blocked, never posted.
    public property eventCode(self): Int32 =
        match self with
            case SuspensionKind.Subtask => 1i32
            case SuspensionKind.Read => 2i32
            case SuspensionKind.Write => 3i32
            case SuspensionKind.FutureRead => 4i32

/// A fiber parked on an external waitable (subtask or stream handle): the
/// continuation to run when its completion event arrives.
public record Suspension =
    fiberId: FiberId
    // Cancel the in-flight host operation and report what it resolved to:
    // whether the cancel LOST ITS RACE — the host had already transferred
    // elements — and the value the parked fiber should resume with either way.
    //
    // One hook rather than a cancel/abandon pair, because there is nothing to
    // abandon. If elements came through, the fiber that asked for them is the
    // only thing that knows what they are (bytes to hand on, a socket to close),
    // so it is resumed with them even when it is being interrupted. If none did,
    // the buffer is empty and lifting it frees it.
    //
    // THE PARAMETER IS WHETHER THE CALLER WILL DELIVER what comes back, and the
    // closure is not allowed to guess: two callers cancel, and only one of them
    // has a fiber left to hand anything to. An interrupt does — that is the
    // losing-cancel case above. A FORCE-CLOSE does not: it detaches the fiber and
    // fails it with the stream's `canceledError`, deliberately, because a fiber
    // whose stream is being taken away must not be handed a short read it would
    // take for a clean end of input. What rides on the difference is not the
    // elements but the stream's ONE-SHOT RESULT FUTURE: settling a cancelled copy
    // that reports the stream `Dropped` reads it, and reading it on a path that
    // then throws the answer away leaves the wrapper believing it is unread — so
    // the `close` that is doing the detaching reads it a second time on its way
    // out, and that traps. See `settleCancelledRead`.
    cancel: (Bool) => (Bool, Result<Any, Any>)
    onEvent: (EventPayload) => Result<Any, Any>
    // Whether the copy that parked here took the per-handle lock. False when it
    // inherited the lock from an enclosing region, which releases it itself, and
    // for a subtask, which has no handle to serialize on. Settling the copy —
    // by completion or by cancel — is what releases it.
    ownsLock: Bool
    // What was posted, and so which event code may wake it. See `deliver`.
    kind: SuspensionKind

implement Default for Suspension =
    public property default: Suspension =
        Suspension {
            fiberId = FiberId(0)
            cancel = (_deliver: Bool) => (false, Ok(()))
            onEvent = (_: EventPayload) => Ok(())
            ownsLock = false
            kind = SuspensionKind.Subtask
        }

public class Runtime(
    public fibers: MutableMap<FiberId, FiberState>,
    runQueue: MutableQueue<FiberId>,
    mutable nextFiberId: FiberId,
    public mainFiber: Fiber<Any, Any>,
    public waitableSet: WaitableSet,
    suspensions: MutableMap<Waitable, Suspension>,
    // Reverse indexes so tearing a fiber down touches only that fiber's
    // registrations instead of scanning every waiter stack and every other
    // fiber's join list (which made each completion O(fibers + waiters)).
    fiberJoinTargets: MutableMap<FiberId, MutableSet<FiberId>>,
    // Which waitables each fiber is parked on. Same purpose as registeredWaiters:
    // tearing a fiber down used to scan the whole `suspensions` map, making
    // every interrupt and every completion O(all parked host ops).
    fiberSuspensions: MutableMap<FiberId, MutableSet<Waitable>>,
    // Per-handle mutex for p3 stream ends: key present = held; the queue holds
    // fibers waiting their turn. See `lockForCopy`.
    streamLocks: MutableMap<Waitable, MutableQueue<FiberId>>,
    // Live scopes only — see `ScopeRecord`. A scope with no children has no
    // entry, which is the overwhelmingly common case.
    scopes: MutableMap<ScopeId, ScopeRecord>,
    // Which scope owns each live fiber. The authority for detaching a fiber
    // when it finalizes; `FiberState.parent` is kept for diagnostics only.
    childScope: MutableMap<FiberId, ScopeId>,
    mutable nextScopeId: ScopeId,
    internal producers: MutableMap<FiberId, ProducerState>,
    internal producerRequests: MutableMap<FiberId, ProducerRequest>
) =
    public function make(program: Async<Any, Any>): Runtime =
        let mainFiber = FiberState.make(FiberId.zero, program, None, ScopeId(0))
        let fibers = MutableMap<FiberId, FiberState>.new()
        fibers.put(mainFiber.id, mainFiber)
        let runQueue = MutableQueue<FiberId>.new()
        runQueue.enqueue(mainFiber.id)
        let waitableSet = WaitableSet.make()
        let suspensions = MutableMap<Waitable, Suspension>.new()
        let fiberJoinTargets = MutableMap<FiberId, MutableSet<FiberId>>.new()
        let fiberSuspensions = MutableMap<FiberId, MutableSet<Waitable>>.new()
        let streamLocks = MutableMap<Waitable, MutableQueue<FiberId>>.new()
        let scopes = MutableMap<ScopeId, ScopeRecord>.new()
        let childScope = MutableMap<FiberId, ScopeId>.new()
        Runtime(fibers, runQueue, mainFiber.id.next, mainFiber.handle, waitableSet, suspensions,
            fiberJoinTargets, fiberSuspensions,
            streamLocks, scopes, childScope, ScopeId(1),
            MutableMap.new(), MutableMap.new())

    function newScopeId(self): ScopeId =
        let id = self.nextScopeId
        self.nextScopeId = ScopeId(id.value + 1)
        id

    /// Open a nested scope in `fiber` and make it the target of its next fork.
    /// No record is allocated — a scope that never forks and never has anything
    /// attached to it costs one counter bump.
    internal function openScope(self, fiber: FiberState): ScopeId =
        let id = self.newScopeId()
        fiber.currentScope = id
        id

    /// Arm a scope's unwind so that NO step leaves it owned by nothing: push the
    /// frame that consumes its result, then the HARD mask frame, and hand the
    /// chain itself to `asyncValue`.
    ///
    /// Wrapping the chain in an `Uninterruptible` NODE instead would park that
    /// node in `asyncValue` for one step with the release frame already popped
    /// and nothing on the stack owning the release — and the fairness boundary
    /// can end the run on exactly that step, where a sibling's interrupt
    /// clobbers the node and the release (and every attached finalizer with
    /// it) never runs. The same reason the acquire mask is a frame push: see
    /// the `Bracket` arm. `after` is a `MapFrame` or `AndThenFrame`; their pops
    /// take a trace entry, so one is prepended here as their arms would.
    function runMaskedUnwind(self, fiber: FiberState, after: Frame, chain: Async<Any, Any>): Unit =
        fiber.continuation.push(after)
        fiber.trace = fiber.trace.prepend(SourceLocation { file = ""; line = 0; column = 0; functionName = "" })
        fiber.continuation.push(Frame.UninterruptibleFrame { previousInterruptible = fiber.interruptible; wasHard = true })
        fiber.interruptible = false
        fiber.hardMaskDepth = fiber.hardMaskDepth + 1
        fiber.asyncValue = chain

    /// The record for `scopeId`, created if this is the first thing that ever
    /// needed one. Only the fiber that owns a scope ever forks into it or
    /// attaches to it, so the owner is known at every call site.
    function scopeRecordFor(self, scopeId: ScopeId, ownerId: FiberId): ScopeRecord =
        match self.scopes.get(scopeId) with
            case Some(existing) => existing
            case None =>
                let fresh = ScopeRecord.make(ownerId)
                self.scopes.put(scopeId, fresh)
                fresh

    /// Register `childId` as a child of `scopeId`. Named apart from
    /// `registerFinalizer` because a scope now holds two different kinds of
    /// thing, and apart from `Resource.attachToScope` because that one attaches
    /// the other kind.
    function attachFiberToScope(self, scopeId: ScopeId, ownerId: FiberId, childId: FiberId, kind: ChildKind): Unit =
        let scopeRecord = self.scopeRecordFor(scopeId, ownerId)
        match kind with
            case ChildKind.Structured => scopeRecord.structured.add(childId)
            case ChildKind.Background => scopeRecord.background.add(childId)
        self.childScope.put(childId, scopeId)

    /// Hand `finalizer` to `scopeId`, to be run when that scope closes.
    ///
    /// Only the fiber that HOLDS a scope open ever attaches to it — `currentScope`
    /// is per-fiber, and a fiber parked draining a scope runs no code — so a
    /// registration can never land on a scope that is already closing.
    function registerFinalizer(self, fiber: FiberState, scopeId: ScopeId, finalizer: Finalizer): Unit =
        let scopeRecord = self.scopeRecordFor(scopeId, fiber.id)
        scopeRecord.finalizers = scopeRecord.finalizers.prepend(finalizer)

    /// Whether `scopeId` has anything attached to it. One map lookup, asked by
    /// `completeFiber` on the way out of every fiber.
    function scopeHasFinalizers(self, scopeId: ScopeId): Bool =
        match self.scopes.get(scopeId) with
            case None => false
            case Some(scopeRecord) => !scopeRecord.finalizers.isEmpty || !scopeRecord.producers.isEmpty

    /// True while the owner of `scopeId` is parked waiting for it to empty.
    function scopeIsDraining(self, scopeId: ScopeId): Bool =
        match self.scopes.get(scopeId) with
        case None => false
        case Some(scopeRecord) =>
            match self.fibers.get(scopeRecord.owner) with
            case None => false
            case Some(owner) =>
                match owner.status with
                case FiberStatus.Draining(waitingOn) => waitingOn.equals(scopeId)
                case _ => false

    internal function createFiber(self, program: Async<Any, Any>, scopeId: ScopeId, ownerId: FiberId,
                         kind: ChildKind): Fiber<Any, Any> =
        self.createFiber(program, scopeId, ownerId, kind, (id: FiberId) => Fiber<Any, Any>(id))

    internal function createFiber(self, program: Async<Any, Any>, scopeId: ScopeId, ownerId: FiberId,
                         kind: ChildKind, makeHandle: (FiberId) => Fiber<Any, Any>): Fiber<Any, Any> =
        let fiberId = self.nextFiberId
        self.nextFiberId = self.nextFiberId.next
        let fiber = FiberState.make(fiberId, program, Some(ownerId), self.newScopeId(), makeHandle(fiberId))
        self.fibers.put(fiberId, fiber)
        self.runQueue.enqueue(fiberId)
        // Read before attaching, or the fiber would see its own arrival.
        let draining = self.scopeIsDraining(scopeId)
        self.attachFiberToScope(scopeId, ownerId, fiberId, kind)
        // Born into a scope that is already closing — reachable when a fiber
        // being interrupted by that very close forks from a finalizer as it
        // unwinds. Attach it, so the close still waits for its teardown, but
        // interrupt it immediately so it never runs a step under a resource
        // that is being released.
        if draining then
            self.interruptFiber(fiber)
        fiber.handle

    /// One step of `fiber`, and the one place a first-step deferral is paid off.
    ///
    /// See `interruptFiber`: an interrupt that arrives before a fiber has run
    /// waits exactly this long, because one step is what it takes for the fiber's
    /// outermost node to become a frame — every combinator pushes its frame in a
    /// single step — and a frame is what an interrupt unwinds into. Not longer:
    /// the fiber must not go on to run its body.
    internal function step(self, fiber: FiberState): Unit =
        let firstStep = !fiber.started
        fiber.started = true
        // The one granted step exists to turn the outermost COMBINATOR into a
        // frame so the unwind runs its handlers. A leaf head has no frame to
        // build and does its work in that very step — a `Thunk` runs its
        // function, a `Fork` creates a fiber, a bare `Succeed` finishes the
        // fiber normally — all of which the deferral's contract forbids. So a
        // leaf-headed fiber owing an interrupt is interrupted BEFORE the step:
        // nothing has been acquired, nothing is owed, and delivery is just the
        // failure path over an empty continuation.
        if firstStep && !buildsFrame(fiber.asyncValue) then
            self.deliverDeferredInterrupt(fiber)
            ()
        self.stepNode(fiber)
        if firstStep then
            match fiber.status with
                case FiberStatus.Running =>
                    if fiber.interruptPending then
                        if !self.deliverDeferredInterrupt(fiber) then
                            // Not delivered: the granted step entered a mask,
                            // and the interrupt will be paid at that mask's pop.
                            // The carried-value flag the deferral set has done
                            // its one job (stopping the Running-arm clobber
                            // before the step) — left set, it would make the
                            // mask pop's gate SKIP the delivery the region's end
                            // promised, and a program masked to its last node
                            // would finish normally with the interrupt lost.
                            fiber.maskedUntilSafePoint = false
                case _ => ()
        else
            ()

    function stepNode(self, fiber: FiberState): Unit =
        match fiber.asyncValue with
        case s: Succeed<Any> =>
            let value = s.value
            match fiber.continuation.pop() with
            case None => self.completeFiber(fiber, FiberResult.Succeeded(value))
            case Some(frame) =>
                match frame with
                case Frame.ProducerCleanupFrame(_) =>
                    fiber.asyncValue = Succeed(value)
                case Frame.ProducerCleanupHandlerFrame =>
                    fiber.asyncValue = Succeed(value)
                case Frame.ProducerValueFrame { producer } =>
                    match producer.phase with
                        case ProducerPhase.Pulling(state) => producer.phase = ProducerPhase.Idle(state)
                        case _ => panic "expected a pulling producer"
                    self.notifyProducer(producer, Succeed(value))
                    fiber.asyncValue = ProducerIdle(producer)
                    self.beginPark(fiber)
                    ()
                case Frame.ProducerRequestFrame(request) =>
                    self.detachProducerRequest(request)
                    self.producerRequests.remove(fiber.id)
                    fiber.asyncValue = Succeed(value)
                case Frame.ProducerAwaitFrame(request) =>
                    self.awaitProducerShutdown(fiber, request)
                case Frame.ProducerShutdownFrame { request, originalFailure = failure } =>
                    self.finishProducerShutdown(fiber, request, failure)
                case Frame.MapFrame { transform = f } =>
                    fiber.trace = fiber.trace.tail
                    let next: Async<Any, Any> = Succeed(f(value))
                    fiber.asyncValue = next
                case Frame.AndThenFrame { continuation = f } =>
                    fiber.trace = fiber.trace.tail
                    fiber.asyncValue = f(value)
                case Frame.FoldFrame { onSuccess } =>
                    fiber.asyncValue = onSuccess(value)
                case Frame.FoldCauseFrame { onSuccess } =>
                    fiber.asyncValue = onSuccess(value)
                case Frame.UninterruptibleFrame { previousInterruptible = previous, wasHard } =>
                    fiber.interruptible = previous
                    if wasHard then
                        fiber.hardMaskDepth = fiber.hardMaskDepth - 1
                    // NOT while the fiber is carrying something (`maskedUntilSafePoint`).
                    // The end of a masked region is a safe point for an interrupt that
                    // was waiting for the region — that is what the region promised —
                    // but it is not one for an interrupt waiting for the fiber to OWN
                    // a value, because the value being carried is the very thing this
                    // arm's `FailCause` throws away. Every read in this library returns
                    // through one: `readAvailable` holds its stream's mutex with `use`,
                    // and a bracket release runs masked. So an interrupted read whose
                    // cancel lost its race handed the bytes to the fiber and then
                    // dropped them one frame later, on the way out — invisible
                    // everywhere the stream is reopened, and permanent on stdin, which
                    // is a process-wide singleton with nowhere to re-read from.
                    //
                    // Skipping here loses nothing: `deliverDeferredInterrupt` fires at
                    // the next park or the next acquired resource, and a fiber that
                    // reaches neither is finishing anyway.
                    //
                    // THE COST, stated so nobody reads it as a defect: a release or
                    // finalizer that READS (`stdin.read`, a socket read, a future)
                    // after an interrupt went pending leaves this mask carrying the
                    // bytes it was handed, so the pop skips and the interrupt is paid
                    // at the next park or fairness boundary instead — or dropped, if
                    // the fiber finishes first. That is latency, never correctness.
                    // The alternative — guarding the sync read lifts on `!pending`,
                    // the way the sync WRITE lift and `runSubtaskCall` are guarded —
                    // would lose the bytes for `uninterruptible { stdin.read }` under
                    // a pending interrupt, bytes the host has already transferred and
                    // nobody else can read. Elements always win. A release that reads
                    // AND must observe its interrupt promptly should end with its own
                    // `deliverDeferredInterrupt`; the carry rule does not change for
                    // it.
                    if fiber.interruptPending && fiber.interruptible && !fiber.maskedUntilSafePoint then
                        // An interrupt arrived while this region was
                        // uninterruptible and was deferred to here. Deliver it as
                        // a failure so the REMAINING continuation unwinds — outer
                        // bracket releases and `foldCause` finalizers must still
                        // run. Completing the fiber directly would discard them.
                        //
                        // The value being replaced may be a masked `acquire`'s
                        // resource — `Async.bracket(acquire.uninterruptible(), …)`
                        // — with the acquire frame now on top. Settle that first,
                        // for the reason in `settlePendingAcquire`.
                        //
                        // The mask is cleared with it for symmetry with
                        // `deliverDeferredInterrupt`: it is already false to get
                        // here, and leaving a set one behind on a fiber that
                        // recovers through `foldCause` would silently defer every
                        // later interrupt too.
                        fiber.interruptPending = false
                        fiber.maskedUntilSafePoint = false
                        self.settlePendingAcquire(fiber)
                        let next: Async<Any, Any> = FailCause<Any>(Cause.Interrupted(fiber.trace))
                        fiber.asyncValue = next
                    else
                        // The region's result leaves the mask as a pending
                        // `Succeed` that the next frame consumes — and if this
                        // pop was the region's last step before a fairness
                        // boundary, the fiber sits in the run queue interruptible
                        // with that value owned by nothing: a `Queue.take` has
                        // already dequeued its element inside the mask. Carry it,
                        // as the mutex take and the sync copy lifts carry theirs.
                        // Not when an interrupt is already pending: the outer
                        // mask that deferred it is about to pay it, and a set
                        // flag would make that pop skip (a release's nested
                        // `use writeLock` would drop the interrupt).
                        // And only when this pop actually EXPOSED the fiber: a
                        // nested pop inside an outer mask restores `interruptible`
                        // to false, the outer mask still defers every interrupt,
                        // and no fairness boundary can split a masked run — so
                        // there is no window to guard, and a set flag would only
                        // make the outer pop skip.
                        if !fiber.interruptPending && fiber.interruptible then
                            fiber.maskedUntilSafePoint = true
                        let next: Async<Any, Any> = Succeed(value)
                        fiber.asyncValue = next
                case Frame.AwaitFrame { signal, check } =>
                    match value as Option<Any> with
                    case Some(v) =>
                        // The wait ended without parking: give back the
                        // registration the `Await` node made, or a later wake
                        // would prod this fiber while it is doing something
                        // else entirely.
                        self.unregisterWaiter(signal, fiber.id)
                        fiber.forgetWake(signal)
                        // The check ran masked and produced this value (a
                        // dequeued element): carry it to the frame that owns
                        // it, for the reason at the mask pop above.
                        if !fiber.interruptPending && fiber.interruptible then
                            fiber.maskedUntilSafePoint = true
                        let next: Async<Any, Any> = Succeed(v)
                        fiber.asyncValue = next
                    case None =>
                        if fiber.hasPendingWake(signal) then
                            // A wake landed while the check was running — it
                            // consumed the registration, so the `None` in hand
                            // is stale. Re-run the whole `Await`: the node
                            // re-registers and the check asks again.
                            fiber.forgetWake(signal)
                            let retry: Async<Any, Any> = Await<Any, Any>(signal, check)
                            fiber.asyncValue = retry
                        else if self.beginPark(fiber) then
                            // The registration made at the node is still in
                            // place — it IS the park registration. A wake
                            // re-runs the node, which registers afresh.
                            let next: Async<Any, Any> = Await<Any, Any>(signal, check)
                            fiber.asyncValue = next
                        else
                            // `beginPark` delivered a deferred interrupt
                            // instead. This frame is already popped, so the
                            // failure path will not scrub this wait's
                            // registration — do it here.
                            self.unregisterWaiter(signal, fiber.id)
                            fiber.forgetWake(signal)
                case Frame.BracketAcquireFrame { release, useFn, scope, outerScope = outer } =>
                    // Resource acquired successfully — push a Release frame so the
                    // resource is finalized whatever happens to useFn, then run
                    // useFn(resource). The scope opened at the Bracket node stays
                    // open across the body.
                    fiber.continuation.push(Frame.BracketReleaseFrame { release = release; resource = value; scope = scope; outerScope = outer })
                    // The resource is now owned, which is exactly what a deferred
                    // interrupt was waiting for: unwinding from here runs the
                    // release rather than stranding what the cancel handed back.
                    //
                    // Ownership also ENDS the carrying window, interrupt or not:
                    // a fiber marked as carrying (a woken read's bytes, a mutex
                    // taken but not yet armed) with no interrupt pending would
                    // otherwise keep the flag forever, and a stale flag makes
                    // every later mask pop skip its delivery.
                    fiber.maskedUntilSafePoint = false
                    if !self.deliverDeferredInterrupt(fiber) then
                        fiber.asyncValue = useFn(value)
                case Frame.BracketReleaseFrame { release, resource, scope, outerScope = outer } =>
                    // useFn succeeded with `value`. Close the scope first: the
                    // resource must not be released while fibers forked inside
                    // are still alive.
                    //
                    // The release itself then runs MASKED. A finalizer with its
                    // own suspension points — a close that flushes, a TLS
                    // close_notify — would otherwise be cut in half by an
                    // interrupt landing mid-way, leaving the resource neither
                    // open nor closed. The interrupt is not lost: it is deferred
                    // to the `UninterruptibleFrame` pop and delivered the moment
                    // the release is done. Waiting for the scope above is NOT
                    // masked, on purpose — that wait must stay interruptible or
                    // an interrupt could not end a fiber whose child never
                    // finishes.
                    fiber.currentScope = outer
                    match self.closeScope(fiber, scope, false, DrainResume.ResumeValue(value)) with
                    case ScopeClose.Draining =>
                        // Children outstanding. Re-push this frame UNCHANGED so
                        // the scope stays armed: the fiber resumes right back
                        // here once the scope empties, and an interrupt landing
                        // meanwhile re-enters it through `handleFailure` instead
                        // of releasing under a live child.
                        fiber.continuation.push(Frame.BracketReleaseFrame { release = release; resource = resource; scope = scope; outerScope = outer })
                    case ScopeClose.Closed(finalizers) =>
                        // Run what the scope was attached (most recent first),
                        // then release(resource, Ok(value)), then succeed with
                        // the original value. Attachments come first because
                        // everything attached inside this block was acquired
                        // AFTER the block's own resource. One mask over both: a
                        // chain cut between two finalizers is as broken as one
                        // cut inside a single finalizer.
                        let useResult: Any = value
                        let outcome: Result<Any, Cause<Any>> = Ok(useResult)
                        let releaseAsync: Async<Unit, Never> = release(resource, outcome)
                        let releaseErased: Async<Any, Any> = releaseAsync
                        let loc = SourceLocation { file = ""; line = 0; column = 0; functionName = "" }
                        let unwind: Async<Any, Any> = unwindChain(finalizers, releaseErased)
                        self.runMaskedUnwind(fiber, Frame.MapFrame { transform = (_: Any) => useResult; location = loc }, unwind)
                        self.observeProducerCleanup(fiber, scope)
                case Frame.AttachAcquireFrame { finalizerOf, scope } =>
                    // Acquired: hand the finalizer to the scope BEFORE anything
                    // else can happen to this fiber. From here the resource is
                    // owned by that scope, which is exactly what a deferred
                    // interrupt was waiting for — unwinding now reaches the
                    // scope's close and releases, rather than stranding what the
                    // acquire produced. Same order, same reason, as the bracket
                    // acquire frame above.
                    self.registerFinalizer(fiber, scope, finalizerOf(value))
                    // Registered = owned: end the carrying window, as the
                    // bracket acquire frame above does.
                    fiber.maskedUntilSafePoint = false
                    if !self.deliverDeferredInterrupt(fiber) then
                        let next: Async<Any, Any> = Succeed(value)
                        fiber.asyncValue = next
                case Frame.ScopeCloseFrame { scope, outerScope = outer } =>
                    // A scope that acquired nothing of its own: no release to
                    // run, only what was attached to it.
                    fiber.currentScope = outer
                    match self.closeScope(fiber, scope, false, DrainResume.ResumeValue(value)) with
                    case ScopeClose.Draining =>
                        fiber.continuation.push(Frame.ScopeCloseFrame { scope = scope; outerScope = outer })
                    case ScopeClose.Closed(finalizers) =>
                        if finalizers.isEmpty then
                            let next: Async<Any, Any> = Succeed(value)
                            fiber.asyncValue = next
                        else
                            let loc = SourceLocation { file = ""; line = 0; column = 0; functionName = "" }
                            let chain: Async<Any, Any> = runFinalizers(finalizers)
                            self.runMaskedUnwind(fiber, Frame.MapFrame { transform = (_: Any) => value; location = loc }, chain)
        case fc: FailCause<Any> =>
            self.handleFailure(fiber, withTrace(fc.cause, fiber.trace))
        case m: Map<Any, Any> =>
            fiber.continuation.push(Frame.MapFrame { transform = m.f; location = m.trace })
            fiber.trace = fiber.trace.prepend(m.trace)
            fiber.asyncValue = m.inner
        case at: AndThen<Any, Any> =>
            fiber.continuation.push(Frame.AndThenFrame { continuation = at.f; location = at.trace })
            fiber.trace = fiber.trace.prepend(at.trace)
            fiber.asyncValue = at.inner
        case fld: Fold<Any, Any> =>
            fiber.continuation.push(Frame.FoldFrame { onFailure = fld.onFailure; onSuccess = fld.onSuccess })
            fiber.asyncValue = fld.inner
        case fc: FoldCause<Any, Any> =>
            fiber.continuation.push(Frame.FoldCauseFrame { onCause = fc.onCause; onSuccess = fc.onSuccess })
            fiber.asyncValue = fc.inner
        case ip: Interruptible<Any, Any> =>
            // Restores through the same frame as `Uninterruptible`: whatever
            // `interruptible` was, it comes back on the way out.
            //
            // It punches the ACQUIRE mask only. Inside a hard mask — a release
            // chain, a user `uninterruptible()` — it is a no-op: a finalizer
            // that takes a mutex must stay uncuttable, or the mask's whole
            // guarantee ("an interrupt cannot cut a release in half") dies the
            // day a release path parks.
            //
            // Becoming interruptible IS a safe point: an interrupt that went
            // pending while the enclosing mask held is delivered here, before
            // the region runs — otherwise it would sit stranded across the very
            // park this node exists to make cancellable (`beginPark` pays
            // pending interrupts too, but delivering before the wait even
            // starts is strictly better).
            fiber.continuation.push(Frame.UninterruptibleFrame { previousInterruptible = fiber.interruptible; wasHard = false })
            fiber.interruptible = fiber.hardMaskDepth == 0
            if !self.deliverDeferredInterrupt(fiber) then
                let restored: Async<Any, Any> = ip.inner
                fiber.asyncValue = restored
        case un: Uninterruptible<Any, Any> =>
            // A HARD mask: `Interruptible` inside it stays masked. This node is
            // what wraps every release chain and every user critical section.
            fiber.continuation.push(Frame.UninterruptibleFrame { previousInterruptible = fiber.interruptible; wasHard = true })
            fiber.interruptible = false
            fiber.hardMaskDepth = fiber.hardMaskDepth + 1
            let inner: Async<Any, Any> = un.inner
            fiber.asyncValue = inner
        case created: CreateProducer<Any, Any, Any> =>
            self.createProducer(fiber, created)
        case pulled: Pull<Any, Any> =>
            self.requestProducer(fiber, pulled.producer, ProducerRequestKind.Pull)
        case stopped: InterruptProducer<Any, Any> =>
            self.requestProducer(fiber, stopped.producer, ProducerRequestKind.Stop)
        case acquired: ProducerAcquired =>
            acquired.producer.phase = ProducerPhase.Idle(acquired.value)
            self.notifyProducer(acquired.producer, Succeed(acquired.producer.handle))
            fiber.asyncValue = ProducerIdle(acquired.producer)
            self.beginPark(fiber)
            ()
        case idle: ProducerIdle =>
            self.beginPark(fiber)
            ()
        case fk: Fork<Any, Any> =>
            // Structured: belongs to the innermost open scope, which waits for
            // it when it closes normally.
            let handle = self.createFiber(fk.source, fiber.currentScope, fiber.id, ChildKind.Structured, (id: FiberId) => fk.makeHandle(id))
            let next: Async<Any, Any> = Succeed(handle)
            fiber.asyncValue = next
        case fkb: ForkBackground<Any, Any> =>
            // Same scope, but any close interrupts it rather than waiting.
            let handle = self.createFiber(fkb.source, fiber.currentScope, fiber.id, ChildKind.Background, (id: FiberId) => fkb.makeHandle(id))
            let next: Async<Any, Any> = Succeed(handle)
            fiber.asyncValue = next
        case jn: Join<Any, Any> =>
            let targetFiberHandle = jn.target
            match targetFiberHandle.completedResult with
            case Some(FiberResult.Succeeded(value)) =>
                let next: Async<Any, Any> = Succeed(value)
                fiber.asyncValue = next
            case Some(FiberResult.FiberFailed(cause)) =>
                let next: Async<Any, Any> = FailCause(cause)
                fiber.asyncValue = next
            case None =>
                if self.beginPark(fiber) then
                    let target = self.fibers.get(targetFiberHandle.id).require
                    target.joinWaiters.push(fiber.id)
                    self.recordJoinTarget(fiber.id, target.id)
        case rs: RunSubtask<Any, Any> =>
            // Start the call and, if it blocked, park on its subtask — all in this
            // one step, so there is no boundary at which an interrupt could find a
            // started call with no cleanup armed.
            //
            // CHECK, THEN POST, THEN PARK: the shape every arm that talks to the
            // host has to have. A deferred interrupt discovered after `start()`
            // would abandon a live subtask and its pinned result block — `parkOn`
            // is where it used to be caught, which is one host call too late.
            if !self.deliverDeferredInterrupt(fiber) then
                self.runSubtaskCall(fiber, rs.call)
        case rf: ReadFutureValue<Any, Any> =>
            // The per-handle lock is taken HERE, before the copy is posted. p3
            // permits exactly one outstanding copy per stream or future end, so
            // the collision is at the post, not at the suspension — by the time a
            // fiber parks it is already too late. A contended fiber suspends with
            // `asyncValue` still on this node and runs it again once granted.
            //
            // NO `stillOpen` PROBE, unlike the two stream arms, because no
            // producer can close a future under this post: `CancelStream` — the
            // force-close that drops a handle out from under a Running fiber —
            // is minted only from the stream records (`Async.cancelStreamRead`/
            // `cancelStreamWrite`), no wrapper closes a `ComponentFuture`, and
            // nothing in this tree produces one yet. The day a closable future
            // wrapper exists, it needs the probe for the same window.
            if !self.deliverDeferredInterrupt(fiber) then
                let future = rf.future
                if self.lockForCopy(fiber, future.readable) then
                    let copy = future.start()
                    if copy.blocked then
                        // Lift only when the cancel LOST — the same guard the read
                        // arm gets from passing `cancelled.copyCount` into a
                        // count-aware lift. A future's `lift` takes no count, so
                        // the guard has to be here: a cancel that won leaves the
                        // pinned block unwritten, and decoding it would not
                        // produce a wrong value so much as a pointer-shaped one.
                        // The `deliver` flag changes nothing here and is named
                        // `_deliver` to say so: a future's value is decoded out
                        // of a pinned block this fiber owns, not read off a
                        // one-shot host future, so lifting it costs nothing that
                        // another reader was owed. Only a stream end has an
                        // ending to spend.
                        let cancel: (Bool) => (Bool, Result<Any, Any>) = (_deliver: Bool) =>
                            let cancelled = future.cancel()
                            let arrived = cancelled.copyCount > 0
                            let outcome: Result<Any, Any> =
                                if arrived then
                                    future.lift(copy)
                                else
                                    Ok(Stream.discard(copy))
                            future.dropReadable()
                            (arrived, outcome)
                        let onEvent: (EventPayload) => Result<Any, Any> = (_: EventPayload) =>
                            let outcome = future.lift(copy)
                            future.dropReadable()
                            outcome
                        self.parkOn(fiber, future.readable, true, SuspensionKind.FutureRead, cancel, onEvent)
                    else
                        let outcome = future.lift(copy)
                        future.dropReadable()
                        self.releaseCopyLock(fiber, future.readable)
                        // The value the lift just materialized is unowned until
                        // the continuation consumes it — the sync twin of the
                        // parked path's carrying wake. See `runSubtaskCall`.
                        //
                        // Only an `Ok` owns anything. An `Error` is a code the
                        // host reported: it owns nothing, so carrying it buys
                        // nobody safety and only defers a pending interrupt past
                        // the next mask pop — where a `catchAll` could recover
                        // and the following pop would expose its element instead
                        // of paying the interrupt. Same rule the raced-cancel
                        // branch of `interruptFiber` states for the parked twin.
                        match outcome with
                            case Ok(_) => fiber.maskedUntilSafePoint = true
                            case Error(_) => ()
                        fiber.asyncValue = liftOutcome(outcome)
        case rd: ReadStream<Any, Any> =>
            if !self.deliverDeferredInterrupt(fiber) then
                let read = rd.read
                // THE PROBE, asked inside the posting step because no earlier
                // step's answer survives to here: the wrappers validate their
                // state before posting, but validation and post are separate
                // steps, and the fairness budget can run a sibling `close`
                // between them — which cancels, DROPS the handle, and hands the
                // index back to a host that reuses it. A post after that does
                // not fail; it lands on whatever stream got the index next.
                // Failed exactly as `failDetachedFiber` fails the fibers the
                // close found parked — same `canceledError`, same shape — so
                // which side of the close the scheduler put this fiber on is
                // not observable (invariant (9) on `AsyncInputStream`).
                //
                // Before the lock, so a loser never queues on a dying handle;
                // the abandon covers the re-run of a fiber that was GRANTED the
                // lock before the close drained the queue's entry — hand-off is
                // exactly what a dropped handle must not get.
                if !read.stillOpen() then
                    self.abandonCopyLock(fiber, read.readable)
                    let failed: Async<Any, Any> = FailCause(Cause.Failed(read.canceledError, emptyTrace()))
                    fiber.asyncValue = failed
                else if self.lockForCopy(fiber, read.readable) then
                    let copy = read.start(rd.capacity)
                    if copy.blocked then
                        // See `settleCancelledRead`: a cancel is an undo or a
                        // late completion, and the count decides which — unless
                        // the caller is not going to deliver it, which is the
                        // other half of the same rule.
                        let cancel: (Bool) => (Bool, Result<Any, Any>) = (deliver: Bool) =>
                            self.settleCancelledRead(read, copy, deliver)
                        let onEvent: (EventPayload) => Result<Any, Any> = (payload: EventPayload) =>
                            self.settleRead(read, copy, payload.copyResult, boundCopyCount(payload.copyCount, rd.capacity))
                        self.parkOn(fiber, read.readable, true, SuspensionKind.Read, cancel, onEvent)
                    else
                        let outcome = self.settleRead(read, copy, copy.result, boundCopyCount(copy.count, rd.capacity))
                        self.releaseCopyLock(fiber, read.readable)
                        // Elements already left the host (bytes, an accepted
                        // socket): carry them to the safe point, exactly as the
                        // parked path's wake does — a budget split here with the
                        // fiber interruptible would otherwise let a sibling's
                        // interrupt clobber them unowned.
                        fiber.maskedUntilSafePoint = true
                        fiber.asyncValue = liftOutcome(outcome)
        case wr: WriteStream<Any, Any> =>
            if !self.deliverDeferredInterrupt(fiber) then
                let write = wr.write
                // The same probe as the read arm, for the same window — see the
                // comment there.
                if !write.stillOpen() then
                    self.abandonCopyLock(fiber, write.writable)
                    let failed: Async<Any, Any> = FailCause(Cause.Failed(write.canceledError, emptyTrace()))
                    fiber.asyncValue = failed
                else if self.lockForCopy(fiber, write.writable) then
                    let copy = write.start(wr.bytes)
                    if copy.blocked then
                        // The same rule as the read side, and it is one rule:
                        // see `settleCancelledRead`, which states it for both.
                        let cancel: (Bool) => (Bool, Result<Any, Any>) = (deliver: Bool) =>
                            self.settleCancelledWrite(write, copy, deliver)
                        let onEvent: (EventPayload) => Result<Any, Any> = (payload: EventPayload) =>
                            Stream.discard(copy)
                            self.settleWrite(write, payload.copyResult, payload.copyCount)
                        self.parkOn(fiber, write.writable, true, SuspensionKind.Write, cancel, onEvent)
                    else
                        Stream.discard(copy)
                        let outcome = self.settleWrite(write, copy.result, copy.count)
                        self.releaseCopyLock(fiber, write.writable)
                        // The count in this triple is what keeps `written`
                        // honest (see `writeReframed`'s fence): carry it, as
                        // the read side does — unless an interrupt is already
                        // pending, the same rule as the write WAKE (nothing to
                        // deposit; the mask about to pay it must not be skipped).
                        if !fiber.interruptPending then
                            fiber.maskedUntilSafePoint = true
                        fiber.asyncValue = liftOutcome(outcome)
        case th: Thunk<Any> =>
            let next: Async<Any, Any> = Succeed(th.f())
            fiber.asyncValue = next
        case cs: CancelStream =>
            let next: Async<Any, Any> = Succeed(())
            fiber.asyncValue = next
            self.detachFibersFrom(cs.waitable, cs.canceledError)
        case am: AcquireMutex =>
            // A handoff resumed this fiber back INTO this node with the mutex
            // already taken (see `grantMutex`): recognize the grant first, or the
            // `holdsMutex` check below would read our own grant as `AlreadyHeld`.
            if fiber.consumeGrantedMutex(am.state) then
                fiber.maskedUntilSafePoint = true
                let next: Async<Any, Any> = Succeed(())
                fiber.asyncValue = next
            // Queueing behind yourself would never end, so say so instead. This is
            // the whole difference between the two mutex types.
            else if fiber.holdsMutex(am.state) then
                let failed: Async<Any, Any> =
                    FailCause<Any>(Cause.Failed(MutexError.AlreadyHeld, emptyTrace()))
                fiber.asyncValue = failed
            else if self.enqueueForMutex(fiber, am.state) then
                ()
            else
                // The mutex is now HELD, but the release that frees it is only
                // armed when the frames above consume this `Succeed` — with the
                // `Interruptible` wrapper the fiber is interruptible in that gap,
                // so a budget-boundary interrupt could clobber the pending value
                // and strand the mutex on a fiber that recovers via `foldCause`.
                // Carry the hold to the safe point instead, like any other owned
                // value.
                fiber.maskedUntilSafePoint = true
                let next: Async<Any, Any> = Succeed(())
                fiber.asyncValue = next
        case ar: AcquireReentrantMutex =>
            // The same grant recognition as `AcquireMutex`, and it matters just
            // as much here: `holdsMutex` below would nest a level the grant
            // never asked for, and the single release coming would leave the
            // mutex stranded at depth one.
            if fiber.consumeGrantedMutex(ar.state) then
                fiber.maskedUntilSafePoint = true
                let next: Async<Any, Any> = Succeed(())
                fiber.asyncValue = next
            else if fiber.holdsMutex(ar.state) then
                // The phantom-depth twin of the take-to-arm window below: this
                // `depth + 1` outlives an interrupt that clobbers the pending
                // `Succeed`, and the outer hold's single release then never
                // reaches depth zero. Carry it to the safe point.
                ar.state.depth = ar.state.depth + 1
                fiber.maskedUntilSafePoint = true
                let next: Async<Any, Any> = Succeed(())
                fiber.asyncValue = next
            else if self.enqueueForMutex(fiber, ar.state) then
                ()
            else
                // See `AcquireMutex` above: held but not yet armed — carry it.
                fiber.maskedUntilSafePoint = true
                let next: Async<Any, Any> = Succeed(())
                fiber.asyncValue = next
        case rm: ReleaseMutex =>
            let next: Async<Any, Any> = Succeed(())
            fiber.asyncValue = next
            // Only a fiber that still holds it may hand it on: teardown may have
            // reclaimed the mutex already, and a second handoff would give it to
            // two fibers at once.
            if fiber.holdsMutex(rm.state) then
                self.releaseMutexLevel(fiber, rm.state)
        case y: Yield =>
            // Resume with Unit, but flag `runFiber` to end this step-run so the
            // scheduler hands every other ready fiber a turn before we continue.
            // The fiber stays `Running`, so `runFiber`'s post-loop re-enqueues it.
            let next: Async<Any, Any> = Succeed(())
            fiber.asyncValue = next
            fiber.yielding = true
        case aw: Await<Any, Any> =>
            fiber.continuation.push(Frame.AwaitFrame { signal = aw.signal; check = aw.check })
            // Registered BEFORE the check runs, not when the fiber parks. The
            // check takes steps of its own, and the fairness budget can hand
            // the scheduler to another fiber between any two of them: a
            // completer waking this waiter in that window used to find nobody
            // registered, and the fiber then parked on the check's stale
            // answer — forever, because nothing wakes twice. With the
            // registration in place first, a wake landing mid-check either
            // wakes a parked fiber or is recorded in `pendingWakes` (see
            // `wakeAwaiter`), and the `AwaitFrame` arm re-checks before it
            // parks. The registration is given back on every exit that is not
            // the park itself: the check answering `Some`, the check failing,
            // or a deferred interrupt firing at the park.
            //
            // One constraint follows: an `Await`'s check must not itself
            // `Await`. `pendingWakes` tells waits apart by waiter identity, but a
            // wake for the outer wait consumed the outer registration, and
            // only the outer `AwaitFrame` re-registers it — a nested `Await`
            // in the check would re-run the INNER node and leave the outer
            // registration a step behind. Every check in this library is a
            // state probe (Promise, Queue); keep it that way.
            self.addWaiter(aw.signal, fiber.id)
            let check: Async<Any, Any> = aw.check
            fiber.asyncValue = check
        case wk: Wake =>
            self.wakeWaiters(wk.signal)
            let next: Async<Any, Any> = Succeed(())
            fiber.asyncValue = next
        case it: Interrupt =>
            // Set our own resume value FIRST. If `it.target` is THIS fiber (its handle
            // routed back to itself), `interruptTarget` -> `interruptFiber` sets our
            // asyncValue to `FailCause(Interrupted)`; doing it in the other order would
            // clobber that self-interrupt with `Succeed(())` and the interrupt would vanish.
            // For any other target this is equivalent (interruptTarget doesn't touch us).
            let next: Async<Any, Any> = Succeed(())
            fiber.asyncValue = next
            self.interruptTarget(it.target)
        case br: Bracket<Any, Any> =>
            // Open the scope BEFORE `acquire`, so a fiber forked while the
            // resource is being acquired belongs to the resource and cannot
            // outlive its release.
            let outer = fiber.currentScope
            let scope = self.openScope(fiber)
            // The producer's first bracket owns cleanup even if acquisition fails
            // or cancellation arrives before ProducerAcquired can run.
            match self.producers.get(fiber.id) with
                case Some(producer) =>
                    if producer.releaseScope.equals(ScopeId(-1)) then producer.releaseScope = scope
                case None => ()
            fiber.continuation.push(Frame.BracketAcquireFrame { release = br.release; useFn = br.useFn; scope = scope; outerScope = outer })
            // `acquire` runs MASKED, as ZIO's `acquireRelease` does. An acquire
            // is not one step: it is however many the caller wrote, and the
            // resource becomes real somewhere inside it, invisibly. `Resource`
            // adds one more — its acquisition ends in a `map` pairing the value
            // with its finalizer — so an interrupt landing there discarded the
            // pairing as "a pure continuation" and stranded a resource that
            // already existed, with no frame left that could release it.
            //
            // Masking makes the whole acquisition atomic against interruption,
            // so the value reaches the frame that owns it or the acquire never
            // ran at all. The interrupt is deferred to the mask's pop, which is
            // exactly where the acquire frame is on top and
            // `settlePendingAcquire` can arm the release over it.
            //
            // The cost is that an acquire which parks indefinitely can no longer
            // be cut short. Keep acquisitions bounded.
            //
            // Masked by pushing the frame directly rather than by wrapping
            // `acquire` in an `Uninterruptible` NODE, and the difference is not
            // cosmetic. A node would still be sitting in `asyncValue` when the
            // first-step deferral fires (see `step`), and `settlePendingAcquire`
            // only recognises a pending `Succeed` — so a fiber interrupted
            // before its first step would unwind reading the acquire as failed.
            // That is exactly `forkAndUse`, whose acquire IS a `Succeed` holding
            // a socket its parent already accepted. With the frame pushed here,
            // `interruptible` is already false at that deferral, the interrupt
            // waits, and the mask's pop lands it where the repair works.
            fiber.continuation.push(Frame.UninterruptibleFrame { previousInterruptible = fiber.interruptible; wasHard = false })
            fiber.interruptible = false
            fiber.asyncValue = br.acquire
        case at: Attach<Any, Any> =>
            // NO `openScope`, and that is the whole difference from `Bracket`:
            // the finalizer belongs to a scope that is already open, and a fiber
            // forked while the acquire runs belongs to that same scope — which is
            // right, since the attached resource's lifetime IS that scope's.
            //
            // The scope is captured in the frame rather than read again at
            // success, because `settlePendingAcquire` needs the same answer from
            // outside this arm. They are equal by construction anyway: a bracket
            // nested inside the acquire restores `currentScope` on its way out.
            fiber.continuation.push(Frame.AttachAcquireFrame { finalizerOf = at.finalizerOf; scope = fiber.currentScope })
            // Masked for the same reason as the bracket's acquire above, and by
            // pushing the frame for the same reason too: the registration that
            // owns the resource must not be separated from the acquisition that
            // produced it by an interrupt.
            fiber.continuation.push(Frame.UninterruptibleFrame { previousInterruptible = fiber.interruptible; wasHard = false })
            fiber.interruptible = false
            fiber.asyncValue = at.acquire
        case rc: Race<Any, Any> =>
            // CHECK, THEN FORK, THEN PARK — the same shape as the arms that
            // talk to the host: a deferred interrupt discovered after the
            // forks would have created two racers only to tear them down.
            if !self.deliverDeferredInterrupt(fiber) then
                // A dedicated scope for the two racers, and a no-op
                // release frame over it. The frame is what makes every
                // non-winner path work without new machinery: an interrupt
                // landing mid-race wakes this fiber into its failure path,
                // which pops the frame, escalates the close to abnormal
                // (interrupting both racers), re-parks for their unwind, and
                // still propagates — exactly a bracket whose body failed. On
                // the winner path the frame is popped by the resumed value
                // and finds the scope already gone.
                let outer = fiber.currentScope
                let scope = self.openScope(fiber)
                // Enqueue order is program order: `left` gets the first step.
                self.createFiber(rc.left, scope, fiber.id, ChildKind.Structured)
                self.createFiber(rc.right, scope, fiber.id, ChildKind.Structured)
                // Arm the record as an undecided race. It exists — the two
                // forks above created it.
                match self.scopes.get(scope) with
                    case Some(scopeRecord) =>
                        scopeRecord.resume = DrainResume.RaceUndecided
                        // Marks the scope for `decideRace`'s second arm: only a
                        // race lets a child's defect supersede a decided result.
                        scopeRecord.isRace = true
                    case None => panic "race scope has no record after forking both racers"
                let noopRelease: (Any, Result<Any, Cause<Any>>) => Async<Unit, Never> =
                    (_: Any, _: Result<Any, Cause<Any>>) => Succeed(())
                fiber.continuation.push(Frame.BracketReleaseFrame { release = noopRelease; resource = (); scope = scope; outerScope = outer })
                // Park as the scope's draining owner — the same state a
                // bracket close parks in, so `resumeScopeOwner` (winner path)
                // and `interruptDrainingFiber` (interrupt path) both apply
                // unchanged. The racers were created while this fiber was
                // still Running, so `createFiber`'s born-into-a-closing-scope
                // rule did not fire on them.
                fiber.maskedUntilSafePoint = false
                fiber.status = FiberStatus.Draining(scope)

    function handleFailure(self, fiber: FiberState, cause: Cause<Any>): Unit =
        match fiber.continuation.pop() with
        case None => self.completeFiber(fiber, FiberResult.FiberFailed(cause))
        case Some(frame) =>
            match frame with
            case Frame.ProducerCleanupFrame(producer) =>
                producer.phase = ProducerPhase.Closing(Some(cause))
                fiber.asyncValue = FailCause(cause)
            case Frame.ProducerCleanupHandlerFrame =>
                match cause with
                    case Cause.Panicked(_, _) => self.preserveProducerCleanup(fiber, cause)
                    case _ => ()
                fiber.asyncValue = FailCause(cause)
            case Frame.ProducerValueFrame { producer, cleanupFailure } =>
                let cleanup = match cleanupFailure with
                    case Some(original) =>
                        match cause with
                            case Cause.Panicked(_, _) => Some(cause)
                            case _ => Some(original)
                    case None => None
                producer.phase = ProducerPhase.Closing(cleanup)
                match cause with
                    case Cause.Failed(error, _) =>
                        match error as Option<Any> with
                            case None => fiber.asyncValue = Succeed(())
                            case Some(_) => fiber.asyncValue = FailCause(cause)
                    case _ => fiber.asyncValue = FailCause(cause)
            case Frame.ProducerRequestFrame(request) =>
                self.stopProducerRequest(fiber, request, Some(cause))
            case Frame.ProducerAwaitFrame(request) =>
                self.awaitProducerShutdown(fiber, request)
            case Frame.ProducerShutdownFrame { request } =>
                self.finishProducerShutdown(fiber, request, Some(cause))
            case Frame.FoldFrame { onFailure } =>
                match cause with
                case Cause.Failed(error, _) =>
                    fiber.asyncValue = onFailure(error)
                case _ =>
                    self.handleFailure(fiber, cause)
            case Frame.FoldCauseFrame { onCause } =>
                // `foldCause` observes the full cause, including interruption
                // (see Async.foldCause docs) — this is what runs `use`/bracket
                // and `forkAndUse` finalizers when a fiber is interrupted.
                fiber.asyncValue = onCause(cause)
            case Frame.UninterruptibleFrame { previousInterruptible = previous, wasHard } =>
                fiber.interruptible = previous
                if wasHard then
                    fiber.hardMaskDepth = fiber.hardMaskDepth - 1
                // The success arm's gate, mirrored: the end of a masked region
                // is a safe point for an interrupt that was waiting for the
                // region whichever way the region ends. An interrupt that
                // landed while this region ran set only `interruptPending` —
                // no `maskedUntilSafePoint`, the fiber was not carrying
                // anything — and every later delivery point
                // (`deliverDeferredInterrupt`, at parks and host-op posts)
                // requires that mask. So a typed failure that recovered below
                // this frame through `catchAll`/`foldCause` used to walk off
                // with the pending interrupt still set and no mechanism left
                // to deliver it: the fiber parked unmasked and immune, and its
                // interrupter drained forever.
                //
                // The interrupt REPLACES `cause` — the same resolution as a
                // deferred interrupt at a masked release, documented on
                // `BracketReleaseFrame` below ("it is delivered at the mask's
                // pop and REPLACES `cause`"). The typed failure the region
                // exited with is superseded; preserving both would need a
                // composite `Cause`.
                //
                // Still NOT while carrying (`maskedUntilSafePoint`), exactly
                // as on the success arm: a raced cancel's payload defers its
                // interrupt to a real safe point, and this is not one. And no
                // `settlePendingAcquire` here: that guards a pending `Succeed`
                // sitting under a `BracketAcquireFrame`, and this fiber is
                // unwinding a FAILURE — a successful acquire becomes a release
                // frame in the same step it succeeds, so no owned-but-unarmed
                // resource can exist on this path.
                if fiber.interruptPending && fiber.interruptible && !fiber.maskedUntilSafePoint then
                    fiber.interruptPending = false
                    self.handleFailure(fiber, Cause.Interrupted(fiber.trace))
                else
                    self.handleFailure(fiber, cause)
            case Frame.MapFrame {} =>
                fiber.trace = fiber.trace.tail
                self.handleFailure(fiber, cause)
            case Frame.AndThenFrame {} =>
                fiber.trace = fiber.trace.tail
                self.handleFailure(fiber, cause)
            case Frame.AwaitFrame { signal } =>
                // The check failed, or an interrupt unwound through it: the
                // registration the `Await` node made must not outlive the
                // wait it belonged to.
                self.unregisterWaiter(signal, fiber.id)
                fiber.forgetWake(signal)
                self.handleFailure(fiber, cause)
            case Frame.BracketAcquireFrame { release, useFn, scope, outerScope = outer } =>
                // Acquire itself failed — nothing to release. The scope opened
                // before `acquire` may still hold fibers forked during it, so
                // close it before propagating; a fiber forked by a failing
                // acquire is still owned by the resource that never existed.
                // It may also hold FINALIZERS, if something attached during the
                // acquire, and those are owed whether or not the acquire got
                // anywhere.
                fiber.currentScope = outer
                match self.closeScope(fiber, scope, true, DrainResume.ResumeCause(cause)) with
                case ScopeClose.Draining =>
                    // Re-push UNCHANGED, the same trick as the release frame and
                    // now needed for the same reason: only a frame can run the
                    // attachments once the drain is over. `release`/`useFn` stay
                    // unused on this path — the resource never existed.
                    fiber.continuation.push(Frame.BracketAcquireFrame { release = release; useFn = useFn; scope = scope; outerScope = outer })
                case ScopeClose.Closed(finalizers) =>
                    if finalizers.isEmpty then
                        self.handleFailure(fiber, cause)
                    else
                        let loc = SourceLocation { file = ""; line = 0; column = 0; functionName = "" }
                        let failed: Async<Any, Any> = FailCause(cause)
                        let chain: Async<Any, Any> = runFinalizers(finalizers)
                        self.runMaskedUnwind(fiber, Frame.AndThenFrame { continuation = (_: Any) => failed; location = loc }, chain)
                        self.observeProducerCleanup(fiber, scope)
            case Frame.BracketReleaseFrame { release, resource, scope, outerScope = outer } =>
                // useFn failed — close the scope (an abnormal close, so
                // structured children are interrupted too), then run the scope's
                // attachments, then release, then re-fail with the same cause.
                //
                // The unwind is masked, as on the success path. One wrinkle: if
                // an interrupt lands while a finalizer runs here, it is delivered
                // at the mask's pop and REPLACES `cause`, so the original failure
                // is lost. That is how deferred interrupts have always resolved;
                // preserving both would need a composite `Cause`.
                fiber.currentScope = outer
                match self.closeScope(fiber, scope, true, DrainResume.ResumeCause(cause)) with
                case ScopeClose.Draining =>
                    // Stay armed: re-entered once the scope empties. See the
                    // success arm in `step`.
                    fiber.continuation.push(Frame.BracketReleaseFrame { release = release; resource = resource; scope = scope; outerScope = outer })
                case ScopeClose.Closed(finalizers) =>
                    let outcome: Result<Any, Cause<Any>> = Error(cause)
                    let releaseAsync: Async<Unit, Never> = release(resource, outcome)
                    let releaseErased: Async<Any, Any> = releaseAsync
                    let loc = SourceLocation { file = ""; line = 0; column = 0; functionName = "" }
                    let failed: Async<Any, Any> = FailCause(cause)
                    let unwind: Async<Any, Any> = unwindChain(finalizers, releaseErased)
                    self.runMaskedUnwind(fiber, Frame.AndThenFrame { continuation = (_: Any) => failed; location = loc }, unwind)
                    self.observeProducerCleanup(fiber, scope)
            case Frame.AttachAcquireFrame {} =>
                // The acquire failed: no resource exists, and nothing was
                // registered. Unlike `BracketAcquireFrame` there is no scope to
                // close — an attach opens none, and the scope it would have
                // registered on is closed by its own frame. Just propagate.
                self.handleFailure(fiber, cause)
            case Frame.ScopeCloseFrame { scope, outerScope = outer } =>
                fiber.currentScope = outer
                match self.closeScope(fiber, scope, true, DrainResume.ResumeCause(cause)) with
                case ScopeClose.Draining =>
                    fiber.continuation.push(Frame.ScopeCloseFrame { scope = scope; outerScope = outer })
                case ScopeClose.Closed(finalizers) =>
                    if finalizers.isEmpty then
                        self.handleFailure(fiber, cause)
                    else
                        let loc = SourceLocation { file = ""; line = 0; column = 0; functionName = "" }
                        let failed: Async<Any, Any> = FailCause(cause)
                        let chain: Async<Any, Any> = runFinalizers(finalizers)
                        self.runMaskedUnwind(fiber, Frame.AndThenFrame { continuation = (_: Any) => failed; location = loc }, chain)

    function wakeWaiter(self, waiter: FiberState): Unit =
        match waiter.status with
        case FiberStatus.Suspended =>
            waiter.status = FiberStatus.Running
            self.runQueue.enqueue(waiter.id)
        case _ => ()

    /// Close `scopeId` on `fiber`'s behalf, reporting whether the fiber must now
    /// PARK (`Draining` — it is, and the frame that asked must re-push itself) or
    /// may carry straight on (`Closed`, which hands back what the scope was
    /// owed).
    ///
    /// `abnormal` means the scope's body failed or was interrupted, which is the
    /// only thing that distinguishes the two closes: a normal close lets its
    /// structured fibers finish, an abnormal one interrupts them. Background
    /// fibers are interrupted either way — but still waited for, because a
    /// resource must not be released while a fiber is part-way through its own
    /// finalizers on it, and an interrupted fiber is not gone until it has
    /// finished unwinding.
    ///
    /// `Closed(finalizers)` are the scope's attachments, most recent first. Run
    /// them BEFORE your own release: anything attached inside a bracket was
    /// acquired after the bracket's own resource, and finalizers run in reverse
    /// acquisition order.
    ///
    /// This is the ONE place a record leaves `self.scopes` on a close, which is
    /// what lets it hand the finalizers over in the same expression.
    function closeScope(self, fiber: FiberState, scopeId: ScopeId, abnormal: Bool,
                        resume: DrainResume): ScopeClose =
        match self.scopes.get(scopeId) with
        // No record: nothing was ever forked into this scope and nothing
        // attached to it. The common case, and free.
        case None => ScopeClose.Closed([])
        case Some(scopeRecord) =>
            self.interruptScopeChildren(scopeRecord, abnormal)
            if scopeRecord.hasNoChildren then
                for producer in scopeRecord.producers do
                    // Unobserved producer cleanup defects belong to scope cleanup.
                    // Ordinary child body failures remain join-only. An explicit
                    // pull/interrupt already removes its producer, so this does
                    // not report an observed failure a second time.
                    match producer.phase with
                        case ProducerPhase.Failed(_, Some(cause)) =>
                            match cause with
                                case Cause.Panicked(message, trace) =>
                                    let failure: () => Async<Unit, Never> = () => Async<Unit, Never>.fromCause(Cause.Panicked(message, trace))
                                    scopeRecord.finalizers = List.Cons(failure, scopeRecord.finalizers)
                                case _ => ()
                        case _ => ()
                    self.producers.remove(producer.handle.fiber)
                scopeRecord.producers = []
                self.scopes.remove(scopeId)
                ScopeClose.Closed(scopeRecord.finalizers)
            else
                scopeRecord.resume = resume
                fiber.status = FiberStatus.Draining(scopeId)
                // A park, so carrying ends here (see `beginPark`).
                fiber.maskedUntilSafePoint = false
                // A Draining park bypasses `beginPark`, so it must pay a pending
                // interrupt itself — a fiber that parked still owing one would
                // wait for children that may never finish, and its interrupter
                // (a `timeout`, a scope teardown) hangs with it. Same resolution
                // as an interrupt landing mid-drain: escalate through
                // `interruptDrainingFiber`, which rewrites a FinishFiber resume
                // or wakes a framed park into its failure path — the caller
                // re-pushes its frame before the failure runs, so the re-entry
                // finds it armed. The carried-value flag is consumed too: at a
                // scope close the body is over, so whatever was carried has been
                // consumed or never will be — this is the "it tries to park
                // again" safe point the flag's contract promises.
                if fiber.interruptPending && fiber.interruptible then
                    fiber.interruptPending = false
                    self.interruptDrainingFiber(fiber, scopeId)
                ScopeClose.Draining

    /// Interrupt what a closing scope must not wait for: its background fibers
    /// always, its structured ones too when the close is `abnormal`.
    ///
    /// NOT once-per-teardown, and deliberately not. One teardown can reach here
    /// twice — a normal close interrupts the background children, an interrupt
    /// landing on the draining owner re-enters the frame and escalates the same
    /// close to abnormal — so a child can be interrupted a second time. That is
    /// idempotent for every child that did not recover: an interrupted fiber is
    /// already unwinding, and a masked one only re-arms a pending flag it
    /// already had. The one child it reaches twice is one that SWALLOWED the
    /// first interrupt (`foldCause`) and carried on inside a scope that is being
    /// torn down, and that child is exactly what the escalation is for.
    ///
    /// The alternative — a per-child "already interrupted for this close" mark —
    /// would buy an "interrupt once per teardown" guarantee at the price of a
    /// hang: a child that recovers is then never told again, and the close waits
    /// for it forever. Escalation is best-effort on purpose.
    function interruptScopeChildren(self, scopeRecord: ScopeRecord, abnormal: Bool): Unit =
        // Snapshot ids first — interrupting a fiber can finalize it, which
        // removes it from these sets mid-iteration.
        let childIds = ArrayList<FiberId>.new()
        for childId in scopeRecord.background do
            childIds.add(childId)
        if abnormal then
            for childId in scopeRecord.structured do
                childIds.add(childId)
        for childId in childIds do
            match self.fibers.get(childId) with
            case Some(child) => self.interruptFiber(child)
            case None => ()

    internal function completeFiber(self, fiber: FiberState, fiberResult: FiberResult): Unit =
        // Clean up any registrations for this fiber
        self.removeAllRegistrationsForFiber(fiber.id)

        // A root scope holding finalizers is the one close with no frame under
        // it: the body is over, so there is no `use` block and no bracket
        // release to hang them on — and a finalizer can SUSPEND (a flushing
        // close, a TLS close_notify), which this function has no way to run.
        //
        // So give it a frame, and hand the fiber back to the interpreter with
        // the result it was about to finish with. The frame drains the scope,
        // runs the chain masked, reproduces the result, and lands back here with
        // an empty continuation — this time with nothing left, unless a
        // finalizer attached or forked something of its own, which is exactly
        // what the second pass is for. That loop is what makes the close
        // transitive, and what terminates it.
        if self.scopeHasFinalizers(fiber.rootScope) then
            fiber.continuation.push(Frame.ScopeCloseFrame { scope = fiber.rootScope; outerScope = fiber.rootScope })
            match fiberResult with
                case FiberResult.Succeeded(value) =>
                    let next: Async<Any, Any> = Succeed(value)
                    fiber.asyncValue = next
                case FiberResult.FiberFailed(cause) =>
                    // `FailCause` re-traces with the fiber's current trace, which
                    // at the bottom of a drained continuation is empty. Restore
                    // the cause's own trace so re-tracing changes nothing.
                    fiber.trace = traceOf(cause)
                    let next: Async<Any, Any> = FailCause(cause)
                    fiber.asyncValue = next
            // Reached from `stepNode`/`handleFailure` the fiber is still Running
            // inside its own step-run, and `runFiber` takes the next step by
            // itself; reached from `resumeDrain` it is parked and has to go back
            // on the queue.
            match fiber.status with
                case FiberStatus.Running => ()
                case _ =>
                    fiber.status = FiberStatus.Running
                    self.runQueue.enqueue(fiber.id)
        else
            // The body is over: close the fiber's root scope. A body that ended
            // normally waits for its structured fibers; one that failed or was
            // interrupted cancels them first.
            let abnormal = match fiberResult with
                case FiberResult.Succeeded(_) => false
                case FiberResult.FiberFailed(_) => true
            match self.closeScope(fiber, fiber.rootScope, abnormal, DrainResume.FinishFiber(fiberResult)) with
            // Parked in Draining(rootScope); `leaveScope` finalizes it when the
            // last fiber in the scope is gone.
            case ScopeClose.Draining => ()
            // `Nil` by the check above: a root scope with attachments never
            // reaches here.
            case ScopeClose.Closed(_) => self.finalizeFiber(fiber, fiberResult)

    function finalizeFiber(self, fiber: FiberState, fiberResult: FiberResult): Unit =
        self.completeProducer(fiber, fiberResult)
        fiber.handle.setResult(fiberResult)
        fiber.status = FiberStatus.Completed

        // A dead fiber cannot release anything, so anything it still holds is
        // handed on here. Normally there is nothing: a copy takes its lock and
        // releases it inside one node, and a copy that settled while parked is
        // released through its suspension. The gap is the fiber that was GRANTED
        // a lock and interrupted before it re-ran the node — it owns the lock
        // with nothing scheduled to give it up, and the stream would be locked
        // for the rest of the run.
        self.releaseHeldLocks(fiber)
        self.releaseHeldMutexes(fiber)

        // Wake joinWaiters
        while !fiber.joinWaiters.isEmpty do
            let waiterId = fiber.joinWaiters.pop().require
            self.forgetJoinTarget(waiterId, fiber.id)
            let waiter = self.fibers.get(waiterId).require
            self.wakeWaiter(waiter)

        // This fiber's own root scope is empty by construction — it only got
        // here after draining — so drop the record rather than outlive it.
        self.scopes.remove(fiber.rootScope)

        // Leave the scope that owns this fiber, which may be the last thing a
        // closing scope was waiting for. If that scope is an undecided race,
        // this fiber's completion decides it — before `leaveScope`, so a race
        // whose second fiber finalizes in the same drain window still resumes
        // with the FIRST completion.
        match self.childScope.get(fiber.id) with
            case Some(scopeId) =>
                self.childScope.remove(fiber.id)
                self.decideRace(scopeId, fiberResult)
                self.leaveScope(scopeId, fiber.id)
            case None => ()

        // Forget the fiber. A server that forks one per connection would
        // otherwise accumulate a dead `FiberState` for every request it has
        // ever served. Everything that could still look it up either goes
        // through its handle (`Join` reads `completedResult`, which was set
        // above, before anything could observe the removal) or tolerates a
        // miss (`interruptTarget`, `wakeReadyFiber`, `drainRunQueue`,
        // `grantStreamLock` — a completed fiber left in a run queue or a lock
        // queue is meant to be skipped). Its join waiters were woken above,
        // and a waiter can never be finalized while still queued: teardown
        // scrubs its join registrations first.
        //
        // Main is the exception, and stays: `run` resolves the program's
        // result through it after the loop has finished.
        if !fiber.id.equals(self.mainFiber.id) then
            self.fibers.remove(fiber.id)

    /// If `scopeId` is a race scope still waiting on its first completion,
    /// `fiberResult` — the result the finalizing racer just settled with — is
    /// that completion: it becomes the race's resume, and every other racer in
    /// the scope is interrupted. Step-atomic by construction: this runs inside
    /// the finalizing racer's own step, so there is no window in which two
    /// completed racers could each think they won. A later finalization (the
    /// interrupted loser unwinding, or a photo-finish sibling in the same
    /// drain window) finds the resume already decided and is only a
    /// `leaveScope` — with ONE exception. A race that was itself interrupted had
    /// its resume overwritten by `closeScope`, which this must not undo — hence
    /// the first arm matches `RaceUndecided` and nothing else.
    ///
    /// The exception: a loser that PANICKED while unwinding its own finalizers
    /// (a bracket/`use` release that raised `Cause.Panicked` — see the
    /// `BracketReleaseFrame` failure arm) settles with a DEFECT, not the ordinary
    /// `Interrupted`. Dropping it would hide a real bug behind the winner's
    /// result, so it SUPERSEDES a decided winner (a value, or a typed failure —
    /// a defect outranks both). Precedence, applied by the second arm:
    ///
    /// The second arm is gated on `scopeRecord.isRace`, and has to be:
    /// `finalizeFiber` calls here for EVERY scope a fiber leaves, and an
    /// ordinary `use`/root scope whose owner is parked draining carries a
    /// `ResumeValue`/`ResumeCause` of exactly the same shape. Ungated, a
    /// structured child that panicked while its parent happened to be draining
    /// replaced the parent's result, while the same child panicking a moment
    /// earlier — before the parent reached its close — was observable only
    /// through `join`: what the parent saw depended on timing. The gate keeps
    /// the promotion where it is owed (a race must not hide its loser's
    /// finalizer panic behind the winner, F8) and leaves every other scope on
    /// the join-only doctrine of §5.4 rule 7, whenever the child dies.
    ///   - `RaceUndecided`: a racer that panicked FIRST already wins with its
    ///     panic via the first arm; nothing to do here.
    ///   - already `Panicked`: the first panic stands (winner's or an earlier
    ///     loser's) — first defect wins.
    ///   - `Interrupted`: the whole race is being torn down by an outer interrupt
    ///     (`closeScope` set it); left as-is, not rewritten into a panic.
    function decideRace(self, scopeId: ScopeId, fiberResult: FiberResult): Unit =
        match self.scopes.get(scopeId) with
        case None => ()
        case Some(scopeRecord) =>
            match scopeRecord.resume with
            case DrainResume.RaceUndecided =>
                scopeRecord.resume = match fiberResult with
                    case FiberResult.Succeeded(value) => DrainResume.ResumeValue(value)
                    case FiberResult.FiberFailed(cause) => DrainResume.ResumeCause(cause)
                self.interruptScopeChildren(scopeRecord, true)
            case _ =>
                match fiberResult with
                case FiberResult.FiberFailed(Cause.Panicked(msg, tr)) =>
                    if scopeRecord.isRace then
                        match scopeRecord.resume with
                            case DrainResume.ResumeValue(_) =>
                                scopeRecord.resume = DrainResume.ResumeCause(Cause.Panicked(msg, tr))
                            case DrainResume.ResumeCause(Cause.Failed(_, _)) =>
                                scopeRecord.resume = DrainResume.ResumeCause(Cause.Panicked(msg, tr))
                            case _ => ()
                case _ => ()

    /// Take a finished fiber out of its scope and, if that empties a scope
    /// somebody is closing, let the owner get on with the close.
    function leaveScope(self, scopeId: ScopeId, childId: FiberId): Unit =
        match self.scopes.get(scopeId) with
        case None => ()
        case Some(scopeRecord) =>
            scopeRecord.structured.remove(childId)
            scopeRecord.background.remove(childId)
            if scopeRecord.hasNoChildren then
                let resume = scopeRecord.resume
                let ownerId = scopeRecord.owner
                // Drop the record only if there is nothing left in it at all. A
                // scope holding finalizers outlives its last child: the owner's
                // `closeScope` is what removes it and takes them. Leaving it
                // costs nothing else — `scopeIsDraining` keys off the OWNER's
                // status, and a later fork just reuses the record.
                if scopeRecord.isDroppable then
                    self.scopes.remove(scopeId)
                self.resumeScopeOwner(ownerId, scopeId, resume)

    /// Wake the owner of a scope that has just emptied — but only while it is
    /// still parked on exactly that scope. An owner interrupted out of its drain
    /// is already runnable and re-checks the (now absent) record itself, so
    /// there is no lost wakeup and no double resume. Same guard shape as
    /// `isAwaitingLock`.
    function resumeScopeOwner(self, ownerId: FiberId, scopeId: ScopeId, resume: DrainResume): Unit =
        match self.fibers.get(ownerId) with
        case None => ()
        case Some(owner) =>
            match owner.status with
            case FiberStatus.Draining(waitingOn) =>
                if waitingOn.equals(scopeId) then
                    self.resumeDrain(owner, resume)
            case _ => ()

    function resumeDrain(self, owner: FiberState, resume: DrainResume): Unit =
        match resume with
        // The fiber's own body is over: finish it. Recurses through
        // `finalizeFiber` exactly as the old parent cascade did.
        case DrainResume.FinishFiber(result) =>
            self.finalizeFiber(owner, result)
        // A `use`/`bracket` scope closed: hand the fiber back to its release
        // frame through the run queue, so a chain of draining scopes runs as
        // ordinary steps instead of growing the interpreter stack.
        case DrainResume.ResumeValue(value) =>
            let next: Async<Any, Any> = Succeed(value)
            owner.asyncValue = next
            owner.status = FiberStatus.Running
            self.runQueue.enqueue(owner.id)
        case DrainResume.ResumeCause(cause) =>
            let next: Async<Any, Any> = FailCause(cause)
            owner.asyncValue = next
            owner.status = FiberStatus.Running
            self.runQueue.enqueue(owner.id)
        // Unreachable: a race scope only empties after at least one racer
        // finalized, and the first finalization replaced this in `decideRace`.
        case DrainResume.RaceUndecided =>
            panic "race scope emptied with no racer having completed"

    /// Forget that `waiterId` is queued on `targetId`'s join list — the join has
    /// been satisfied, so the reverse index must not keep pointing at it.
    function forgetJoinTarget(self, waiterId: FiberId, targetId: FiberId): Unit =
        match self.fiberJoinTargets.get(waiterId) with
        case Some(targets) => targets.remove(targetId)
        case None => ()

    function interruptTarget(self, targetFiberHandle: Fiber<Any, Any>): Unit =
        match self.fibers.get(targetFiberHandle.id) with
        case Some(target) => self.interruptFiber(target)
        case None => ()

    /// Settle a bracket's acquire→release-armed transition before a failure is
    /// injected over the value it produced.
    ///
    /// Injecting an interrupt into a fiber replaces whatever value its last step
    /// produced, and the fiber's next step never gets to interpret it. That is
    /// harmless for every frame but one. A `BracketAcquireFrame` under a pending
    /// `Succeed` means the resource EXISTS — `acquire` returned it — and the
    /// release frame that owns it is only pushed by the step that will not
    /// happen. Clobber there and the unwind reads the acquire as having failed,
    /// so nothing is released: a bound listener, an open file, a TLS stream
    /// leaks with no frame left that could close it.
    ///
    /// So finish that transition here — swap the acquire frame for the release
    /// frame the next step would have pushed. `useFn` deliberately never runs;
    /// the fiber is dying. The point is only that the resource is now held by a
    /// frame the failure path knows how to unwind.
    ///
    /// Every other frame that reads a pending success is safe to clobber, each
    /// for its own reason: `MapFrame`/`AndThenFrame` lose a pure continuation;
    /// `FoldFrame`/`FoldCauseFrame` skip a success handler the interrupt is
    /// meant to skip; `AwaitFrame` abandons a poll; and `BracketReleaseFrame`
    /// runs its release on the failure path anyway, so nothing is lost.
    function settlePendingAcquire(self, fiber: FiberState): Unit =
        match fiber.asyncValue with
        case s: Succeed<Any> =>
            let value = s.value
            match fiber.continuation.peek with
            case Some(frame) =>
                match frame with
                case Frame.BracketAcquireFrame { release, scope, outerScope = outer } =>
                    fiber.continuation.pop()
                    fiber.continuation.push(Frame.BracketReleaseFrame { release = release; resource = value; scope = scope; outerScope = outer })
                case Frame.AttachAcquireFrame { finalizerOf, scope } =>
                    // The same hazard as the bracket frame above, with a
                    // different repair. The resource EXISTS — the acquire
                    // returned it — and the registration that owns it is only
                    // done by the step that will not happen. There is no release
                    // frame to swap to, because an attach has none: the OWNER is
                    // the scope. So do the registration the arm would have done,
                    // and let that scope's close run it — a `use` block's release
                    // frame, or the root scope's `ScopeCloseFrame`.
                    fiber.continuation.pop()
                    self.registerFinalizer(fiber, scope, finalizerOf(value))
                case _ => ()
            case None => ()
        case _ => ()

    internal function interruptFiber(self, fiber: FiberState): Unit =
        match fiber.status with
        case FiberStatus.Completed => ()
        case FiberStatus.Draining(scopeId) =>
            self.interruptDrainingFiber(fiber, scopeId)
        case FiberStatus.Running =>
            if !fiber.started then
                // A fiber that has not run has its whole program in `asyncValue`
                // and nothing in its continuation, so replacing the one and
                // unwinding the other destroys its handlers instead of running
                // them. `Resource.forkAndUse` is the case that matters: the parent
                // acquires, and the release is armed by the `Bracket` the CHILD
                // steps into (its acquire is `Succeed(pair)`, settled by
                // `settlePendingAcquire`) — so an interrupt landing on a freshly-
                // enqueued child would leak whatever the parent had just acquired,
                // which for the accept loop it was written for is a socket per connection.
                //
                // Deferred by exactly one step, not dropped and not deferred
                // further: `step` delivers it as it finishes, by which time the
                // outermost node is a frame and unwinding runs it. The fiber has
                // still not run its body. See `maskedUntilSafePoint`.
                fiber.interruptPending = true
                fiber.maskedUntilSafePoint = true
            else if fiber.interruptible && !fiber.maskedUntilSafePoint then
                self.settlePendingAcquire(fiber)
                // A granted-but-not-yet-posted stream lock dies with the copy
                // node this interrupt is about to discard. The lock was handed to
                // this fiber (`grantStreamLock` left `asyncValue` on the copy node
                // so the re-run would post with the lock in hand), and the re-run
                // is exactly what replacing `asyncValue` below cancels — so the
                // node that would have released the lock never runs. A fiber that
                // then recovers through `foldCause` and lives on would hold the
                // lock for the rest of the run, deadlocking every other fiber
                // queued on that handle; `releaseHeldLocks` only fires at
                // `finalizeFiber`, which a recovering fiber never reaches. Hand it
                // on now — the copy will not be posted, so releasing here strands
                // nothing. A copy already IN FLIGHT is on a `Suspended` fiber and
                // is released through its suspension instead (see the arm below);
                // this arm only ever sees the transient grant window, where the
                // fiber holds the lock but has not yet re-run the node.
                self.releaseHeldLocks(fiber)
                // Same window, mutex flavor: a mutex granted to this fiber whose
                // acquire node has not re-run yet has no release frame armed and
                // dies with the node this interrupt discards. See
                // `reclaimGrantedMutex`.
                self.reclaimGrantedMutex(fiber)
                let next: Async<Any, Any> = FailCause<Any>(Cause.Interrupted(fiber.trace))
                fiber.asyncValue = next
                // An immediate delivery subsumes anything that was pending: a
                // pending flag left behind here would be paid a SECOND time by
                // the next gate, re-interrupting a fiber that already recovered.
                // Today no Running fiber is interruptible with a pending
                // interrupt and no carrying flag, so this is a backstop.
                fiber.interruptPending = false
            else
                fiber.interruptPending = true
        case FiberStatus.Suspended =>
            if fiber.interruptible then
                // Cancel the pending host ops + clear registrations, then re-run
                // the fiber with an interrupt failure so its continuation stack
                // (bracket releases, `forkAndUse`/`foldCause` finalizers) unwinds
                // — rather than discarding it by completing the fiber directly.
                //
                // Unless a cancel lost its race. Then the host had already
                // transferred elements into this fiber's buffer, and cancelling
                // HANDS THEM BACK rather than undoing anything. Throwing them away
                // strands whatever came through — an accepted socket nobody will
                // ever close — so the fiber is resumed with them, masked, and the
                // interrupt lands once it has owned them. See `maskedUntilSafePoint`.
                //
                // Only an `Ok` payload owns anything (elements, a handle). An
                // `Error` payload owns nothing — the host reported a code and
                // `cancel` already finished the call — so it is treated like a
                // cancel that won: the interrupt supersedes the typed error, the
                // same resolution every mask pop applies. Resuming with the
                // error AND a pending interrupt would leave the fiber
                // interruptible with nothing masked, and the next value-bearing
                // mask pop after a `catchAll` would pay that interrupt instead of
                // exposing its result — a `Queue.take` losing its element.
                //
                // "An `Error` payload owns nothing" is a property of the WIT in
                // this tree, not a law: every error type here is a payload-less
                // code. A component whose error variant carried an `own<…>`
                // handle would have it dropped unowned here — and equally at
                // `handleFailure`'s `UninterruptibleFrame` arm and every other
                // point a typed failure is superseded, so it is a class rather
                // than a site. Such an import needs typed errors that can be
                // finalized (an `IoError` method the runtime calls); see
                // `docs/component-model-design.md` §3.
                //
                // The cancel runs FIRST: `removeAllRegistrationsForFiber` also
                // releases the suspensions (idempotently, payload discarded), so
                // the sweep after it finds nothing left to cancel.
                let raced = self.releaseSuspensionsForFiber(fiber.id)
                self.removeAllRegistrationsForFiber(fiber.id)
                match raced with
                    case Some(Ok(payload)) =>
                        let resumed: Async<Any, Any> = Succeed(payload)
                        fiber.asyncValue = resumed
                        fiber.interruptPending = true
                        fiber.maskedUntilSafePoint = true
                    case _ =>
                        let next: Async<Any, Any> = FailCause<Any>(Cause.Interrupted(fiber.trace))
                        fiber.asyncValue = next
                fiber.status = FiberStatus.Running
                self.runQueue.enqueue(fiber.id)
            else
                fiber.interruptPending = true

    /// Interrupt a fiber that is parked waiting for a scope to empty.
    ///
    /// Finalize-park (the fiber's own body ending): there is no continuation left
    /// to unwind, so the interrupt changes the result the fiber will finalize
    /// with — and escalates the close. A fiber whose body ended normally is
    /// *waiting* for its structured fibers; once it is interrupted it must stop
    /// waiting politely, or an interrupt could not end a fiber whose child never
    /// finishes. Background fibers were already interrupted when the close began;
    /// interrupting them twice is a no-op.
    ///
    /// Frame-park (a `use` scope, a race, or a root scope being closed through a
    /// `ScopeCloseFrame` because something attached to it): wake the fiber into
    /// its own failure path. It re-enters the still-armed frame, which escalates
    /// the close from normal to abnormal — interrupting the structured fibers it
    /// was politely waiting for — re-parks, and still runs its finalizers before
    /// propagating.
    function interruptDrainingFiber(self, fiber: FiberState, scopeId: ScopeId): Unit =
        // Which of the two cases this is, is the RESUME, not the scope id. The
        // root scope can now be drained in two roles: the finalize-park below,
        // and a frame-park, when `completeFiber` closes it through a
        // `ScopeCloseFrame` because something attached to it. Only the first has
        // nothing left to unwind.
        //
        // A draining fiber always has a record — `closeScope` parks only when
        // one exists with children — so `None` is unreachable, and falling to
        // the framed branch is the safe answer if it ever were not.
        let finishing = match self.scopes.get(scopeId) with
            case None => false
            case Some(scopeRecord) =>
                match scopeRecord.resume with
                    case DrainResume.FinishFiber(_) => true
                    case _ => false
        if finishing then
            match self.scopes.get(scopeId) with
            case Some(scopeRecord) =>
                scopeRecord.resume = DrainResume.FinishFiber(
                    FiberResult.FiberFailed(Cause.Interrupted(fiber.trace)))
                self.interruptScopeChildren(scopeRecord, true)
            case None => ()
        else
            if fiber.interruptible then
                self.removeAllRegistrationsForFiber(fiber.id)
                let next: Async<Any, Any> = FailCause<Any>(Cause.Interrupted(fiber.trace))
                fiber.asyncValue = next
                fiber.status = FiberStatus.Running
                self.runQueue.enqueue(fiber.id)
            else
                fiber.interruptPending = true

    internal function addWaiter(self, signal: Waiter, fiberId: FiberId): Unit =
        signal.suspended.push(fiberId)
        match self.fibers.get(fiberId) with
        case Some(fiber) => fiber.registeredWaiters.add(signal)
        case None => ()

    /// Note that `fiberId` is parked on `waitable`, so tearing the fiber down
    /// can find its host ops without scanning every live suspension.
    function recordSuspension(self, fiberId: FiberId, waitable: Waitable): Unit =
        match self.fiberSuspensions.get(fiberId) with
        case Some(waitables) => waitables.add(waitable)
        case None =>
            let waitables = MutableSet<Waitable>.new()
            waitables.add(waitable)
            self.fiberSuspensions.put(fiberId, waitables)

    /// Drop one waitable from a fiber's suspension index — its op completed or
    /// was cancelled from outside. Drops the whole entry when it empties, so an
    /// idle fiber carries no set.
    function forgetSuspension(self, fiberId: FiberId, waitable: Waitable): Unit =
        match self.fiberSuspensions.get(fiberId) with
        case Some(waitables) =>
            waitables.remove(waitable)
            if waitables.isEmpty then
                self.fiberSuspensions.remove(fiberId)
        case None => ()

    /// Note that `fiberId` is queued on `targetId`'s join list, so tearing the
    /// fiber down knows which single list to scrub.
    function recordJoinTarget(self, fiberId: FiberId, targetId: FiberId): Unit =
        match self.fiberJoinTargets.get(fiberId) with
        case Some(targets) => targets.add(targetId)
        case None =>
            let targets = MutableSet<FiberId>.new()
            targets.add(targetId)
            self.fiberJoinTargets.put(fiberId, targets)

    internal function wakeWaiters(self, signal: Waiter): Unit =
        while !signal.suspended.isEmpty do
            let fiberId = signal.suspended.pop().require
            match self.fibers.get(fiberId) with
            case Some(fiber) => self.wakeAwaiter(fiber, signal)
            case None => ()

    /// Wake one fiber registered on `signal`. Registration happens at the
    /// `Await` node, before the check runs, so the fiber may be in any state
    /// here — and the wake must not be losable in any of them:
    ///
    /// - Parked on this very `Await`: the ordinary case — resume it; it
    ///   re-runs the node.
    /// - Anything else — running its check, parked mid-check on a host op or
    ///   a mutex, or draining a scope the check opened: record the wake in
    ///   `pendingWakes` instead. Disturbing a park that is not the `Await`'s
    ///   own would re-run whatever node the fiber is actually suspended on
    ///   (re-posting a copy the host still owns); the flag is consulted by
    ///   the `AwaitFrame` arm before the fiber trusts its check's answer.
    /// - Completed: nothing is owed.
    function wakeAwaiter(self, waiter: FiberState, signal: Waiter): Unit =
        match waiter.status with
        case FiberStatus.Suspended =>
            match waiter.asyncValue with
            case aw: Await<Any, Any> =>
                if ClassIdentity.equals(aw.signal, signal) then
                    waiter.status = FiberStatus.Running
                    self.runQueue.enqueue(waiter.id)
                else
                    waiter.recordWake(signal)
            case _ =>
                waiter.recordWake(signal)
        case FiberStatus.Running =>
            waiter.recordWake(signal)
        case FiberStatus.Draining(_) =>
            waiter.recordWake(signal)
        case FiberStatus.Completed => ()

    function removeAllRegistrationsForFiber(self, fiberId: FiberId): Unit =
        match self.producerRequests.get(fiberId) with
            case Some(request) => self.detachProducerRequest(request)
            case None => ()
        self.removeWaiterRegistrations(fiberId)
        self.removeJoinRegistrations(fiberId)
        // Idempotent: an interrupt path that already released the suspensions —
        // to rescue what a raced cancel handed back — leaves none to find here.
        self.releaseSuspensionsForFiber(fiberId)
        // The fiber is being interrupted or torn down, so it gives up its place
        // in any stream-lock or mutex queue.
        self.forgetAwaitingLock(fiberId)

    /// Give up this fiber's claim on anything it was queued for. The queue entries
    /// themselves are left behind to be skipped at handoff, rather than scanning
    /// every live lock and mutex here — this flag is what makes them skippable.
    function forgetAwaitingLock(self, fiberId: FiberId): Unit =
        match self.fibers.get(fiberId) with
        case Some(fiber) =>
            match fiber.streamLock with
                case Awaiting(_) => fiber.streamLock = StreamLock.Free
                case _ => ()
            let noMutex: Option<MutexState> = None
            fiber.awaitingMutex = noMutex
        case None => ()

    /// Give back ONE (waiter, fiber) registration — the `Await` it belonged to
    /// is over without parking (its check answered, failed, or a deferred
    /// interrupt fired). Selective on purpose, unlike
    /// `removeWaiterRegistrations`: only this wait's claim is withdrawn.
    internal function unregisterWaiter(self, signal: Waiter, fiberId: FiberId): Unit =
        signal.suspended.filterInPlace((id: FiberId) => !id.equals(fiberId))
        match self.fibers.get(fiberId) with
        case Some(fiber) => fiber.registeredWaiters.remove(signal)
        case None => ()

    /// Withdraw every queue registration and pending wake on teardown.
    internal function removeWaiterRegistrations(self, fiberId: FiberId): Unit =
        match self.fibers.get(fiberId) with
        case Some(fiber) =>
            for signal in fiber.registeredWaiters do
                signal.suspended.filterInPlace((id: FiberId) => !id.equals(fiberId))
            fiber.registeredWaiters.clear()
            fiber.pendingWakes.clear()
        case None => ()

    /// Drop `fiberId` from the join lists of exactly the fibers it is joining.
    function removeJoinRegistrations(self, fiberId: FiberId): Unit =
        match self.fiberJoinTargets.get(fiberId) with
        case Some(targetIds) =>
            for targetId in targetIds do
                match self.fibers.get(targetId) with
                case Some(target) =>
                    target.joinWaiters.filterInPlace((id: FiberId) => !id.equals(fiberId))
                case None => ()
            self.fiberJoinTargets.remove(fiberId)
        case None => ()

    /// Hand on the stream lock `fiber` still owns, if any. Called once, from
    /// `finalizeFiber`, because that is the only point at which the fiber is
    /// certainly never going to reach the node that would release it. Reclaiming
    /// any earlier would hand the lock on while this fiber could still post an op
    /// over the same handle.
    function releaseHeldLocks(self, fiber: FiberState): Unit =
        match fiber.heldLock() with
            case Some(waitable) =>
                fiber.streamLock = StreamLock.Free
                self.handOffStreamLock(waitable)
            case None => ()

    /// Hand the per-handle stream lock to the next fiber queued on it, or drop
    /// the lock if nobody is waiting.
    ///
    /// Queued fibers are not unregistered when they are interrupted — that would
    /// mean scanning every live lock on every teardown. Instead each entry is
    /// validated on the way out (`grantStreamLock`) and a stale one is skipped,
    /// passing the lock to the next fiber. Handing the lock to a fiber that has
    /// abandoned its place would deadlock the stream: nothing would release it.
    function handOffStreamLock(self, waitable: Waitable): Unit =
        match self.streamLocks.get(waitable) with
        case Some(queue) =>
            match queue.dequeue() with
            case Some(nextFiberId) =>
                if !self.grantStreamLock(nextFiberId, waitable) then
                    self.handOffStreamLock(waitable)
            case None => self.streamLocks.remove(waitable)
        case None => ()

    /// Take `state` for `fiber`, or queue behind whoever holds it. Reports true
    /// when the acquire did not complete here — the fiber was queued and
    /// suspended, or a deferred interrupt fired instead — and either way its
    /// caller must leave `asyncValue` alone.
    function enqueueForMutex(self, fiber: FiberState, state: MutexState): Bool =
        match state.owner with
        case Some(_) =>
            // Queue only if it really parks: an interrupt delivered here sends
            // the fiber down its failure path, and an entry left behind for it
            // would hand the mutex to a fiber that is no longer waiting for it.
            if self.beginPark(fiber) then
                state.queue.enqueue(fiber.id)
                fiber.awaitingMutex = Some(state)
            true
        case None =>
            fiber.takeMutex(state)
            false

    /// Give up one level of `fiber`'s hold on `state`, handing the mutex on when
    /// the outermost level exits. Only the outermost exit hands off — that is what
    /// makes a `ReentrantMutex` nest rather than escape after its inner `use`.
    function releaseMutexLevel(self, fiber: FiberState, state: MutexState): Unit =
        state.depth = state.depth - 1
        if state.depth <= 0 then
            state.depth = 0
            state.owner = None
            fiber.forgetMutex(state)
            self.handOffMutex(state)

    /// Give the mutex to the longest-waiting fiber, skipping entries left behind
    /// by fibers that moved on. Same tombstone protocol as `handOffStreamLock`,
    /// and for the same reason: an interrupt wakes a queued fiber without
    /// scrubbing its entry.
    function handOffMutex(self, state: MutexState): Unit =
        match state.queue.dequeue() with
            case Some(nextFiberId) =>
                if !self.grantMutex(nextFiberId, state) then
                    self.handOffMutex(state)
            case None => ()

    /// Hand `state` to `fiberId`, reporting whether it took it.
    ///
    /// Ownership transfers HERE — `takeMutex` — so nothing that runs between the
    /// grant and the grantee's next step can take the mutex out from under it.
    /// But the fiber is resumed back INTO its acquire node, not past it, with
    /// `grantedMutex` marking the handoff: `asyncValue` is left alone — it is
    /// still the node that queued — and the re-run consumes the marker
    /// (`consumeGrantedMutex`) and succeeds. That re-run is the first step of a
    /// fresh-budget slice, and from there to the `BracketAcquireFrame` that arms
    /// the release is a handful of pure frames with no delivery point in
    /// between, so take-and-arm is effectively atomic. The one exposed window is
    /// BEFORE that slice starts, while the granted fiber sits in the run queue:
    /// an interrupt landing there discards the very node that would consume the
    /// grant, so the interrupt Running arm reclaims it (`reclaimGrantedMutex`) —
    /// the mutex twin of `releaseHeldLocks` in the same arm. Resuming PAST the
    /// node, as this used to, left `heldMutexes` owning a mutex no frame would
    /// ever release: a fiber interrupted in the window that then recovered
    /// through an outer `foldCause` stranded the mutex forever, deadlocking
    /// every other waiter.
    function grantMutex(self, fiberId: FiberId, state: MutexState): Bool =
        match self.fibers.get(fiberId) with
        case Some(nextFiber) =>
            if nextFiber.isAwaitingMutex(state) then
                nextFiber.awaitingMutex = None
                nextFiber.takeMutex(state)
                nextFiber.grantedMutex = Some(state)
                nextFiber.status = FiberStatus.Running
                self.runQueue.enqueue(nextFiber.id)
                true
            else
                false
        case None => false

    /// Reclaim a mutex granted to `fiber` whose acquire node never got to run.
    /// `grantMutex` handed ownership over and left `asyncValue` on the acquire
    /// node so the re-run would consume the grant — and the re-run is exactly
    /// what replacing `asyncValue` with the interrupt cancels, so no release
    /// frame ever arms. A fiber that recovers through `foldCause` never reaches
    /// `finalizeFiber`'s backstop, so hand the mutex on now. Only the marked
    /// grant is reclaimed: unlike a stream lock, a Running fiber legitimately
    /// holds other mutexes inside their `use` bodies, and those have release
    /// frames armed to hand them on.
    function reclaimGrantedMutex(self, fiber: FiberState): Unit =
        match fiber.grantedMutex with
        case Some(state) =>
            fiber.grantedMutex = None
            state.depth = 0
            state.owner = None
            fiber.forgetMutex(state)
            self.handOffMutex(state)
        case None => ()

    /// Reclaim every mutex a dying fiber still holds, whatever depth it was at.
    /// Same backstop role as `releaseHeldLocks`: an interrupt landing between the
    /// acquire and its release frame would otherwise strand the mutex forever.
    function releaseHeldMutexes(self, fiber: FiberState): Unit =
        // A grant the fiber died holding is in `heldMutexes` too — the loop
        // below hands it on; clearing the marker just keeps a completed fiber
        // from carrying a stale reference.
        fiber.grantedMutex = None
        let held = fiber.heldMutexes
        fiber.heldMutexes = List.empty
        for state in held do
            state.depth = 0
            state.owner = None
            self.handOffMutex(state)

    /// Hand the lock on `waitable` to `fiberId`, reporting whether it took it.
    ///
    /// The entry is honoured only while the fiber is still parked on *this*
    /// lock. An interrupt wakes a queued fiber without scrubbing its entry, and
    /// that fiber may recover (`foldCause`) and suspend again on some other
    /// waitable — resuming it here would clobber the live suspension with the
    /// lock's `Succeed(())` and then double-resume when its real completion
    /// arrives. `StreamLock.Awaiting` is what distinguishes the two.
    function grantStreamLock(self, fiberId: FiberId, waitable: Waitable): Bool =
        match self.fibers.get(fiberId) with
        case Some(nextFiber) =>
            if nextFiber.isAwaitingLock(waitable) then
                // Resume back INTO the node, not past it: a copy node has to run
                // again so the copy is posted with the lock in hand, which is the
                // whole point of taking it. `asyncValue` is therefore left alone —
                // it is still the node that queued — and the `Awaiting` it queued
                // as becomes `Held`, so the re-run finds the lock already its own
                // rather than queueing behind itself forever.
                nextFiber.takeLock(waitable)
                nextFiber.status = FiberStatus.Running
                self.runQueue.enqueue(nextFiber.id)
                true
            else
                false
        case None => false

    /// Wake a parked fiber with the outcome its suspension produced: `Ok` value
    /// resumes normally, `Error` resumes into the fiber's failure path.
    ///
    /// `elements` says whether the settle hands the fiber bytes or a socket it
    /// must deposit; `wakeReadyFiber` decides from that and the fiber's state
    /// whether the wake carries.
    function resumeSuspension(self, susp: Suspension, outcome: Result<Any, Any>): Unit =
        match outcome with
        case Ok(value) =>
            let elements = match susp.kind with
                case SuspensionKind.Read => true
                case SuspensionKind.FutureRead => true
                case SuspensionKind.Subtask => false
                case SuspensionKind.Write => false
            let resume: Async<Any, Any> = Succeed(value)
            self.wakeReadyFiber(susp.fiberId, resume, true, elements)
        case Error(error) =>
            let resume: Async<Any, Any> = FailCause(Cause.Failed(error, emptyTrace()))
            self.wakeReadyFiber(susp.fiberId, resume, false, false)

    /// Unlink `waitable`'s suspension everywhere at once — the suspension record,
    /// the fiber's reverse index (`fiberSuspensions`), and the waitable-set
    /// membership — and hand the `Suspension` back for the caller to settle or
    /// cancel.
    ///
    /// One ordering invariant, kept in one place: the waitable must leave the
    /// waitable-set BEFORE the caller runs the suspension's `cancel` or
    /// `onEvent`, because either may drop the handle (e.g. `awaitCall`'s cancel
    /// does `subtask.cancel(); subtask.drop()`), and dropping a waitable that is
    /// still a member of a waitable-set traps.
    function unlinkSuspension(self, waitable: Waitable): Option<Suspension> =
        match self.suspensions.get(waitable) with
        case Some(susp) =>
            self.suspensions.remove(waitable)
            self.forgetSuspension(susp.fiberId, waitable)
            WaitableSet.remove(waitable)
            Some(susp)
        case None => None

    /// Cancel and forget any host operations the fiber is parked on. For each
    /// waitable the fiber holds a suspension for, unlink the suspension (see
    /// `unlinkSuspension` for the ordering this hinges on) and then run its
    /// `cancel` (cancelling the in-flight `stream.read`/`write` or subtask).
    /// Without this, an interrupted fiber would leave the host op live — a later
    /// drop of that stream traps ("busy stream") and the stale suspension would
    /// swallow the completion.
    function releaseSuspensionsForFiber(self, fiberId: FiberId): Option<Result<Any, Any>> =
        let toRemove = ArrayList<Waitable>.new()
        // Snapshot first: `cancel` below can suspend nothing, but removing
        // from the set while iterating it would still be a mutation mid-walk.
        // The whole reverse-index entry goes with the snapshot, so the
        // `forgetSuspension` inside `unlinkSuspension` finds nothing left to do.
        match self.fiberSuspensions.get(fiberId) with
            case Some(waitables) =>
                for waitable in waitables do
                    toRemove.add(waitable)
                self.fiberSuspensions.remove(fiberId)
            case None => ()
        let mutable raced: Option<Result<Any, Any>> = None
        for waitable in toRemove do
            match self.unlinkSuspension(waitable) with
            case Some(susp) =>
                let outcome = susp.cancel(true)
                self.releaseSuspensionLock(susp, waitable)
                // A cancel that lost its race handed back elements. They go to the
                // fiber, not to the floor — see `maskedUntilSafePoint`. A fiber is
                // parked on at most one waitable, so there is one at most.
                if outcome._0 then
                    raced = Some(outcome._1)
            case None => ()
        raced

    /// Take the per-handle lock for a copy about to be posted, reporting whether
    /// the copy may proceed.
    ///
    /// Locking happens here rather than at the suspension because every copy arm
    /// calls `start()` before it discovers the copy blocked: the collision is at
    /// the post, not at the park.
    ///
    /// False means another fiber holds it. This one is queued and suspended with
    /// `asyncValue` untouched, so the grant re-runs the same node and it takes the
    /// lock on the way through — which is why a grant needs no marker of its own.
    /// A fiber that already holds this lock can only have been granted it that
    /// way: locks live and die inside one copy node, and copy nodes do not nest.
    function lockForCopy(self, fiber: FiberState, waitable: Waitable): Bool =
        if fiber.holdsLock(waitable) then
            true
        else
            match self.streamLocks.get(waitable) with
            case Some(queue) =>
                if self.beginPark(fiber) then
                    queue.enqueue(fiber.id)
                    fiber.streamLock = StreamLock.Awaiting(waitable)
                false
            case None =>
                self.streamLocks.put(waitable, MutableQueue<FiberId>.new())
                fiber.takeLock(waitable)
                true

    /// Release the per-handle lock a settled copy took, handing it to the next
    /// fiber queued behind it. `dropLock` reporting false means teardown already
    /// reclaimed it, so handing it on again would give one stream to two fibers.
    function releaseCopyLock(self, fiber: FiberState, waitable: Waitable): Unit =
        if fiber.dropLock(waitable) then
            self.handOffStreamLock(waitable)

    /// The same release, for a copy that settled while parked.
    function releaseSuspensionLock(self, susp: Suspension, waitable: Waitable): Unit =
        if susp.ownsLock then
            match self.fibers.get(susp.fiberId) with
                case Some(owner) => self.releaseCopyLock(owner, waitable)
                case None => ()

    /// Give up a lock claim WITHOUT handing it on — for a handle that is going
    /// away, where handing it on is precisely the bug being avoided.
    function abandonCopyLock(self, fiber: FiberState, waitable: Waitable): Unit =
        if fiber.holdsLock(waitable) then
            fiber.streamLock = StreamLock.Free

    /// Detach every fiber from `waitable` so its handle can be dropped: cancel
    /// the copy in flight on it, and empty the queue of fibers waiting their turn
    /// on it, failing each of them with `canceled`.
    ///
    /// Both halves are needed. Cancelling only the in-flight copy leaves the next
    /// fiber in the queue to be granted the lock and post on a handle that has
    /// been dropped — and a dropped index is reused, so that copy lands on
    /// whatever stream the host handed it to next. See `CancelStream`.
    function detachFibersFrom(self, waitable: Waitable, canceled: Any): Unit =
        self.cancelInFlightCopy(waitable, canceled)
        self.drainLockQueue(waitable, canceled)

    /// Stop the copy posted on `waitable`, if there is one, and fail the fiber
    /// that posted it. The unlink comes first, for the ordering reason on
    /// `unlinkSuspension`: cancelling may drop the handle.
    function cancelInFlightCopy(self, waitable: Waitable, canceled: Any): Unit =
        match self.unlinkSuspension(waitable) with
            case Some(susp) =>
                // Cancel through the *suspension's* own canceller: only the
                // parked fiber's closure captured the `CopyOperation` whose
                // pinned buffer must be freed. What that cancel RETURNS is
                // deliberately dropped — it reports how far the op got, and a
                // fiber whose stream is being closed under it should be told
                // that, not handed a short read it would take for a clean end
                // of input. Elements the cancel raced are NOT dropped with it:
                // `deliver = false` sends them through the record's
                // `discardElements`, which closes whatever they own — see
                // `settleCancelledRead`.
                susp.cancel(false)
                if susp.ownsLock then
                    match self.fibers.get(susp.fiberId) with
                        case Some(owner) => self.abandonCopyLock(owner, waitable)
                        case None => ()
                self.failDetachedFiber(susp.fiberId, canceled)
            case None => ()

    /// Fail everyone queued for a turn on `waitable` and forget the lock itself.
    ///
    /// The lock entry is removed outright rather than handed on — handing it on
    /// is what the drain exists to prevent — and leaving it behind would be no
    /// better: `streamLocks` is keyed by the raw handle index and the presence of
    /// a key means "held", so an entry outliving its handle would lock the *next*
    /// stream given that index behind a holder that can never release it.
    function drainLockQueue(self, waitable: Waitable, canceled: Any): Unit =
        match self.streamLocks.get(waitable) with
            case Some(queue) =>
                let mutable draining = true
                while draining do
                    match queue.dequeue() with
                        case Some(queuedId) => self.failQueuedFiber(queuedId, waitable, canceled)
                        case None => draining = false
                self.streamLocks.remove(waitable)
            case None => ()

    /// Fail one fiber taken off a closing handle's lock queue.
    ///
    /// Same tombstone rule as `grantStreamLock`: an entry speaks for a fiber
    /// only while that fiber is still parked on THIS lock. One left behind by a
    /// fiber that was interrupted and then recovered must be skipped — that
    /// fiber is parked on something else now, and failing it here would clobber
    /// a live suspension.
    function failQueuedFiber(self, fiberId: FiberId, waitable: Waitable, canceled: Any): Unit =
        match self.fibers.get(fiberId) with
            case Some(queued) =>
                if queued.isAwaitingLock(waitable) then
                    queued.streamLock = StreamLock.Free
                    self.failDetachedFiber(fiberId, canceled)
            case None => ()

    /// Wake a fiber detached from a closing handle into its failure path.
    function failDetachedFiber(self, fiberId: FiberId, canceled: Any): Unit =
        let failed: Async<Any, Any> = FailCause(Cause.Failed(canceled, emptyTrace()))
        self.wakeReadyFiber(fiberId, failed, false, false)

    /// Post an async import call and park on its subtask if it blocked.
    ///
    /// Lives here rather than inline in the arm so that the arm reads as the one
    /// shape every host-facing arm has: check for a deferred interrupt, post,
    /// park. The check is the caller's, because it has to happen before `start()`.
    function runSubtaskCall(self, fiber: FiberState, subtask: ComponentSubtask<Any, Any>): Unit =
        let call = subtask.start()
        if call.returned then
            // Returned synchronously: no subtask handle exists (the field is
            // only meaningful when STARTED), so lifting the result is the
            // whole operation.
            //
            // The lifted result may OWN something — `openAtAsync`'s finish
            // materializes a FileDescriptor — and inside an `Interruptible`
            // region the fiber is interruptible until the region's frame pops
            // one step later, so a fairness-boundary split here would let an
            // interrupt clobber the pending value with nothing armed to close
            // it. Carry it to the safe point, exactly as the mutex take does —
            // unless an interrupt is already pending, for the reason in
            // `wakeReadyFiber`.
            if !fiber.interruptPending then
                fiber.maskedUntilSafePoint = true
            fiber.asyncValue = liftOutcome(subtask.finish(call))
        else
            let handle = call.subtask
            // Cancelling can lose the race: state 2 (RETURNED) means the host
            // wrote the full result before the cancel landed, and then `finish`
            // is the only thing that frees what hangs off the retptr block —
            // freeing the block alone would leak everything it points to.
            // `_deliver` for the reason the future arm ignores it: `finish` is
            // what frees the call's result block, so it has to run whoever asked
            // for the cancel, and it spends nothing a later reader is owed.
            let cancel: (Bool) => (Bool, Result<Any, Any>) = (_deliver: Bool) =>
                let raced = handle.cancel() == 2
                handle.drop()
                if raced then (true, subtask.finish(call)) else (false, Ok(call.discard()))
            let onEvent: (EventPayload) => Result<Any, Any> = (payload: EventPayload) =>
                // Only RETURNED (state 2) is terminal: `subtask.drop` requires it and
                // `finish` reads a result block the host does not write until then. A
                // conforming WASI host reports STARTED synchronously (which is why this
                // fiber parked), so RETURNED is the only transition left to observe — hence
                // the loud failure rather than decoding a half-written result.
                //
                // KNOWN LIMITATION (unreachable with wasmtime's WASI, reachable via an
                // imported *component* callee under backpressure): such a callee can return
                // STARTING and then deliver a non-terminal STARTED (state 1) event FIRST.
                // Handling it means staying parked across that event, but `deliver` unlinks
                // the suspension before `onEvent` — a re-park path this runtime does not yet
                // have. Fail specifically rather than pretend the state is impossible.
                if payload.subtaskState != 2i32 then
                    panic "subtask event in non-terminal state " ++ payload.subtaskState.format() ++ " before RETURNED (a backpressured component callee needs re-park support this runtime lacks)"
                handle.drop()
                subtask.finish(call)
            // No lock: every call mints its own subtask, so there is no shared
            // handle two fibers could collide on.
            self.parkOn(fiber, handle.waitable, false, SuspensionKind.Subtask, cancel, onEvent)

    /// Deliver a PENDING interrupt at a safe point. Two states arrive here:
    /// one deferred while the fiber carried elements a raced cancel handed back
    /// (`maskedUntilSafePoint`), and a plain pending one — set while a mask
    /// held, on a fiber that became interruptible again without popping a mask
    /// frame, which the `Interruptible` node made possible. Both deliver on the
    /// same terms; requiring the carried-value flag left the plain one stranded
    /// across an interruptible park, hanging its interrupter (`beginPark`'s
    /// contract: a fiber that parks still owing an interrupt waits forever).
    ///
    /// Called where carrying is resolved: the value has been owned (a bracket
    /// armed its release, an attach registered its finalizer), the fiber is
    /// about to park again (`beginPark`), a region just became interruptible
    /// (`Interruptible` arm), or the fairness boundary in `runFiber`. Returns
    /// true if it fired.
    ///
    /// Gated on `interruptible` exactly as a direct interrupt is: a masked
    /// region — a bracket release mid-`close_notify`, a finalizer mid-flush —
    /// is masked against deferred interrupts too. Without the gate, a
    /// raced-cancel interrupt fired at the first suspension INSIDE the mask
    /// (`beginPark` and the copy arms all call here) and cut the finalizer in
    /// half. Skipping while masked loses nothing: the flags stay set, and the
    /// next delivery point — or the fairness boundary, which bounds the wait —
    /// fires it.
    function deliverDeferredInterrupt(self, fiber: FiberState): Bool =
        if fiber.interruptPending && fiber.interruptible then
            fiber.maskedUntilSafePoint = false
            fiber.interruptPending = false
            self.settlePendingAcquire(fiber)
            // The same repairs the immediate branch of `interruptFiber` makes:
            // a stream lock or mutex GRANTED to this fiber whose node has not
            // re-run has no release armed, and dies with the node this
            // delivery discards. Both are no-ops when nothing is granted.
            //
            // Backstops, and known to be: the round-8 flag audit found no
            // reachable state in which either has anything to repair from HERE.
            // A fiber carrying a granted lock or mutex is interruptible, so it
            // is interrupted through `interruptFiber`'s immediate branch; a
            // masked one pays at a pop that comes after the acquire frame has
            // armed its release. They stay because the argument is an invariant
            // over every delivery site rather than something the two lines can
            // check locally — the same standing as the `interruptPending =
            // false` in the immediate branch after the round-11 fix. Remove
            // them only with a proof, not with a reading of today's call graph.
            self.releaseHeldLocks(fiber)
            self.reclaimGrantedMutex(fiber)
            let next: Async<Any, Any> = FailCause<Any>(Cause.Interrupted(fiber.trace))
            fiber.asyncValue = next
            true
        else
            false

    /// Put `fiber` to sleep, first delivering an interrupt it was carrying.
    ///
    /// THE ONLY WAY INTO `FiberStatus.Suspended`, and that is the point. Parking
    /// again means the fiber is never going to own what a raced cancel handed
    /// back, so the interrupt owed to it fires now rather than after it has
    /// blocked — a fiber that parks still owing one waits forever, because
    /// nothing interrupts it twice. That contract used to be re-stated at each
    /// park site, and the sites that forgot it (a `join`, a promise `await`, a
    /// contended mutex) were the ones that could deadlock. There is nowhere left
    /// to forget it.
    ///
    /// Reports whether the fiber actually parked. `false` means the interrupt
    /// fired instead: the fiber is Running its failure path, and the caller must
    /// neither register it as a waiter nor touch `asyncValue`.
    function beginPark(self, fiber: FiberState): Bool =
        // Parking again is the safe point the carrying flag's contract names:
        // whatever the fiber was carrying is consumed or never will be. End
        // the carrying window here whether or not an interrupt is pending —
        // a stale flag that survived into this park would make the next mask
        // pop skip its delivery, and the Running arm skip its lock repair.
        fiber.maskedUntilSafePoint = false
        if self.deliverDeferredInterrupt(fiber) then
            false
        else
            fiber.status = FiberStatus.Suspended
            true

    /// Park `fiber` on `waitable` until its completion event arrives.
    ///
    /// At most one fiber may park on a given waitable: the map is keyed by handle,
    /// so a second suspension would silently overwrite the first, which would then
    /// hang forever. p3 also forbids concurrent operations on one stream or future,
    /// so this should be unreachable — fail loudly rather than deadlock.
    function parkOn(
        self,
        fiber: FiberState,
        waitable: Waitable,
        ownsLock: Bool,
        kind: SuspensionKind,
        cancel: (Bool) => (Bool, Result<Any, Any>),
        onEvent: (EventPayload) => Result<Any, Any>
    ): Unit =
        if self.beginPark(fiber) then
            if self.suspensions.contains(waitable) then
                panic "two fibers suspended on the same waitable (concurrent ops on one p3 stream/future are not allowed)"
            self.waitableSet.join(waitable)
            self.suspensions.put(waitable, Suspension {
                fiberId = fiber.id
                cancel = cancel
                onEvent = onEvent
                ownsLock = ownsLock
                kind = kind
            })
            self.recordSuspension(fiber.id, waitable)

    /// Lift the elements a read copied, and consult the stream's paired result
    /// future if the stream ended.
    ///
    /// The elements come back whatever the result: a `Dropped` copy still reports
    /// what it transferred before the end went away, and those elements have
    /// already moved. Only the future can turn an ending into a failure — a
    /// `stream<T>` has no error channel — and if it reports none, the ending is
    /// handed to the caller as a plain `Dropped` to interpret. The runtime never
    /// invents an `E` it was not given.
    ///
    /// Which is why the ending travels ALONGSIDE the elements rather than in
    /// place of them, as a third component and not as a failed `Result`. The two
    /// are not alternatives: one copy can both transfer the last chunk of a file
    /// and learn from the result future that the transport then broke, and
    /// raising the failure from here threw those bytes away — the elements had
    /// already been lifted out of the pinned buffer, so nothing else was ever
    /// going to hand them over. That is the round-13 rule, and it is enforced one
    /// layer down (`AsyncInputStream` invariant (3)) only if this layer stops
    /// discarding the payload. The wrapper delivers the elements and latches the
    /// reason for the next read.
    function settleRead(
        self,
        read: ComponentStreamRead<Any, Any>,
        copy: CopyOperation,
        result: CopyResult,
        count: Int32
    ): Result<Any, Any> =
        let elements = read.lift(copy, count)
        Ok((result, elements, self.endedWith(result, read.ending)))

    /// THE CANCEL PATH, both directions, stated once.
    ///
    /// `stream.cancel-read` and `stream.cancel-write` do not undo a copy the host
    /// has already performed part of; they REPORT it. So a cancel is one of two
    /// things, and the count it comes back with is what says which — the same
    /// test on both ends.
    ///
    /// AN UNDO (count 0, or a caller that will not deliver). Nothing is
    /// settled, the stream's one-shot result future is not consulted, and no
    /// outcome reaches any fiber. What DID move goes through the record's
    /// `discardElements`: at a count of zero that is only the pinned buffer
    /// going back, but a force-close's cancel can lose its race like any other,
    /// and the elements it hands back then have no fiber to take custody of
    /// them — the force-close is failing that fiber with `canceledError` on
    /// purpose. For bytes, releasing them to nowhere is freeing the buffer; for
    /// an OWNED element — the accept stream's `stream<own<tcp-socket>>` — it is
    /// closing a live socket, and only the record knows which it holds.
    /// Lifting-and-dropping instead (the old shape) closed neither: a raced
    /// force-close materialized a live `TcpSocket` nobody would ever serve or
    /// close.
    ///
    /// A COMPLETION THAT ARRIVED TOO LATE TO STOP (count > 0). The host moved
    /// elements, or took bytes, before the cancel reached it, and this is the only
    /// report of that there will ever be. It is settled EXACTLY as the completion
    /// event would have been — the same `settleRead`/`settleWrite`, including
    /// reading the result future when the status says `Dropped` — and handed to
    /// the fiber, which is resumed with it and takes its interrupt at the next
    /// safe point (see `maskedUntilSafePoint`).
    ///
    /// Two rules fall out of that, and neither is optional.
    ///
    /// THE RESULT FUTURE IS READ IF AND ONLY IF THE OUTCOME IS DELIVERED. Reading
    /// it on a path that then discards the outcome spends a one-shot read that the
    /// wrapper still believes it owns, and `dropHandles` reads it again on the way
    /// out — a trap during teardown rather than a missing error. Not reading it on
    /// a path that DOES deliver is the opposite failure, and the one the ending
    /// triple exists to prevent: a `Dropped` handed over with no reason beside it
    /// is a broken transport reported as a clean end of stream.
    ///
    /// Which is why `deliver` is a PARAMETER and not something this decides. Two
    /// callers cancel a copy. An interrupt (`releaseSuspensionsForFiber`) still
    /// has a fiber to resume, so it delivers. A force-close (`cancelInFlightCopy`)
    /// does not: it detaches that fiber and fails it with the stream's
    /// `canceledError` on purpose, so anything settled here would go on the floor
    /// — including a reading of the very future the closing wrapper is about to
    /// take for itself.
    ///
    /// THE COUNT IS PART OF THE OUTCOME ON BOTH ENDS. On the read side it is the
    /// elements, which nothing else can hand over. On the write side it is not a
    /// payload — the pinned buffer is a private copy of the caller's bytes — it is
    /// the HOLE: the difference between a write that did nothing and a byte stream
    /// with half an array spliced into it. That is what overturns the `false` this
    /// used to report. Round 13 asked whether a cancel handed back anything an
    /// interrupted fiber must take CUSTODY of and answered no, which is true of
    /// the bytes and false of the damage. Only the fiber that posted the copy
    /// knows how much of its own array went out; only it can fence the stream; and
    /// because it holds that stream's write mutex until it unwinds, it is the only
    /// party that can fence it before another writer appends onto the hole. Round
    /// 13's other reason survives whole, as the rule above.
    ///
    /// `ReadFutureValue`'s cancel is the third instance and states the same rule
    /// in its own terms: lift only when the cancel lost.
    function settleCancelledRead(
        self,
        read: ComponentStreamRead<Any, Any>,
        copy: CopyOperation,
        deliver: Bool
    ): (Bool, Result<Any, Any>) =
        let cancelled = read.cancel()
        if deliver && self.cancelCarriesNews(cancelled.copyResult, cancelled.copyCount) then
            (true, self.settleRead(read, copy, cancelled.copyResult, cancelled.copyCount))
        else
            // Elements nobody will receive are the RECORD's to release, not
            // this layer's to guess at: `discardElements` frees the pinned
            // buffer at a count of zero and, at a count a raced cancel handed
            // back, also closes whatever the elements own — a socket the
            // accept stream's copy carried, nothing for bytes. `lift` here
            // (the old shape) materialized those elements with no fiber left
            // to give them to, which for owned elements is a stranded live
            // handle. The `false` is the whole of what the caller reads;
            // the payload slot is never looked at.
            read.discardElements(copy, cancelled.copyCount)
            (false, Ok(()))

    /// The write-side twin. Same rule, same shape — see `settleCancelledRead`.
    ///
    /// No `discardElements` twin, and the asymmetry is by construction, not
    /// omission. A write's elements flow GUEST → HOST: whatever the host took
    /// before the cancel landed is the host's to own or unwind, and what is
    /// left behind is a pinned buffer holding a private copy of the caller's
    /// bytes — `ComponentStreamWrite.start` takes `Array<Uint8>`, so there is
    /// no element type whose leftovers could own a handle. `Stream.discard`
    /// below is therefore the whole of the release, on every path.
    function settleCancelledWrite(
        self,
        write: ComponentStreamWrite<Any>,
        copy: CopyOperation,
        deliver: Bool
    ): (Bool, Result<Any, Any>) =
        let cancelled = write.cancel()
        // Unconditional, and the write side's whole equivalent of a lift: the
        // buffer is a private copy of the caller's bytes, so there is never
        // anything in it that anybody upstream wants back.
        Stream.discard(copy)
        if deliver && self.cancelCarriesNews(cancelled.copyResult, cancelled.copyCount) then
            (true, self.settleWrite(write, cancelled.copyResult, cancelled.copyCount))
        else
            let noEnding: Option<Any> = None
            (false, Ok((cancelled.copyResult, cancelled.copyCount, noEnding)))

    /// Whether a cancelled copy has anything the fiber has to be told, which is
    /// the whole of the undo/late-completion test and is the same on both ends.
    ///
    /// A COUNT is the obvious half: elements moved, or bytes taken, and only the
    /// fiber that asked can take custody of either.
    ///
    /// `Dropped` IS THE OTHER HALF, and it is news at a count of zero. The status
    /// is the host telling the GUEST that the stream has ended, and that telling
    /// happens whether or not anybody passes it on: the end is now known, and
    /// posting another copy on a stream one has been told about is what the
    /// runtime traps on ("cannot read after being notified that the writable end
    /// dropped"). Treating it as an undo left the wrapper `Open`, contradicting
    /// something the host had already said and arming exactly that trap for the
    /// next reader. `Cancelled` and `Completed` at a count of zero really are
    /// undos — nothing moved and nothing ended.
    function cancelCarriesNews(self, result: CopyResult, count: Int32): Bool =
        count > 0 || result == CopyResult.Dropped

    /// The write-side twin of `settleRead`, and now the same shape: there is
    /// nothing to lift — a write yields how many elements the host accepted — so
    /// the triple is `(result, count, ending)`.
    ///
    /// It never RAISES the ending, and that is the change. A failed `Result` here
    /// arrived at the wrapper through a `catchAll`, which cannot tell a transport
    /// ending from the `canceledError` the runtime raises in a fiber it detaches
    /// — so the wrapper recorded "the one-shot result future has been spent" on a
    /// path where nothing had spent it, and the `close` doing the detaching then
    /// skipped the read it exists to make. Alongside rather than instead is the
    /// same fix the read side got for the same reason, and it is what makes the
    /// ledger provable: `ending()` is called here and in
    /// `WasiOutputStream.dropHandles`, and nowhere else.
    ///
    /// It also stops the count going missing on a copy that both moved bytes and
    /// ended: `write` promises all of them were accepted, and a failure has
    /// nowhere to say how many were.
    ///
    /// `spendEnding` and not `ending`: the write end's future has a second reader
    /// — the wrapper, when it lets the handles go — and whether this one has
    /// already been spent is a fact about the HANDLE, which is where the record of
    /// it lives. It used to be a field on the wrapper, set by the fiber this
    /// outcome is handed to, and an interrupt landing on that fiber before it ran
    /// left the wrapper believing the future unread. See `EndingLedger`.
    function settleWrite(
        self,
        write: ComponentStreamWrite<Any>,
        result: CopyResult,
        count: Int32
    ): Result<Any, Any> =
        let ending: () => Result<Unit, Any> = () => write.spendEnding()
        Ok((result, count, self.endedWith(result, ending)))

    /// Read a stream's paired result future, if the copy reported the stream
    /// ended and the interface pairs one.
    ///
    /// One-shot: the future resolves when the host is finished with the stream, so
    /// it is read exactly once, at the ending, and dropped. Callers must not post
    /// another copy on a stream they have seen end — every stream wrapper in
    /// `standard.io` latches the ending for exactly this reason.
    function endedWith(self, result: CopyResult, ending: () => Result<Unit, Any>): Option<Any> =
        if result != CopyResult.Dropped then
            None
        else
            match ending() with
                case Error(error) => Some(error)
                case Ok(_) => None

    function runFiber(self, fiber: FiberState): Unit =
        let mutable steps = 0
        let mutable keepGoing = true
        while keepGoing do
            match fiber.status with
            case FiberStatus.Running =>
                // Keep stepping past the fairness budget WHILE the fiber is masked
                // (`!interruptible`), so the boundary never splits an uninterruptible region.
                // Splitting one lets another fiber run mid-mask and set `interruptPending`,
                // and the mask-pop then replaces the region's result with `Interrupted` —
                // e.g. losing an already-dequeued `Queue.take` element. This relies on every
                // masked region being bounded (the library's finalizers/lock ops never loop
                // unboundedly and a mask that PARKS leaves `Running`, exiting this loop anyway).
                if steps < 1024 || !fiber.interruptible then
                    self.step(fiber)
                    steps = steps + 1
                    // A `Yield` node asked to give up the rest of this run. Honor
                    // it only while interruptible: yielding mid-mask would let a
                    // sibling run and set `interruptPending`, and the mask-pop
                    // would then replace the region's carried value with
                    // `Interrupted` — the very corruption the budget check above
                    // avoids by never splitting an uninterruptible region. Masked,
                    // the flag is cleared and the fiber just continues (yield is a
                    // no-op there); ending the run while `Running` re-enqueues it.
                    if fiber.yielding then
                        fiber.yielding = false
                        if fiber.interruptible then
                            keepGoing = false
                else
                    keepGoing = false
            case _ =>
                keepGoing = false
        // If still running after budget, re-enqueue for fairness
        match fiber.status with
        case FiberStatus.Running =>
            // The budget boundary is also a DELIVERY point for a deferred
            // interrupt. The ordinary points — a park, a host-op post, a
            // bracket acquire — assume the fiber keeps suspending; a fiber
            // that ran a whole budget without reaching one is in a long pure
            // computation (a parser over a handed-back buffer, a thunk loop),
            // and the mask on the value it carries must not become a permanent
            // exemption: with every later interrupt deferred behind it, the
            // fiber was unkillable and shutdown hung with it always runnable.
            // Delivering here bounds the deferral at one budget of work.
            // `deliverDeferredInterrupt` still respects `interruptible`, so a
            // masked region stays masked. The carried value is lost, as it is
            // at any other delivery point — the fiber is dying either way, and
            // a bounded loss beats an unbounded hang.
            self.deliverDeferredInterrupt(fiber)
            self.runQueue.enqueue(fiber.id)
        case _ => ()

    function wakeReadyFiber(self, fiberId: FiberId, whenReady: Async<Any, Any>, value: Bool, elements: Bool): Unit =
        match self.fibers.get(fiberId) with
        case Some(readyFiber) =>
            match readyFiber.status with
            case FiberStatus.Suspended =>
                readyFiber.asyncValue = whenReady
                // Which wakes carry: an ELEMENT-bearing one always — the bytes
                // or accepted socket must reach their deposit even under a
                // pending interrupt. Any other successful wake carries only
                // when no interrupt is pending yet: its value may own something
                // (a subtask's finish can materialize a handle, and
                // `forkAndUse` hands the value on with no acquire frame to arm
                // a release), so a Running-arm interrupt must not clobber it —
                // but if the fiber is ALREADY condemned by a mask-deferred
                // interrupt, carrying would only push delivery past the mask
                // pop that is about to pay it, and a release's sleep would
                // come back to drop the interrupt at completion.
                // A failure wake (`value` false) carries nothing: a `FailCause`
                // owns no handle, and a stale flag on a fiber that recovers and
                // finishes inside the window would drop a later interrupt.
                //
                // And only when the value is EXPOSED: a fiber woken inside a
                // mask cannot be clobbered — the Running arm already defers for
                // it — so carrying would buy nothing and cost the mask pop its
                // delivery (a lock handoff can enqueue a grantee ahead of the
                // woken fiber, and the grantee's interrupt lands in that window).
                // Elements are the exception either way: bytes and sockets must
                // reach their deposit.
                let carrying = value && (elements || (!readyFiber.interruptPending && readyFiber.interruptible))
                // A wake that WON the race against an interrupt deposits its
                // payload as a pending `Succeed` — which the Running arm of
                // `interruptFiber` clobbers. When the payload owns something (a
                // read's bytes, an accepted socket the lift just materialized),
                // clobbering is a leak with nothing left to close it: the
                // suspension is gone, so no cancel path runs, and no release is
                // armed yet. Mark the fiber as carrying, exactly as the
                // raced-cancel hand-back does; an interrupt landing before its
                // next step defers to the safe point where the value is owned.
                if carrying then
                    readyFiber.maskedUntilSafePoint = true
                readyFiber.status = FiberStatus.Running
                self.runQueue.enqueue(readyFiber.id)
            case _ => ()
        case None => ()

    /// Drain runnable work, returning after a bounded batch when host operations
    /// are pending. The event loop decides whether to poll or wait for them.
    function drainRunQueue(self): Unit =
        let mutable moreToRun = true
        let mutable turns = 0
        while moreToRun && (turns < 16 || self.suspensions.isEmpty) do
            if turns < 16 then turns = turns + 1
            match self.runQueue.dequeue() with
            case Some(fiberId) =>
                match self.fibers.get(fiberId) with
                case Some(fiber) =>
                    match fiber.status with
                    case FiberStatus.Running => self.runFiber(fiber)
                    case _ => ()
                case None => ()
            case None =>
                moreToRun = false

    /// Deliver one host completion event to the fiber parked on `index`.
    public function deliver(self, event: Int32, index: Waitable, payload: EventPayload): Unit =
        match self.suspensions.get(index) with
        case Some(susp) =>
            // The payload word means whatever the event code says it means, and
            // nothing in the word itself would give away a mismatch: a subtask
            // state 2 (RETURNED) reads as a copy `Dropped` with a count of 0, so
            // crossing the two would hand a fiber a clean end of stream that
            // never happened. Check rather than assume — this is the one place
            // the code is known alongside what was posted.
            if event != susp.kind.eventCode then
                panic "runtime received event " ++ event.format() ++ " for a waitable expecting " ++ susp.kind.eventCode.format()
            // The waitable's event was consumed; unlink it everywhere (see
            // `unlinkSuspension` for the ordering) so a stream handle can be
            // re-armed (re-read/re-write) on a later suspension. SubtaskHandle
            // handles are released by the continuation.
            self.unlinkSuspension(index)
            // onEvent yields the resumption as a pure Result; lift it into the
            // fiber's next Async (Ok → Succeed, Error → a typed failure).
            let outcome = susp.onEvent(payload)
            // The copy is done, so the handle is free for whoever is queued behind
            // it. Hand off before resuming: both only enqueue, and releasing first
            // keeps the lock's lifetime exactly one copy.
            self.releaseSuspensionLock(susp, index)
            self.resumeSuspension(susp, outcome)
        case None =>
            panic "runtime received an event for an unknown waitable"

    /// Explain a stall. Only ever called on the panic path, so scanning every
    /// fiber is free. A scope waiting on a fiber that will never finish is the
    /// failure mode structured `fork` introduces, and it is unreadable without
    /// naming who is waiting for whom.
    internal function stallMessage(self): String =
        let mutable message = "Deadlock: no runnable fibers and no pending waitables"
        for entry in self.fibers do
            let fiber = entry._1
            message = message ++ self.producerWaitDescription(fiber)
            match fiber.status with
            case FiberStatus.Draining(scopeId) =>
                message = message ++ self.drainingDescription(fiber, scopeId)
            case _ => ()
        message

    function producerWaitDescription(self, fiber: FiberState): String =
        match self.producerRequests.get(fiber.id) with
            case Some(request) =>
                let operation = match request.kind with
                    case ProducerRequestKind.Create => "producer acquisition or its cleanup"
                    case ProducerRequestKind.Pull => "producer pull or its cleanup"
                    case ProducerRequestKind.Stop => "producer cleanup"
                "\n  fiber " ++ fiber.id.value.format() ++ " is waiting for " ++ operation
            case None => ""

    function drainingDescription(self, fiber: FiberState, scopeId: ScopeId): String =
        match self.scopes.get(scopeId) with
        case None => ""
        case Some(scopeRecord) =>
            let waitingFor = " is waiting for " ++ self.scopeChildList(scopeRecord) ++
                ". Use `forkBackground` for a fiber that should be cancelled instead of waited for."
            if scopeId.equals(fiber.rootScope) then
                "\n  fiber " ++ fiber.id.value.format() ++
                    " has finished its body but" ++ waitingFor
            else
                "\n  fiber " ++ fiber.id.value.format() ++
                    " is closing a `use` scope — the resource stays open until it does — and" ++ waitingFor

    function scopeChildList(self, scopeRecord: ScopeRecord): String =
        let mutable ids: List<String> = List.empty
        for childId in scopeRecord.structured do
            ids = ids.prepend(childId.value.format())
        for childId in scopeRecord.background do
            ids = ids.prepend(childId.value.format())
        let ordered = ids.reverse()
        match ordered with
            case Cons(only, Nil) => "fiber " ++ only
            case _ => "fibers " ++ String.join(ordered, ", ")

    function observeProducerCleanup(self, fiber: FiberState, scope: ScopeId): Unit =
        match self.producers.get(fiber.id) with
            case Some(producer) =>
                if producer.releaseScope.equals(scope) then
                    fiber.continuation.push(Frame.ProducerCleanupFrame(producer))
            case None => ()

    function createProducer(self, caller: FiberState, node: CreateProducer<Any, Any, Any>): Unit =
        let handle = node.makeHandle(self.nextFiberId, caller.id)
        let pull = (state: Any) =>
            let effect: Async<Any, Any> = node.pull(state)
            effect
        let producer = ProducerState(handle, caller.currentScope, ProducerPhase.Acquiring,
            pull, ScopeId(-1), None)
        let body = (value: Any) =>
            let effect: Async<Any, Any> = ProducerAcquired(producer, value)
            effect
        let release = (value: Any, _: Result<Any, Cause<Any>>) =>
            let onFailure = (cause: Cause<Any>) =>
                producer.phase = ProducerPhase.Closing(Some(cause))
                let failed: Async<Any, Any> = FailCause(cause)
                failed
            let onSuccess = (_: Any) =>
                let done: Async<Any, Any> = Succeed(())
                done
            FoldCause<Unit, Never>(node.release(value), onFailure, onSuccess)
        let program: Async<Any, Any> = Bracket<Any, Any>(node.acquire, release, body)
        // Ownership is established before either the child or its caller can run.
        self.createFiber(program, caller.currentScope, caller.id, ChildKind.Background)
        self.producers.put(handle.fiber, producer)
        let scope = self.scopeRecordFor(caller.currentScope, caller.id)
        scope.producers = scope.producers.prepend(producer)
        let request = ProducerRequest(caller.id, producer, ProducerRequestKind.Create, false)
        self.beginProducerRequest(caller, request)

    function requestProducer(self, caller: FiberState, handle: Producer<Any, Any>, kind: ProducerRequestKind): Unit =
        match self.producers.get(handle.fiber) with
            case Some(producer) =>
                if !ClassIdentity.equals(producer.handle, handle) then
                    self.closedProducerResult(caller, kind)
                else if !handle.creator.equals(caller.id) then
                    caller.asyncValue = FailCause<Any>(Cause.Panicked("only the creating fiber may pull or interrupt a producer", caller.trace))
                else if self.producerRequests.contains(caller.id) then
                    caller.asyncValue = FailCause<Any>(Cause.Panicked("overlapping producer request", caller.trace))
                else
                    let request = ProducerRequest(caller.id, producer, kind, false)
                    self.beginProducerRequest(caller, request)
            case None => self.closedProducerResult(caller, kind)

    function closedProducerResult(self, caller: FiberState, kind: ProducerRequestKind): Unit =
        match kind with
            case ProducerRequestKind.Stop => caller.asyncValue = Succeed(())
            case _ =>
                let end: Option<Never> = None
                caller.asyncValue = FailCause(Cause.Failed(end, caller.trace))

    function beginProducerRequest(self, caller: FiberState, request: ProducerRequest): Unit =
        self.producerRequests.put(caller.id, request)
        match request.kind with
            case ProducerRequestKind.Stop => self.stopProducerRequest(caller, request, None)
            case _ =>
                caller.continuation.push(Frame.ProducerRequestFrame(request))
                self.checkProducerRequest(caller, request)

    function detachProducerRequest(self, request: ProducerRequest): Unit =
        request.active = false
        match request.producer.waiter with
            case Some(waiting) =>
                if ClassIdentity.equals(waiting, request) then request.producer.waiter = None
            case None => ()

    function notifyProducer(self, producer: ProducerState, result: Async<Any, Any>): Unit =
        match producer.waiter with
            case Some(request) =>
                if request.active then
                    self.detachProducerRequest(request)
                    match self.fibers.get(request.caller) with
                        case Some(caller) =>
                            caller.asyncValue = result
                            self.wakeWaiter(caller)
                        case None => ()
            case None => ()

    function parkProducerRequest(self, caller: FiberState, request: ProducerRequest): Unit =
        if self.beginPark(caller) then
            request.active = true
            request.producer.waiter = Some(request)

    function checkProducerRequest(self, caller: FiberState, request: ProducerRequest): Unit =
        let producer = request.producer
        match producer.phase with
            case ProducerPhase.Failed(cause, _) =>
                self.forgetProducer(producer)
                caller.asyncValue = FailCause(cause)
            case ProducerPhase.Closed => self.closedProducerResult(caller, request.kind)
            case ProducerPhase.Idle(state) =>
                match request.kind with
                    case ProducerRequestKind.Create => caller.asyncValue = Succeed(producer.handle)
                    case _ =>
                        if !self.deliverDeferredInterrupt(caller) then
                            self.startProducerPull(producer, state)
                            self.parkProducerRequest(caller, request)
            case _ => self.parkProducerRequest(caller, request)

    function startProducerPull(self, producer: ProducerState, state: Any): Unit =
        let child = self.fibers.get(producer.handle.fiber).require
        producer.phase = ProducerPhase.Pulling(state)
        child.continuation.push(Frame.ProducerValueFrame { producer = producer; cleanupFailure = None })
        // Build the pull effect on the producer, so pure code and defects also run
        // with its scope and interruption state, rather than on the driver.
        let suspended: Async<Async<Any, Any>, Any> = Async.thunk(() => producer.pull(state))
        child.asyncValue = suspended.andThen((effect: Async<Any, Any>) => effect)
        self.wakeWaiter(child)

    function stopProducerRequest(self, caller: FiberState, request: ProducerRequest, failure: Option<Cause<Any>>): Unit =
        self.detachProducerRequest(request)
        match self.fibers.get(request.producer.handle.fiber) with
            case Some(child) => self.interruptFiber(child)
            case None => ()
        let step: Async<Any, Any> = Succeed(())
        // Wait inside the mask, but choose the final outcome after deferred
        // cancellation is delivered at mask exit. Cleanup panics win there too.
        self.runMaskedUnwind(caller, Frame.ProducerShutdownFrame { request = request; originalFailure = failure }, step)
        caller.continuation.push(Frame.ProducerAwaitFrame(request))

    function awaitProducerShutdown(self, caller: FiberState, request: ProducerRequest): Unit =
        let producer = request.producer
        if !producer.phase.isFinished then
            // A pull may catch interruption and return an item. Interrupt again
            // once it is Idle so shutdown cannot leave both fibers parked.
            if producer.phase.isIdle then
                match self.fibers.get(producer.handle.fiber) with
                    case Some(child) => self.interruptFiber(child)
                    case None => ()
            caller.continuation.push(Frame.ProducerAwaitFrame(request))
            self.parkProducerRequest(caller, request)
        else caller.asyncValue = Succeed(())

    function finishProducerShutdown(self, caller: FiberState, request: ProducerRequest, originalFailure: Option<Cause<Any>>): Unit =
        caller.trace = caller.trace.tail
        self.detachProducerRequest(request)
        let producer = request.producer
        let failure = match producer.phase with
            case ProducerPhase.Failed(_, Some(cause)) =>
                match cause with
                    case Cause.Panicked(_, _) =>
                        self.preserveProducerCleanup(caller, cause)
                        Some(cause)
                    case _ => originalFailure
            case _ => originalFailure
        self.forgetProducer(producer)
        self.producerRequests.remove(caller.id)
        match failure with
            case Some(cause) => caller.asyncValue = FailCause(cause)
            case None => caller.asyncValue = Succeed(())

    // A child shutdown's cleanup panic remains cleanup when it unwinds through
    // its owner's active pull. Keep that provenance on the pull's frame, where
    // successful completion discards it. A foldCause handler gets a frame of
    // its own: success recovers and drops provenance; a panic from the handler
    // remains cleanup failure, including a replacement panic or mapError rethrow.
    function preserveProducerCleanup(self, caller: FiberState, cause: Cause<Any>): Unit =
        let mutable saved: List<Frame> = []
        let mutable searching = true
        while searching do
            match caller.continuation.pop() with
                case None => searching = false
                case Some(frame) =>
                    match frame with
                        case Frame.ProducerValueFrame { producer } =>
                            caller.continuation.push(Frame.ProducerValueFrame { producer = producer; cleanupFailure = Some(cause) })
                            searching = false
                        case Frame.FoldCauseFrame {} =>
                            caller.continuation.push(Frame.ProducerCleanupHandlerFrame)
                            caller.continuation.push(frame)
                            searching = false
                        case _ => saved = saved.prepend(frame)
        for frame in saved do caller.continuation.push(frame)

    function completeProducer(self, fiber: FiberState, result: FiberResult): Unit =
        match self.producers.get(fiber.id) with
            case None => ()
            case Some(producer) =>
                producer.pull = (_: Any) => Async.succeed(())
                let cleanupFailure = match producer.phase with
                    case ProducerPhase.Closing(failure) => failure
                    case _ => None
                producer.phase = match result with
                    case FiberResult.Succeeded(_) => ProducerPhase.Closed
                    case FiberResult.FiberFailed(cause) => ProducerPhase.Failed(cause, cleanupFailure)
                let completed: Async<Any, Any> = match result with
                    case FiberResult.Succeeded(_) =>
                        let end: Option<Never> = None
                        FailCause(Cause.Failed(end, fiber.trace))
                    case FiberResult.FiberFailed(cause) => FailCause(cause)
                self.notifyProducer(producer, completed)
                match producer.phase with
                    case ProducerPhase.Closed => self.forgetProducer(producer)
                    case _ => ()

    function forgetProducer(self, producer: ProducerState): Unit =
        self.producers.remove(producer.handle.fiber)
        match self.scopes.get(producer.ownerScope) with
            case Some(scope) =>
                scope.producers = scope.producers.filter((other: ProducerState) => !ClassIdentity.equals(other, producer))
            case None => ()

    /// Deliver one bounded batch, counting the initial wait result toward the
    /// same budget as polled events. Only wait when no fiber can run.
    function drainHostEvents(self): Unit =
        let eventBatchSize = 64
        let mutable delivered = 0
        if self.runQueue.isEmpty then
            let event = self.waitableSet.wait()
            self.deliver(event.event, event.index, event.payload)
            delivered = 1
        let mutable moreEvents = true
        while moreEvents && delivered < eventBatchSize && !self.suspensions.isEmpty do
            match self.waitableSet.poll() with
                case Some(event) =>
                    self.deliver(event.event, event.index, event.payload)
                    delivered = delivered + 1
                case None => moreEvents = false

    /// Alternate runnable and host-event batches. Yield less often than polling,
    /// always before the batch's first wait or poll. A wait may return immediately,
    /// so only an explicit yield resets the counter.
    public function eventLoop(self): Unit =
        let hostYieldInterval = 4
        let mutable batchesSinceYield = 0
        let mutable mainCompleted = false
        while !mainCompleted do
            self.drainRunQueue()
            match self.mainFiber.completedResult with
            case Some(_) => mainCompleted = true
            case None =>
                if self.suspensions.isEmpty then
                    if self.runQueue.isEmpty then panic self.stallMessage()
                else
                    batchesSinceYield = batchesSinceYield + 1
                    if batchesSinceYield == hostYieldInterval then
                        WaitableSet.yieldToHost()
                        batchesSinceYield = 0
                    self.drainHostEvents()


test "FiberResult Succeeded" =
    let r = FiberResult.Succeeded(42)
    match r with
    case FiberResult.Succeeded(v) => assert (v as Int32) == 42
    case _ => panic "expected Succeeded"

test "FiberResult FiberFailed" =
    let trace: List<SourceLocation> = List.empty
    let c: Cause<Any> = Cause.Failed("err", trace)
    let r = FiberResult.FiberFailed(c)
    match r with
    case FiberResult.FiberFailed(Cause.Failed(_, _)) => ()
    case _ => panic "expected FiberFailed"

test "Runtime: simple succeed" =
    let p: Async<Unit, Never> = Succeed(())
    p.run()

test "Runtime: succeed with value" =
    let p: Async<Int32, Never> = Succeed(42)
    let mapped: Async<Unit, Never> = p.map((v: Int32) => assert v == 42)
    mapped.run()

test "Runtime: fork and join" =
    let program: Async<Int32, Never> = Succeed(42)
    let forked: Async<Fiber<Int32, Never>, Never> = program.fork()
    let joined: Async<Int32, Never> = forked.andThen((f: Fiber<Int32, Never>) => f.join())
    let asserted: Async<Unit, Never> = joined.map((v: Int32) => assert v == 42)
    asserted.run()

function assertFiberPanicked(fiber: FiberState, expectedMsg: String): Unit =
    match fiber.handle.completedResult with
    case Some(FiberResult.FiberFailed(Cause.Panicked(msg, _))) => assert msg == expectedMsg
    case _ => panic "expected fiber to panic"

function joinAndAssert(f1: Fiber<Int32, Never>, f2: Fiber<Int32, Never>): Async<Unit, Never> =
    let j1: Async<Int32, Never> = f1.join()
    j1.andThen((v1: Int32) => f2.join().map((v2: Int32) => assert v1 + v2 == 30))

function forkSecondAndJoin(f1: Fiber<Int32, Never>): Async<Unit, Never> =
    let p2: Async<Int32, Never> = Succeed(20)
    p2.fork().andThen((f2: Fiber<Int32, Never>) => joinAndAssert(f1, f2))

test "Runtime: multiple forks" =
    let p1: Async<Int32, Never> = Succeed(10)
    let program: Async<Unit, Never> = p1.fork().andThen((f1: Fiber<Int32, Never>) => forkSecondAndJoin(f1))
    program.run()

function assertFiberSucceeded(fiber: FiberState): Unit =
    match fiber.handle.completedResult with
    case Some(FiberResult.Succeeded(_)) => ()
    case _ => panic "expected fiber to succeed"

function assertFiberInterruptedOrSucceeded(fiber: FiberState): Unit =
    match fiber.handle.completedResult with
    case Some(FiberResult.FiberFailed(Cause.Interrupted(_))) => ()
    case Some(FiberResult.Succeeded(_)) => ()
    case _ => panic "expected fiber to be interrupted or succeeded"

function makeAndComplete(p: Promise<Int32, Never>): Async<Unit, Never> =
    let completed: Async<Bool, Never> = p.complete(42)
    completed.andThen((_: Bool) => p.awaitPromise().map((v: Int32) => assert v == 42))

test "Runtime: make and complete promise" =
    let makeP: Async<Promise<Int32, Never>, Never> = Async.makePromise()
    let program: Async<Unit, Never> = makeP.andThen((p: Promise<Int32, Never>) => makeAndComplete(p))
    program.run()

function awaitBeforeCompleteBody(p: Promise<Int32, Never>): Async<Unit, Never> =
    let forked: Async<Fiber<Int32, Never>, Never> = p.awaitPromise().fork()
    forked.andThen((f: Fiber<Int32, Never>) => completeAndJoinPromise(p, f))

function completeAndJoinPromise(p: Promise<Int32, Never>, f: Fiber<Int32, Never>): Async<Unit, Never> =
    let completed: Async<Bool, Never> = p.complete(42)
    completed.andThen((_: Bool) => f.join().map((v: Int32) => assert v == 42))

test "Runtime: promise await before complete" =
    let makeP: Async<Promise<Int32, Never>, Never> = Async.makePromise()
    let program: Async<Unit, Never> = makeP.andThen((p: Promise<Int32, Never>) => awaitBeforeCompleteBody(p))
    program.run()

test "Runtime: basic interrupt" =
    let mutable childRan = false
    let makeP: Async<Promise<Int32, Never>, Never> = Async.makePromise()
    let program: Async<Unit, Never> = makeP.andThen((p: Promise<Int32, Never>) =>
        let waiting: Async<Int32, Never> = p.awaitPromise().map((v: Int32) =>
            childRan = true
            v
        )
        waiting.fork().andThen((f: Fiber<Int32, Never>) =>
            f.interrupt().andThen((_: Unit) =>
                p.complete(42).map((_: Bool) => ())
            )
        )
    )
    program.run()
    assert !childRan

test "Runtime: interrupt completed fiber is no-op" =
    let child: Async<Int32, Never> = Succeed(42)
    let program: Async<Unit, Never> = child.fork().andThen((f: Fiber<Int32, Never>) =>
        f.join().andThen((v: Int32) =>
            assert v == 42
            f.interrupt()
        )
    )
    program.run()

test "Runtime: interrupt deferred in uninterruptible" =
    let mutable marker = 0
    let makeP1: Async<Promise<Int32, Never>, Never> = Async.makePromise()
    let makeSync: Async<Promise<Unit, Never>, Never> = Async.makePromise()
    let program: Async<Unit, Never> = makeP1.andThen((p1: Promise<Int32, Never>) =>
        makeSync.andThen((pSync: Promise<Unit, Never>) =>
            // Child: enter uninterruptible, signal pSync, then await p1
            let body: Async<Int32, Never> =
                let start: Async<Unit, Never> = Succeed(())
                start.andThen((_: Unit) =>
                    pSync.complete(()).andThen((_: Bool) =>
                        p1.awaitPromise().andThen((v: Int32) =>
                            marker = 1
                            let result: Async<Int32, Never> = Succeed(v)
                            result
                        )
                    )
                )
            let uninterruptibleWork: Async<Int32, Never> = Uninterruptible(body)
            uninterruptibleWork.fork().andThen((f: Fiber<Int32, Never>) =>
                // Wait for child to enter uninterruptible region
                pSync.awaitPromise().andThen((_: Unit) =>
                    // Child is now Suspended+!interruptible
                    f.interrupt().andThen((_: Unit) =>
                        p1.complete(99).map((_: Bool) => ())
                    )
                )
            )
        )
    )
    program.run()
    assert marker == 1

test "Runtime: a completing fiber interrupts its background children" =
    let makeP: Async<Promise<Int32, Never>, Never> = Async.makePromise()
    let program: Async<Unit, Never> = makeP.andThen((p: Promise<Int32, Never>) =>
        let waiting: Async<Int32, Never> = p.awaitPromise()
        // Background: nothing ever completes `p`, so the parent's exit is the
        // only thing that can end this fiber. A plain `fork` here would wait
        // for it forever — see the test below.
        let parentBody: Async<Unit, Never> = waiting.forkBackground().andThen((child: Fiber<Int32, Never>) =>
            let done: Async<Unit, Never> = Succeed(())
            done
        )
        parentBody.fork().andThen((parent: Fiber<Unit, Never>) =>
            parent.join().andThen((_: Unit) =>
                let done: Async<Unit, Never> = Succeed(())
                done
            )
        )
    )
    program.run()

test "Runtime: forkBackground child interrupted when parent completes" =
    let mutable childRan = false
    let makeP: Async<Promise<Int32, Never>, Never> = Async.makePromise()
    let program: Async<Unit, Never> = makeP.andThen((p: Promise<Int32, Never>) =>
        let childBody: Async<Int32, Never> = p.awaitPromise().map((v: Int32) =>
            childRan = true
            v
        )
        let parentBody: Async<Unit, Never> = childBody.forkBackground().map((_: Fiber<Int32, Never>) => ())
        parentBody.fork().andThen((parent: Fiber<Unit, Never>) =>
            parent.join().andThen((_: Unit) =>
                p.complete(42).map((_: Bool) => ())
            )
        )
    )
    program.run()
    // The parent returned immediately, which cancelled the child before the
    // promise was ever completed. `fork` would instead have kept the parent
    // alive until the child finished — the test below.
    assert !childRan

test "Runtime: fork makes the parent wait for its child" =
    let mutable childRan = false
    let makeP: Async<Promise<Int32, Never>, Never> = Async.makePromise()
    let program: Async<Unit, Never> = makeP.andThen((p: Promise<Int32, Never>) =>
        let childBody: Async<Int32, Never> = p.awaitPromise().map((v: Int32) =>
            childRan = true
            v
        )
        let parentBody: Async<Unit, Never> = childBody.fork().map((_: Fiber<Int32, Never>) => ())
        parentBody.fork().andThen((parent: Fiber<Unit, Never>) =>
            // Complete the promise BEFORE joining: the parent's body is already
            // over, but the parent does not finish until its structured child
            // does, so the join only returns once the child has run.
            p.complete(42).andThen((_: Bool) =>
                parent.join()
            )
        )
    )
    program.run()
    assert childRan


// The stall diagnostic is what a user sees when a scope waits on a fiber that
// can never finish — the one new way to hang that structured `fork` introduces.
// It cannot be asserted through a real deadlock: a Dovetail `panic` writes its
// text to stderr and traps, so a test only ever observes the trap. Build the
// stalled state directly instead.

test "Runtime: a stalled fiber body names the fiber it is waiting for" =
    let program: Async<Any, Any> = Succeed(())
    let runtime = Runtime.make(program)
    let main = runtime.fibers.get(FiberId.zero).require
    let _child = runtime.createFiber(program, main.rootScope, main.id, ChildKind.Structured)
    main.status = FiberStatus.Draining(main.rootScope)
    let message = runtime.stallMessage()
    assert message.contains("Deadlock: no runnable fibers")
    assert message.contains("fiber 0 has finished its body but is waiting for fiber 1")
    // The way out has to be in the message; nothing else points at it.
    assert message.contains("forkBackground")

test "Runtime: a stalled scope close says it is a `use` scope" =
    let program: Async<Any, Any> = Succeed(())
    let runtime = Runtime.make(program)
    let main = runtime.fibers.get(FiberId.zero).require
    let scope = runtime.openScope(main)
    let _first = runtime.createFiber(program, scope, main.id, ChildKind.Structured)
    let _second = runtime.createFiber(program, scope, main.id, ChildKind.Background)
    main.status = FiberStatus.Draining(scope)
    let message = runtime.stallMessage()
    assert message.contains("is closing a `use` scope")
    // Both fibers are named, whatever kind they were forked as.
    assert message.contains("fibers 1, 2")

test "Runtime: a completed fiber is no longer registered" =
    let program: Async<Any, Any> = Succeed(())
    let runtime = Runtime.make(program)
    let main = runtime.fibers.get(FiberId.zero).require
    let handle = runtime.createFiber(program, main.rootScope, main.id, ChildKind.Structured)
    let child = runtime.fibers.get(handle.id).require
    assert runtime.fibers.get(handle.id).isSome
    runtime.completeFiber(child, FiberResult.Succeeded(()))
    // A server forking a fiber per connection must not accumulate one dead
    // `FiberState` per request it has ever served.
    assert runtime.fibers.get(handle.id).isNone
    // The result still resolves — through the handle, not the registry.
    assert handle.completedResult.isSome
    // Main always stays: `run` resolves the program's result through it.
    assert runtime.fibers.get(FiberId.zero).isSome

test "Runtime identity: waiter registration and pending wakes are idempotent" =
    let program: Async<Any, Any> = Succeed(())
    let runtime = Runtime.make(program)
    let fiber = runtime.fibers.get(FiberId.zero).require
    let signal = Waiter.make()
    runtime.addWaiter(signal, fiber.id)
    runtime.addWaiter(signal, fiber.id)
    assert fiber.registeredWaiters.length == 1
    runtime.wakeWaiters(signal)
    assert signal.suspended.isEmpty
    assert fiber.pendingWakes.length == 1
    assert fiber.hasPendingWake(signal)
    runtime.unregisterWaiter(signal, fiber.id)
    fiber.forgetWake(signal)
    assert fiber.registeredWaiters.isEmpty
    assert fiber.pendingWakes.isEmpty
    runtime.addWaiter(signal, fiber.id)
    runtime.removeWaiterRegistrations(fiber.id)
    assert signal.suspended.isEmpty
    assert fiber.registeredWaiters.isEmpty

test "Runtime identity: retained waiter has no registrations from the previous runtime" =
    let program: Async<Any, Any> = Succeed(())
    let first = Runtime.make(program)
    let firstFiber = first.fibers.get(FiberId.zero).require
    let signal = Waiter.make()
    first.addWaiter(signal, firstFiber.id)
    firstFiber.recordWake(signal)
    first.completeFiber(firstFiber, FiberResult.Succeeded(()))
    assert signal.suspended.isEmpty
    assert firstFiber.registeredWaiters.isEmpty
    assert firstFiber.pendingWakes.isEmpty
    let second = Runtime.make(program)
    let secondFiber = second.fibers.get(FiberId.zero).require
    second.addWaiter(signal, secondFiber.id)
    second.wakeWaiters(signal)
    assert secondFiber.hasPendingWake(signal)
    assert firstFiber.pendingWakes.isEmpty
    second.removeWaiterRegistrations(secondFiber.id)

test "Runtime: no stalled fiber leaves the deadlock message bare" =
    let program: Async<Any, Any> = Succeed(())
    let runtime = Runtime.make(program)
    let message = runtime.stallMessage()
    assert message == "Deadlock: no runnable fibers and no pending waitables"
