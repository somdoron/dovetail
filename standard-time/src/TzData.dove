package standard.time

/// Parsed representation of the tzdata blob embedded under
/// `standard-time/tzdata/tzdata.bin`. The format is documented at the top
/// of `tools/tzdata-compiler/src/main.rs`.
///
/// The blob is treated as immutable read-only memory: the `TzDatabase`
/// record carries an alias to it and reads on demand. No per-zone
/// `TzZone` materialization happens up front — `findZone` parses just the
/// header + zone-index entries needed to resolve the name, then returns a
/// `TzZone` that points back into the blob.
record TzDatabase =
    bytes: Array<Uint8>
    zoneCount: Int32
    /// Absolute offset to the start of the zone_index section.
    indexOffset: Int32
    namePoolOffset: Int32
    abbrevPoolOffset: Int32
    /// Absolute offset to the leap-seconds section (0 when absent).
    leapOffset: Int32

/// A resolved IANA zone — owns no data of its own; reads transitions
/// directly from the underlying blob each lookup.
record TzZone =
    /// Canonical name as stored in the index (post-link resolution: a
    /// linked alias resolves to the same data, but `id` reflects the
    /// name the caller asked for).
    id: String
    bytes: Array<Uint8>
    abbrevPoolOffset: Int32
    /// Absolute offset to this zone's data block (transition_count +
    /// transitions + posix string).
    dataOffset: Int32
    transitionCount: Int32

/// An offset returned by `TzZone.offsetAt`. Carries both the numeric UTC
/// offset (seconds) and metadata for human-facing display.
record TzOffset =
    offsetSeconds: Int32
    isDst: Bool
    abbrev: String

module TzData =
    /// Single, lazily-initialized handle to the embedded database. The
    /// `EmbeddedResource.bytes` call is resolved at compile time — codegen
    /// embeds the blob as a passive WASM data segment and `array.new_data`
    /// runs once at module init.
    let database: TzDatabase = parseHeader(EmbeddedResource.bytes("tzdata/tzdata.bin"))

    /// Find a zone by IANA name (e.g. `"America/New_York"`). Returns
    /// `None` if the name isn't in the database.
    function findZone(id: String): Option<TzZone> =
        let db = database
        if db.zoneCount == 0 then
            None
        else
            let idx = binarySearchZone(db, id)
            match idx with
                case None => None
                case Some(i) =>
                    let entryOffset = db.indexOffset + i * 16
                    let nameOffset = readU32(db.bytes [| entryOffset.. |]).toInt32()
                    let nameLength = readU32(db.bytes [| entryOffset + 4.. |]).toInt32()
                    let dataOffset = readU32(db.bytes [| entryOffset + 8.. |]).toInt32()
                    let count = readU32(db.bytes [| dataOffset.. |]).toInt32()
                    let nameStr =
                        String.fromBytes(db.bytes, db.namePoolOffset + nameOffset, nameLength)
                    Some(
                        TzZone {
                            id = nameStr
                            bytes = db.bytes
                            abbrevPoolOffset = db.abbrevPoolOffset
                            dataOffset = dataOffset
                            transitionCount = count
                        }
                    )

module TzZone =
    /// Return the active UTC offset (seconds), DST flag, and abbreviation
    /// for `epochSecond` in this zone. Walks the transition table with a
    /// binary search; complexity O(log n).
    function offsetAt(self, epochSecond: Int64): TzOffset =
        // Transitions are sorted ascending by epoch. Find the largest
        // index `i` with `transitions[i].epoch <= epochSecond`. The first
        // transition is at i64::MIN+1 (sentinel) so a match is guaranteed.
        let mutable lo = 0
        let mutable hi = self.transitionCount - 1
        while lo < hi do
            // mid biased to upper so we converge on the *largest* index
            // whose epoch is still <= target.
            let mid = (lo + hi + 1) / 2
            let midEpoch = readTransitionEpoch(self, mid)
            if midEpoch <= epochSecond then lo = mid else hi = mid - 1
        // lo is the answer.
        let transOffset = self.dataOffset + 4 + lo * 16
        let offset = readI32(self.bytes [| transOffset + 8.. |])
        let abbrevIdx = readU16(self.bytes [| transOffset + 12.. |])
        let flags = self.bytes.get(transOffset + 14)
        let isDst = (flags.toInt32() & 1) != 0
        let abbrev = readCStringAt(self.bytes, self.abbrevPoolOffset + abbrevIdx)
        TzOffset { offsetSeconds = offset; isDst = isDst; abbrev = abbrev }

// --- Internal helpers ------------------------------------------------------
/// Parse the 32-byte header and return a populated `TzDatabase` with the
/// raw `bytes` alongside cached offsets. Panics if the magic is wrong or
/// the format version is unknown — both are bugs in the build pipeline,
/// not user-recoverable runtime errors.
internal function parseHeader(bytes: Array<Uint8>): TzDatabase =
    if bytes.length < 32 then panic "tzdata blob too small"
    if bytes
        .get(0)
        != 84u8
        || bytes.get(1) != 90u8
        || bytes.get(2) != 68u8
        || bytes.get(3) != 66u8 then panic "tzdata magic mismatch (expected TZDB)"
    let version = readU32(bytes [| 4.. |])
    if version != 1i64 then panic "tzdata version unsupported"
    let zoneCount = readU32(bytes [| 8.. |]).toInt32()
    let namePoolOffset = readU32(bytes [| 12.. |]).toInt32()
    let abbrevPoolOffset = readU32(bytes [| 16.. |]).toInt32()
    let zonesOffset = readU32(bytes [| 20.. |]).toInt32()
    let leapOffset = readU32(bytes [| 24.. |]).toInt32()
    let _ = zonesOffset // not stored — `data_offset` per zone is absolute
    TzDatabase {
        bytes = bytes
        zoneCount = zoneCount
        indexOffset = 32
        namePoolOffset = namePoolOffset
        abbrevPoolOffset = abbrevPoolOffset
        leapOffset = leapOffset
    }

/// Read the epoch (Int64) of transition `i` for `zone`.
internal function readTransitionEpoch(zone: TzZone, i: Int32): Int64 =
    let off = zone.dataOffset + 4 + i * 16
    readI64(zone.bytes [| off.. |])

/// Binary search the zone_index for `id`. Returns the matching index, or
/// `None` if not found.
internal function binarySearchZone(db: TzDatabase, id: String): Option<Int32> =
    let mutable lo = 0
    let mutable hi = db.zoneCount - 1
    let mutable result: Option<Int32> = None
    let mutable done = false
    while !done && lo <= hi do
        let mid = lo + (hi - lo) / 2
        let entryOffset = db.indexOffset + mid * 16
        let nameOffset = readU32(db.bytes [| entryOffset.. |]).toInt32()
        let nameLength = readU32(db.bytes [| entryOffset + 4.. |]).toInt32()
        let cmp = compareStringToBytes(id, db.bytes, db.namePoolOffset + nameOffset, nameLength)
        if cmp == 0 then
            result = Some(mid)
            done = true
        else if cmp < 0 then
            hi = mid - 1
        else
            lo = mid + 1
    result

/// Compare a String to a byte slice (lexicographically by byte). Returns
/// `<0` if `s < slice`, `0` if equal, `>0` if greater. Used for
/// zone-index binary search.
internal function compareStringToBytes(s: String, bytes: Array<Uint8>, start: Int32, length: Int32):
    Int32 =
    let sBytes = s.bytes()
    let sLen = sBytes.length
    let mutable i = 0
    let mutable result = 0
    let mutable done = false
    let minLen = if sLen < length then sLen else length
    while !done && i < minLen do
        let a = sBytes.get(i).toInt32()
        let b = bytes.get(start + i).toInt32()
        if a != b then
            result = a - b
            done = true
        else
            i = i + 1
    if !done then result = sLen - length
    result

/// Read a NUL-terminated UTF-8 string starting at `start`.
internal function readCStringAt(bytes: Array<Uint8>, start: Int32): String =
    let mutable end = start
    while end < bytes.length && bytes.get(end) != 0u8 do
        end = end + 1
    String.fromBytes(bytes, start, end - start)

/// Little-endian unsigned 32-bit read; returned as Int64 to avoid sign
/// trouble (callers narrow to Int32 when they know the value fits).
internal function readU32(bytes: Slice<Uint8>): Int64 =
    let b0 = bytes.get(0).toInt64()
    let b1 = bytes.get(1).toInt64()
    let b2 = bytes.get(2).toInt64()
    let b3 = bytes.get(3).toInt64()
    b0 | (b1 << 8i64) | (b2 << 16i64) | (b3 << 24i64)

/// Little-endian signed 32-bit read.
internal function readI32(bytes: Slice<Uint8>): Int32 =
    let raw = readU32(bytes).toInt32()
    raw

/// Little-endian unsigned 16-bit read; widened to Int32.
internal function readU16(bytes: Slice<Uint8>): Int32 =
    let b0 = bytes.get(0).toInt32()
    let b1 = bytes.get(1).toInt32()
    b0 | (b1 << 8)

/// Little-endian signed 64-bit read.
internal function readI64(bytes: Slice<Uint8>): Int64 =
    let mutable acc = 0i64
    let mutable i = 7
    while i >= 0 do
        acc = (acc << 8i64) | bytes.get(i).toInt64()
        i = i - 1
    acc

// --- Tests -----------------------------------------------------------------
test "TzData: blob is non-empty and has TZDB magic" =
    let db = TzData.database
    assert db.bytes.length > 32
    assert db.zoneCount > 0
    assert db.bytes.get(0) == 84u8 // 'T'
    assert db.bytes.get(1) == 90u8 // 'Z'
    assert db.bytes.get(2) == 68u8 // 'D'
    assert db.bytes.get(3) == 66u8 // 'B'

test "TzData: findZone for UTC" =
    match TzData.findZone("UTC") with
        case Some(z) => assert z.id == "UTC"
        case None => panic "UTC zone not found"

test "TzData: findZone for unknown name returns None" =
    match TzData.findZone("Nowhere/Notreal") with
        case Some(_) => panic "should not find"
        case None => ()

test "TzData: findZone for America/New_York" =
    match TzData.findZone("America/New_York") with
        case Some(z) => assert z.id == "America/New_York"
        case None => panic "America/New_York not found"

test "TzData: NY offset in summer is -04:00" =
    // 2024-07-15T12:00:00Z = 1721044800
    match TzData.findZone("America/New_York") with
        case Some(z) =>
            let off = z.offsetAt(1721044800i64)
            assert off.offsetSeconds == -14400 // -4h
            assert off.isDst
        case None => panic "zone missing"

test "TzData: NY offset in winter is -05:00" =
    // 2024-12-15T12:00:00Z = 1734264000
    match TzData.findZone("America/New_York") with
        case Some(z) =>
            let off = z.offsetAt(1734264000i64)
            assert off.offsetSeconds == -18000 // -5h
            assert off.isDst == false
        case None => panic "zone missing"

test "TzData: linked alias resolves to same data" =
    // Asia/Kolkata is a link to Asia/Calcutta
    match TzData.findZone("Asia/Kolkata") with
        case Some(z) =>
            let off = z.offsetAt(1721044800i64)
            assert off.offsetSeconds == 19800 // +5:30
        case None => panic "Asia/Kolkata not found"
