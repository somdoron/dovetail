package standard.time

/// Leap-second lookup against the embedded IANA `leapseconds` table.
///
/// `Instant.epochSecond` follows Unix-time convention (ignores leap
/// seconds), so the standard `Instant`/`LocalDateTime` conversions are
/// unaffected by leap seconds. This module exposes the table for users
/// who need the TAI/UTC delta at a given instant.
module LeapSeconds =

    /// Total accumulated leap-second correction (TAI − UTC, in seconds)
    /// at `epochSecond`. Returns 0 before the first introduced leap
    /// second (1972-07-01 in IANA's table) and the running total after.
    public function correctionFor(epochSecond: Int64): Int32 =
        let db = TzData.database
        if db.leapOffset == 0 then 0
        else
            let bytes = db.bytes
            let off = db.leapOffset
            let count = readU32(bytes[|off..|]).toInt32()
            // Linear walk — the table has ~28 entries; binary search adds
            // complexity without meaningful speedup at that size.
            let mutable i = 0
            let mutable result = 0
            while i < count do
                let entryOff = off + 4 + i * 16
                let entryEpoch = readI64(bytes[|entryOff..|])
                if entryEpoch <= epochSecond then
                    result = readI32(bytes[|entryOff + 8..|])
                i = i + 1
            result

    /// Total number of leap-second entries in the embedded table.
    public function count(): Int32 =
        let db = TzData.database
        if db.leapOffset == 0 then 0
        else readU32(db.bytes[|db.leapOffset..|]).toInt32()

test "LeapSeconds: table is non-empty" =
    assert LeapSeconds.count() > 0

test "LeapSeconds: pre-1972 has zero correction" =
    // 1970-01-01T00:00:00Z = 0
    assert LeapSeconds.correctionFor(0i64) == 0

test "LeapSeconds: 2020-01-01 has 27 leap seconds" =
    // 2020-01-01T00:00:00Z = 1577836800
    // 27 leap seconds were introduced between 1972 and the end of 2016.
    assert LeapSeconds.correctionFor(1577836800i64) == 27
