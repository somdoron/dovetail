package standard.io.http

import standard.collection.Map
import standard.uri.Uri

/// Captured query-string parameters from `Request.uri.query`. Backed by
/// `Map<String, Array<String>>` so `?foo=a&foo=b` preserves both values
/// (URL order in the per-key array); single-value access via `get`,
/// multi-value via `getAll`.
public class QueryParams(items: Map<String, Array<String>>) =
    /// Empty query — used when `uri.query` is `None`.
    public function empty(): QueryParams = QueryParams(Map<String, Array<String>>.empty())

    /// Parse the optional `uri.query` field into a `QueryParams`.
    /// Empty query string is treated as no params. Pair separator is
    /// `&`; key/value separator is the first `=` per pair. Keys and
    /// values are percent-decoded via `Uri.decode` (with `+` mapped to
    /// space, per legacy form encoding). Malformed encoding is silently
    /// skipped — we err on the side of preserving the request rather
    /// than rejecting it; handlers can validate manually.
    public function parse(query: Option<String>): QueryParams =
        match query with
            case None => QueryParams.empty()
            case Some(s) =>
                if s.length == 0 then
                    QueryParams.empty()
                else
                    let mutable map: Map<String, Array<String>> = Map<String, Array<String>>.empty()
                    for chunk in s.split("&") do
                        if chunk.length > 0 then
                            match parseQueryPair(chunk) with
                                case Some(pair) =>
                                    let key = pair._0
                                    let value = pair._1
                                    let updated =
                                        match map.get(key) with
                                            case Some(existing) => existing.concat([| value |])
                                            case None => [| value |]
                                    map = map.put(key, updated)
                                case None => ()
                    QueryParams(map)

    /// First value for the named param. For repeated `?foo=a&foo=b`,
    /// returns `"a"`.
    public function get(self, name: String): Option<String> =
        match self.items.get(name) with
            case None => None
            case Some(arr) => if arr.length > 0 then Some(arr.get(0)) else None

    /// All values for the named param in URL order. Empty array if absent.
    public function getAll(self, name: String): Array<String> =
        match self.items.get(name) with
            case Some(arr) => arr
            case None => Array<String>.empty()

    /// Parse the first value of `name` as `Int32`.
    public function getInt32(self, name: String): Result<Int32, ParamDecodeError> =
        match self.get(name) with
            case None => Error(ParamDecodeError.Missing(name))
            case Some(v) =>
                match parseInt32(v) with
                    case Some(n) => Ok(n)
                    case None => Error(ParamDecodeError.InvalidFormat(name, "Int32"))

    /// Parse the first value of `name` as `Int64`.
    public function getInt64(self, name: String): Result<Int64, ParamDecodeError> =
        match self.get(name) with
            case None => Error(ParamDecodeError.Missing(name))
            case Some(v) =>
                match parseInt64(v) with
                    case Some(n) => Ok(n)
                    case None => Error(ParamDecodeError.InvalidFormat(name, "Int64"))

module QueryParams =
    /// Split a single `key=value` (or bare `key`) chunk and percent-decode
    /// both sides. Returns `None` if either decode fails.
    function parseQueryPair(chunk: String): Option<(String, String)> =
        let eqPos = findFirstChar(chunk, '=')
        let (rawKey, rawValue) =
            match eqPos with
                case None => (chunk, "")
                case Some(idx) => (chunk.substring(0, idx), chunk.substring(idx + 1, chunk.length))
        let decodedKey = Uri.decode(rawKey.replace("+", " "))
        let decodedValue = Uri.decode(rawValue.replace("+", " "))
        match decodedKey with
            case Error(_) => None
            case Ok(k) =>
                match decodedValue with
                    case Error(_) => None
                    case Ok(v) => Some((k, v))

    function findFirstChar(s: String, c: Char): Option<Int32> =
        let len = s.length
        let mutable found: Option<Int32> = None
        let mutable i = 0
        while i < len do
            if found.isNone then
                if s.getChar(i) == c then found = Some(i)
            i = i + 1
        found

    /// Duplicated from `PathParams` — small, used only here. Keeping it
    /// local rather than introducing a shared `parse` utility module.
    function parseInt32(s: String): Option<Int32> =
        if s.length == 0 then
            None
        else
            let bytes = s.bytes()
            let (negative, start) = if bytes.get(0) == 45u8 then (true, 1) else (false, 0)
            if start >= bytes.length then
                None
            else
                let mutable acc = 0i32
                let mutable i = start
                let mutable failed = false
                while i < bytes.length do
                    if !failed then
                        let b = bytes.get(i).toInt32()
                        if b < 48 || b > 57 then
                            failed = true
                        else
                            let digit = b - 48
                            if acc > 214748364i32 then failed = true else acc = acc * 10 + digit
                    i = i + 1
                if failed then None else if negative then Some(0 - acc) else Some(acc)

    function parseInt64(s: String): Option<Int64> =
        if s.length == 0 then
            None
        else
            let bytes = s.bytes()
            let (negative, start) = if bytes.get(0) == 45u8 then (true, 1) else (false, 0)
            if start >= bytes.length then
                None
            else
                let mutable acc = 0i64
                let mutable i = start
                let mutable failed = false
                while i < bytes.length do
                    if !failed then
                        let b = bytes.get(i).toInt32()
                        if b < 48 || b > 57 then
                            failed = true
                        else
                            let digit = (b - 48).toInt64()
                            if acc > 922337203685477580i64 then failed = true
                            else acc = acc * 10i64 + digit
                    i = i + 1
                if failed then None else if negative then Some(0i64 - acc) else Some(acc)
