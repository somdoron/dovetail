package test

import standard.io.http.HttpClient
import standard.io.http.HttpClientError
import standard.io.http.Request
import standard.io.http.Response
import standard.io.http.Method
import standard.io.Async
import standard.io.Fiber
import standard.io.net.Tcp
import standard.io.net.TcpListener
import standard.uri.Uri
import standard.uri.UriError
import standard.http.Headers

// =============================================================================
// HttpClient.send takes a fully-formed Request and returns a flat Response.
// This is the primitive proxy / forwarding code calls.
// =============================================================================
@timeout(5000)
 test "HttpClient.send returns 200 + body" =
    let canned = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello"
    let mutable response: Option<Response> = None
    let mutable err: Option<HttpClientError> = None
    let program: Async<Unit, Never> =
        runSendAgainstMock(canned.bytes())
            .fold(
            (e: HttpClientError) => Async.thunk(() => err = Some(e)),
            (r: Response) => Async.thunk(() => response = Some(r))
        )
    program.run()
    match err with
        case Some(_) => assert false
        case None => ()
    match response with
        case None => assert false
        case Some(r) =>
            assert r.statusCode == 200
            assert r.isSuccess
            assert r.bodyAsString() == "hello"

@timeout(5000)
 test "HttpClient.send returns 500 response (no Result split)" =
    let canned =
        "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 4\r\nConnection: close\r\n\r\noops"
    let mutable response: Option<Response> = None
    let program: Async<Unit, Never> =
        runSendAgainstMock(canned.bytes())
            .fold(
            (_: HttpClientError) => Async.succeed(()),
            (r: Response) => Async.thunk(() => response = Some(r))
        )
    program.run()
    match response with
        case None => assert false
        case Some(r) =>
            assert r.statusCode == 500
            assert !r.isSuccess
            assert r.bodyAsString() == "oops"

async function runSendAgainstMock(canned: Array<Uint8>): Async<Response, HttpClientError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress().mapError(HttpClientError.from)
    let port = parsePortSuffix(address)
    let _server: Fiber<Unit, Never> = await mockServer(listener, canned).forkBackground()
    let url = "http://127.0.0.1:" ++ port.format()
    let uri =
        await Async
            .fromResult(Uri.parse(url).mapError((e: UriError) => HttpClientError.UriParseFailed(e)))
    let req: Request =
        Request {
            method = Method.Get
            uri = uri
            headers = Headers.empty()
            body = Array<Uint8>.empty()
        }
    await HttpClient.send(req)
