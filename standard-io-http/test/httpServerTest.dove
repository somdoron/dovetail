package test

import standard.io.http.HttpServer
import standard.io.http.HttpClient
import standard.io.http.HttpClientError
import standard.io.http.Route
import standard.io.http.Response
import standard.io.http.Context
import standard.io.http.ServerError
import standard.io.http.ServerConfig
import standard.io.Async
import standard.io.Fiber
import standard.io.Promise
import standard.io.Cause
import standard.time.Duration
import standard.io.net.Tcp
import standard.io.net.TcpListener
import standard.io.net.TcpStream
import standard.io.net.NetError

// End-to-end: real TCP server in a daemon fiber, real HttpClient making
// the request in the same process. Each test binds 127.0.0.1:0 to avoid
// port collisions and drives the route-as-handler shape end-to-end.
@timeout(5000)
 test "GET /hello returns 200 with text body via HttpServer + HttpClient" =
    let mutable response: Option<Response> = None
    let program: Async<Unit, Never> =
        clientAgainstServer("/hello")
            .fold(
            (_: HttpClientError) => Async.succeed(()),
            (r: Response) => Async.thunk(() => response = Some(r))
        )
    program.run()
    match response with
        case None => assert false
        case Some(r) =>
            assert r.statusCode == 200
            assert r.isSuccess
            assert r.bodyAsString() == "hello world"

@timeout(5000)
 test "GET /users/{id} returns path-param echo" =
    let mutable response: Option<Response> = None
    let program: Async<Unit, Never> =
        clientAgainstServer("/users/42")
            .fold(
            (_: HttpClientError) => Async.succeed(()),
            (r: Response) => Async.thunk(() => response = Some(r))
        )
    program.run()
    match response with
        case None => assert false
        case Some(r) =>
            assert r.statusCode == 200
            assert r.bodyAsString() == "user 42"

@timeout(5000)
 test "Two sequential GETs against the same server complete" =
    // Smoke test for the per-connection forking: the server must service
    // the second request after the first completes, which exercises the
    // accept loop / semaphore release path.
    let mutable first: Option<Response> = None
    let mutable second: Option<Response> = None
    let program: Async<Unit, Never> =
        twoSequentialGets()
            .fold(
            (_: HttpClientError) => Async.succeed(()),
            (pair: (Response, Response)) =>
                Async
                    .thunk(
                    () =>
                        first = Some(pair._0)
                        second = Some(pair._1)
                )
        )
    program.run()
    match (first, second) with
        case (Some(r1), Some(r2)) =>
            assert r1.bodyAsString() == "hello world"
            assert r2.bodyAsString() == "user 7"
        case _ => assert false

@timeout(5000)
 test "Unmatched path returns 404 via Routes.orNotFound fallback" =
    let mutable response: Option<Response> = None
    let program: Async<Unit, Never> =
        clientAgainstServer("/no/such/route")
            .fold(
            (_: HttpClientError) => Async.succeed(()),
            (r: Response) => Async.thunk(() => response = Some(r))
        )
    program.run()
    match response with
        case None => assert false
        case Some(r) =>
            assert r.statusCode == 404
            assert !r.isSuccess

// --- Route fixture ----------------------------------------------------------
function simpleApp(): Route =
    let hello: (Context) => Async<Response, ServerError> =
        (_: Context) => Async.succeed(Response.text("hello world"))
    let echoId: (Context) => Async<Response, ServerError> =
        (ctx: Context) =>
            let id = ctx.pathParams.require("id")
            Async.succeed(Response.text("user " ++ id))
    Route.choose([| Route.get("/hello", hello), Route.get("/users/{id}", echoId),  |])

// --- Drivers ----------------------------------------------------------------
async function clientAgainstServer(path: String): Async<Response, HttpClientError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress().mapError(HttpClientError.from)
    let port = parsePortSuffix(address)
    let _server: Fiber<Unit, Never> = await serverFiber(listener, simpleApp()).forkBackground()
    let url = "http://127.0.0.1:" ++ port.format() ++ path
    await HttpClient.get(url).send()

function serverFiber(listener: TcpListener, route: Route): Async<Unit, Never> =
    HttpServer
        .serveOn(listener, route)
        .fold((_: ServerError) => Async.succeed(()), (_: Unit) => Async.succeed(()))

/// Issue two GETs to different paths in sequence against the same
/// server fiber. Exercises the accept loop's "ready for the next
/// connection" semantics; if the server only serviced one connection
/// the second would time out.
async function twoSequentialGets(): Async<(Response, Response), HttpClientError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress().mapError(HttpClientError.from)
    let port = parsePortSuffix(address)
    let _server: Fiber<Unit, Never> = await serverFiber(listener, simpleApp()).forkBackground()
    let base = "http://127.0.0.1:" ++ port.format()
    let r1 = await HttpClient.get(base ++ "/hello").send()
    let r2 = await HttpClient.get(base ++ "/users/7").send()
    (r1, r2)

// The accept loop must unwind cleanly when the scope that owns its listener
// ends — and unwind as an INTERRUPTION, not as a failure. Before the fix a
// terminal accept error propagated out of the loop, so the server fiber died
// with a failure; every non-terminal accept failure did the same, while also
// swallowing the concurrency permit that iteration had taken.
@timeout(10000)
 test "HttpServer: serveOn unwinds cleanly when the scope owning its listener ends" =
    let mutable outcome = 0i32
    serverOutlivesListener((n: Int32) => outcome = n).run()
    // 2 = the loop unwound on the scope's interrupt; -1 = it failed or panicked
    // out, which is what an accept error must never turn into.
    assert outcome == 2i32

function serverOutcome(listener: TcpListener, route: Route, done: Promise<Int32, Never>):
    Async<Unit, Never> =
    let onCause: (Cause<ServerError>) => Async<Unit, Never> =
        (cause: Cause<ServerError>) =>
            let code =
                match cause with
                    case Cause.Interrupted(_) => 2i32
                    case _ => -1i32
            done.complete(code).map<Unit>((_: Bool) => ())
    let onSuccess: (Unit) => Async<Unit, Never> =
        (_: Unit) => done.complete(1i32).map<Unit>((_: Bool) => ())
    HttpServer.serveOn(listener, route).foldCause<Unit, Never>(onCause, onSuccess)

/// Serve a real request, then let the scope end — tearing the accept loop down
/// and then releasing the listener, in that order.
async function serveWhileListenerLives(done: Promise<Int32, Never>): Async<Unit, HttpClientError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress().mapError(HttpClientError.from)
    let port = parsePortSuffix(address)
    // Background: the loop only ends when the listener closes, so a scope that
    // waited for it would never reach the release that ends it.
    let _server: Fiber<Unit, Never> =
        await serverOutcome(listener, simpleApp(), done).forkBackground()
    let response = await HttpClient.get("http://127.0.0.1:" ++ port.format() ++ "/hello").send()
    assert response.statusCode == 200
    // The client can see its response slightly before the handler fiber returns
    // its permit and the loop posts the next accept. There is no signal to wait
    // on from outside `serveOn`, so pause long enough for that hand-off — a few
    // scheduler steps — before pulling the listener out.
    await Async<Unit, Never>.sleep(Duration.ofMillis(250i64))
    ()

async function serverOutlivesListener(setter: (Int32) => Unit): Async<Unit, HttpClientError> =
    let done: Promise<Int32, Never> = await Async<Int32, Never>.makePromise()
    await serveWhileListenerLives(done)
    let outcome = await done.awaitPromise()
    setter(outcome)

// --- the connection fiber must return its permit on EVERY cause ---------------
// The concurrency semaphore is a permit queue: the accept loop takes one before
// forking and the connection fiber returns it when the connection ends. That
// return used to go through a plain `fold`, which only covers a typed failure
// and a success — a `Cause.Panicked` or an interruption took neither arm and
// the permit was gone for good. After `maxConcurrency` of those the loop's
// `permits.take()` blocks forever and the server stops accepting.
//
// Note what this test does NOT show. A panicking *handler* never reaches that
// fold: `serveExchange` folds every cause out of the handler into a 500 wire
// response, so the connection body still ends as a typed success. What is left
// for the all-causes arm is a defect in the transport code itself, and an
// interruption while the server is shutting down. Neither is reachable from a
// test, so this pins the observable half — a handler defect answers 500 and the
// server keeps accepting afterwards — and the `foldCause` covers the rest by
// construction.
function panicApp(): Route =
    let boom: (Context) => Async<Response, ServerError> =
        // `Async.failPanic`, not the `panic` keyword: a Dovetail `panic` traps the
        // component outright, whereas a defect raised inside an async program is
        // a `Cause.Panicked` that unwinds through the fiber.
        (
            _: Context
        ) => Async.failPanic("handler exploded")
    let ok: (Context) => Async<Response, ServerError> =
        (_: Context) => Async.succeed(Response.text("still serving"))
    Route.choose([| Route.get("/boom", boom), Route.get("/ok", ok),  |])

function narrowServerFiber(listener: TcpListener, route: Route): Async<Unit, Never> =
    let config =
        ServerConfig {
            maxBodyBytes = 1048576i32
            maxConcurrency = 2i32
            connectionTimeout = Duration.ofSeconds(30i64)
        }
    HttpServer
        .serveOnWithConfig(listener, route, config)
        .fold((_: ServerError) => Async.succeed(()), (_: Unit) => Async.succeed(()))

async function survivePanicsProgram(setStatus: (Int32) => Unit, setBody: (String) => Unit):
    Async<Unit, HttpClientError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress().mapError(HttpClientError.from)
    let port = parsePortSuffix(address)
    let _server: Fiber<Unit, Never> = await narrowServerFiber(listener, panicApp()).forkBackground()
    let base = "http://127.0.0.1:" ++ port.format()
    // Exactly `maxConcurrency` defective requests, so a leaked permit each time
    // would leave none for the request after them.
    let mutable status = 0i32
    let mutable i = 0i32
    while i < 2i32 do
        let response = await HttpClient.get(base ++ "/boom").send()
        status = response.statusCode
        i = i + 1
    let response = await HttpClient.get(base ++ "/ok").send()
    setStatus(status)
    setBody(response.bodyAsString())

@timeout(15000)
 test "HttpServer: a handler defect answers 500 and leaves the server accepting" =
    let mutable status = 0i32
    let mutable body: String = ""
    survivePanicsProgram((n: Int32) => status = n, (s: String) => body = s).run()
    assert status == 500i32
    assert body == "still serving"

// --- a silent connection must not hold its permit forever ---------------------
// FIX: `connectionTimeout`. A client that completes the TCP handshake and sends
// nothing parks the connection's first `read`. With no bound it holds a
// concurrency permit for good; after `maxConcurrency` such connections the
// server stops accepting. `connectionTimeout` interrupts the stalled connection,
// which returns its permit. `maxConcurrency = 1` makes a single leaked permit
// fatal, so a served follow-up request proves the permit came back — without the
// timeout this test would hang until its `@timeout` fired.
@timeout(15000)
 test "HttpServer drops a silent connection after connectionTimeout and keeps accepting" =
    let mutable status = 0i32
    silentThenServeProgram((n: Int32) => status = n).run()
    assert status == 200i32

function boundedServerFiber(listener: TcpListener, route: Route, config: ServerConfig):
    Async<Unit, Never> =
    HttpServer
        .serveOnWithConfig(listener, route, config)
        .fold((_: ServerError) => Async.succeed(()), (_: Unit) => Async.succeed(()))

/// Open a TCP connection and hold it open, sending nothing, until the server's
/// `connectionTimeout` interrupts the server-side fiber. `ready` fires once the
/// socket is connected so the caller can order the follow-up request after this
/// connection is the one holding the sole permit.
async function holdSilentConnection(port: Uint16, ready: Promise<Unit, Never>): Async<Unit, Never> =
    await holdSilentConnectionRaw(port, ready)
        .fold((_: NetError) => Async.succeed(()), (_: Unit) => Async.succeed(()))

async function holdSilentConnectionRaw(port: Uint16, ready: Promise<Unit, Never>):
    Async<Unit, NetError> =
    let stream: TcpStream = use Tcp.connect("127.0.0.1", port)
    await ready.complete(()).asUnit()
    await Async<Unit, Never>.sleep(Duration.ofSeconds(10i64))

async function silentThenServeProgram(setStatus: (Int32) => Unit): Async<Unit, HttpClientError> =
    let listener: TcpListener = use Tcp.bind("127.0.0.1:0")
    let address = await listener.localAddress().mapError(HttpClientError.from)
    let port = parsePortSuffix(address)
    // maxConcurrency = 1 so the silent connection holds the ONLY permit; a
    // half-second bound so the test does not linger.
    let config =
        ServerConfig {
            maxBodyBytes = 1048576i32
            maxConcurrency = 1i32
            connectionTimeout = Duration.ofMillis(500i64)
        }
    let _server: Fiber<Unit, Never> =
        await boundedServerFiber(listener, simpleApp(), config).forkBackground()
    let ready: Promise<Unit, Never> = await Async<Unit, Never>.makePromise()
    let _silent: Fiber<Unit, Never> = await holdSilentConnection(port, ready).forkBackground()
    await ready.awaitPromise()
    // Let the server accept the silent connection and park on its first read
    // (taking the sole permit) before the real request goes out.
    await Async<Unit, Never>.sleep(Duration.ofMillis(150i64))
    // Servable only once the silent connection times out and returns the permit:
    // with maxConcurrency = 1 the accept loop is blocked on `take()` until then.
    let response = await HttpClient.get("http://127.0.0.1:" ++ port.format() ++ "/hello").send()
    setStatus(response.statusCode)
