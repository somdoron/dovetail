package standard.collection

import standard.prelude.Hashable
import standard.prelude.Equatable
import standard.prelude.Option

enum MapNode<K, V> =
    EmptyNode
    LeafNode(Int64, K, V)
    HashCollision(Int64, Array<(K, V)>)
    BitmapNode(Int32, Array<MapNode<K, V>>)

/// An immutable hash map from keys to values, backed by a hash-array mapped trie (CHAMP).
/// Keys must implement Hashable and Equatable.
/// All mutating operations return a new Map, leaving the original unchanged.
public record Map<K, V> where K: Hashable, K: Equatable =
    root: MapNode<K, V>
    count: Int32

function popcount(x: Int32): Int32 =
    let a = x - ((x >> 1) & 1431655765)
    let b = (a & 858993459) + ((a >> 2) & 858993459)
    let c = (b + (b >> 4)) & 252645135
    let d = c + (c >> 8)
    let e = d + (d >> 16)
    e & 63

function champMask(hash: Int64, shift: Int32): Int32 =
    ((hash >> shift.toInt64()) & 31i64).toInt32()

function champBitpos(idx: Int32): Int32 = 1 << idx

function champIndex(bitmap: Int32, bit: Int32): Int32 =
    popcount(bitmap & (bit - 1))

function nodeArrayInsert<K, V>(arr: Array<MapNode<K, V>>, idx: Int32, value: MapNode<K, V>): Array<MapNode<K, V>> =
    let newArr = Array.fill(arr.length + 1, value)
    let mutable i = 0
    while i < idx do
        newArr.set(i, arr.get(i))
        i = i + 1
    i = idx
    while i < arr.length do
        newArr.set(i + 1, arr.get(i))
        i = i + 1
    newArr

function nodeArrayRemove<K, V>(arr: Array<MapNode<K, V>>, idx: Int32): Array<MapNode<K, V>> =
    let newArr = Array.fill(arr.length - 1, arr.get(0))
    let mutable i = 0
    let mutable j = 0
    while i < arr.length do
        if i != idx then
            newArr.set(j, arr.get(i))
            j = j + 1
        i = i + 1
    newArr

function collisionArrayInsert<K, V>(arr: Array<(K, V)>, entry: (K, V)): Array<(K, V)> =
    let newArr = Array.fill(arr.length + 1, entry)
    let mutable i = 0
    while i < arr.length do
        newArr.set(i, arr.get(i))
        i = i + 1
    newArr

function collisionArrayRemove<K, V>(arr: Array<(K, V)>, idx: Int32): Array<(K, V)> =
    let newArr = Array.fill(arr.length - 1, arr.get(0))
    let mutable i = 0
    let mutable j = 0
    while i < arr.length do
        if i != idx then
            newArr.set(j, arr.get(i))
            j = j + 1
        i = i + 1
    newArr

function mergeLeaves<K, V>(shift: Int32, hash1: Int64, node1: MapNode<K, V>, hash2: Int64, node2: MapNode<K, V>): MapNode<K, V> =
    let frag1 = champMask(hash1, shift)
    let frag2 = champMask(hash2, shift)
    if frag1 == frag2 then
        let subNode = mergeLeaves(shift + 5, hash1, node1, hash2, node2)
        MapNode.BitmapNode(champBitpos(frag1), Array.fill(1, subNode))
    else
        let bit1 = champBitpos(frag1)
        let bit2 = champBitpos(frag2)
        let bitmap = bit1 | bit2
        if frag1 < frag2 then
            let arr = Array.fill(2, node1)
            arr.set(1, node2)
            MapNode.BitmapNode(bitmap, arr)
        else
            let arr = Array.fill(2, node2)
            arr.set(1, node1)
            MapNode.BitmapNode(bitmap, arr)

function handleBitmapChildRemoval<K, V>(bitmap: Int32, children: Array<MapNode<K, V>>, idx: Int32, bit: Int32, newChild: MapNode<K, V>): (MapNode<K, V>, Bool) =
    match newChild with
        case EmptyNode =>
            let newBitmap = bitmap ^ bit
            if newBitmap == 0 then (MapNode.EmptyNode, true)
            else
                let newChildren = nodeArrayRemove(children, idx)
                if popcount(newBitmap) == 1 then
                    let remaining = newChildren.get(0)
                    match remaining with
                        case LeafNode(_, _, _) => (remaining, true)
                        case _ => (MapNode.BitmapNode(newBitmap, newChildren), true)
                else (MapNode.BitmapNode(newBitmap, newChildren), true)
        case _ =>
            let newChildren = children.clone()
            newChildren.set(idx, newChild)
            (MapNode.BitmapNode(bitmap, newChildren), true)

function nodeGet<K, V>(node: MapNode<K, V>, hash: Int64, shift: Int32, key: K): Option<V> where K: Equatable =
    match node with
        case EmptyNode => None
        case LeafNode(h, k, v) =>
            if h == hash then
                if k.equals(key) then Some(v) else None
            else None
        case BitmapNode(bitmap, children) =>
            let frag = champMask(hash, shift)
            let bit = champBitpos(frag)
            if (bitmap & bit) == 0 then None
            else nodeGet(children.get(champIndex(bitmap, bit)), hash, shift + 5, key)
        case HashCollision(h, entries) =>
            if h != hash then None
            else
                let mutable i = 0
                let mutable result: Option<V> = None
                while i < entries.length do
                    if entries.get(i)._0.equals(key) then
                        result = Some(entries.get(i)._1)
                        i = entries.length
                    else i = i + 1
                result

function nodePut<K, V>(node: MapNode<K, V>, hash: Int64, shift: Int32, key: K, value: V): (MapNode<K, V>, Bool) where K: Equatable =
    match node with
        case EmptyNode =>
            (MapNode.LeafNode(hash, key, value), true)
        case LeafNode(h, k, v) =>
            if h == hash then
                if k.equals(key) then (MapNode.LeafNode(hash, key, value), false)
                else
                    let entries = Array.fill(2, (k, v))
                    entries.set(1, (key, value))
                    (MapNode.HashCollision(hash, entries), true)
            else
                let newLeaf: MapNode<K, V> = MapNode.LeafNode(hash, key, value)
                (mergeLeaves(shift, h, node, hash, newLeaf), true)
        case BitmapNode(bitmap, children) =>
            let frag = champMask(hash, shift)
            let bit = champBitpos(frag)
            let idx = champIndex(bitmap, bit)
            if (bitmap & bit) != 0 then
                let result = nodePut(children.get(idx), hash, shift + 5, key, value)
                let newChildren = children.clone()
                newChildren.set(idx, result._0)
                (MapNode.BitmapNode(bitmap, newChildren), result._1)
            else
                let leaf: MapNode<K, V> = MapNode.LeafNode(hash, key, value)
                let newChildren = nodeArrayInsert(children, idx, leaf)
                (MapNode.BitmapNode(bitmap | bit, newChildren), true)
        case HashCollision(h, entries) =>
            if h == hash then
                let mutable i = 0
                let mutable found = -1
                while i < entries.length do
                    if entries.get(i)._0.equals(key) then
                        found = i
                        i = entries.length
                    else i = i + 1
                if found >= 0 then
                    let newEntries = entries.clone()
                    newEntries.set(found, (key, value))
                    (MapNode.HashCollision(h, newEntries), false)
                else
                    let newEntries = collisionArrayInsert(entries, (key, value))
                    (MapNode.HashCollision(h, newEntries), true)
            else
                let frag = champMask(h, shift)
                let bit = champBitpos(frag)
                let wrapped: MapNode<K, V> = MapNode.BitmapNode(bit, Array.fill(1, node))
                nodePut(wrapped, hash, shift, key, value)

function nodeRemove<K, V>(node: MapNode<K, V>, hash: Int64, shift: Int32, key: K): (MapNode<K, V>, Bool) where K: Equatable =
    match node with
        case EmptyNode => (node, false)
        case LeafNode(h, k, v) =>
            if h == hash then
                if k.equals(key) then (MapNode.EmptyNode, true)
                else (node, false)
            else (node, false)
        case BitmapNode(bitmap, children) =>
            let frag = champMask(hash, shift)
            let bit = champBitpos(frag)
            if (bitmap & bit) == 0 then (node, false)
            else
                let idx = champIndex(bitmap, bit)
                let result = nodeRemove(children.get(idx), hash, shift + 5, key)
                if !result._1 then (node, false)
                else handleBitmapChildRemoval(bitmap, children, idx, bit, result._0)
        case HashCollision(h, entries) =>
            if h != hash then (node, false)
            else
                let mutable foundIdx = -1
                let mutable i = 0
                while i < entries.length do
                    if entries.get(i)._0.equals(key) then
                        foundIdx = i
                        i = entries.length
                    else i = i + 1
                if foundIdx < 0 then (node, false)
                else if entries.length == 2 then
                    let remaining = if foundIdx == 0 then entries.get(1) else entries.get(0)
                    (MapNode.LeafNode(h, remaining._0, remaining._1), true)
                else
                    let newEntries = collisionArrayRemove(entries, foundIdx)
                    (MapNode.HashCollision(h, newEntries), true)

function nodeFoldEntries<K, V, R>(node: MapNode<K, V>, acc: R, f: (R, K, V) => R): R =
    match node with
        case EmptyNode => acc
        case LeafNode(_, k, v) => f(acc, k, v)
        case BitmapNode(_, children) =>
            let mutable result = acc
            let mutable i = 0
            while i < children.length do
                result = nodeFoldEntries(children.get(i), result, f)
                i = i + 1
            result
        case HashCollision(_, entries) =>
            let mutable result = acc
            let mutable i = 0
            while i < entries.length do
                result = f(result, entries.get(i)._0, entries.get(i)._1)
                i = i + 1
            result

function nodeFindFirst<K, V>(node: MapNode<K, V>): (K, V) =
    match node with
        case LeafNode(_, k, v) => (k, v)
        case HashCollision(_, entries) => entries.get(0)
        case BitmapNode(_, children) => nodeFindFirst(children.get(0))
        case EmptyNode => panic "nodeFindFirst on EmptyNode"

function nodeFillEntries<K, V>(node: MapNode<K, V>, result: Slice<(K, V)>): Int32 =
    match node with
        case EmptyNode => 0
        case LeafNode(_, k, v) =>
            result[0] = (k, v)
            1
        case HashCollision(_, entries) =>
            entries[|..|].copyTo(result)
            entries.length
        case BitmapNode(_, children) =>
            let mutable i = 0
            let mutable written = 0
            while i < children.length do
                written = written + nodeFillEntries(children.get(i), result[|written..|])
                i = i + 1
            written

function mapCollectEntries<K, V>(root: MapNode<K, V>, count: Int32): Array<(K, V)> =
    if count == 0 then Array.empty()
    else
        let first = nodeFindFirst(root)
        let entries = Array.fill(count, first)
        let _ = nodeFillEntries(root, entries[|..|])
        entries

class MapEntryIterator<K, V>(entries: Array<(K, V)>, mutable index: Int32) implements Iterator<(K, V)> =
    public function next(self): Option<(K, V)> =
        if self.index >= self.entries.length then None
        else
            let entry = self.entries.get(self.index)
            self.index = self.index + 1
            Some(entry)

module Map<K, V> =
    /// Creates an empty map.
    public function empty(): Map<K, V> =
        let emptyNode: MapNode<K, V> = MapNode.EmptyNode
        Map { root = emptyNode; count = 0 }

    /// Returns a new map with the key set to the given value, overwriting any existing entry.
    public function put(self, key: K, value: V): Map<K, V> =
        let hash = key.hash()
        let result = nodePut(self.root, hash, 0, key, value)
        let newCount = if result._1 then self.count + 1 else self.count
        Map { root = result._0; count = newCount }

    /// Returns the value associated with the key, or None if not found.
    public function get(self, key: K): Option<V> =
        nodeGet(self.root, key.hash(), 0, key)

    /// Returns true if the map contains the given key.
    public function contains(self, key: K): Bool =
        self.get(key).isSome

    /// Returns a new map with the given key removed. Returns the same map if the key is not present.
    public function remove(self, key: K): Map<K, V> =
        let hash = key.hash()
        let result = nodeRemove(self.root, hash, 0, key)
        let newCount = if result._1 then self.count - 1 else self.count
        Map { root = result._0; count = newCount }

    /// Folds over all entries in the map, accumulating a result.
    public function foldEntries<R>(self, initial: R, f: (R, K, V) => R): R =
        nodeFoldEntries(self.root, initial, f)

    /// The number of key-value pairs in the map.
    public property length(self): Int32 = self.count

    /// True if the map contains no entries.
    public property isEmpty(self): Bool = self.count == 0

// TODO: Replace eager collect-to-array iterator with a lazy CHAMP traversal
// using an explicit stack of (BitmapNode, child-index) frames to avoid O(n) up-front allocation.
implement <K, V> Iterable<(K, V)> for Map<K, V> where K: Hashable, K: Equatable =
    public function iterator(self): Iterator<(K, V)> =
        MapEntryIterator(mapCollectEntries(self.root, self.count), 0)

test "Map empty" =
    let m: Map<String, Int32> = Map.empty()
    assert m.isEmpty == true
    assert m.length == 0

test "Map put and get" =
    let m: Map<String, Int32> = Map.empty()
    let m2 = m.put("a", 1)
    let m3 = m2.put("b", 2)
    let ra = m3.get("a")
    assert ra.isSome
    assert ra.require == 1
    let rb = m3.get("b")
    assert rb.isSome
    assert rb.require == 2
    assert m3.length == 2

test "Map get missing key" =
    let m: Map<String, Int32> = Map.empty()
    assert m.get("x").isNone

test "Map put overwrites" =
    let m: Map<String, Int32> = Map.empty()
    let m2 = m.put("a", 1)
    let m3 = m2.put("a", 99)
    let ra = m3.get("a")
    assert ra.isSome
    assert ra.require == 99
    assert m3.length == 1

test "Map contains" =
    let m: Map<String, Int32> = Map.empty()
    let m2 = m.put("x", 10)
    assert m2.contains("x") == true
    assert m2.contains("y") == false

test "Map remove" =
    let m: Map<String, Int32> = Map.empty()
    let m2 = m.put("a", 1).put("b", 2)
    let m3 = m2.remove("a")
    assert m3.contains("a") == false
    assert m3.contains("b") == true
    assert m3.length == 1

test "Map remove missing key" =
    let m: Map<String, Int32> = Map.empty()
    let m2 = m.put("a", 1)
    let m3 = m2.remove("z")
    assert m3.length == 1

test "Map immutability" =
    let m: Map<String, Int32> = Map.empty()
    let m1 = m.put("a", 1)
    let m2 = m1.put("b", 2)
    assert m1.length == 1
    assert m2.length == 2

test "Map many entries" =
    let mutable m: Map<Int32, Int32> = Map.empty()
    let mutable i = 0
    while i < 100 do
        m = m.put(i, i * 10)
        i = i + 1
    assert m.length == 100
    assert m.get(0).require == 0
    assert m.get(50).require == 500
    assert m.get(99).require == 990

test "Map iterator" =
    let m: Map<String, Int32> = Map.empty().put("a", 1).put("b", 2).put("c", 3)
    let mutable sum = 0
    let mutable count = 0
    for entry in m do
        sum = sum + entry._1
        count = count + 1
    assert count == 3
    assert sum == 6

test "Map iterator empty" =
    let m: Map<String, Int32> = Map.empty()
    let mutable count = 0
    for entry in m do
        count = count + 1
    assert count == 0
