package standard.collection

import standard.prelude.Iterable
import standard.prelude.Iterator
import standard.prelude.Option

/// A mutable, dynamically-resizing list backed by an array. Implements Iterable.
public class ArrayList<T>(mutable data: Array<T>, mutable size: Int32) implements Iterable<T>
    where T: Default =
    /// Appends a value to the end of the list, growing capacity if needed.
    public function add(self, value: T): Unit =
        if self.size >= self.data.length then
            self.data = self.data.extend(value, self.data.length * 2)
        self.data.set(self.size, value)
        self.size = self.size + 1

    /// Returns the element at the given index.
    public function get(self, index: Int32): T = self.data.get(index)

    /// Replaces the element at the given index with the provided value.
    public function set(self, index: Int32, value: T): Unit = self.data.set(index, value)

    /// Removes and returns the element at the given index, shifting subsequent elements left.
    public function removeAt(self, index: Int32): T =
        let value = self.data.get(index)
        let mutable i = index
        while i < self.size - 1 do
            self.data.set(i, self.data.get(i + 1))
            i = i + 1
        self.size = self.size - 1
        value

    /// Removes all elements from the list by resetting the size to zero.
    public function clear(self): Unit = self.size = 0

    /// The number of elements in the list.
    public property length(self): Int32 = self.size

    /// The current capacity of the underlying array.
    public property capacity(self): Int32 = self.data.length

    /// Returns a new array containing a copy of the list's elements.
    public function toArray(self): Array<T> =
        let result = Array.fill(self.size, T.default)
        let mutable i = 0
        while i < self.size do
            result.set(i, self.data.get(i))
            i = i + 1
        result

    /// Creates a new empty ArrayList.
    public function new(): ArrayList<T> = ArrayList(Array.fill(4, T.default), 0)

    /// Returns an iterator over the elements of this list.
    public function iterator(self): Iterator<T> = ArrayListIterator(self, 0)

implement<T> Default for ArrayList<T> where T: Default =
    public property default: ArrayList<T> = ArrayList.new()

class ArrayListIterator<T>(list: ArrayList<T>, mutable index: Int32) implements Iterator<T>
    where T: Default =
    public function next(self): Option<T> =
        if self.index >= self.list.length then
            None
        else
            let value = self.list.get(self.index)
            self.index = self.index + 1
            Some(value)

test "ArrayList new is empty" =
    let list = ArrayList<Int32>.new()
    assert list.length == 0

test "ArrayList add and get" =
    let list = ArrayList<Int32>.new()
    list.add(10)
    list.add(20)
    list.add(30)
    assert list.length == 3
    assert list.get(0) == 10
    assert list.get(1) == 20
    assert list.get(2) == 30

test "ArrayList set" =
    let list = ArrayList<Int32>.new()
    list.add(1)
    list.add(2)
    list.set(0, 99)
    assert list.get(0) == 99
    assert list.get(1) == 2

test "ArrayList removeAt" =
    let list = ArrayList<Int32>.new()
    list.add(10)
    list.add(20)
    list.add(30)
    let removed = list.removeAt(1)
    assert removed == 20
    assert list.length == 2
    assert list.get(0) == 10
    assert list.get(1) == 30

test "ArrayList removeAt first" =
    let list = ArrayList<Int32>.new()
    list.add(1)
    list.add(2)
    list.add(3)
    let removed = list.removeAt(0)
    assert removed == 1
    assert list.length == 2
    assert list.get(0) == 2

test "ArrayList clear" =
    let list = ArrayList<Int32>.new()
    list.add(1)
    list.add(2)
    list.clear()
    assert list.length == 0

test "ArrayList capacity grows" =
    let list = ArrayList<Int32>.new()
    let mutable i = 0
    while i < 10 do
        list.add(i)
        i = i + 1
    assert list.length == 10
    assert list.capacity >= 10

test "ArrayList toArray" =
    let list = ArrayList<Int32>.new()
    list.add(5)
    list.add(10)
    let arr = list.toArray()
    assert arr.length == 2
    assert arr.get(0) == 5
    assert arr.get(1) == 10

test "ArrayList iterator" =
    let list = ArrayList<Int32>.new()
    list.add(1)
    list.add(2)
    list.add(3)
    let iter = list.iterator()
    let r1 = iter.next()
    assert r1.isSome
    assert r1.require == 1
    let r2 = iter.next()
    assert r2.isSome
    assert r2.require == 2
    let r3 = iter.next()
    assert r3.isSome
    assert r3.require == 3
    assert iter.next().isNone

test "ArrayList removeAt last" =
    let list = ArrayList<Int32>.new()
    list.add(10)
    list.add(20)
    let removed = list.removeAt(1)
    assert removed == 20
    assert list.length == 1
    assert list.get(0) == 10
