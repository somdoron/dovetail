package test

import standard.io.log.ConsoleSink
import standard.io.log.Logger
import standard.io.log.LogSink
import standard.io.Async

// Smoke tests — we can't capture stderr/stdout inside Dovetail, so the bar is
// "doesn't error end-to-end." Successful runs are visible to a human reading
// the test runner's stdout/stderr.

test "ConsoleSink routes Info to stdout" =
    let program: Async<Unit, Never> =
        let sink = use ConsoleSink.make()
        let log = Logger.make(sink)
        log.info("[console_sink_test] info-to-stdout")
    program.run()

test "ConsoleSink routes Warn to stderr" =
    let program: Async<Unit, Never> =
        let sink = use ConsoleSink.make()
        let log = Logger.make(sink)
        log.warn("[console_sink_test] warn-to-stderr")
    program.run()

test "ConsoleSink routes Error to stderr" =
    let program: Async<Unit, Never> =
        let sink = use ConsoleSink.make()
        let log = Logger.make(sink)
        log.error("[console_sink_test] error-to-stderr")
    program.run()

test "ConsoleSink resource release runs without error" =
    let program: Async<Unit, Never> =
        let sink = use ConsoleSink.make()
        let log = Logger.make(sink)
        log.info("[console_sink_test] before scope exit")
    program.run()
