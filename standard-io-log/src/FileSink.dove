package standard.io.log

import standard.io.Async
import standard.io.AsyncOutputStream
import standard.io.Console
import standard.io.ConsoleError
import standard.io.Resource
import standard.io.Switchable
import standard.io.fs.File
import standard.io.fs.FileStreamError
import standard.io.fs.Path
import standard.time.DateTimeFormatter
import standard.time.Instant
import standard.time.TimeZone
import standard.wasi.fs.FileSystemError
import standard.io.TimeExtension

/// A `LogSink` backed by a file on disk. Every program run starts a
/// brand-new, uniquely-named segment file derived from the user-supplied base
/// path — existing files are never appended to or truncated.
///
/// Construct via `FileSink.open(basePath)` (or `openWith` for a custom
/// formatter). The returned `Resource<LogSink, FileStreamError>` owns the
/// current segment's file handle; `use` it for guaranteed flush + close on
/// scope exit, even if the surrounding computation panics.
///
/// **Size-based rotation.** `openLimited(basePath, maxBytes)` rotates into a
/// fresh, uniquely-named segment file whenever the next record would push the
/// current segment past `maxBytes`. Rotation closes (flush + close) the old
/// segment and opens a new one via a `Switchable` resource handle — no
/// retention/cleanup of old segments is performed; they accumulate on disk.
public class FileSink(
    streamSwitch: Switchable<AsyncOutputStream<FileSystemError>, FileStreamError>,
    format: (LogRecord) => String,
    maxBytes: Option<Int64>,
    basePath: Path,
    mutable bytesWritten: Int64
) implements LogSink =
    public function emit(self, event: LogRecord): Async<Unit, Never> =
        let line = self.format(event) ++ "\n"
        let lineBytes = line.bytes()
        let lineLength = lineBytes.length.toInt64()
        let exceedsLimit = match self.maxBytes with
            case Some(max) => self.bytesWritten > 0i64 && self.bytesWritten + lineLength > max
            case None => false
        if exceedsLimit then
            self.rotate().andThen<Unit>((_: Unit) => self.writeLine(lineBytes, lineLength))
        else self.writeLine(lineBytes, lineLength)

    /// Swap the current segment for a fresh one. On success the byte counter
    /// resets; on failure the previous segment stays in place (Switchable
    /// leaves the old resource untouched when acquiring the new one fails) and
    /// a diagnostic is written to stderr.
    function rotate(self): Async<Unit, Never> =
        self.streamSwitch.replace(segmentResource(self.basePath))
            .map<Unit>((_: AsyncOutputStream<FileSystemError>) => self.bytesWritten = 0i64)
            .catchAll((_: FileStreamError) => diagnoseRotate())

    /// Write one record, and treat a failed write as a reason to start a new
    /// segment rather than as news for stderr.
    ///
    /// A segment's stream is FENCED when a write leaves a record half on disk:
    /// nothing may be appended to it, because a later record would splice itself
    /// onto a truncated line and the file would read as whole. That is the right
    /// answer for the file and the wrong end of the story for the sink, which
    /// swallowed the failure and went on calling `write` on a stream that could
    /// never take another byte — a log that stops, silently, and one line of
    /// stderr per record for the rest of the run.
    ///
    /// Rotating is what this sink can do about it, and it is exactly what the
    /// fence asks for: a fresh segment is a new file, so the truncated record
    /// cannot be mistaken for the start of the next one. Retried ONCE — a second
    /// failure is the file system rather than this stream, and a sink that keeps
    /// opening segments to hold a record it can never write is a worse failure
    /// than a missing line.
    function writeLine(self, lineBytes: Array<Uint8>, lineLength: Int64): Async<Unit, Never> =
        self.writeCurrent(lineBytes, lineLength)
            .catchAll((_: FileSystemError) =>
                self.rotate().andThen<Unit>((_: Unit) =>
                    self.writeCurrent(lineBytes, lineLength)
                        .catchAll((err: FileSystemError) => diagnoseFs(err))
                )
            )

    function writeCurrent(self, lineBytes: Array<Uint8>, lineLength: Int64): Async<Unit, FileSystemError> =
        self.streamSwitch.value().write(lineBytes.readonly)
            .map<Unit>((_: Unit) =>
                self.bytesWritten = self.bytesWritten + lineLength
            )

module FileSink =

    /// Open a file sink writing `logfmt` records to a brand-new segment file
    /// derived from `basePath`. The actual filename inserts a
    /// millisecond-precision timestamp before the extension — e.g.
    /// `./app.log` → `./app-2026-06-01_14-23-45-123.log`. The base file is
    /// never touched.
    public function open(basePath: Path): Resource<LogSink, FileStreamError> =
        openWith(basePath, None, Formatter.logfmt)

    /// Like `open`, but rotates into a new segment file once the current one
    /// would exceed `maxBytes`.
    public function openLimited(basePath: Path, maxBytes: Int64): Resource<LogSink, FileStreamError> =
        openWith(basePath, Some(maxBytes), Formatter.logfmt)

    /// Most general form: caller supplies an optional size limit and a custom
    /// formatter.
    public function openWith(
        basePath: Path,
        maxBytes: Option<Int64>,
        format: (LogRecord) => String
    ): Resource<LogSink, FileStreamError> =
        Resource.switchable(segmentResource(basePath))
            .map<LogSink>((streamSwitch: Switchable<AsyncOutputStream<FileSystemError>, FileStreamError>) =>
                FileSink(streamSwitch, format, maxBytes, basePath, 0i64) as LogSink
            )

// --- Internal helpers -------------------------------------------------------

// Resource for a single segment: read the wall clock, derive a unique path,
// open it for writing, and CLOSE it on release so the transport's durability
// verdict is actually read. `flush` is not enough: it only waits for the host
// to ACCEPT the bytes and deliberately never spends the one-shot result future
// (see `AsyncOutputStream`'s contract), so a disk that fills while the last
// segment's records are being written returns `Ok` from flush and the failure
// is lost. `close` ends the stream and reads that future — the durability
// point that `File.writeBytes` calls for the same reason. A finalizer has
// nowhere to RETURN an error, so a failed close is surfaced to stderr rather
// than swallowed. `File.openOutputStream`'s own finalizer then drops the
// handles over the top (idempotent). Used both for the initial segment and for
// each rotation.
function segmentResource(basePath: Path): Resource<AsyncOutputStream<FileSystemError>, FileStreamError> =
    clockResource().andThen<AsyncOutputStream<FileSystemError>>((now: Instant) =>
        let path = uniqueFilePath(basePath, now)
        File.openOutputStream(path).andThen<AsyncOutputStream<FileSystemError>>((stream: AsyncOutputStream<FileSystemError>) =>
            Resource.make(
                () => Async.succeed(stream),
                (_: AsyncOutputStream<FileSystemError>) =>
                    stream.close().catchAll((err: FileSystemError) => diagnoseClose(err))
            )
        )
    )

// A resource whose acquire reads the wall clock at the moment of acquisition;
// the release is a no-op. Used so each segment's timestamp reflects the moment
// it is opened, not when the sink was constructed.
function clockResource(): Resource<Instant, FileStreamError> =
    Resource.make(
        () => Instant.now,
        (_: Instant) => Async.succeed(())
    )

let timestampFormatter: DateTimeFormatter =
    DateTimeFormatter.ofPattern("yyyy-MM-dd_HH-mm-ss-SSS")

/// Derive a unique target path from `basePath` by inserting a UTC timestamp
/// between the stem and the extension. Falls back to `"log"` as the stem and
/// drops the extension when the base path has no name or extension.
internal function uniqueFilePath(basePath: Path, instant: Instant): Path =
    let timestamp = timestampFormatter.format(instant, TimeZone.utc)
    let stem = match basePath.stem with
        case Some(s) => s
        case None => "log"
    let ext = match basePath.ext with
        case Some(e) => e
        case None => ""
    let newName =
        if ext == "" then stem ++ "-" ++ timestamp
        else stem ++ "-" ++ timestamp ++ "." ++ ext
    basePath.withName(newName)

// Internal diagnostic for file-sink failures. `FileSystemError` doesn't
// implement `Display`, so the diagnostic is a fixed phrase — enough to flag
// that something went wrong without inspecting the variant.
function diagnoseFs(_err: FileSystemError): Async<Unit, Never> =
    // Best-effort: if stderr is gone too there is nothing left to say it to.
    Console.errorWriteLine("[log-sink: file] write failed")
        .catchAll((_: ConsoleError) => Async.succeed(()))

function diagnoseRotate(): Async<Unit, Never> =
    Console.errorWriteLine("[log-sink: file] rotation failed; continuing on the current segment")
        .catchAll((_: ConsoleError) => Async.succeed(()))

// A segment's close reports the transport's durability verdict — the only place
// a late disk-full (bytes accepted, never flushed to disk) can surface. The
// finalizer that closes it has nowhere to return that error, so it is logged
// rather than dropped: a truncated tail that says so beats one that does not.
function diagnoseClose(_err: FileSystemError): Async<Unit, Never> =
    Console.errorWriteLine("[log-sink: file] closing a segment failed; its final records may not have reached disk")
        .catchAll((_: ConsoleError) => Async.succeed(()))
