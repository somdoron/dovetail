        else if self < other then Ordering.Less
        else Ordering.Greater

test "Ordering equality same" =
    assert Ordering.Less == Ordering.Less
    assert Ordering.Equal == Ordering.Equal
    assert Ordering.Greater == Ordering.Greater

test "Ordering inequality" =
    let eq = Ordering.Less == Ordering.Greater
    assert eq == false
    let eq2 = Ordering.Less == Ordering.Equal
    assert eq2 == false

implement <T> Comparable for Array<T> where T: Comparable =
    public function compare(self: Array<T>, other: Array<T>): Ordering =
        let mutable i = 0
        let mutable result = Ordering.Equal
        while i < self.length do
            if i >= other.length then
                result = Ordering.Greater
                break
            let c = self.get(i).compare(other.get(i))
            if c != Ordering.Equal then
                result = c
                break
            i = i + 1
        if result != Ordering.Equal then result
        else if self.length < other.length then Ordering.Less
        else Ordering.Equal

test "Comparable Int32 returns Ordering" =
    assert 1i32.compare(2i32) == Ordering.Less
    assert 2i32.compare(2i32) == Ordering.Equal
    assert 3i32.compare(2i32) == Ordering.Greater

test "Comparable String returns Ordering" =
    assert "abc".compare("def") == Ordering.Less
    assert "abc".compare("abc") == Ordering.Equal
    assert "def".compare("abc") == Ordering.Greater


implement <A, B> Comparable for (A, B) where A: Comparable, B: Comparable =
    public function compare(self: (A, B), other: (A, B)): Ordering =
        match self.init.compare(other.init) with
            case Ordering.Equal => self.last.compare(other.last)
            case result => result

implement <T, U> Comparable for T ~ U where T: Tuple, T: Comparable, U: Comparable =
    public function compare(self: T ~ U, other: T ~ U): Ordering =
        match self.init.compare(other.init) with
            case Ordering.Equal => self.last.compare(other.last)
            case result => result
