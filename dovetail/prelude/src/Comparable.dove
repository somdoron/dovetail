package standard.prelude

@derive(Equatable)
public enum Ordering =
    Less
    Equal
    Greater

public trait Comparable =
    function compare(self: Self, other: Self): Ordering

implement Comparable for Int8 =
    public function compare(self: Int8, other: Int8): Ordering =
        if self == other then Ordering.Equal
        else if self < other then Ordering.Less
        else Ordering.Greater

implement Comparable for Int16 =
    public function compare(self: Int16, other: Int16): Ordering =
        if self == other then Ordering.Equal
        else if self < other then Ordering.Less
        else Ordering.Greater

implement Comparable for Int32 =
    public function compare(self: Int32, other: Int32): Ordering =
        if self == other then Ordering.Equal
        else if self < other then Ordering.Less
        else Ordering.Greater

implement Comparable for Int64 =
    public function compare(self: Int64, other: Int64): Ordering =
        if self == other then Ordering.Equal
        else if self < other then Ordering.Less
        else Ordering.Greater

