package standard.prelude

/// A universally unique identifier (UUID), stored as two 64-bit integers.
@derive(Equatable)
 public record Uuid =
    high: Int64
    low: Int64

module Uuid =
    /// The nil UUID (all zeros).
    public function nil(): Uuid = Uuid { high = 0i64; low = 0i64 }

    /// Extracts the UUID version nibble — the high nibble of byte 6, i.e. the
    /// 13th hex digit (`16^3` place of `high`), matching `Display`/`toBytes`.
    /// `high`/`low` hold the 128-bit value as two *unsigned* 64-bit words, so
    /// the bit extraction goes through `toUint64()` — a signed division would
    /// misread any UUID whose top bit is set (~half of all random UUIDs).
    public property version(self): Int32 = ((self.high.toUint64() / 4096u64) % 16u64).toInt32()

    /// Returns a 16-byte big-endian representation.
    public function toBytes(self): Array<Uint8> =
        let buf = Array.fill(16, 0u8)
        let mutable h = self.high.toUint64()
        let mutable i = 7
        while i >= 0 do
            buf.set(i, (h % 256u64).toUint8())
            h = h / 256u64
            i = i - 1
        let mutable l = self.low.toUint64()
        i = 15
        while i >= 8 do
            buf.set(i, (l % 256u64).toUint8())
            l = l / 256u64
            i = i - 1
        buf

    /// Parses a UUID from standard "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx".
    public function parse(s: String): Result<Uuid, String> =
        if s.length != 36 then Error("invalid UUID length") else uuidParseValidated(s)

    /// Creates a UUID from 16 bytes in big-endian order.
    public function fromBytes(bytes: Array<Uint8>): Result<Uuid, String> =
        if bytes.length != 16 then
            Error("expected 16 bytes for UUID")
        else
            let mutable high = 0i64
            let mutable i = 0
            while i < 8 do
                high = high * 256i64 + bytes.get(i).toInt64()
                i = i + 1
            let mutable low = 0i64
            while i < 16 do
                low = low * 256i64 + bytes.get(i).toInt64()
                i = i + 1
            Ok(Uuid { high = high; low = low })

implement Comparable for Uuid =
    public function compare(self: Uuid, other: Uuid): Ordering =
        // Unsigned, big-endian order (a UUID's high word is its leading bytes).
        if self.high == other.high then self.low.toUint64().compare(other.low.toUint64())
        else self.high.toUint64().compare(other.high.toUint64())

implement Hashable for Uuid =
    public function hash(self: Uuid): Int64 = Hashable.combine(self.high, self.low)

function uuidIsDash(i: Int32): Bool =
    let a = i == 8
    let b = i == 13
    let c = i == 18
    let d = i == 23
    if a then true else if b then true else if c then true else if d then true else false

function uuidParseValidated(s: String): Result<Uuid, String> =
    let mutable h = 0i64
    let mutable l = 0i64
    let mutable ok = true
    let mutable i = 0
    let mutable pos = 0
    while i < 36 do
        if uuidIsDash(i) then
            i = i + 1
        else
            let byte = String.fromChar(s.getChar(i)).bytes().get(0).toInt32()
            let n = uuidHexVal(byte)
            if n < 0 then
                ok = false
                i = 36
            else
                if pos < 16 then
                    h = h + n.toInt64() * uuidP16(15 - pos)
                else
                    l = l + n.toInt64() * uuidP16(31 - pos)
                pos = pos + 1
                i = i + 1
    if ok then Ok(Uuid { high = h; low = l }) else Error("invalid hex character")

function uuidHexVal(b: Int32): Int32 =
    if b >= 48 then
        if b <= 57 then
            b - 48
        else if b >= 97 then
            if b <= 102 then b - 87 else -1
        else if b >= 65 then
            if b <= 70 then b - 55 else -1
        else
            -1
    else
        -1

function uuidHexCh(n: Int32): String =
    let b = if n < 10 then (n + 48).toUint8() else (n + 87).toUint8()
    String.fromBytes(Array.fill(1, b), 0, 1)

function uuidP16(exp: Int32): Int64 =
    let mutable result = 1i64
    let mutable i = 0
    while i < exp do
        result = result * 16i64
        i = i + 1
    result

implement Display for Uuid =
    public function format(self: Uuid): String =
        let mutable result = ""
        let mutable i = 0
        while i < 32 do
            if i == 8 then result = result ++ "-"
            if i == 12 then result = result ++ "-"
            if i == 16 then result = result ++ "-"
            if i == 20 then result = result ++ "-"
            let nibble =
                if i < 16 then
                    ((self.high.toUint64() / uuidP16(15 - i).toUint64()) % 16u64).toInt32()
                else
                    ((self.low.toUint64() / uuidP16(31 - i).toUint64()) % 16u64).toInt32()
            result = result ++ uuidHexCh(nibble)
            i = i + 1
        result

// --- Tests ---
test "Uuid nil is all zeros" =
    let u = Uuid.nil()
    assert u.high == 0i64
    assert u.low == 0i64

test "Uuid equality" =
    let a = Uuid { high = 1i64; low = 2i64 }
    let b = Uuid { high = 1i64; low = 2i64 }
    let c = Uuid { high = 1i64; low = 3i64 }
    assert a == b
    assert (a == c) == false

test "Uuid toBytes and fromBytes roundtrip" =
    let u = Uuid { high = 123456789i64; low = 987654321i64 }
    let bytes = u.toBytes()
    assert bytes.length == 16
    let result = Uuid.fromBytes(bytes)
    assert result.isOk
    assert result.require == u

test "Uuid fromBytes wrong length" =
    let bytes = Array.fill(10, 0u8)
    let result = Uuid.fromBytes(bytes)
    assert result.isError

test "Uuid parse valid" =
    let result = Uuid.parse("00000000-0000-0000-0000-000000000000")
    assert result.isOk
    let u = result.require
    assert u == Uuid.nil()

test "Uuid parse invalid length" =
    let result = Uuid.parse("too-short")
    assert result.isError

test "Uuid hashable deterministic" =
    let u = Uuid { high = 42i64; low = 99i64 }
    assert u.hash() == u.hash()

test "Uuid comparable" =
    let a = Uuid { high = 1i64; low = 1i64 }
    let b = Uuid { high = 1i64; low = 2i64 }
    assert a < b
    assert b > a

test "Uuid extraction is unsigned (top bit set)" =
    // Leading byte 0xf0 sets `high`'s sign bit; signed division would misread
    // every extraction. Version nibble is 4 (high nibble of byte 6 = 0x46).
    let bytes =
        [|
            0xf0u8,
            0x11u8,
            0x22u8,
            0x33u8,
            0x44u8,
            0x55u8,
            0x46u8,
            0x77u8,
            0x88u8,
            0x99u8,
            0xaau8,
            0xbbu8,
            0xccu8,
            0xddu8,
            0xeeu8,
            0xffu8,
        |]
    let u = Uuid.fromBytes(bytes).require
    assert u.version == 4
    // toBytes round-trips despite the high bit.
    let back = u.toBytes()
    let mutable i = 0
    let mutable ok = true
    while i < 16 do
        if back.get(i) != bytes.get(i) then ok = false
        i = i + 1
    assert ok
    // Display renders the leading 'f' and the version digit '4'.
    let s = u.format()
    assert s.length == 36
    assert s.bytes().get(0) == 102u8 // 'f'
    assert s.bytes().get(14) == 52u8 // '4' (version position)
