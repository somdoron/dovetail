package standard.prelude

/// Defines the result of the div operator for a right-hand operand R.
public trait Div<R> =
    type Output
    function div(self: Self, rhs: R): Output

implement Div<Int8> for Int8 =
    type Output = Int8
    public function div(self: Int8, rhs: Int8): Int8 = intrinsic

implement Div<Int16> for Int16 =
    type Output = Int16
    public function div(self: Int16, rhs: Int16): Int16 = intrinsic

implement Div<Int32> for Int32 =
    type Output = Int32
    public function div(self: Int32, rhs: Int32): Int32 = intrinsic

implement Div<Int64> for Int64 =
    type Output = Int64
    public function div(self: Int64, rhs: Int64): Int64 = intrinsic

implement Div<Uint8> for Uint8 =
    type Output = Uint8
    public function div(self: Uint8, rhs: Uint8): Uint8 = intrinsic

implement Div<Uint16> for Uint16 =
    type Output = Uint16
    public function div(self: Uint16, rhs: Uint16): Uint16 = intrinsic

implement Div<Uint32> for Uint32 =
    type Output = Uint32
    public function div(self: Uint32, rhs: Uint32): Uint32 = intrinsic

implement Div<Uint64> for Uint64 =
    type Output = Uint64
    public function div(self: Uint64, rhs: Uint64): Uint64 = intrinsic

implement Div<Float32> for Float32 =
    type Output = Float32
    public function div(self: Float32, rhs: Float32): Float32 = intrinsic

implement Div<Float64> for Float64 =
    type Output = Float64
    public function div(self: Float64, rhs: Float64): Float64 = intrinsic
