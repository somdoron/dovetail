module Uint16 =
    public function toInt8(self): Int8 = intrinsic
    public function toInt16(self): Int16 = intrinsic
    public function toInt32(self): Int32 = intrinsic
    public function toInt64(self): Int64 = intrinsic
    public function toUint8(self): Uint8 = intrinsic
    public function toUint32(self): Uint32 = intrinsic
    public function toUint64(self): Uint64 = intrinsic
    public function toUint128(self): Uint128 = intrinsic
    public function toFloat32(self): Float32 = intrinsic
    public function toFloat64(self): Float64 = intrinsic

module Uint32 =
    public function toInt8(self): Int8 = intrinsic
    public function toInt16(self): Int16 = intrinsic
    public function toInt32(self): Int32 = intrinsic
    public function toInt64(self): Int64 = intrinsic
    public function toUint8(self): Uint8 = intrinsic
