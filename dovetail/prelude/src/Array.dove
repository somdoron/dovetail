module standard.prelude.Array<T>

public function get(self, index: Int32): T = intrinsic
public function set(self, index: Int32, value: T): Unit = intrinsic
public property readonly(self): ReadonlySlice<T> = ReadonlySlice.full(self)
public property length(self): Int32 = intrinsic
public function clone(self): Array<T> = intrinsic
public function fill(size: Int32, value: T): Array<T> = intrinsic
public function extend(self, value: T, newSize: Int32): Array<T> = intrinsic
public function concat(self, other: Array<T>): Array<T> = intrinsic
public function empty(): Array<T> = intrinsic
public function copy(self, sourceOffset: Int32, destination: Array<T>, destinationOffset: Int32, length: Int32): Array<T> = intrinsic
public function copy(self, destination: Array<T>, destinationOffset: Int32): Array<T> = self.copy(0, destination, destinationOffset, self.length)

/// Copies the array's elements into a `List`, preserving order.
/// Built back-to-front, so it needs no reversing pass.
public function toList(self): List<T> =
    let mutable result: List<T> = List.empty
    let mutable i = self.length - 1
    while i >= 0 do
        result = List.Cons(self.get(i), result)
        i = i - 1
    result

public function contains(self, value: T): Bool where T: Equatable =
    let mutable found = false
    for a in self do
        if a == value then
            found = true
            break
    found

public function map<U>(self, f: T => U): Array<U> =
    if (self.length == 0) then Array.empty()
    else
        let result = Array.fill(self.length, f(self.get(0)))
        let mutable i = 1
        while i < self.length do
            result.set(i, f(self.get(i)))
            i = i + 1
        result

public function foldLeft<U>(self, initial: U, f: (U, T) => U): U =
    if (self.length == 0) then initial
    else
        let mutable acc = initial
        let mutable i = 0
        while i < self.length do
            acc = f(acc, self.get(i))
            i = i + 1
        acc

/// Return a new sorted array using the supplied comparator. The
/// comparator receives `(left, right)` and returns an `Ordering`.
/// Stable: equal elements keep their original relative order.
///
/// O(n log n) bottom-up merge sort using two alternating buffers; the
/// receiver is unchanged.
public function sortedBy(self, cmp: (T, T) => Ordering): Array<T> =
    let n = self.length
    if n <= 1 then self.clone()
    else
        // `src` holds each pass's input; `dst` is written this pass;
        // swap at the end of each pass so the final result lives in
        // `src`. Both start as a clone so the receiver isn't mutated.
        let mutable src = self.clone()
        let mutable dst = self.clone()
        let mutable width = 1
        while width < n do
            let mutable runStart = 0
            while runStart < n do
                let mid = if runStart + width < n then runStart + width else n
                let hi = if runStart + 2 * width < n then runStart + 2 * width else n
                // Inline two-run merge from src[runStart..hi) into dst.
                let mutable i = runStart
                let mutable j = mid
                let mutable k = runStart
                while k < hi do
                    if i >= mid then
                        dst.set(k, src.get(j))
                        j = j + 1
                    else if j >= hi then
                        dst.set(k, src.get(i))
                        i = i + 1
                    else if cmp(src.get(i), src.get(j)) != Ordering.Greater then
                        dst.set(k, src.get(i))
                        i = i + 1
                    else
                        dst.set(k, src.get(j))
                        j = j + 1
                    k = k + 1
                runStart = runStart + 2 * width
            let tmp = src
            src = dst
            dst = tmp
            width = width * 2
        src

/// Return a new array containing the same elements in sorted order
/// (smallest first). Does not modify the receiver. Stable.
///
/// O(n log n) bottom-up merge sort. Requires `T: Comparable`; for
/// custom ordering use `sortedBy` (no trait bound) or `sortedByKey`.
public function sorted(self): Array<T> where T: Comparable =
    self.sortedBy((a: T, b: T) => a.compare(b))

/// Return a new sorted array using a projection. Each element's `key`
/// is computed once per comparison; if the key is expensive, prefer
/// `sortedBy` with a memoized comparator instead.
public function sortedByKey<K>(self, key: (T) => K): Array<T> where K: Comparable =
    self.sortedBy((a: T, b: T) => key(a).compare(key(b)))

test "Array sorted: empty array" =
    let a: Array<Int32> = Array.empty()
    let s = a.sorted()
    assert s.length == 0

test "Array sorted: single element" =
    let a = Array.fill(1, 42)
    let s = a.sorted()
    assert s.length == 1
    assert s.get(0) == 42

test "Array sorted: already sorted" =
    let a = [|1, 2, 3, 4, 5|]
    let s = a.sorted()
    assert s.length == 5
    assert s.get(0) == 1
    assert s.get(4) == 5

test "Array sorted: reverse order" =
    let a = [|5, 4, 3, 2, 1|]
    let s = a.sorted()
    assert s.get(0) == 1
    assert s.get(1) == 2
    assert s.get(2) == 3
    assert s.get(3) == 4
    assert s.get(4) == 5

test "Array sorted: mixed order with duplicates" =
    let a = [|3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5|]
    let s = a.sorted()
    assert s.get(0) == 1
    assert s.get(1) == 1
    assert s.get(2) == 2
    assert s.get(3) == 3
    assert s.get(4) == 3
    assert s.get(5) == 4
    assert s.get(6) == 5
    assert s.get(7) == 5
    assert s.get(8) == 5
    assert s.get(9) == 6
    assert s.get(10) == 9

test "Array sorted: does not mutate receiver" =
    let a = [|3, 1, 2|]
    let _ = a.sorted()
    assert a.get(0) == 3
    assert a.get(1) == 1
    assert a.get(2) == 2

test "Array sorted: strings" =
    let a = [|"cherry", "apple", "banana"|]
    let s = a.sorted()
    assert s.get(0) == "apple"
    assert s.get(1) == "banana"
    assert s.get(2) == "cherry"

test "Array sortedBy: reverse via comparator" =
    let a = [|1, 2, 3, 4, 5|]
    let s = a.sortedBy((x: Int32, y: Int32) => y.compare(x))
    assert s.get(0) == 5
    assert s.get(4) == 1

test "Array sortedByKey: by string length" =
    let a = [|"banana", "fig", "cherry", "kiwi"|]
    let s = a.sortedByKey((x: String) => x.length)
    assert s.get(0) == "fig"        // 3
    assert s.get(1) == "kiwi"       // 4
    assert s.get(2) == "banana"     // 6
    assert s.get(3) == "cherry"     // 6

test "Array sorted: large array (32 elements)" =
    // Exercises multiple merge-sort passes (32 = 2^5, so width grows 1→2→4→8→16).
    let a = [|
        29, 17, 3, 8, 24, 14, 21, 1,
        15, 9, 18, 6, 27, 11, 20, 26,
        12, 4, 30, 13, 22, 7, 31, 2,
        28, 16, 10, 19, 23, 5, 25, 0
    |]
    let s = a.sorted()
    let mutable i = 0
    while i < 32 do
        assert s.get(i) == i
        i = i + 1
