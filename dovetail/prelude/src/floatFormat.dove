// Helper: count decimal digits in a 64-bit value
function decimalLength(v: Int64): Int32 =
    if v < 10i64 then 1
    else if v < 100i64 then 2
    else if v < 1000i64 then 3
    else if v < 10000i64 then 4
    else if v < 100000i64 then 5
    else if v < 1000000i64 then 6
    else if v < 10000000i64 then 7
    else if v < 100000000i64 then 8
    else if v < 1000000000i64 then 9
    else if v < 10000000000i64 then 10
    else if v < 100000000000i64 then 11
    else if v < 1000000000000i64 then 12
    else if v < 10000000000000i64 then 13
    else if v < 100000000000000i64 then 14
    else if v < 1000000000000000i64 then 15
    else if v < 10000000000000000i64 then 16
    else 17

// Helper: log10(2^e) = floor(e * log10(2)) approx
function log10_pow2(e: Int32): Int32 =
    (e * 78913) >> 18

// Helper: log10(5^e) approx
function log10_pow5(e: Int32): Int32 =
    (e * 732923) >> 20

// Helper: number of bits in 5^e
function pow5bits(e: Int32): Int32 =
    ((e * 1217359) >> 19) + 1

// 0xFFFFFFFF as Int64
let MASK32: Int64 = 4294967295i64

// High 64 bits of unsigned 128-bit product of two Int64 values
// (treating them as unsigned bit patterns).
// Uses wrapping arithmetic: all products and sums wrap mod 2^64
// which gives correct unsigned bit patterns.
// Right shifts are masked to get unsigned shift behavior:
// (x >> n) & mask clears sign-extended bits.
function umul128_hi(a: Int64, b: Int64): Int64 =
    let a_lo = a & MASK32
    let a_hi = (a >> 32i64) & MASK32
    let b_lo = b & MASK32
    let b_hi = (b >> 32i64) & MASK32
    // Partial products (wrapping is fine for unsigned multiply)
    let p00 = a_lo * b_lo
    let p01 = a_lo * b_hi
    let p10 = a_hi * b_lo
    let p11 = a_hi * b_hi
    // Accumulate the middle column
    let mid = p10 + ((p00 >> 32i64) & MASK32)
    let mid2 = p01 + (mid & MASK32)
    // High 64 bits of 128-bit product
    p11 + ((mid >> 32i64) & MASK32) + ((mid2 >> 32i64) & MASK32)

// 128-bit multiply and shift: computes (m * mul) >> shift
// where mul is the 128-bit value (mul_hi, mul_lo)
// m is at most 55 bits (4*m2 + 2 where m2 is 53 bits)
// shift is in the range [64, 128)
function mulShift64(m: Int64, mul_hi: Int64, mul_lo: Int64, shift: Int32): Int64 =
    // Compute the 192-bit product m * (mul_hi : mul_lo)
    // = m*mul_lo (128 bits) + m*mul_hi (128 bits) << 64
    //
    // Bits 0-63:   low 64 of m*mul_lo (not needed since shift >= 64)
    // Bits 64-127: hi(m*mul_lo) + lo(m*mul_hi)
    // Bits 128-191: hi(m*mul_hi) + carry
    let lo_hi = umul128_hi(m, mul_lo)
    let hi_lo = m * mul_hi
    let hi_hi = umul128_hi(m, mul_hi)
    let sum = lo_hi + hi_lo
    // Unsigned carry detection: carry = 1 if unsigned(sum) < unsigned(lo_hi)
    // Convert signed comparison to unsigned by XOR with sign bit
    let sign_bit = -9223372036854775808i64
    let carry = if (sum ^ sign_bit) < (lo_hi ^ sign_bit) then 1i64 else 0i64
    let bits_mid = sum
    let bits_top = hi_hi + carry
    let s = shift.toInt64() - 64i64
    if s == 0i64 then bits_mid
    else if s < 64i64 then
        let mask = (1i64 << (64i64 - s)) - 1i64
        (bits_top << (64i64 - s)) | ((bits_mid >> s) & mask)
    else if s == 64i64 then bits_top
    else
        let s2 = s - 64i64
        let mask2 = (1i64 << (64i64 - s2)) - 1i64
        (bits_top >> s2) & mask2

function formatFloat64(value: Float64): String =
    let bits = value.toBits()
    let sign = (bits >> 63i64) & 1i64
    let mantissa = bits & 4503599627370495i64
    let biased_exp = ((bits >> 52i64) & 2047i64).toInt32()
    // Special cases
    if biased_exp == 2047 then
        if mantissa != 0i64 then "NaN"
        else if sign != 0i64 then "-Infinity"
        else "Infinity"
    else if if biased_exp == 0 then mantissa == 0i64 else false then
        if sign != 0i64 then "-0.0" else "0.0"
    else
        // Ryū d2d algorithm inlined
        // Determine e2 and m2
        let mutable e2 = 0
        let mutable m2 = 0i64
        if biased_exp == 0 then
            // Subnormal
            e2 = 1 - 1023 - 52 - 2
            m2 = mantissa
        else
            // Normal
            e2 = biased_exp - 1023 - 52 - 2
            m2 = (1i64 << 52i64) | mantissa
        let even = (m2 & 1i64) == 0i64
        let accept_bounds = even
        // Step 2: Determine interval and compute decimal
        let mv = 4i64 * m2
        let mm_shift = if mantissa != 0i64 then 1i64
                       else if biased_exp > 1 then 1i64
                       else 0i64
        let mutable vr = 0i64
        let mutable vp = 0i64
        let mutable vm = 0i64
        let mutable e10 = 0
        let mutable vm_is_trailing_zeros = false
        let mutable vr_is_trailing_zeros = false
        if e2 >= 0 then
            let q = log10_pow2(e2) - (if e2 > 3 then 1 else 0)
            e10 = q
            let k = 125 + pow5bits(q) - 1
            let i = 0 - e2 + q + k
            let tbl_hi = POW5_INV_SPLIT_HI.get(q)
            let tbl_lo = POW5_INV_SPLIT_LO.get(q)
            vr = mulShift64(mv, tbl_hi, tbl_lo, i)
            vp = mulShift64(mv + 2i64, tbl_hi, tbl_lo, i)
            vm = mulShift64(mv - 1i64 - mm_shift, tbl_hi, tbl_lo, i)
            if q <= 21 then
                if mv % 5i64 == 0i64 then
                    vr_is_trailing_zeros = true
                else if accept_bounds then
                    vm_is_trailing_zeros = true
        else
            let q = log10_pow5(0 - e2) - (if 0 - e2 > 1 then 1 else 0)
            e10 = q + e2
            let i = 0 - e2 - q
            let k = pow5bits(i) - 125
            let j = q - k
            let tbl_hi = POW5_SPLIT_HI.get(i)
            let tbl_lo = POW5_SPLIT_LO.get(i)
            vr = mulShift64(mv, tbl_hi, tbl_lo, j)
            vp = mulShift64(mv + 2i64, tbl_hi, tbl_lo, j)
            vm = mulShift64(mv - 1i64 - mm_shift, tbl_hi, tbl_lo, j)
            if q <= 1 then
                vr_is_trailing_zeros = true
                if accept_bounds then
                    vm_is_trailing_zeros = true
                else
                    vp = vp - 1i64
        // Step 3: Find the shortest decimal representation
        let mutable removed = 0
        let mutable last_removed_digit = 0i64
        // General case: remove trailing digits
        while vp / 10i64 > vm / 10i64 do
            vm_is_trailing_zeros = if vm_is_trailing_zeros then vm % 10i64 == 0i64 else false
            vr_is_trailing_zeros = if vr_is_trailing_zeros then last_removed_digit == 0i64 else false
            last_removed_digit = vr % 10i64
            vr = vr / 10i64
            vp = vp / 10i64
            vm = vm / 10i64
            removed = removed + 1
        if vm_is_trailing_zeros then
            while vm % 10i64 == 0i64 do
                vr_is_trailing_zeros = if vr_is_trailing_zeros then last_removed_digit == 0i64 else false
                last_removed_digit = vr % 10i64
                vr = vr / 10i64
                vp = vp / 10i64
                vm = vm / 10i64
                removed = removed + 1
        // Banker's rounding: if trailing zeros and last digit is 5 and vr is even, round down
        if if vr_is_trailing_zeros then last_removed_digit == 5i64 else false then
            if vr % 2i64 == 0i64 then
                last_removed_digit = 4i64
        // Round up condition: (vr == vm and we're not accepting bounds or vm has no trailing zeros) or last_removed_digit >= 5
        let vm_eq_round = if vr == vm then
                              if accept_bounds then false
                              else if vm_is_trailing_zeros then false
                              else true
                          else false
        let round_up = if vm_eq_round then true else last_removed_digit >= 5i64
        let output = vr + (if round_up then 1i64 else 0i64)
        let exp = e10 + removed
        // Format the output
        let ol = decimalLength(output)
        let sci_exp = exp + ol - 1
        // Build string
        let buf = Array.fill(25, 0u8)
        let mutable pos = 0
        if sign != 0i64 then
            buf.set(pos, 45u8)
            pos = pos + 1
        // Decide format: use plain for reasonable exponents
        if if sci_exp >= 0 then sci_exp < 16 else false then
            // Fixed-like: e.g. 3.14, 100.0
            let int_digits = sci_exp + 1
            if int_digits >= ol then
                // All digits before decimal: e.g. 100.0
                let mutable n = output
                let mutable i = ol - 1
                while i >= 0 do
                    buf.set(pos + i, (n % 10i64).toInt32().toUint8() + 48u8)
                    n = n / 10i64
                    i = i - 1
                pos = pos + ol
                // Add trailing zeros for integer part
                let mutable j = 0
                while j < int_digits - ol do
                    buf.set(pos, 48u8)
                    pos = pos + 1
                    j = j + 1
                buf.set(pos, 46u8)
                pos = pos + 1
                buf.set(pos, 48u8)
                pos = pos + 1
            else
                // Some digits after decimal: e.g. 3.14
                let mutable n = output
                let mutable i = ol - 1
                while i >= 0 do
                    let d = (n % 10i64).toInt32().toUint8() + 48u8
                    n = n / 10i64
                    if i == int_digits then
                        buf.set(pos + i + 1, d)
                        buf.set(pos + i, 46u8)
                    else if i > int_digits then
                        buf.set(pos + i + 1, d)
                    else
                        buf.set(pos + i, d)
                    i = i - 1
                pos = pos + ol + 1
            String.fromBytes(buf, 0, pos)
        else if if sci_exp >= -3 then sci_exp < 0 else false then
            // Small decimal: 0.001 to 0.999...
            buf.set(pos, 48u8)
            pos = pos + 1
            buf.set(pos, 46u8)
            pos = pos + 1
            // Leading zeros
            let leading_zeros = 0 - sci_exp - 1
            let mutable j = 0
            while j < leading_zeros do
                buf.set(pos, 48u8)
                pos = pos + 1
                j = j + 1
            // Digits
            let mutable n = output
            let mutable i = ol - 1
            while i >= 0 do
                buf.set(pos + i, (n % 10i64).toInt32().toUint8() + 48u8)
                n = n / 10i64
                i = i - 1
            pos = pos + ol
            String.fromBytes(buf, 0, pos)
        else
            // Scientific notation: 1.23E10
            let ebuf = Array.fill(30, 0u8)
            let mutable epos = 0
            if sign != 0i64 then
                ebuf.set(epos, 45u8)
                epos = epos + 1
            // Output digits with decimal point
            let mutable n = output
            let digits = Array.fill(ol, 0u8)
            let mutable i = ol - 1
            while i >= 0 do
                digits.set(i, (n % 10i64).toInt32().toUint8() + 48u8)
                n = n / 10i64
                i = i - 1
            ebuf.set(epos, digits.get(0))
            epos = epos + 1
            if ol > 1 then
                ebuf.set(epos, 46u8)
                epos = epos + 1
                let mutable k = 1
                while k < ol do
                    ebuf.set(epos, digits.get(k))
                    epos = epos + 1
                    k = k + 1
            // Exponent
            ebuf.set(epos, 69u8)
            epos = epos + 1
            if sci_exp < 0 then
                ebuf.set(epos, 45u8)
                epos = epos + 1
                let abs_exp = 0 - sci_exp
                if abs_exp >= 100 then
                    ebuf.set(epos, (abs_exp / 100).toUint8() + 48u8)
                    epos = epos + 1
                    ebuf.set(epos, ((abs_exp / 10) % 10).toUint8() + 48u8)
                    epos = epos + 1
                    ebuf.set(epos, (abs_exp % 10).toUint8() + 48u8)
                    epos = epos + 1
                else if abs_exp >= 10 then
                    ebuf.set(epos, (abs_exp / 10).toUint8() + 48u8)
                    epos = epos + 1
                    ebuf.set(epos, (abs_exp % 10).toUint8() + 48u8)
                    epos = epos + 1
                else
                    ebuf.set(epos, abs_exp.toUint8() + 48u8)
                    epos = epos + 1
            else
                let mutable abs_exp = sci_exp
                if abs_exp >= 100 then
                    ebuf.set(epos, (abs_exp / 100).toUint8() + 48u8)
                    epos = epos + 1
                    ebuf.set(epos, ((abs_exp / 10) % 10).toUint8() + 48u8)
                    epos = epos + 1
                    ebuf.set(epos, (abs_exp % 10).toUint8() + 48u8)
                    epos = epos + 1
                else if abs_exp >= 10 then
                    ebuf.set(epos, (abs_exp / 10).toUint8() + 48u8)
                    epos = epos + 1
                    ebuf.set(epos, (abs_exp % 10).toUint8() + 48u8)
                    epos = epos + 1
                else
                    ebuf.set(epos, abs_exp.toUint8() + 48u8)
                    epos = epos + 1
            String.fromBytes(ebuf, 0, epos)
