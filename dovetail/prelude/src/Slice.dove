package standard.prelude

/// A writable, bounded view of an array. Copies share the underlying elements.
/// The view flattens to (data, start, length), boxing at single-slot boundaries.
public newtype Slice<T> private = (Array<T>, Int32, Int32)

module Slice<T> =
    public function make(data: Array<T>, start: Int32, length: Int32): Slice<T> =
        assert start >= 0 && length >= 0 && start <= data.length, "slice out of bounds"
        assert length <= data.length - start, "slice out of bounds"
        Slice((data, start, length))

    public function full(data: Array<T>): Slice<T> = Slice.make(data, 0, data.length)

    public property readonly(self): ReadonlySlice<T> =
        let (data, start, length) = self.value
        ReadonlySlice.make(data, start, length)

    public property length(self): Int32 = self.value._2

    public function isEmpty(self): Bool = self.length == 0

    public function get(self, index: Int32): T =
        assert index >= 0 && index < self.length, "slice index out of bounds"
        let (data, start, _) = self.value
        data.get(start + index)

    public function set(self, index: Int32, value: T): Unit =
        assert index >= 0 && index < self.length, "slice index out of bounds"
        let (data, start, _) = self.value
        data.set(start + index, value)

    /// Return a view of the half-open interval [start, end).
    public function slice(self, start: Int32, end: Int32): Slice<T> =
        assert start >= 0 && end >= start && end <= self.length, "slice out of bounds"
        let (data, offset, _) = self.value
        Slice((data, offset + start, end - start))

    /// Inclusive counterpart used by [|start..=end|]; check before incrementing.
    public function sliceInclusive(self, start: Int32, end: Int32): Slice<T> =
        assert start >= 0 && end >= start && end < self.length, "slice out of bounds"
        self.slice(start, end + 1)

    public function drop(self, count: Int32): Slice<T> = self.slice(count, self.length)

    public function take(self, count: Int32): Slice<T> = self.slice(0, count)

    public function toArray(self): Array<T> =
        if self.isEmpty() then
            Array.empty()
        else
            let result = Array.fill(self.length, self.get(0))
            self.copyTo(Slice.full(result))
            result

    /// Copy all elements to dest, preserving source values even for overlapping views.
    public function copyTo(self, dest: Slice<T>): Unit =
        assert dest.length >= self.length, "slice destination too short"
        let (data, start, length) = self.value
        let (target, offset, _) = dest.value
        let _ = data.copy(start, target, offset, length)
        ()

class SliceIterator<T>(slice: Slice<T>, mutable index: Int32) implements Iterator<T> =
    public function next(self): Option<T> =
        if self.index == self.slice.length then
            None
        else
            let item = self.slice.get(self.index)
            self.index = self.index + 1
            Some(item)

implement<T> Iterable<T> for Slice<T> =
    public function iterator(self): Iterator<T> = SliceIterator<T>(self, 0)

implement<T> Display for Slice<T> where T: Display =
    public function format(self: Slice<T>): String =
        let mutable parts: List<String> = List.empty
        let mutable i = 0
        while i < self.length do
            parts = List.Cons(self.get(i).format() ++ ",", parts)
            i = i + 1
        "[" ++ String.join(parts.reverse(), "") ++ "]"

implement<T> Equatable for Slice<T> where T: Equatable =
    public function equals(self: Slice<T>, other: Slice<T>): Bool =
        if self.length != other.length then
            false
        else
            let mutable equal = true
            let mutable i = 0
            while i < self.length do
                if self.get(i) != other.get(i) then
                    equal = false
                    break
                i = i + 1
            equal

implement<T> Index<Int32> for Slice<T> =
    type Output = T

    public function get(self: Slice<T>, index: Int32): T = self.get(index)

implement<T> IndexSet<Int32> for Slice<T> =
    type Value = T

    public function set(self: Slice<T>, index: Int32, value: T): Unit = self.set(index, value)
