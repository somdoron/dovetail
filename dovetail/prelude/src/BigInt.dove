package standard.prelude

/// Arbitrary-precision integer. sign=true means non-negative, sign=false means negative.
/// magnitude is stored in base 10^9, least-significant digit first. Zero is [0].
public record BigInt =
    /// True if non-negative, false if negative.
    sign: Bool
    /// Base-10^9 digits stored least-significant first.
    magnitude: Array<Int32>

private let BASE: Int64 = 1000000000i64

/// Factory methods and arithmetic operations for BigInt.
module BigInt =
    /// Creates a BigInt from a 32-bit integer.
    public function fromInt32(n: Int32): BigInt =
        if n == 0 then BigInt.zero()
        else if n > 0 then
            let mag = bigintMagFromUint32(n.toInt64())
            BigInt { sign = true; magnitude = mag }
        else
            let mag = bigintMagFromUint32((0i64 - n.toInt64()))
            BigInt { sign = false; magnitude = mag }

    /// Creates a BigInt from a 64-bit integer.
    public function fromInt64(n: Int64): BigInt =
        if n == 0i64 then BigInt.zero()
        else if n > 0i64 then
            let mag = bigintMagFromUint64(n)
            BigInt { sign = true; magnitude = mag }
        else
            let mag = bigintMagFromNegative(n)
            BigInt { sign = false; magnitude = mag }

    /// Returns the BigInt representing zero.
    public function zero(): BigInt =
        BigInt { sign = true; magnitude = Array.fill(1, 0) }

    /// Returns the BigInt representing one.
    public function one(): BigInt =
        BigInt { sign = true; magnitude = Array.fill(1, 1) }

    /// Returns the sum of this BigInt and another.
    public function add(self, other: BigInt): BigInt =
        if self.sign == other.sign then
            let mag = bigintAddMag(self.magnitude, other.magnitude)
            BigInt { sign = self.sign; magnitude = mag }
        else
            let cmp = bigintCmpMag(self.magnitude, other.magnitude)
            if cmp == Ordering.Equal then BigInt.zero()
            else if cmp == Ordering.Greater then
                let mag = bigintSubMag(self.magnitude, other.magnitude)
                BigInt { sign = self.sign; magnitude = mag }
            else
                let mag = bigintSubMag(other.magnitude, self.magnitude)
                BigInt { sign = other.sign; magnitude = mag }

    /// Returns the difference of this BigInt minus another.
    public function subtract(self, other: BigInt): BigInt =
        self.add(other.negate())

    /// Returns the product of this BigInt and another.
    public function multiply(self, other: BigInt): BigInt =
        let mag = bigintMulMag(self.magnitude, other.magnitude)
        let sign = if mag.length == 1 then
            if mag.get(0) == 0 then true
            else self.sign == other.sign
        else self.sign == other.sign
        BigInt { sign = sign; magnitude = mag }

    /// Returns the negation of this BigInt. Zero remains unchanged.
    public function negate(self): BigInt =
        if self.isZero then self
        else BigInt { sign = if self.sign then false else true; magnitude = self.magnitude }

    /// Returns the absolute value of this BigInt.
    public function abs(self): BigInt =
        BigInt { sign = true; magnitude = self.magnitude }

    /// Converts this BigInt to an Int32, returning None if the value overflows.
    public function toInt32(self): Option<Int32> =
        match self.toInt64() with
            case None => None
            case Some(value) =>
                if value < -2147483648i64 || value > 2147483647i64 then None
                else Some(value.toInt32())

    /// Converts this BigInt to an Int64, returning None if the value overflows.
    public function toInt64(self): Option<Int64> =
        bigintMagToInt64(self.magnitude, self.sign)

    public property isNegative(self): Bool = !self.sign && !self.isZero

    /// Returns true if this BigInt is zero.
    public property isZero(self): Bool =
        self.magnitude.length == 1 && self.magnitude.get(0) == 0

implement Equatable for BigInt =
    /// Returns true if two BigInts have the same sign and magnitude.
    public function equals(self: BigInt, other: BigInt): Bool =
        if self.sign != other.sign then false
        else bigintCmpMag(self.magnitude, other.magnitude) == Ordering.Equal

implement Comparable for BigInt =
    /// Compares two BigInts, returning their relative ordering.
    public function compare(self: BigInt, other: BigInt): Ordering =
        if self.sign && !other.sign then Ordering.Greater
        else if !self.sign && other.sign then Ordering.Less
        else if self.sign then
            bigintCmpMag(self.magnitude, other.magnitude)
        else
            match bigintCmpMag(self.magnitude, other.magnitude) with
                case Ordering.Less => Ordering.Greater
                case Ordering.Greater => Ordering.Less
                case _ => Ordering.Equal

implement Hashable for BigInt =
    /// Returns a hash code for this BigInt.
    public function hash(self: BigInt): Int64 =
        let sign_hash = if self.sign then 1i64 else 0i64
        let mag_hash = bigintMagHash(self.magnitude)
        bigintHashCombine(sign_hash, mag_hash)

implement Display for BigInt =
    /// Formats this BigInt as a decimal string, with a leading minus for negatives.
    public function format(self: BigInt): String =
        if self.isZero then "0"
        else
            let s = bigintMagFormat(self.magnitude)
            if self.sign then s else "-" ++ s

function bigintMagFromUint64(n: Int64): Array<Int32> =
    if n == 0i64 then Array.fill(1, 0)
    else
        let mutable parts = Array.fill(0, 0)
        let mutable x = n
        while x > 0i64 do
            let d = (x % BASE).toInt32()
            parts = parts.concat(Array.fill(1, d))
            x = x / BASE
        parts

function bigintMagFromUint32(n: Int64): Array<Int32> =
    bigintMagFromUint64(n)

function bigintCmpMag(a: Array<Int32>, b: Array<Int32>): Ordering =
    let alen = a.length
    let blen = b.length
    if alen > blen then Ordering.Greater
    else if alen < blen then Ordering.Less
    else
        let mutable i = alen - 1
        let mutable result = Ordering.Equal
        while i >= 0 do
            let av = a.get(i).toInt64()
            let bv = b.get(i).toInt64()
            if av > bv then
                result = Ordering.Greater
                i = -1
            else if av < bv then
                result = Ordering.Less
                i = -1
            else i = i - 1
        result

function bigintAddMag(a: Array<Int32>, b: Array<Int32>): Array<Int32> =
    let alen = a.length
    let blen = b.length
    let len = if alen > blen then alen else blen
    let mutable result = Array.fill(0, 0)
    let mutable carry = 0i64
    let mutable i = 0
    while i < len do
        let av = if i < alen then a.get(i).toInt64() else 0i64
        let bv = if i < blen then b.get(i).toInt64() else 0i64
        let sum = av + bv + carry
        carry = sum / BASE
        let digit = (sum % BASE).toInt32()
        result = result.concat(Array.fill(1, digit))
        i = i + 1
    if carry > 0i64 then
        result = result.concat(Array.fill(1, carry.toInt32()))
    bigintNormalize(result)

function bigintSubMag(a: Array<Int32>, b: Array<Int32>): Array<Int32> =
    let alen = a.length
    let blen = b.length
    let mutable result = Array.fill(0, 0)
    let mutable borrow = 0i64
    let mutable i = 0
    while i < alen do
        let av = a.get(i).toInt64()
        let bv = if i < blen then b.get(i).toInt64() else 0i64
        let diff = av - bv - borrow
        if diff < 0i64 then
            borrow = 1i64
            result = result.concat(Array.fill(1, (diff + BASE).toInt32()))
        else
            borrow = 0i64
            result = result.concat(Array.fill(1, diff.toInt32()))
        i = i + 1
    bigintNormalize(result)

function bigintMulMag(a: Array<Int32>, b: Array<Int32>): Array<Int32> =
    let alen = a.length
    let blen = b.length
    if alen == 0 || blen == 0 then Array.fill(1, 0)
    else if alen == 1 && a.get(0) == 0 then Array.fill(1, 0)
    else if blen == 1 && b.get(0) == 0 then Array.fill(1, 0)
    else
        let mutable acc = Array.fill(1, 0)
        let mutable j = 0
        while j < blen do
            let bdig = b.get(j).toInt64()
            let mutable carry = 0i64
            let mutable row = Array.fill(0, 0)
            let mutable mut_k = 0
            while mut_k < j do
                row = row.concat(Array.fill(1, 0))
                mut_k = mut_k + 1
            let mutable mut_i = 0
            while mut_i < alen do
                let adig = a.get(mut_i).toInt64()
                let prod = adig * bdig + carry
                carry = prod / BASE
                row = row.concat(Array.fill(1, (prod % BASE).toInt32()))
                mut_i = mut_i + 1
            if carry > 0i64 then
                row = row.concat(Array.fill(1, carry.toInt32()))
            acc = bigintAddMag(acc, row)
            j = j + 1
        bigintNormalize(acc)

function bigintNormalize(mag: Array<Int32>): Array<Int32> =
    let len = mag.length
    let mutable result_len = 1
    let mutable k = len - 1
    while k >= 1 do
        if mag.get(k) == 0 then k = k - 1
        else
            result_len = k + 1
            k = 0
    if result_len == 0 then Array.fill(1, 0)
    else if result_len == len then mag
    else
        let result = Array.fill(result_len, 0)
        let mutable mut_j = 0
        while mut_j < result_len do
            result.set(mut_j, mag.get(mut_j))
            mut_j = mut_j + 1
        result

function bigintMagToInt64(mag: Array<Int32>, positive: Bool): Option<Int64> =
    let limit = if positive then -9223372036854775807i64 else -9223372036854775808i64
    let mutable value = 0i64
    let mutable i = mag.length - 1
    let mutable overflow = false
    while i >= 0 && !overflow do
        let digit = mag.get(i).toInt64()
        if value < limit / BASE then overflow = true
        else
            value = value * BASE
            if value < limit + digit then overflow = true
            else value = value - digit
        i = i - 1
    if overflow then None
    else Some(if positive then 0i64 - value else value)

function bigintMagFromNegative(n: Int64): Array<Int32> =
    let mutable parts = Array.fill(0, 0)
    let mutable value = n
    while value < 0i64 do
        parts = parts.concat(Array.fill(1, (0i64 - value % BASE).toInt32()))
        value = value / BASE
    parts

function bigintHashCombine(seed: Int64, value: Int64): Int64 =
    let h = seed + value * 2654435761i64
    let s = h / 65536i64
    (h + s) * 2246822519i64 + 1i64

function bigintMagHash(mag: Array<Int32>): Int64 =
    let len = mag.length
    let mutable h = 0i64
    let mutable mut_i = 0
    while mut_i < len do
        h = bigintHashCombine(h, mag.get(mut_i).toInt64())
        mut_i = mut_i + 1
    h

function bigintMagFormat(mag: Array<Int32>): String =
    let len = mag.length
    if len == 0 then "0"
    else
        let mutable result = ""
        let mutable mut_i = len - 1
        while mut_i >= 0 do
            let d = mag.get(mut_i)
            let s = d.format()
            if mut_i < len - 1 then
                let pad = 9 - s.length
                let mutable mut_j = 0
                while mut_j < pad do
                    result = result ++ "0"
                    mut_j = mut_j + 1
            result = result ++ s
            mut_i = mut_i - 1
        result

test "BigInt zero" =
    let z = BigInt.zero()
    assert z.isZero
    assert z.format() == "0"

test "BigInt one" =
    let o = BigInt.one()
    assert o.isZero == false
    assert o.format() == "1"

test "BigInt fromInt32 positive" =
    let n = BigInt.fromInt32(42)
    assert n.format() == "42"
    assert n.toInt32().isSome
    assert n.toInt32().require == 42

test "BigInt fromInt32 negative" =
    let n = BigInt.fromInt32(-99)
    assert n.format() == "-99"
    assert n.toInt32().isSome
    assert n.toInt32().require == -99

test "BigInt fromInt32 zero" =
    let n = BigInt.fromInt32(0)
    assert n.isZero
    assert n.format() == "0"

test "BigInt fromInt64" =
    let n = BigInt.fromInt64(1000000000i64)
    assert n.format() == "1000000000"
    assert n.toInt64().isSome
    assert n.toInt64().require == 1000000000i64

test "BigInt add same sign" =
    let a = BigInt.fromInt32(100)
    let b = BigInt.fromInt32(200)
    assert a.add(b).format() == "300"

test "BigInt add different signs" =
    let a = BigInt.fromInt32(100)
    let b = BigInt.fromInt32(-30)
    assert a.add(b).format() == "70"

test "BigInt add to zero" =
    let a = BigInt.fromInt32(5)
    let b = BigInt.fromInt32(-5)
    assert a.add(b).isZero

test "BigInt subtract" =
    let a = BigInt.fromInt32(100)
    let b = BigInt.fromInt32(30)
    assert a.subtract(b).format() == "70"

test "BigInt multiply" =
    let a = BigInt.fromInt32(7)
    let b = BigInt.fromInt32(6)
    assert a.multiply(b).format() == "42"

test "BigInt multiply by zero" =
    let a = BigInt.fromInt32(12345)
    let z = BigInt.zero()
    assert a.multiply(z).isZero

test "BigInt negate" =
    let a = BigInt.fromInt32(42)
    assert a.negate().format() == "-42"
    assert a.negate().negate().format() == "42"
    assert BigInt.zero().negate().isZero

test "BigInt abs" =
    let a = BigInt.fromInt32(-42)
    assert a.abs().format() == "42"
    let b = BigInt.fromInt32(42)
    assert b.abs().format() == "42"

test "BigInt equality" =
    let a = BigInt.fromInt32(42)
    let b = BigInt.fromInt32(42)
    let c = BigInt.fromInt32(43)
    assert a == b
    assert (a == c) == false

test "BigInt comparison" =
    let a = BigInt.fromInt32(10)
    let b = BigInt.fromInt32(20)
    let c = BigInt.fromInt32(-5)
    assert a < b
    assert b > a
    assert c < a

test "BigInt hash deterministic" =
    let a = BigInt.fromInt32(42)
    assert a.hash() == a.hash()

test "BigInt toInt32 overflow" =
    let big = BigInt.fromInt64(3000000000i64)
    assert big.toInt32().isNone

implement Add<BigInt> for BigInt =
    type Output = BigInt
    public function add(self: BigInt, rhs: BigInt): BigInt = self.add(rhs)

implement Sub<BigInt> for BigInt =
    type Output = BigInt
    public function sub(self: BigInt, rhs: BigInt): BigInt = self.subtract(rhs)

implement Mul<BigInt> for BigInt =
    type Output = BigInt
    public function mul(self: BigInt, rhs: BigInt): BigInt = self.multiply(rhs)

implement Neg for BigInt =
    public function negate(self: BigInt): BigInt = self.negate()
