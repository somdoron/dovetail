package standard.crypto.roots

import standard.crypto.X509
import standard.crypto.X509Certificate
import standard.time.Instant

/// Captured from generativelanguage.googleapis.com on 2026-09-27 using
/// openssl s_client -showcerts. The leaf covers *.googleapis.com. Fixed time
/// 2026-09-27T00:00:00Z is inside all three certificates' validity windows.
module GoogleChainTest =
    function now(): Instant = Instant.ofEpochSecond(1790467200i64)

    function leaf(): X509Certificate =
        X509
            .parseCertificatePem(
            "-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n"
        )
            .require

    function intermediate(): X509Certificate =
        X509
            .parseCertificatePem(
            "-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n"
        )
            .require

    function crossSignedRoot(): X509Certificate =
        X509
            .parseCertificatePem(
            "-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n"
        )
            .require

test "Google cross-signed chain terminates at Mozilla GTS Root R1" =
    let chain =
        [GoogleChainTest.leaf(), GoogleChainTest.intermediate(), GoogleChainTest.crossSignedRoot()]
    assert X509.validate(chain, Roots.mozillaRoots(), 10, GoogleChainTest.now()).isOk

test "Google WR2 directly anchors without the cross-signed root" =
    let chain = [GoogleChainTest.leaf(), GoogleChainTest.intermediate()]
    assert X509.validate(chain, Roots.mozillaRoots(), 10, GoogleChainTest.now()).isOk

test "Google chain rejects missing trust anchors" =
    let chain =
        [GoogleChainTest.leaf(), GoogleChainTest.intermediate(), GoogleChainTest.crossSignedRoot()]
    assert X509.validate(chain, [], 10, GoogleChainTest.now()).isError

test "Google chain rejects a corrupted leaf signature" =
    let leaf = GoogleChainTest.leaf()
    leaf.signatureValue.set(0, leaf.signatureValue.get(0) ^ 1u8)
    assert X509
        .validate(
        [leaf, GoogleChainTest.intermediate(), GoogleChainTest.crossSignedRoot()],
        Roots.mozillaRoots(),
        10,
        GoogleChainTest.now()
    )
        .isError

test "Google chain rejects a corrupted intermediate signature" =
    let intermediate = GoogleChainTest.intermediate()
    intermediate.signatureValue.set(0, intermediate.signatureValue.get(0) ^ 1u8)
    assert X509
        .validate(
        [GoogleChainTest.leaf(), intermediate, GoogleChainTest.crossSignedRoot()],
        Roots.mozillaRoots(),
        10,
        GoogleChainTest.now()
    )
        .isError

test "Google selected path still checks validity" =
    assert X509
        .validate(
        [GoogleChainTest.leaf(), GoogleChainTest.intermediate(), GoogleChainTest.crossSignedRoot()],
        Roots.mozillaRoots(),
        10,
        Instant.ofEpochSecond(2000000000i64)
    )
        .isError

test "Google unused cross-signed suffix does not require verification" =
    let unused = GoogleChainTest.crossSignedRoot()
    unused.signatureValue.set(0, unused.signatureValue.get(0) ^ 1u8)
    assert X509
        .validate(
        [GoogleChainTest.leaf(), GoogleChainTest.intermediate(), unused],
        Roots.mozillaRoots(),
        10,
        GoogleChainTest.now()
    )
        .isOk
