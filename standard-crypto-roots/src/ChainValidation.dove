package standard.crypto.roots

import standard.prelude.Array
import standard.prelude.String
import standard.prelude.Result
import standard.crypto.X509
import standard.crypto.X509Certificate
import standard.time.Instant

/// End-to-end validation of real, captured TLS certificate chains against the
/// embedded Mozilla trust store. Each leaf+intermediate pair was captured with
/// `openssl s_client -showcerts` and frozen here as Base64 DER; the validity
/// window is pinned to a fixed instant inside every cert's lifetime so the test
/// stays deterministic. Together they exercise every signature verifier:
///
///   * ECDSA chain (www.cloudflare.com): P-256 leaf signed ecdsa-with-SHA256 by
///     the WE1 intermediate, which is signed ecdsa-with-SHA384 by the P-384
///     `GTS Root R4` — covers both EcdsaP256 and EcdsaP384.
///   * RSA chain (badssl.com): leaf signed sha256WithRSAEncryption by Let's
///     Encrypt `R13`, signed sha256WithRSAEncryption by `ISRG Root X1` —
///     covers RSA PKCS#1 v1.5.
module ChainTest =
    /// A fixed instant (2026-06-15T00:00:00Z) inside every captured cert's
    /// validity window.
    private function knownGoodTime(): Instant = Instant.ofEpochSecond(1781481600i64)

    private function pem(b64: String): String =
        "-----BEGIN CERTIFICATE-----\n" ++ b64 ++ "\n-----END CERTIFICATE-----\n"

    private function cert(b64: String): X509Certificate = X509.parseCertificatePem(pem(b64)).require

    private function ecdsaLeaf(): String =
        ""

    private function ecdsaInter(): String =
        ""

    private function rsaLeaf(): String =
        ""

    private function rsaInter(): String =
        ""

    function ecdsaChain(): List<X509Certificate> = [cert(ecdsaLeaf()), cert(ecdsaInter())]

    function rsaChain(): List<X509Certificate> = [cert(rsaLeaf()), cert(rsaInter())]

test "validate real ECDSA (P-256/P-384) chain to embedded Mozilla root" =
    let result =
        X509.validate(ChainTest.ecdsaChain(), Roots.mozillaRoots(), 10, ChainTest.knownGoodTime())
    assert result.isOk

test "validate real RSA (PKCS#1 v1.5) chain to embedded Mozilla root" =
    let result =
        X509.validate(ChainTest.rsaChain(), Roots.mozillaRoots(), 10, ChainTest.knownGoodTime())
    assert result.isOk

test "real chain rejected when outside validity window" =
    // 2033-05-18: long after every captured leaf expired (2026).
    let expiredTime = Instant.ofEpochSecond(2000000000i64)
    let result = X509.validate(ChainTest.ecdsaChain(), Roots.mozillaRoots(), 10, expiredTime)
    assert result.isOk == false

test "real chain rejected with no trust anchors" =
    let empty: List<X509Certificate> = []
    let result = X509.validate(ChainTest.rsaChain(), empty, 10, ChainTest.knownGoodTime())
    assert result.isOk == false
