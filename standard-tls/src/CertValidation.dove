package standard.tls

import standard.prelude.Array
import standard.prelude.Result
import standard.prelude.String

import standard.crypto.X509
import standard.crypto.X509Certificate
import standard.crypto.X509Error
import standard.time.Instant

/// Adapts the TLS Certificate message to `standard.crypto`'s X.509 chain
/// validator (RFC 8446 §4.4.2). It parses the DER certificate entries, runs
/// `X509.validate` against the configured trust anchors at the connection's
/// `currentTime`, and translates `X509Error` into the matching `TlsError`
/// (which then becomes the right alert).
///
/// `currentTime` is supplied by the caller (from config) rather than read from
/// a clock, keeping the protocol engine pure.
/// Maximum certificate chain depth accepted (RFC 5280 path length guidance).
let maxChainDepth: Int32 = 10

/// Translate an X.509 validation failure to the TLS alert-bearing error.
function mapX509Error(e: X509Error): TlsError =
    match e with
        case CertificateExpired => TlsError.CertificateExpired
        case CertificateNotYetValid => TlsError.CertificateExpired
        case SignatureVerificationFailed => TlsError.BadCertificate("signature verification failed")
        case MissingTrustAnchor => TlsError.BadCertificate("unknown certificate authority")
        case MalformedCertificate(m) => TlsError.BadCertificate(m)
        case UnsupportedAlgorithm(_) => TlsError.BadCertificate("unsupported certificate algorithm")
        case ChainTooLong(_) => TlsError.BadCertificate("certificate chain too long")
        case ConstraintViolation(m) => TlsError.BadCertificate(m)
        case _ => TlsError.BadCertificate("certificate validation failed")

// ---------------------------------------------------------------------------
// Hostname / identity verification (RFC 6125 / RFC 6066)
// ---------------------------------------------------------------------------
/// Parse a single decimal octet (0..255) from an IPv4 literal component.
function parseOctet(text: String): Option<Uint8> =
    let n = text.length
    if (n == 0) || (n > 3) then
        None
    else
        let bytes = text.bytes()
        let mutable value = 0i32
        let mutable failed = false
        let mutable i = 0
        while i < bytes.length do
            let b = bytes.get(i)
            if (b < 48u8) || (b > 57u8) then failed = true
            else value = value * 10 + (b - 48u8).toInt32()
            i = i + 1
        if failed || (value > 255) then None else Some(value.toUint8())

/// Parse an IPv4 literal ("a.b.c.d") into its 4 address bytes.
function parseIpv4(host: String): Option<Array<Uint8>> =
    match host.split(".") with
        case [aText, bText, cText, dText] =>
            match (parseOctet(aText), parseOctet(bText), parseOctet(cText), parseOctet(dText)) with
                case (Some(a), Some(b), Some(c), Some(d)) => Some([| a, b, c, d |])
                case _ => None
        case _ => None

/// Return the address bytes of an IPv4-literal `serverName`, or `None`. IPv6
/// literals are NOT decoded here (there is no IPv6 SAN in practice for this
/// stack); `verifyIdentity` routes every IP literal — IPv4 or IPv6 — through the
/// IP branch via `isIpLiteral`, so an IPv6 literal with no decoded bytes fails
/// identity matching CLOSED rather than falling through to DNS matching against
/// the raw address text.
function ipLiteralBytes(serverName: String): Option<Array<Uint8>> = parseIpv4(serverName)

/// Whether `serverName` is an IP literal — a dotted-quad IPv4 address, or an IPv6
/// literal (detected by a ':'). RFC 6066 §3 forbids IP literals in the SNI
/// `server_name` extension, so the client suppresses SNI for these.
function isIpLiteral(serverName: String): Bool =
    match parseIpv4(serverName) with
        case Some(_) => true
        case None => serverName.contains(":")

function bytesEq(a: Array<Uint8>, b: Array<Uint8>): Bool =
    if a.length != b.length then
        false
    else
        let mutable eq = true
        let mutable i = 0
        while i < a.length do
            if a.get(i) != b.get(i) then eq = false
            i = i + 1
        eq

/// True if `ip` byte-equals any iPAddress SAN entry.
function anyIpMatches(sans: List<Array<Uint8>>, ip: Array<Uint8>): Bool =
    sans.any(san => bytesEq(san, ip))

/// RFC 6125 dNSName match of a certificate `pattern` against `host` (both are
/// lowercased first, so matching is case-insensitive). A `*` is honoured only as
/// the *entire* left-most label: it matches exactly one label and never fewer,
/// never a partial label (`f*.example.com`), and never in a non-leftmost
/// position. A wildcard pattern must have at least two labels after the `*`
/// (so `*.com` is rejected).
function dnsNameMatches(pattern: String, host: String): Bool =
    let p = pattern.toLowerCase()
    let h = host.toLowerCase()
    if p.contains("*") == false then
        p == h
    else
        let pLabels = p.split(".")
        let hLabels = h.split(".")
        // `length` is O(n) on a list and both sides are peer-controlled, so
        // count once each rather than in a loop condition.
        let pCount = pLabels.length
        let hCount = hLabels.length
        // Never match a wildcard against a name with a different number of
        // labels (in particular, never fewer labels than the pattern).
        if pCount != hCount then
            false
        else
            if pCount < 3 then
                // Require the wildcard plus at least two more labels (no `*.com`).
                false
            else
                match (pLabels, hLabels) with
                    // `*` must be the ENTIRE leftmost label; `f*.example.com` is
                    // rejected, as is any wildcard not in the leftmost position.
                    case ("*" :: pRest, _ :: hRest) =>
                        let mutable eq = true
                        let mutable pCurrent = pRest
                        let mutable hCurrent = hRest
                        while !pCurrent.isEmpty && !hCurrent.isEmpty do
                            if pCurrent.head != hCurrent.head then eq = false
                            pCurrent = pCurrent.tail
                            hCurrent = hCurrent.tail
                        eq
                    case _ => false

/// True if `host` matches any dNSName SAN entry per `dnsNameMatches`.
function anyDnsMatches(sans: List<String>, host: String): Bool =
    sans.any(san => dnsNameMatches(san, host))

/// Verify that the leaf certificate's identity matches `serverName`. IP literals
/// match iPAddress SANs only (byte equality, no wildcards, no CN fallback); DNS
/// names match dNSName SANs only. A leaf with no SAN at all is rejected: there is
/// deliberately NO Common Name fallback (SAN-less certificates are effectively
/// extinct, and CN-only matching is the classic identity-confusion hole).
function verifyIdentity(leaf: X509Certificate, serverName: String): Result<Unit, TlsError> =
    // An IP literal (IPv4 or IPv6) matches iPAddress SANs only — never DNS. Route
    // by `isIpLiteral` FIRST so an IPv6 literal, which `ipLiteralBytes` cannot
    // decode, fails closed here instead of falling into the DNS branch and being
    // matched as text against a dNSName SAN.
    if isIpLiteral(serverName) then
        match ipLiteralBytes(serverName) with
            case Some(ip) =>
                if anyIpMatches(leaf.sanIpAddresses, ip) then
                    Ok(())
                else
                    Error(
                        TlsError.CertificateNameMismatch("no iPAddress SAN matches " ++ serverName)
                    )
            case None =>
                Error(
                    TlsError
                        .CertificateNameMismatch(
                        "unsupported IP-literal serverName (IPv6 not decoded): " ++ serverName
                    )
                )
    else if leaf.hasSan == false then
        Error(
            TlsError
                .CertificateNameMismatch("certificate has no subjectAltName; refusing CN fallback")
        )
    else if anyDnsMatches(leaf.sanDnsNames, serverName) then
        Ok(())
    else
        Error(TlsError.CertificateNameMismatch("no dNSName SAN matches " ++ serverName))

/// Parse and validate a server (or client) certificate chain. Returns the
/// parsed chain (leaf first) on success. This performs BOTH the cryptographic
/// path validation (`X509.validate`: signatures, validity windows, issuer/subject
/// chaining, CA/basic-constraints/keyUsage/pathLen constraints, trust anchoring)
/// AND RFC 6125 hostname/identity verification of the leaf against `serverName`.
function validateChain(
    entries: List<CertificateEntry>,
    trustAnchors: List<X509Certificate>,
    currentTime: Instant,
    serverName: String
): Result<List<X509Certificate>, TlsError> =
    // Counted once: the entry list is peer-supplied, and this bound is what
    // keeps the walk short.
    let entryCount = entries.length
    if entryCount == 0 then
        Error(TlsError.BadCertificate("empty certificate chain"))
    else
        if entryCount > maxChainDepth then
            // D4: reject an over-long Certificate message BEFORE parsing every entry,
            // so a hostile peer cannot force us to DER-parse an unbounded number of
            // certificates ahead of X509.validate's own maxChainDepth enforcement.
            Error(TlsError.BadCertificate("certificate chain too long"))
        else
            let mutable parsed: List<X509Certificate> = List.empty
            for entry in entries do
                match X509.parseCertificate(entry.certData) with
                    case Error(e) => try Result.Error(mapX509Error(e))
                    case Ok(cert) => parsed = parsed.prepend(cert)
            let chain = parsed.reverse()
            match X509.validate(chain, trustAnchors, maxChainDepth, currentTime) with
                case Error(e) => Error(mapX509Error(e))
                case Ok(_) =>
                    match chain with
                        case [] => Error(TlsError.BadCertificate("empty certificate chain"))
                        case leaf :: _ =>
                            match verifyIdentity(leaf, serverName) with
                                case Error(e) => Error(e)
                                case Ok(_) => Ok(chain)

/// The leaf certificate's public-key bytes, for CertificateVerify.
function leafPublicKey(chain: List<X509Certificate>): Array<Uint8> = chain.head.publicKey

test "tls validateChain rejects an empty chain" =
    let result =
        validateChain(
            List<CertificateEntry>.empty,
            List<X509Certificate>.empty,
            Instant.ofEpochSecond(0i64),
            "example.com"
        )
    assert result.isError

test "tls validateChain reports malformed certificate bytes" =
    let entries =
        [
            CertificateEntry {
                certData = [| 0x00u8, 0x01u8, 0x02u8 |]
                extensions = List<Extension>.empty
            }
        ]
    let result =
        validateChain(
            entries,
            List<X509Certificate>.empty,
            Instant.ofEpochSecond(0i64),
            "example.com"
        )
    match result with
        case Error(BadCertificate(_)) => assert true
        case _ => assert false

test "tls validateChain rejects an over-long certificate chain before parsing (D4)" =
    // A Certificate message with more than maxChainDepth entries is rejected up
    // front, so the (here malformed) entries are never DER-parsed. This bounds the
    // pre-validation parse work a hostile peer can force.
    let entry =
        CertificateEntry {
            certData = [| 0x00u8, 0x01u8, 0x02u8 |]
            extensions = List<Extension>.empty
        }
    let mutable entries: List<CertificateEntry> = List.empty
    let mutable i = 0
    while i < maxChainDepth + 1 do
        entries = entries.prepend(entry)
        i = i + 1
    let result =
        validateChain(
            entries,
            List<X509Certificate>.empty,
            Instant.ofEpochSecond(0i64),
            "example.com"
        )
    match result with
        case Error(BadCertificate(_)) => assert true
        case _ => assert false

// --- hostname / identity verification tests --------------------------------
/// Minimal DER builder for parseable (but unsigned) leaf certificates carrying a
/// chosen extensions block, used to exercise `verifyIdentity` in isolation.
module CvTest =
    function derLen(n: Int32): Array<Uint8> =
        if n < 128 then [| n.toUint8() |]
        else if n < 256 then [| 0x81u8, n.toUint8() |]
        else [| 0x82u8, (n / 256).toUint8(), (n % 256).toUint8() |]

    function tlv(tag: Uint8, content: Array<Uint8>): Array<Uint8> =
        [| tag |].concat(derLen(content.length)).concat(content)

    function ed(): Array<Uint8> = tlv(0x30u8, tlv(0x06u8, [| 0x2bu8, 0x65u8, 0x70u8 |]))

    function nm(cn: String): Array<Uint8> =
        tlv(
            0x30u8,
            tlv(
                0x31u8,
                tlv(
                    0x30u8,
                    tlv(0x06u8, [| 0x55u8, 0x04u8, 0x03u8 |]).concat(tlv(0x0cu8, cn.bytes()))
                )
            )
        )

    /// A parseable leaf certificate (dummy public key + signature) carrying `exts`.
    public function leafCert(exts: Array<Uint8>): Array<Uint8> =
        let version = tlv(0xa0u8, tlv(0x02u8, [| 0x02u8 |]))
        let serial = tlv(0x02u8, [| 0x2au8 |])
        let validity =
            tlv(
                0x30u8,
                tlv(0x17u8, "200101000000Z".bytes()).concat(tlv(0x17u8, "300101000000Z".bytes()))
            )
        let spki =
            tlv(
                0x30u8,
                ed().concat(tlv(0x03u8, [| 0x00u8 |].concat(Array<Uint8>.fill(32, 0x01u8))))
            )
        let tbs =
            tlv(
                0x30u8,
                version
                    .concat(serial)
                    .concat(ed())
                    .concat(nm("host"))
                    .concat(validity)
                    .concat(nm("host"))
                    .concat(spki)
                    .concat(exts)
            )
        tlv(
            0x30u8,
            tbs.concat(ed()).concat(tlv(0x03u8, [| 0x00u8 |].concat(Array<Uint8>.fill(64, 0x00u8))))
        )

    public function exts(extensions: Array<Uint8>): Array<Uint8> =
        tlv(0xa3u8, tlv(0x30u8, extensions))

    public function sanDns(dns: String): Array<Uint8> =
        tlv(
            0x30u8,
            tlv(0x06u8, [| 0x55u8, 0x1du8, 0x11u8 |])
                .concat(tlv(0x04u8, tlv(0x30u8, tlv(0x82u8, dns.bytes()))))
        )

    public function sanIp(ip: Array<Uint8>): Array<Uint8> =
        tlv(
            0x30u8,
            tlv(0x06u8, [| 0x55u8, 0x1du8, 0x11u8 |])
                .concat(tlv(0x04u8, tlv(0x30u8, tlv(0x87u8, ip))))
        )

test "hostname dNSName exact and case-insensitive match" =
    assert dnsNameMatches("example.com", "example.com")
    assert dnsNameMatches("EXAMPLE.com", "example.COM")
    assert dnsNameMatches("example.com", "www.example.com") == false
    assert dnsNameMatches("example.com", "example.org") == false

test "hostname wildcard matches exactly one leftmost label" =
    // matches one leftmost label, case-insensitively
    assert dnsNameMatches("*.example.com", "a.example.com")
    assert dnsNameMatches("*.example.com", "A.Example.Com")
    // reject: more labels than the pattern
    assert dnsNameMatches("*.example.com", "a.b.example.com") == false
    // reject: fewer labels (the bare registered domain)
    assert dnsNameMatches("*.example.com", "example.com") == false
    // reject: partial-label wildcard (`*` is not the entire leftmost label)
    assert dnsNameMatches("f*.example.com", "foo.example.com") == false
    // reject: wildcard over a public suffix (fewer than two labels follow `*`)
    assert dnsNameMatches("*.com", "example.com") == false
    // reject: wildcard not in the leftmost position
    assert dnsNameMatches("a.*.com", "a.b.com") == false

test "IPv4 literal parsing" =
    match parseIpv4("127.0.0.1") with
        case Some(b) => assert (b.length == 4) && (b.get(0) == 127u8) && (b.get(3) == 1u8)
        case None => assert false
    assert parseIpv4("256.0.0.1").isNone
    assert parseIpv4("1.2.3").isNone
    assert parseIpv4("example.com").isNone

test "verifyIdentity matches an iPAddress SAN and rejects a mismatch" =
    let cert =
        X509
            .parseCertificate(
            CvTest.leafCert(CvTest.exts(CvTest.sanIp([| 127u8, 0u8, 0u8, 1u8 |])))
        )
            .require
    assert verifyIdentity(cert, "127.0.0.1").isOk
    match verifyIdentity(cert, "127.0.0.2") with
        case Error(CertificateNameMismatch(_)) => assert true
        case _ => assert false
    // an IP-literal serverName never falls back to a dNSName SAN
    let dnsCert =
        X509.parseCertificate(CvTest.leafCert(CvTest.exts(CvTest.sanDns("127.0.0.1")))).require
    assert verifyIdentity(dnsCert, "127.0.0.1").isError

test "verifyIdentity matches a dNSName SAN and yields a typed mismatch error" =
    let cert =
        X509.parseCertificate(CvTest.leafCert(CvTest.exts(CvTest.sanDns("example.com")))).require
    assert verifyIdentity(cert, "example.com").isOk
    assert verifyIdentity(cert, "EXAMPLE.COM").isOk
    match verifyIdentity(cert, "evil.com") with
        case Error(CertificateNameMismatch(_)) => assert true
        case _ => assert false

test "verifyIdentity rejects a certificate with no SAN (no CN fallback)" =
    let cert = X509.parseCertificate(CvTest.leafCert(Array<Uint8>.empty())).require
    match verifyIdentity(cert, "example.com") with
        case Error(CertificateNameMismatch(_)) => assert true
        case _ => assert false

test "verifyIdentity fails closed on an IPv6-literal serverName (no DNS fallthrough)" =
    // A cert whose dNSName SAN is the literal text "::1". An IPv6 literal is an IP
    // literal (matched only against iPAddress SANs, which this stack cannot decode
    // for IPv6) and MUST NOT fall through to dNSName text matching — otherwise a
    // cert bearing "::1" as a dNSName would be accepted for the IPv6 host ::1.
    // Before the isIpLiteral-first routing, this returned Ok via the DNS branch.
    let cert = X509.parseCertificate(CvTest.leafCert(CvTest.exts(CvTest.sanDns("::1")))).require
    match verifyIdentity(cert, "::1") with
        case Error(CertificateNameMismatch(_)) => assert true
        case _ => assert false
