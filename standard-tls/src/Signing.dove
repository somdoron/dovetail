package standard.tls

import standard.prelude.Array
import standard.prelude.Option
import standard.prelude.Result
import standard.prelude.String

import standard.crypto.SecretKey
import standard.crypto.PublicKey
import standard.crypto.Ed25519
import standard.crypto.EcdsaP256
import standard.crypto.RsaPss
import standard.crypto.Sha256
import standard.crypto.Sha384
import standard.crypto.ConstantTime

/// CertificateVerify signing/verification (RFC 8446 §4.4.3). The "signed
/// content" is `64×0x20 ‖ context ‖ 0x00 ‖ Transcript-Hash`, and the signature
/// is produced/verified by the algorithm named in the message's
/// `SignatureScheme`.
///
/// The crypto package keeps its RSA public-key DER parser and DER↔raw ECDSA
/// conversion private, so this module re-implements the few lines of ASN.1 it
/// needs (a leaf-only DER reader). RSA-PSS in TLS uses salt length = hash
/// length (not the empty salt the crypto self-tests use).
/// The signed-content octet string for a CertificateVerify (RFC 8446 §4.4.3).
function signedContentInput(context: String, transcriptHash: Array<Uint8>): Array<Uint8> =
    let w = ByteWriter.make()
    let mutable i = 0
    while i < 64 do
        w.putU8(0x20)
        i = i + 1
    w.putBytes(context.bytes())
    w.putU8(0)
    w.putBytes(transcriptHash)
    w.toBytes()

/// The context string a client uses to verify the server's CertificateVerify.
let serverVerifyContext: String = "TLS 1.3, server CertificateVerify"

/// The context string a server uses to verify a client's CertificateVerify.
let clientVerifyContext: String = "TLS 1.3, client CertificateVerify"

/// Verify a CertificateVerify signature over `signedInput` using the peer's
/// certificate public key (SPKI key bytes), dispatched by scheme.
function verifyCertificateSignature(
    scheme: SignatureScheme,
    certPublicKey: Array<Uint8>,
    signedInput: Array<Uint8>,
    signature: Array<Uint8>
): Bool =
    match scheme with
        case Ed25519 => Ed25519.verify(PublicKey(certPublicKey), signedInput, signature)
        case EcdsaSecp256r1Sha256 =>
            match derEcdsaToRaw(signature) with
                case Error(_) => false
                case Ok(raw) => EcdsaP256.verify(PublicKey(certPublicKey), signedInput, raw)
        case RsaPssRsaeSha256 =>
            match parseRsaSpki(certPublicKey) with
                case Error(_) => false
                case Ok(ne) => RsaPss.verify(Sha256, ne._0, ne._1, signedInput, signature, 32)
        case RsaPssRsaeSha384 =>
            match parseRsaSpki(certPublicKey) with
                case Error(_) => false
                case Ok(ne) => RsaPss.verify(Sha384, ne._0, ne._1, signedInput, signature, 48)

// OID content bytes (the value octets, without tag/length) of the SPKI key
// algorithms a CertificateVerify SignatureScheme can bind to. These mirror
// standard.crypto's X509 OID constants, which are module-private there. Ed25519
// is 1.3.101.112; id-ecPublicKey is 1.2.840.10045.2.1; prime256v1/secp256r1 is
// 1.2.840.10045.3.1.7; rsaEncryption is 1.2.840.113549.1.1.1.
let oidEd25519: Array<Uint8> = [| 0x2bu8, 0x65u8, 0x70u8 |]

let oidEcPublicKey: Array<Uint8> = [| 0x2au8, 0x86u8, 0x48u8, 0xceu8, 0x3du8, 0x02u8, 0x01u8 |]

let oidSecp256r1: Array<Uint8> =
    [| 0x2au8, 0x86u8, 0x48u8, 0xceu8, 0x3du8, 0x03u8, 0x01u8, 0x07u8 |]

let oidRsaEncryption: Array<Uint8> =
    [| 0x2au8, 0x86u8, 0x48u8, 0x86u8, 0xf7u8, 0x0du8, 0x01u8, 0x01u8, 0x01u8 |]

/// RFC 8446 §4.4.3: the CertificateVerify signature algorithm MUST be compatible
/// with the key in the sender's end-entity certificate. Given the scheme and the
/// leaf certificate's SPKI algorithm OID (`spkiOid`) plus its named-curve OID
/// (`curveOid`, empty for non-EC keys), report whether the scheme's key family
/// matches the leaf key. An ECDSA scheme additionally requires the exact curve.
function schemeMatchesKey(scheme: SignatureScheme, spkiOid: Array<Uint8>, curveOid: Array<Uint8>):
    Bool =
    match scheme with
        case Ed25519 => ConstantTime.equal(spkiOid, oidEd25519)
        case EcdsaSecp256r1Sha256 =>
            ConstantTime
                .equal(spkiOid, oidEcPublicKey)
                && ConstantTime.equal(curveOid, oidSecp256r1)
        case RsaPssRsaeSha256 => ConstantTime.equal(spkiOid, oidRsaEncryption)
        case RsaPssRsaeSha384 => ConstantTime.equal(spkiOid, oidRsaEncryption)

/// Sign `signedInput` for our own CertificateVerify with the given scheme and
/// secret key. RSA server signing is not yet supported (needs modulus + private
/// exponent rather than a bare scalar) and returns an error.
function signCertificateVerify(scheme: SignatureScheme, key: SecretKey, signedInput: Array<Uint8>):
    Result<Array<Uint8>, TlsError> =
    match scheme with
        case Ed25519 => Ok(Ed25519.sign(key, signedInput))
        case EcdsaSecp256r1Sha256 => rawEcdsaToDer(EcdsaP256.sign(key, signedInput))
        case RsaPssRsaeSha256 => Error(TlsError.InternalError("RSA server signing unsupported"))
        case RsaPssRsaeSha384 => Error(TlsError.InternalError("RSA server signing unsupported"))

// ---------------------------------------------------------------------------
// Minimal DER (leaf-only) for RSA SPKI and ECDSA signatures
// ---------------------------------------------------------------------------
function readDerLen(r: ByteReader): Result<Int32, TlsError> =
    let first = try r.u8()
    if first < 0x80 then
        Ok(first)
    else
        let numBytes = first - 0x80
        let mutable len = 0
        let mutable i = 0
        while i < numBytes do
            let b = try r.u8()
            len = (len << 8) | b
            i = i + 1
        Ok(len)

/// Read one DER TLV, returning (tag, content bytes).
function readTlv(r: ByteReader): Result<(Int32, Array<Uint8>), TlsError> =
    let tag = try r.u8()
    let len = try readDerLen(r)
    let content = try r.bytes(len)
    Ok((tag, content))

function stripLeadingZeros(bytes: Array<Uint8>): Array<Uint8> =
    let mutable start = 0
    while start < bytes.length - 1 && bytes.get(start) == 0u8 do
        start = start + 1
    let n = bytes.length - start
    let result = Array<Uint8>.fill(n, 0u8)
    bytes.copy(start, result, 0, n)
    result

function leftPad(bytes: Array<Uint8>, size: Int32): Array<Uint8> =
    let result = Array<Uint8>.fill(size, 0u8)
    if bytes.length >= size then bytes.copy(bytes.length - size, result, 0, size)
    else bytes.copy(0, result, size - bytes.length, bytes.length)
    result

/// Parse `RSAPublicKey ::= SEQUENCE { modulus INTEGER, publicExponent INTEGER }`
/// (the SPKI key bytes for an RSA certificate), returning (modulus, exponent)
/// big-endian with sign bytes stripped.
function parseRsaSpki(spki: Array<Uint8>): Result<(Array<Uint8>, Array<Uint8>), TlsError> =
    let r = ByteReader.make(spki)
    let seq = try readTlv(r)
    if seq._0 != 0x30 then
        Error(TlsError.BadCertificate("RSA key is not a SEQUENCE"))
    else
        let sr = ByteReader.make(seq._1)
        let modulus = try readTlv(sr)
        let exponent = try readTlv(sr)
        if modulus._0 != 0x02 || exponent._0 != 0x02 then
            Error(TlsError.BadCertificate("RSA key fields are not INTEGERs"))
        else
            Ok((stripLeadingZeros(modulus._1), stripLeadingZeros(exponent._1)))

/// Convert a DER `SEQUENCE { r INTEGER, s INTEGER }` ECDSA signature to the
/// fixed 64-byte raw `r ‖ s` form `EcdsaP256.verify` expects.
function derEcdsaToRaw(sig: Array<Uint8>): Result<Array<Uint8>, TlsError> =
    let r = ByteReader.make(sig)
    let seq = try readTlv(r)
    if seq._0 != 0x30 then
        Error(TlsError.DecodeError("ECDSA signature is not a SEQUENCE"))
    else
        let sr = ByteReader.make(seq._1)
        let rInt = try readTlv(sr)
        let sInt = try readTlv(sr)
        if rInt._0 != 0x02 || sInt._0 != 0x02 then
            Error(TlsError.DecodeError("ECDSA r/s are not INTEGERs"))
        else
            Ok(
                leftPad(stripLeadingZeros(rInt._1), 32)
                    .concat(leftPad(stripLeadingZeros(sInt._1), 32))
            )

/// Convert a raw 64-byte `r ‖ s` ECDSA signature to DER for the wire.
function rawEcdsaToDer(raw: Array<Uint8>): Result<Array<Uint8>, TlsError> =
    if raw.length != 64 then
        Error(TlsError.InternalError("raw ECDSA signature must be 64 bytes"))
    else
        let rBytes = Array<Uint8>.fill(32, 0u8)
        let sBytes = Array<Uint8>.fill(32, 0u8)
        raw.copy(0, rBytes, 0, 32)
        raw.copy(32, sBytes, 0, 32)
        let seqContent = derInteger(rBytes).concat(derInteger(sBytes))
        let w = ByteWriter.make()
        w.putU8(0x30)
        w.putU8(seqContent.length)
        w.putBytes(seqContent)
        Ok(w.toBytes())

/// DER-encode a positive integer magnitude (strip leading zeros; prepend 0x00
/// if the high bit is set so it stays positive).
function derInteger(magnitude: Array<Uint8>): Array<Uint8> =
    let trimmed = stripLeadingZeros(magnitude)
    let needsPad = trimmed.get(0).toInt32() >= 0x80
    let w = ByteWriter.make()
    w.putU8(0x02)
    if needsPad then
        w.putU8(trimmed.length + 1)
        w.putU8(0)
    else
        w.putU8(trimmed.length)
    w.putBytes(trimmed)
    w.toBytes()

test "tls signedContentInput has the RFC 8446 §4.4.3 shape" =
    let th = Array<Uint8>.fill(32, 0xabu8)
    let input = signedContentInput(serverVerifyContext, th)
    // 64 spaces, then context, then 0x00, then the 32-byte hash
    assert input.length == 64 + serverVerifyContext.bytes().length + 1 + 32
    let mutable i = 0
    let mutable ok = true
    while i < 64 do
        if input.get(i) != 0x20u8 then ok = false
        i = i + 1
    assert ok
    assert input.get(64 + serverVerifyContext.bytes().length) == 0u8

test "tls Ed25519 CertificateVerify signs and verifies" =
    let secret = SecretKey(Array<Uint8>.fill(32, 0x42u8))
    let pub = Ed25519.derivePublicKey(secret)
    let th = Sha256.hash([| 0x01u8, 0x02u8, 0x03u8 |])
    let input = signedContentInput(serverVerifyContext, th)
    let sig = signCertificateVerify(SignatureScheme.Ed25519, secret, input).require
    assert verifyCertificateSignature(SignatureScheme.Ed25519, pub.value, input, sig)
    // a tampered signature fails
    sig
        .set(0, sig.get(0) ^ 0x01u8)
    assert verifyCertificateSignature(SignatureScheme.Ed25519, pub.value, input, sig) == false

test "tls ECDSA-P256 CertificateVerify round-trips through DER" =
    let secret = SecretKey(Array<Uint8>.fill(32, 0x09u8))
    let pub = EcdsaP256.derivePublicKey(secret)
    let th = Sha256.hash([| 0xaau8, 0xbbu8 |])
    let input = signedContentInput(serverVerifyContext, th)
    let derSig = signCertificateVerify(SignatureScheme.EcdsaSecp256r1Sha256, secret, input).require
    // DER signature begins with SEQUENCE
    assert derSig.get(0) == 0x30u8
    assert verifyCertificateSignature(
        SignatureScheme.EcdsaSecp256r1Sha256,
        pub.value,
        input,
        derSig
    )

test "tls DER<->raw ECDSA conversion is invertible" =
    let raw = Array<Uint8>.fill(64, 0u8)
    let mutable i = 0
    while i < 64 do
        raw.set(i, (i + 1).toUint8())
        i = i + 1
    let der = rawEcdsaToDer(raw).require
    let back = derEcdsaToRaw(der).require
    assert ConstantTime.equal(raw, back)

test "tls schemeMatchesKey binds each scheme to its leaf key family (D1)" =
    let noCurve = Array<Uint8>.empty()
    // Each scheme matches its own key family...
    assert schemeMatchesKey(SignatureScheme.Ed25519, oidEd25519, noCurve)
    assert schemeMatchesKey(SignatureScheme.EcdsaSecp256r1Sha256, oidEcPublicKey, oidSecp256r1)
    assert schemeMatchesKey(SignatureScheme.RsaPssRsaeSha256, oidRsaEncryption, noCurve)
    assert schemeMatchesKey(SignatureScheme.RsaPssRsaeSha384, oidRsaEncryption, noCurve)
    // ...and rejects a mismatched key family (the §4.4.3 MUST).
    assert schemeMatchesKey(SignatureScheme.Ed25519, oidRsaEncryption, noCurve) == false
    assert schemeMatchesKey(SignatureScheme.Ed25519, oidEcPublicKey, oidSecp256r1) == false
    assert schemeMatchesKey(SignatureScheme.EcdsaSecp256r1Sha256, oidRsaEncryption, noCurve)
        == false
    assert schemeMatchesKey(SignatureScheme.EcdsaSecp256r1Sha256, oidEd25519, noCurve) == false
    assert schemeMatchesKey(SignatureScheme.RsaPssRsaeSha256, oidEd25519, noCurve) == false
    assert schemeMatchesKey(SignatureScheme.RsaPssRsaeSha384, oidEcPublicKey, oidSecp256r1) == false
    // An ECDSA scheme with the right SPKI OID but the wrong curve is rejected.
    let wrongCurve = [| 0x2bu8, 0x81u8, 0x04u8, 0x00u8, 0x22u8 |]
    assert schemeMatchesKey(SignatureScheme.EcdsaSecp256r1Sha256, oidEcPublicKey, wrongCurve)
        == false

test "tls parseRsaSpki extracts modulus and exponent" =
    // SEQUENCE { INTEGER 0x00B5 (3 bytes, leading sign byte), INTEGER 0x010001 }
    let spki =
        [|
            0x30u8,
            0x09u8,
            0x02u8,
            0x02u8,
            0x00u8,
            0xb5u8,
            0x02u8,
            0x03u8,
            0x01u8,
            0x00u8,
            0x01u8,
        |]
    let ne = parseRsaSpki(spki).require
    // leading 0x00 stripped from modulus
    assert ne._0.length == 1
    assert ne._0.get(0) == 0xb5u8
    assert ne._1.length == 3
    assert ne._1.get(0) == 0x01u8
