package standard.tls

import standard.prelude.Array
import standard.prelude.Option
import standard.prelude.Result

import standard.crypto.ConstantTime

/// TLS 1.3 handshake messages (RFC 8446 §4). Each message is framed as
/// `HandshakeType msg_type ‖ uint24 length ‖ body`. This module serialises and
/// parses the message bodies; the record layer carries them and the transcript
/// hashes their exact framed bytes.

let htClientHello: Int32 = 1
let htServerHello: Int32 = 2
let htNewSessionTicket: Int32 = 4
let htEncryptedExtensions: Int32 = 8
let htCertificate: Int32 = 11
let htCertificateVerify: Int32 = 15
let htFinished: Int32 = 20
let htKeyUpdate: Int32 = 24

record ClientHelloMessage =
    random: Array<Uint8>
    legacySessionId: Array<Uint8>
    cipherSuites: List<CipherSuite>
    extensions: List<Extension>

record ServerHelloMessage =
    random: Array<Uint8>
    legacySessionId: Array<Uint8>
    cipherSuite: CipherSuite
    extensions: List<Extension>

record CertificateEntry =
    certData: Array<Uint8>
    extensions: List<Extension>

record CertificateMessage =
    certificateRequestContext: Array<Uint8>
    certificates: List<CertificateEntry>

record CertificateVerifyMessage =
    algorithm: SignatureScheme
    signature: Array<Uint8>

record NewSessionTicketMessage =
    ticketLifetime: Int64
    ticketAgeAdd: Int64
    ticketNonce: Array<Uint8>
    ticket: Array<Uint8>
    extensions: List<Extension>

enum HandshakeMessage =
    ClientHello(ClientHelloMessage)
    ServerHello(ServerHelloMessage)
    EncryptedExtensions(List<Extension>)
    Certificate(CertificateMessage)
    CertificateVerify(CertificateVerifyMessage)
    Finished(Array<Uint8>)
    NewSessionTicket(NewSessionTicketMessage)
    KeyUpdate(Bool)

/// The 32-byte ServerHello.random sentinel marking a HelloRetryRequest
/// (RFC 8446 §4.1.3): SHA-256("HelloRetryRequest").
function helloRetryMagic(): Array<Uint8> =
    [|
        0xcfu8, 0x21u8, 0xadu8, 0x74u8, 0xe5u8, 0x9au8, 0x61u8, 0x11u8,
        0xbeu8, 0x1du8, 0x8cu8, 0x02u8, 0x1eu8, 0x65u8, 0xb8u8, 0x91u8,
        0xc2u8, 0xa2u8, 0x11u8, 0x16u8, 0x7au8, 0xbbu8, 0x8cu8, 0x5eu8,
        0x07u8, 0x9eu8, 0x09u8, 0xe2u8, 0xc8u8, 0xa8u8, 0x33u8, 0x9cu8,
    |]

/// Whether a parsed ServerHello is really a HelloRetryRequest.
function isHelloRetryRequest(sh: ServerHelloMessage): Bool =
    ConstantTime.equal(sh.random, helloRetryMagic())

// ---------------------------------------------------------------------------
// Serialisation
// ---------------------------------------------------------------------------

/// Frame and serialise a handshake message (type ‖ uint24 length ‖ body).
function serializeHandshake(msg: HandshakeMessage): Array<Uint8> =
    let pair = bodyOf(msg)
    let w = ByteWriter.make()
    w.putU8(pair._0)
    w.putVec24(pair._1)
    w.toBytes()

function bodyOf(msg: HandshakeMessage): (Int32, Array<Uint8>) =
    match msg with
        case ClientHello(ch) => (htClientHello, clientHelloBody(ch))
        case ServerHello(sh) => (htServerHello, serverHelloBody(sh))
        case EncryptedExtensions(exts) => (htEncryptedExtensions, serializeExtensions(exts, ExtensionContext.EncryptedExtensionsContext))
        case Certificate(c) => (htCertificate, certificateBody(c))
        case CertificateVerify(cv) => (htCertificateVerify, certificateVerifyBody(cv))
        case Finished(verifyData) => (htFinished, verifyData)
        case NewSessionTicket(t) => (htNewSessionTicket, newSessionTicketBody(t))
        case KeyUpdate(request) => (htKeyUpdate, [|if request then 1u8 else 0u8|])

function cipherSuiteListBytes(suites: List<CipherSuite>): Array<Uint8> =
    let inner = ByteWriter.make()
    for cs in suites do
        inner.putU16(cipherSuiteCode(cs))
    inner.toBytes()

function clientHelloBody(ch: ClientHelloMessage): Array<Uint8> =
    let w = ByteWriter.make()
    w.putU16(0x0303)
    w.putBytes(ch.random)
    w.putVec8(ch.legacySessionId)
    w.putVec16(cipherSuiteListBytes(ch.cipherSuites))
    w.putVec8([|0u8|])      // legacy_compression_methods = { null }
    w.putBytes(serializeExtensions(ch.extensions, ExtensionContext.ClientHelloContext))
    w.toBytes()

function serverHelloBody(sh: ServerHelloMessage): Array<Uint8> =
    let context = if isHelloRetryRequest(sh) then ExtensionContext.HelloRetryRequestContext else ExtensionContext.ServerHelloContext
    let w = ByteWriter.make()
    w.putU16(0x0303)
    w.putBytes(sh.random)
    w.putVec8(sh.legacySessionId)
    w.putU16(cipherSuiteCode(sh.cipherSuite))
    w.putU8(0)            // legacy_compression_method
    w.putBytes(serializeExtensions(sh.extensions, context))
    w.toBytes()

function certificateBody(c: CertificateMessage): Array<Uint8> =
    let list = ByteWriter.make()
    for entry in c.certificates do
        list.putVec24(entry.certData)
        list.putBytes(serializeExtensions(entry.extensions, ExtensionContext.EncryptedExtensionsContext))
    let w = ByteWriter.make()
    w.putVec8(c.certificateRequestContext)
    w.putVec24(list.toBytes())
    w.toBytes()

function certificateVerifyBody(cv: CertificateVerifyMessage): Array<Uint8> =
    let w = ByteWriter.make()
    w.putU16(sigSchemeCode(cv.algorithm))
    w.putVec16(cv.signature)
    w.toBytes()

function newSessionTicketBody(t: NewSessionTicketMessage): Array<Uint8> =
    let w = ByteWriter.make()
    w.putU32(t.ticketLifetime)
    w.putU32(t.ticketAgeAdd)
    w.putVec8(t.ticketNonce)
    w.putVec16(t.ticket)
    w.putBytes(serializeExtensions(t.extensions, ExtensionContext.EncryptedExtensionsContext))
    w.toBytes()

// ---------------------------------------------------------------------------
// Parsing
// ---------------------------------------------------------------------------

/// Parse a single complete handshake message occupying all of `bytes`.
function parseHandshake(bytes: Array<Uint8>): Result<HandshakeMessage, TlsError> =
    let r = ByteReader.make(bytes)
    let msgType = try r.u8()
    let body = try r.vec24()
    if msgType == htClientHello then parseClientHello(body)
    else if msgType == htServerHello then parseServerHello(body)
    else if msgType == htEncryptedExtensions then parseEncryptedExtensions(body)
    else if msgType == htCertificate then parseCertificate(body)
    else if msgType == htCertificateVerify then parseCertificateVerify(body)
    else if msgType == htFinished then Ok(HandshakeMessage.Finished(body))
    else if msgType == htNewSessionTicket then parseNewSessionTicket(body)
    else if msgType == htKeyUpdate then parseKeyUpdate(body)
    else Error(TlsError.UnexpectedMessage("unknown handshake type"))

/// The total framed length of the handshake message at the front of `bytes`
/// (4 + body length), or `None` if fewer than 4 header bytes are present.
function handshakeMessageLength(bytes: Slice<Uint8>): Option<Int32> =
    if bytes.length < 4 then
        None
    else
        let b1 = bytes.get(1).toInt32()
        let b2 = bytes.get(2).toInt32()
        let b3 = bytes.get(3).toInt32()
        Some(4 + ((b1 << 16) | (b2 << 8) | b3))

function codesToCipherSuites(bytes: Array<Uint8>): List<CipherSuite> =
    let r = ByteReader.make(bytes)
    // Prepend + reverse: the suite list is peer-controlled, and appending to
    // the end walked everything parsed so far on every suite.
    let mutable suites: List<CipherSuite> = List.empty
    while r.remaining >= 2 do
        match cipherSuiteFromCode(r.u16().or(0)) with
            case Some(cs) => suites = suites.prepend(cs)
            case None => ()
    suites.reverse()

function parseClientHello(body: Array<Uint8>): Result<HandshakeMessage, TlsError> =
    let r = ByteReader.make(body)
    let legacyVersion = try r.u16()
    let random = try r.bytes(32)
    let sessionId = try r.vec8()
    let csBytes = try r.vec16()
    let compression = try r.vec8()
    // RFC 8446 §4.1.2: legacy_compression_methods MUST be a single null byte {0}; a
    // server MUST abort on anything else (a compression-offering peer is non-conformant).
    if compression.length != 1 || compression.get(0) != 0u8 then
        try Result.Error(TlsError.IllegalParameter("non-null legacy compression method"))
    let extensions = try parseExtensions(r, ExtensionContext.ClientHelloContext)
    Ok(HandshakeMessage.ClientHello(ClientHelloMessage {
        random = random
        legacySessionId = sessionId
        cipherSuites = codesToCipherSuites(csBytes)
        extensions = extensions
    }))

function parseServerHello(body: Array<Uint8>): Result<HandshakeMessage, TlsError> =
    let r = ByteReader.make(body)
    let legacyVersion = try r.u16()
    let random = try r.bytes(32)
    let sessionId = try r.vec8()
    let csCode = try r.u16()
    let compression = try r.u8()
    // RFC 8446 §4.1.3: legacy_compression_method MUST be 0; the client MUST abort otherwise.
    if compression != 0 then
        try Result.Error(TlsError.IllegalParameter("non-null legacy compression method"))
    let context = if ConstantTime.equal(random, helloRetryMagic()) then ExtensionContext.HelloRetryRequestContext else ExtensionContext.ServerHelloContext
    let extensions = try parseExtensions(r, context)
    match cipherSuiteFromCode(csCode) with
        case None => Error(TlsError.IllegalParameter("unknown cipher suite in ServerHello"))
        case Some(cs) => Ok(HandshakeMessage.ServerHello(ServerHelloMessage {
            random = random
            legacySessionId = sessionId
            cipherSuite = cs
            extensions = extensions
        }))

function parseEncryptedExtensions(body: Array<Uint8>): Result<HandshakeMessage, TlsError> =
    let r = ByteReader.make(body)
    let extensions = try parseExtensions(r, ExtensionContext.EncryptedExtensionsContext)
    Ok(HandshakeMessage.EncryptedExtensions(extensions))

function parseCertificate(body: Array<Uint8>): Result<HandshakeMessage, TlsError> =
    let r = ByteReader.make(body)
    let context = try r.vec8()
    let listBytes = try r.vec24()
    let lr = ByteReader.make(listBytes)
    let mutable entries: List<CertificateEntry> = List.empty
    while lr.remaining >= 3 do
        let certData = try lr.vec24()
        let exts = try parseExtensions(lr, ExtensionContext.EncryptedExtensionsContext)
        entries = entries.prepend(CertificateEntry { certData = certData; extensions = exts })
    let parsedEntries = entries.reverse()
    Ok(HandshakeMessage.Certificate(CertificateMessage {
        certificateRequestContext = context
        certificates = parsedEntries
    }))

function parseCertificateVerify(body: Array<Uint8>): Result<HandshakeMessage, TlsError> =
    let r = ByteReader.make(body)
    let code = try r.u16()
    let signature = try r.vec16()
    match sigSchemeFromCode(code) with
        case None => Error(TlsError.IllegalParameter("unknown signature scheme"))
        case Some(scheme) => Ok(HandshakeMessage.CertificateVerify(CertificateVerifyMessage {
            algorithm = scheme
            signature = signature
        }))

function parseNewSessionTicket(body: Array<Uint8>): Result<HandshakeMessage, TlsError> =
    let r = ByteReader.make(body)
    let lifetime = try r.u32()
    let ageAdd = try r.u32()
    let nonce = try r.vec8()
    let ticket = try r.vec16()
    let extensions = try parseExtensions(r, ExtensionContext.EncryptedExtensionsContext)
    Ok(HandshakeMessage.NewSessionTicket(NewSessionTicketMessage {
        ticketLifetime = lifetime
        ticketAgeAdd = ageAdd
        ticketNonce = nonce
        ticket = ticket
        extensions = extensions
    }))

function parseKeyUpdate(body: Array<Uint8>): Result<HandshakeMessage, TlsError> =
    // RFC 8446 §4.6.3: KeyUpdate carries exactly one byte, request_update, which
    // MUST be 0 (update_not_requested) or 1 (update_requested). Any other value —
    // or a body that is not exactly one byte — MUST abort with illegal_parameter.
    if body.length != 1 then
        Error(TlsError.IllegalParameter("KeyUpdate body must be exactly one byte"))
    else
        let r = ByteReader.make(body)
        let v = try r.u8()
        if v != 0 && v != 1 then
            Error(TlsError.IllegalParameter("KeyUpdate request_update must be 0 or 1"))
        else
            Ok(HandshakeMessage.KeyUpdate(v == 1))

test "tls handshake parseKeyUpdate validates request_update (C6)" =
    // RFC 8446 §4.6.3: request_update is exactly one byte, 0 or 1.
    match parseKeyUpdate([|0u8|]) with
        case Ok(KeyUpdate(req)) => assert req == false
        case _ => assert false
    match parseKeyUpdate([|1u8|]) with
        case Ok(KeyUpdate(req)) => assert req
        case _ => assert false
    // value 2 is illegal_parameter
    match parseKeyUpdate([|2u8|]) with
        case Error(TlsError.IllegalParameter(_)) => assert true
        case _ => assert false
    // a zero-byte body is illegal_parameter
    match parseKeyUpdate(Array<Uint8>.empty()) with
        case Error(TlsError.IllegalParameter(_)) => assert true
        case _ => assert false
    // a two-byte body is illegal_parameter (trailing byte)
    match parseKeyUpdate([|1u8, 0u8|]) with
        case Error(TlsError.IllegalParameter(_)) => assert true
        case _ => assert false

test "tls handshake ClientHello round-trips" =
    let ch = ClientHelloMessage {
        random = Array<Uint8>.fill(32, 0x11u8)
        legacySessionId = Array<Uint8>.fill(32, 0x22u8)
        cipherSuites = [CipherSuite.Aes128GcmSha256, CipherSuite.ChaCha20Poly1305Sha256]
        extensions = [
            Extension.ServerName("example.com"),
            Extension.SupportedVersions([versionTls13]),
            Extension.KeyShare([KeyShareEntry { group = KeyExchangeGroup.X25519; keyExchange = Array<Uint8>.fill(32, 0x33u8) }]),
        ]
    }
    let bytes = serializeHandshake(HandshakeMessage.ClientHello(ch))
    assert bytes.get(0) == 1u8       // client_hello
    match parseHandshake(bytes).require with
        case ClientHello(parsed) =>
            assert parsed.random.length == 32
            assert parsed.cipherSuites.length == 2
            assert parsed.legacySessionId.length == 32
            assert parsed.extensions.length == 3
        case _ => assert false

test "tls handshake ServerHello round-trips" =
    let sh = ServerHelloMessage {
        random = Array<Uint8>.fill(32, 0x44u8)
        legacySessionId = Array<Uint8>.fill(0, 0u8)
        cipherSuite = CipherSuite.Aes256GcmSha384
        extensions = [
            Extension.SupportedVersions([versionTls13]),
            Extension.KeyShare([KeyShareEntry { group = KeyExchangeGroup.X25519; keyExchange = Array<Uint8>.fill(32, 0x55u8) }]),
        ]
    }
    let bytes = serializeHandshake(HandshakeMessage.ServerHello(sh))
    assert bytes.get(0) == 2u8       // server_hello
    match parseHandshake(bytes).require with
        case ServerHello(parsed) =>
            match parsed.cipherSuite with
                case Aes256GcmSha384 => assert true
                case _ => assert false
            assert isHelloRetryRequest(parsed) == false
        case _ => assert false

test "tls handshake Certificate and CertificateVerify round-trip" =
    let certMsg = CertificateMessage {
        certificateRequestContext = Array<Uint8>.empty()
        certificates = [
            CertificateEntry { certData = Array<Uint8>.fill(120, 0x66u8); extensions = List<Extension>.empty },
        ]
    }
    let cb = serializeHandshake(HandshakeMessage.Certificate(certMsg))
    match parseHandshake(cb).require with
        case Certificate(parsed) =>
            match parsed.certificates with
                case [only] => assert only.certData.length == 120
                case _ => assert false
        case _ => assert false

    let cv = CertificateVerifyMessage { algorithm = SignatureScheme.EcdsaSecp256r1Sha256; signature = Array<Uint8>.fill(72, 0x77u8) }
    let vb = serializeHandshake(HandshakeMessage.CertificateVerify(cv))
    match parseHandshake(vb).require with
        case CertificateVerify(parsed) =>
            assert parsed.signature.length == 72
            match parsed.algorithm with
                case EcdsaSecp256r1Sha256 => assert true
                case _ => assert false
        case _ => assert false

test "tls handshake Finished and KeyUpdate round-trip" =
    let fb = serializeHandshake(HandshakeMessage.Finished(Array<Uint8>.fill(32, 0x88u8)))
    match parseHandshake(fb).require with
        case Finished(vd) => assert vd.length == 32
        case _ => assert false
    let kb = serializeHandshake(HandshakeMessage.KeyUpdate(true))
    match parseHandshake(kb).require with
        case KeyUpdate(req) => assert req
        case _ => assert false

test "tls handshakeMessageLength reads the uint24 header" =
    let fb = serializeHandshake(HandshakeMessage.Finished(Array<Uint8>.fill(48, 0x99u8)))
    match handshakeMessageLength(fb[|..|]) with
        case Some(len) => assert len == 4 + 48
        case None => assert false
    let padded = [|255u8|].concat(fb).concat([|255u8|])
    match handshakeMessageLength(padded[|1..5|]) with
        case Some(len) => assert len == 4 + 48
        case None => assert false
    match handshakeMessageLength(padded[|1..4|]) with
        case None => assert true
        case Some(_) => assert false
    // a truncated header gives None
    match handshakeMessageLength([|1u8, 0u8|][|..|]) with
        case None => assert true
        case Some(_) => assert false
